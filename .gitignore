__pycache__/
*.pyc

# La INSTANCIA no vive dentro del PRODUCTO (02 §1). Pero la forma v2
# —correr con AEGIS_HOME == AEGIS_ROOT— sigue siendo legítima, y en esa
# forma la instancia aparece acá adentro. Que no se versione nunca:
/platform/
/.init-state/
/.state-secrets/
/.age-public
/aegis.conf
# Los checkouts que deja `aegis app rebase` (REBASE_DIR = $AEGIS_HOME/
# .aegis-rebase): repos AJENOS, con su propio .git adentro. En la forma
# v2 caen acá, y un clon anidado en un repo se cuela como «embedded
# repository» — que es justo lo que ese directorio se mudó a evitar.
/.aegis-rebase/

# El expediente de cada corrida vive en $AEGIS_HOME/.init-state/runs/ —
# ya cubierto por /.init-state/ de arriba. En v2 hacía falta una línea
# propia porque el log caía DENTRO del repo del producto (init/.init-logs/).

# Bundles de aegis state backup / data backup: van age-cifrados, pero
# adentro viaja el tfstate del borde con el token del túnel EN CLARO.
# El resguardo va FUERA del árbol (misma regla que v2).
*.age
