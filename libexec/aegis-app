#!/usr/bin/env python3
# aegis-summary: Signing an organization up: contract first, apply afterwards
# aegis-group:   apps
# aegis-subcommands: new apply
"""aegis-app — signing an organization up: `new` writes files, `apply` touches GitHub.

THE PROBLEM IT SOLVES
─────────────────────
Signing an organization up left three steps that no tool closed, and all
three are against GitHub: create the app's repo, register the deploy key,
and set up the webhook — steps 4, 6 and 8 of the manual path
(journeys/design.md §3). aegis-org generates the files and aegis-secret
the credential; from there on the operator was left alone with `gh` and a
mental list. The step aegis-secret prints as «ONE STEP IS MISSING, and it
is by hand» —registering the public half in GitHub— was irreducible only
while nobody mechanized it: GitHub does not accept the key registering
itself, but it does accept `gh repo deploy-key add`. `apply` is that step,
reduced.

And on the other side of the same sign-up: writing the contract, the
repo's skeleton and running the derivations was a four-command recipe you
had to know by heart. `new` is that recipe, in order and in one go — the
template path of journeys/design.md §1, without locking anybody in: what
it generates is EXACTLY what the artisan writes by hand, and a second
later the user IS an artisan (the template evaporates, §0.3).

THE BORDER (the house rule, carved here as in aegis-org)
────────────────────────────────────────────────────────
The two subcommands live on either side of the SAME line, and that line
is the whole design (journeys/design.md §0.2 and §3):

  `new`    WRITES FILES AND NEVER TOUCHES THE WORLD. Contract, staging,
           derivations, encrypted secrets: everything is a git diff,
           everything is reviewable, nothing left this machine. It does not
           use `gh`, it does not use the network. Generating is harmless.
  `apply`  TALKS TO THE WORLD (GitHub) AND NEVER WRITES INTO THE REPOS —
           neither into platform/ nor into the app's repo WITH HISTORY.

It is the mirror of aegis-org's «IT DOES NOT TALK TO THE CLUSTER», split
in two: between generating and executing there is a PAUSE with a human
inside (tofu's plan/apply, applied to onboarding). The only planting
`apply` does in somebody else's repo is pushing the skeleton into an EMPTY
repo (0 commits on the default branch): planting where there is nothing.
A repo with history is never trampled — there is no `--force` in this file
and there never must be. (The init does force at phase 12, and it may: its
repos are marked disposable BY CONSTRUCTION. An organization's are not,
and that difference is the whole rule.)

WHO GENERATES AND WHO EXECUTES
──────────────────────────────
aegis-org DERIVES (manifests, jobs, Jenkinsfiles into the .aegis-app/
staging area) and aegis-secret CREATES the encrypted credential; this
command EXECUTES that derivation against GitHub. The list of repos comes
out of the generator's `repos_of()` — the SAME one that decides the
Applications, the AppProject's sourceRepos and the credentials. Fourth
consumer of the same source, and for the same reason as always: two lists
computed apart is how they go out of sync. The webhooks are not listed
here: their honest source is Jenkins's values, and that invariant already
has an owner (`aegis webhook`) — it is delegated, not duplicated.

THREE OUTCOMES PER STEP (the house doctrine)
────────────────────────────────────────────
done / already / COULD NOT EVALUATE. The third is a WARNING and never an
approval: not being able to look is not the same as being fine (the rc 2
of aegis-edge and aegis-webhook, from the same disease E). Re-running with
everything done ends up as pure «already» — converge, do not execute
(journeys/design.md §0.4). It holds for both subcommands: `new` re-run
with everything done also ends up as pure «already».

    aegis app new tienda --template base   # contract + skeleton + derive
    aegis app new tienda                   # artisan: the contract is already
                                           # there, it only re-derives (re-entry)
    aegis app apply orgs/ejemplo.yaml      # converges against GitHub
    aegis app apply ejemplo --check        # says what it would do, without touching

It returns 0 if everything was or has been done, 1 if something is left to
do (--check), 2 if something COULD NOT BE EVALUATED or aborted.

Left human on purpose (journeys/design.md §3): the commit+push of
platform/ —an act of government— and the edge's `tofu apply` (#46). This
command names them at the end, it does not do them.
"""
import argparse
import base64
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

try:
    import yaml
except ImportError:
    sys.exit("pyyaml is missing (python3-yaml)")

# ── canonical python preamble (V-102) ────────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, paths             # noqa: E402

# PLATFORM_DIR is the INSTANCE (the live checkout of the platform), not
# the product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. On moving the
# code to the product the same line went on compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a grep».
PLATFORM_DIR = str(paths.platform_dir())
HERE = os.path.join(_AEGIS_ROOT, "libexec")
ORGS_DIR = os.path.join(PLATFORM_DIR, "orgs")
STAGING_DIR = os.path.join(PLATFORM_DIR, ".aegis-app")
WEBHOOK = os.path.join(HERE, "aegis-webhook")

# The repos THIS command creates carry a topic of their own, not the
# init's `aegis-v2-disposable`: that marker means «the init may trample
# me with --force», and an organization's repo is exactly the opposite of
# that. The topic says who created it, nothing more.
TOPIC = "aegis-app"
KEY_TITLE = "aegis-argocd-ro"   # the same one aegis-secret tells you to set by hand

REPO_URL = re.compile(
    r"^(?:git@github\.com:|https://github\.com/)([^/]+)/(.+?)(?:\.git)?/?$")

red = "\033[31m"; green = "\033[32m"; yellow = "\033[33m"; gray = "\033[90m"; reset = "\033[0m"
if not sys.stdout.isatty():
    red = green = yellow = gray = reset = ""


class Error(Exception):
    pass


def _generator():
    """The generator, as a MODULE of the package.

    The list of repos comes from THERE: reimplementing `repos_of` here
    would be the fourth copy of the same rule, and the way it would fail
    is ugly —the repo is created under one name, the Application reads
    another, and the error talks about permissions and not about two
    lists having diverged—.

    In v2 this loaded the aegis-org executable with SourceFileLoader
    (C1). Now it is a real import: if the package is not there, it fails
    here with the reason, instead of degrading in silence.
    """
    from aegis import org
    return org


def _contract(arg):
    """Resolves `orgs/x.yaml` or `x` to the VALIDATED contract.

    It is validated with the generator's validator and not with a bare
    safe_load: an invalid contract must not get as far as touching
    GitHub, and the validator already knows how to say why with its
    finger on the line.
    """
    path = arg if os.path.exists(arg) else os.path.join(ORGS_DIR, f"{arg}.yaml")
    if not os.path.exists(path):
        raise Error(f"{arg} does not exist (neither as a file nor as orgs/{arg}.yaml)")
    gen = _generator()
    plans = yaml.safe_load(open(gen.PLANS, encoding="utf-8"))
    try:
        c = gen.validate(yaml.safe_load(open(path, encoding="utf-8")), plans)
    except gen.Invalid as e:
        raise Error(f"{path}: {e}")
    return path, c


def _owner_repo(url):
    m = REPO_URL.match(url or "")
    if not m:
        raise Error(f"I do not understand the URL {url!r} (I expect git@github.com:owner/repo.git)")
    return m.group(1), m.group(2)


def _gh(*args, stdin_text=None):
    return subprocess.run(["gh", *args], input=stdin_text, capture_output=True, text=True)


def _repo_exists(owner, repo):
    """True/False, or Error if it could not be LOOKED AT — which is not the same as not being there."""
    r = _gh("api", f"repos/{owner}/{repo}", "--jq", ".id")
    if r.returncode == 0:
        return True
    if "HTTP 404" in r.stderr:
        return False
    raise Error(f"I could not look at {owner}/{repo}: {r.stderr.strip()}")


def _has_history(owner, repo):
    """Is there at least one commit on the default branch?

    The API is asked and not a clone: GitHub answers 409 «Git Repository
    is empty» for a repo without commits, which is exactly the
    distinction the skeleton's guard needs.
    """
    r = _gh("api", f"repos/{owner}/{repo}/commits?per_page=1", "--jq", "length")
    if r.returncode == 0:
        return True
    if "HTTP 409" in r.stderr or "is empty" in r.stderr:
        return False
    raise Error(f"I could not look at the history of {owner}/{repo}: {r.stderr.strip()}")


def _create_repo(owner, repo, org):
    """`gh repo create` with the init's convention (phase 12): private + topic."""
    r = _gh("repo", "create", f"{owner}/{repo}", "--private",
            "--description", f"aegis — organization {org}")
    if r.returncode != 0:
        raise Error(f"gh repo create {owner}/{repo} failed: {r.stderr.strip()}")
    r = _gh("api", "-X", "PUT", f"repos/{owner}/{repo}/topics", "-f", f"names[]={TOPIC}")
    if r.returncode != 0:
        raise Error(f"I could not mark {owner}/{repo} with the topic {TOPIC}: {r.stderr.strip()}")


# ── the skeleton ──────────────────────────────────────────────────────

def _staging_for(c, url):
    """The staging area that corresponds to this repo, or (None, why not).

    For a repo declared IN A SERVICE the answer is direct:
    `.aegis-app/<org>/<svc>/`. For the ORGANIZATION's repo there is an
    answer only if exactly ONE buildable service uses it: with two or
    more, the monorepo's layout (what goes at the root? which Jenkinsfile,
    if the multibranch reads only one?) is not derivable — it is the
    inheritance noted in RUTA.md: the v1 model is repo-per-service, and
    blog and portafolio live with a Jenkinsfile adapted by hand.
    Inventing a layout here would be deciding for the artisan.
    """
    org = c["organizacion"]
    gen = _generator()
    for s in c.get("servicios") or []:
        if s.get("repo") == url:
            return os.path.join(STAGING_DIR, org, s["nombre"]), None
    candidates = [s["nombre"] for s in c.get("servicios") or []
                  if s.get("tipo") in gen.TYPES_WITH_IMAGE and not s.get("repo")]
    if len(candidates) == 1:
        return os.path.join(STAGING_DIR, org, candidates[0]), None
    if not candidates:
        return None, "no buildable service uses this repo"
    return None, (f"{len(candidates)} services share it "
                  f"({', '.join(candidates)}) and the monorepo's layout is not "
                  f"derivable — plant it by hand (v1 is repo-per-service)")


def _plant(owner, repo, staging):
    """Pushes the staging area into an EMPTY repo. A normal push, NEVER --force.

    If history appeared between the emptiness check and this push, the
    push FAILS with non-fast-forward — and failing is the correct
    behaviour: the guard is «do not trample», not «win the race».

    The push goes over https with gh's credential helper (phase 12 of the
    init leaves it configured with `gh auth setup-git`); the SSH deploy
    keys belong to the in-cluster consumers, not to this machine.
    """
    d = tempfile.mkdtemp(prefix="aegis-app.")

    def git(*args):
        r = subprocess.run(["git", "-C", d, *args], capture_output=True, text=True)
        if r.returncode != 0:
            raise Error(f"git {args[0]} failed: {r.stderr.strip() or r.stdout.strip()}\n"
                        f"  (if it is about identity: git config --global user.name/user.email\n"
                        f"   — phase 12 of the init leaves that done)")
        return r

    try:
        shutil.copytree(staging, d, dirs_exist_ok=True)
        git("init", "-b", "main")
        git("add", "-A")
        git("commit", "-m", f"feat: initial skeleton (planted by aegis app apply)",
            "--no-verify")
        git("remote", "add", "origin", f"https://github.com/{owner}/{repo}.git")
        git("push", "-u", "origin", "main")   # without --force: see above
    finally:
        shutil.rmtree(d, ignore_errors=True)


# ── the deploy key ────────────────────────────────────────────────────

def _public_of(name):
    """The public half of the organization's deploy key.

    The public half is not persisted anywhere, and that is on purpose:
    aegis-secret prints it ONCE when creating the pair and stores only the
    private one, encrypted. So here it is DERIVED — and it is derived from
    the LIVE Secret in argocd, not from the encrypted file, by the same
    doctrine as aegis-webhook's HMAC: the key that matters is the one
    ArgoCD PRESENTS, not the one git says it should present. As a bonus,
    reading the cluster does not need the age key; decrypting with sops
    does.

    The private material passes through here and that is why the recipe is
    the SAME as aegis-secret's _deploy_key: tmpfs (/dev/shm), a 700
    directory, a 600 file, shred before deleting. `ssh-keygen -y` does not
    know how to read from stdin —it needs a -f— and that is the only
    reason it touches disk. The private half is NOT printed, does not pass
    through argv, does not leave tmpfs.
    """
    r = subprocess.run(
        ["kubectl", "get", "secret", f"{name}-repo", "-n", "argocd",
         "-o", "jsonpath={.data.sshPrivateKey}"],
        capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        raise Error(f"I could not read the Secret argocd/{name}-repo "
                    f"(is kubectl configured? did aegis secret create run and "
                    f"did argocd-secrets sync?)")
    private = base64.b64decode(r.stdout.strip()).decode()

    if not os.path.isdir("/dev/shm"):
        raise Error("there is no /dev/shm: transient material only goes to tmpfs")
    d = tempfile.mkdtemp(prefix="aegis-app.", dir="/dev/shm")
    os.chmod(d, 0o700)
    priv = os.path.join(d, "k")
    try:
        with open(os.open(priv, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w",
                  encoding="utf-8") as f:
            f.write(private if private.endswith("\n") else private + "\n")
        r = subprocess.run(["ssh-keygen", "-y", "-f", priv],
                           capture_output=True, text=True)
        if r.returncode != 0:
            raise Error(f"ssh-keygen -y could not derive the public half: {r.stderr.strip()}")
        # type + blob, without the comment: it is the shape GitHub returns it in.
        return " ".join(r.stdout.split()[:2])
    finally:
        subprocess.run(["shred", "-u", priv], capture_output=True)
        shutil.rmtree(d, ignore_errors=True)


def _keys_of(owner, repo):
    r = _gh("api", f"repos/{owner}/{repo}/keys")
    if r.returncode != 0:
        raise Error(f"I could not list the deploy keys of {owner}/{repo}: {r.stderr.strip()}")
    return json.loads(r.stdout)


def _register_key(owner, repo, public):
    """`gh repo deploy-key add`, in its API form. read_only EXPLICIT.

    It is GitHub's default, but here it goes declared anyway: a deploy key
    with write access on an app's repo lets whoever holds the cluster
    write into the repo, which is the wrong direction — the same warning
    aegis-secret prints in red. The body goes in through stdin out of the
    house's habit, even though the public half is public.
    """
    body = {"title": KEY_TITLE, "key": public, "read_only": True}
    r = _gh("api", "-X", "POST", f"repos/{owner}/{repo}/keys", "--input", "-",
            stdin_text=json.dumps(body))
    if r.returncode != 0:
        raise Error(f"I could not register the deploy key in {owner}/{repo}: {r.stderr.strip()}")


# ── new: the template path (files only) ───────────────────────────────

def _templates_dir():
    """Where the templates live: the PRODUCT's `seed/templates/`.

    The resolution assumes the layout of aegis dev seed: platform/ (the
    instance, this script's PLATFORM_DIR) lives NESTED inside the root of
    the product repo (aegis-v2), with the seed beside it. That is:

        <product>/            ← os.path.dirname(PLATFORM_DIR)
        ├── seed/templates/   the templates (the catalogue of §4)
        └── platform/         this instance (PLATFORM_DIR)

    On an instance WITHOUT the product repo around it —a loose clone of
    ops-stack— that directory does not exist, and the honest answer is an
    error that names what is missing and the path that remains (the
    artisan does not need templates), not a traceback from os.listdir. The
    return of the templates to the packaged instance belongs to A7
    (RUTA.md), not to this command.
    """
    d = os.path.join(os.path.dirname(PLATFORM_DIR), "seed", "templates")
    if not os.path.isdir(d):
        raise Error(
            f"I cannot find the templates: {d} does not exist\n"
            f"  The templates live in the PRODUCT repo (aegis-v2), with this\n"
            f"  instance nested inside it. This clone looks loose, without the\n"
            f"  product around it. Ways out: run from a checkout of the product,\n"
            f"  or the artisan path — write orgs/<org>.yaml by hand and run\n"
            f"  `aegis app new <org>` WITHOUT --template, which only derives.")
    return d


def _template(name):
    """The directory of ONE template, or the real catalogue in the error."""
    d = os.path.join(_templates_dir(), name)
    if not os.path.isdir(d):
        available = sorted(x for x in os.listdir(_templates_dir())
                           if os.path.isdir(os.path.join(_templates_dir(), x)))
        raise Error(f"the template {name!r} does not exist. "
                    f"There is: {', '.join(available) or '(none)'}")
    return d


# [A-Z0-9_] and not [A-Z]: until 2026-08-24 this pattern was
# `__[A-Z]+__`, which does NOT recognize a single placeholder with an
# underscore inside — that is, neither __ROOT_DOMAIN__ nor __GH_OWNER__
# nor __PLATFORM_REPO__, which are 83 of the seed's 130 appearances. The
# guard in _render_tpl exists so that a template asking for something I
# do not know how to derive stops here; with the old pattern it handed
# over the app's repo with the literal inside.
PLACEHOLDER = re.compile(r"__[A-Z0-9_]+__")


# ── the images a template starts FROM ─────────────────────────────────
#
# WHY A PLACEHOLDER AND NOT THE IMAGE WRITTEN OUT. Until 2026-08-29 the
# `base` template shipped `FROM docker.io/library/golang` and
# `FROM docker.io/library/alpine`: an image pulled off the internet, by
# a mutable tag, into the very pipeline that then signs the result. That
# is the hole mirror-images exists to close (see its header, and the
# canary that was the last place it hid), reopened one level down — and
# reopened by the file that teaches every new organization how to build.
# So every FROM of every template is a placeholder, and the value is
# asked for at the moment of instantiating.
#
# WHY IT IS ASKED OF THE LIVE REGISTRY AND NOT READ OUT OF
# seed/platform/mirror-images/images.txt, which carries a digest for
# every mirrored image and is right there in the tree. Because that
# digest is the UPSTREAM one: crane rebuilds the manifest when it
# copies, so the same bytes get a different name inside. A FROM
# assembled from images.txt pins a digest the internal registry has
# never heard of, and the build dies on the pull with an error that
# talks about a manifest and not about this decision. Only the live
# registry knows the answer, and asking it is `aegis image`'s job.
#
# The table maps the placeholder to WHAT IS ASKED FOR (<name>:<tag>).
# The ANSWER —the reference with the internal digest— never lives here.
_FROM_IMAGES = {
    # Mirrored third parties: the tag is the destination column of
    # seed/platform/mirror-images/images.txt, which is where a new one
    # is added first.
    "__FROM_GOLANG__": "golang:1.26.6-alpine",
    "__FROM_ALPINE__": "alpine:3.21",
    "__FROM_PYTHON__": "python:3.12-slim",
    # Built by the platform's own ci-images job, which DERIVES the tag
    # from the FROM of ci-images/node/Containerfile. It is the image
    # every pipeline already builds in, so a template that compiles
    # javascript compiles in the same place its CI does.
    "__FROM_CI_NODE__": "aegis-ci-node:22.23.1-alpine",
    # Bases the platform OWNS. base-images publishes
    # `<alpine minor>-<build padded to 6>` and never a floating tag, so
    # the build number is not knowable from the seed: what is asked for
    # is the minor the seed pins, and resolving it to the newest build
    # of that minor is the registry's business, not this table's.
    "__FROM_BASE_NGINX__": "aegis-base-nginx:3.22",
    "__FROM_BASE_NODE__": "aegis-base-node:3.22",
    # A JDK/JRE pair NOBODY has mirrored yet, and that is the point: the
    # java template exists so that whoever needs java is told, in one
    # command, exactly what to ask for. Until it is mirrored,
    # instantiating that template fails — loudly, and before a single
    # file is written.
    "__FROM_JDK__": "eclipse-temurin:21-jdk-alpine",
    "__FROM_JRE__": "eclipse-temurin:21-jre-alpine",
}

_FROM_PLACEHOLDER = re.compile(r"__FROM_[A-Z0-9_]+__")

# The CONTRACT of `aegis image from`: one line on stdout and nothing
# else, the whole FROM, against the internal registry and pinned by
# digest. It is matched and not merely captured because an answer of
# another shape is a third outcome —the command ran and said something
# I do not understand— and collapsing it into "not mirrored" would send
# the operator to mirror an image that is already there.
_FROM_ANSWER = re.compile(
    r"FROM (registry\.registry-system\.svc\.cluster\.local:5000/"
    r"[^\s@]+@sha256:[0-9a-f]{64})")


def _from_reference(ref):
    """The image reference behind one __FROM_*__, asked of the registry."""
    try:
        rc, out, err = cli.run("image", "from", ref)
    except cli.CouldNotEvaluate as e:
        raise Error(
            f"I cannot resolve the template's base image {ref}: {e}\n"
            f"  Every FROM of a template is a placeholder on purpose, and only the\n"
            f"  live registry knows the digest it resolves to (the mirror rewrites\n"
            f"  the manifest, so upstream's digest is not the one that pulls here).\n"
            f"  Writing the placeholder through would hand you a Containerfile that\n"
            f"  fails a pipeline later, which is worse than failing now.")
    line = (out or "").strip()
    if rc != 0:
        last = ((err or out or "").strip().splitlines() or [""])[-1]
        raise Error(
            f"{ref} is not in the internal registry"
            + (f" — {last}" if last else "")
            + f"\n  Ask for it and re-run this very command, which converges:\n"
              f"    {cli.cmd('image request')} {ref}")
    m = _FROM_ANSWER.fullmatch(line)
    if m is None:
        raise Error(
            f"{cli.cmd('image from')} {ref} answered something that is not a FROM\n"
            f"  line pinned by digest against the internal registry: {line!r}\n"
            f"  That is not «it is missing»: it is «I could not understand the\n"
            f"  answer», and writing it into a Containerfile would carry the\n"
            f"  confusion into the app's repo.")
    # The keyword stays in the template (`FROM __FROM_X__ AS build`), so
    # what is substituted is the reference alone. Matching the whole line
    # first is what proves the answer is the shape that was asked for.
    return m.group(1)


def _from_values(template_dir):
    """Every __FROM_*__ the template uses, resolved BEFORE anything is written.

    Whole-template and up front on purpose: if one base is missing, the
    operator finds out with ZERO files on disk. Resolving file by file
    would leave a contract written and a Containerfile half rendered,
    and `new` converges by re-running — over a state that is now a lie.
    """
    wanted = set()
    for d, _, files in os.walk(template_dir):
        for a in sorted(files):
            try:
                text = open(os.path.join(d, a), encoding="utf-8").read()
            except (UnicodeDecodeError, OSError):
                continue        # a binary in a template is not a FROM
            wanted |= set(_FROM_PLACEHOLDER.findall(text))
    values = {}
    for ph in sorted(wanted):
        if ph not in _FROM_IMAGES:
            raise Error(
                f"the template asks for {ph} and this command does not know which\n"
                f"  image that is. A new base is TWO lines: its row in _FROM_IMAGES\n"
                f"  (here, the only owner of the template placeholders) and its line\n"
                f"  in the platform's mirror list.")
        values[ph] = _from_reference(_FROM_IMAGES[ph])
    return values


def _values_for(org):
    """The template's placeholders, ALL derivable from the name.

    The user gives ONE word (the organization) and the rest comes out of
    the instance itself — a second source of truth, zero:

      __ORG__      the word
      __DOMINIO__  <org>.<root_domain from edge.yaml> — the same root
                   aegis-org derives the edge's CNAME from
      __REPO__     git@github.com:<owner>/<org>-app.git — the owner comes
                   out of the generator's platform_repo() (THIS instance's repo:
                   the house's apps live in the same account)
    """
    gen = _generator()
    owner, _ = _owner_repo(gen.platform_repo())
    edge = yaml.safe_load(open(gen.EDGE, encoding="utf-8")) or {}
    root = edge.get("root_domain")
    if not root:
        raise Error(f"{os.path.relpath(gen.EDGE, PLATFORM_DIR)} does not declare root_domain — "
                    f"without it I cannot derive the contract's `dominio:`")
    return {"__ORG__": org, "__DOMINIO__": f"{org}.{root}",
            "__REPO__": f"git@github.com:{owner}/{org}-app.git"}


def _render_tpl(text, values, where):
    for k, v in values.items():
        text = text.replace(k, v)
    if (loose := PLACEHOLDER.search(text)) is not None:
        # A template that asks for something this command does not know
        # how to derive has to stop here, not hand over a contract with
        # __X__ inside that the validator rejects with a message about
        # something else.
        raise Error(f"{where}: placeholder {loose.group(0)} without a value — "
                    f"this command derives {', '.join(sorted(values))} and nothing else")
    return text


def _instantiate_contract(org, template_dir, values, tot):
    """Step 2 of `new`: the contract, from the template, VALIDATED before
    touching disk. A contract the generator would reject is not written:
    the template is broken and the error belongs to the template."""
    target = os.path.join(ORGS_DIR, f"{org}.yaml")
    tpl = os.path.join(template_dir, "contract.yaml.tpl")
    if not os.path.exists(tpl):
        raise Error(f"the template has no contract.yaml.tpl ({tpl})")
    text = _render_tpl(open(tpl, encoding="utf-8").read(), values,
                       os.path.relpath(tpl, PLATFORM_DIR))
    gen = _generator()
    plans = yaml.safe_load(open(gen.PLANS, encoding="utf-8"))
    try:
        gen.validate(yaml.safe_load(text), plans)
    except gen.Invalid as e:
        raise Error(f"the instantiated contract does not validate — the template is broken:\n  {e}")
    os.makedirs(ORGS_DIR, exist_ok=True)
    open(target, "w", encoding="utf-8").write(text)
    mark(tot, "done", "contract", os.path.relpath(target, PLATFORM_DIR))
    return target


def _instantiate_skeletons(org, template_dir, values, tot):
    """Step 3 of `new`: the skeletons, into the `.aegis-app/<org>/<svc>/` staging area.

    It coexists with the Jenkinsfile aegis-org leaves in the SAME
    directory (journeys §2b): this function never writes a file called
    Jenkinsfile — that one is instantiated by the derivation, from the
    canonical template, in the next step.

    Convergence file by file: missing → it is written; identical →
    «already»; DIFFERENT → it is left as it is and a warning is given. The
    staging area is the seed of ONE initial push, but if somebody touched
    it up before applying, trampling it would be deciding for them.
    """
    base = os.path.join(template_dir, "repos")
    if not os.path.isdir(base) or not os.listdir(base):
        raise Error(f"the template has no skeletons in {base}")
    for svc in sorted(os.listdir(base)):
        source = os.path.join(base, svc)
        if not os.path.isdir(source):
            continue
        target = os.path.join(STAGING_DIR, org, svc)
        new_files = same = different = 0
        for d, _, files in os.walk(source):
            for a in sorted(files):
                if a == "Jenkinsfile":   # aegis-org's, never from here
                    continue
                rel = os.path.relpath(os.path.join(d, a), source)
                text = _render_tpl(
                    open(os.path.join(d, a), encoding="utf-8").read(),
                    values, os.path.join(os.path.relpath(source, PLATFORM_DIR), rel))
                dest_path = os.path.join(target, rel)
                try:
                    old = open(dest_path, encoding="utf-8").read()
                except FileNotFoundError:
                    old = None
                if old == text:
                    same += 1
                elif old is not None:
                    different += 1
                else:
                    os.makedirs(os.path.dirname(dest_path), exist_ok=True)
                    open(dest_path, "w", encoding="utf-8").write(text)
                    new_files += 1
        rel_dest = os.path.relpath(target, PLATFORM_DIR)
        if different:
            mark(tot, "not_evaluable", f"skeleton {svc}",
                 f"{different} file(s) of {rel_dest} differ from the template "
                 f"and are NOT trampled (review them yourself)")
        elif new_files:
            mark(tot, "done", f"skeleton {svc}",
                 f"{new_files} file(s) in {rel_dest}"
                 + (f" ({same} were already there)" if same else ""))
        else:
            mark(tot, "already", f"skeleton {svc}", rel_dest)


def _derive(path, tot):
    """Steps 4 and 5 of `new`: aegis org apply + aegis secret create.

    Subprocesses with the SAME python and the output NOT captured: both
    report their own convergence line by line and that report is for the
    human, not to be parsed here. Only the rc comes back, and an rc != 0
    stops it: deriving halfway and going on would be printing a «next
    step» over a state that does not exist.
    """
    for step, cmd in (
            ("derivations", [sys.executable, os.path.join(HERE, "aegis-org"),
                             "apply", path]),
            ("secrets", [sys.executable, os.path.join(HERE, "aegis-secret"),
                         "create", path])):
        print(f"\n{gray}── {step}: {' '.join(os.path.relpath(x, PLATFORM_DIR) if os.path.isabs(x) else x for x in cmd[1:])} ──{reset}")
        sys.stdout.flush()
        rc = subprocess.run(cmd).returncode
        if rc != 0:
            raise Error(f"{step} ended with rc {rc} — sort that out and re-run "
                        f"`aegis app new ...`, which converges")
        mark(tot, "done", step, "detail above")


def new(org, template, tot):
    gen = _generator()
    if not gen.VALID_NAME.match(org):
        # The SAME pattern that validates the contract — not a local copy.
        raise Error(f"{org!r} is not a valid organization name "
                    f"({gen.VALID_NAME.pattern}); the namespace is going to be org-{org} "
                    f"and the contract would reject it anyway, better here and now")
    contract = os.path.join(ORGS_DIR, f"{org}.yaml")
    print(f"\n{org}  {gray}(new — files only: none of this touches the world){reset}")

    if template:
        # ── step 1: a live contract is NOT trampled ───────────────
        if os.path.exists(contract):
            raise Error(
                f"orgs/{org}.yaml ALREADY EXISTS and a live contract is not trampled: it\n"
                f"  is edited by hand (it is the only truth, journeys §0.1). If what\n"
                f"  you want is to re-derive whatever is missing, run this very thing\n"
                f"  WITHOUT --template: `aegis app new {org}`")
        d = _template(template)
        values = _values_for(org)
        # The base images LAST and before anything is written: this is
        # the only step that needs the world (the live registry), and it
        # is the one that can honestly say no. Failing here leaves the
        # disk exactly as it was.
        values.update(_from_values(d))
        # ── steps 2 and 3: contract + skeletons ───────────────────
        _instantiate_contract(org, d, values, tot)
        _instantiate_skeletons(org, d, values, tot)
    else:
        # Artisan / re-entry mode: the contract belongs to somebody else,
        # here we only run the machinery that derives from it.
        if not os.path.exists(contract):
            raise Error(
                f"orgs/{org}.yaml does not exist. Without --template this command does\n"
                f"  not invent contracts: write it by hand (the artisan path — look at\n"
                f"  orgs/ejemplo.yaml) or ask a template for one:\n"
                f"  `aegis app new {org} --template base`")
        mark(tot, "already", "contract", f"orgs/{org}.yaml is yours — it is not touched")

    # ── steps 4 and 5: derive and encrypt ─────────────────────────
    _derive(contract, tot)

    # ── step 6: the summary and the pause ─────────────────────────
    staging = os.path.join(STAGING_DIR, org)
    print(f"\n{green}ready{reset} — it has been written, nothing touched the world:")
    print(f"  {gray}contract:{reset}  orgs/{org}.yaml")
    if os.path.isdir(staging):
        n = sum(len(fs) for _, _, fs in os.walk(staging))
        print(f"  {gray}staging:{reset}   {os.path.relpath(staging, PLATFORM_DIR)}/ "
              f"({n} file(s), gitignored — its destination is ANOTHER repo)")
    print(f"  {gray}derived:{reset}   k8s/organizations/org-{org}/ + jobs, edge, "
          f"projects, credentials (above)")
    print(f"\nnext steps, IN ORDER (the pause in the middle is the design):")
    print(f"  1. review the diff: git status && git diff")
    print(f"  2. {cli.cmd('app apply')} {org} --check   {gray}(and without --check when you like it){reset}")
    print(f"  3. commit+push of platform/  {gray}(an act of government — human on purpose){reset}")
    print(f"  4. tofu apply of the edge (#46)  {gray}(tofu/envs/cloudflare-tunnel){reset}")
    return 0


# ── the walk ──────────────────────────────────────────────────────────

def mark(tot, state, step, detail=""):
    tot[state] += 1
    symbol, color = {"already": ("=", gray), "done": ("+", green),
                     "would": ("~", yellow), "not_evaluable": ("!", yellow)}[state]
    text = {"already": "already", "done": "done", "would": "would",
            "not_evaluable": "COULD NOT EVALUATE"}[state]
    suffix = f" — {detail}" if detail else ""
    print(f"  {color}{symbol}{reset} {step}: {text}{gray}{suffix}{reset}")


def apply_repo(c, url, name, write, tot):
    org = c["organizacion"]
    print(f"\n{url}  {gray}(Application: {name}){reset}")
    try:
        owner, repo = _owner_repo(url)
    except Error as e:
        # Without owner/repo NO step of this repo can be evaluated.
        mark(tot, "not_evaluable", "GitHub repo", str(e))
        return

    # ── step 1: the repo ──────────────────────────────────────────
    try:
        exists = _repo_exists(owner, repo)
    except Error as e:
        mark(tot, "not_evaluable", "GitHub repo", str(e))
        # The following steps depend on being able to look at the repo:
        # better three honest warnings than two silences.
        mark(tot, "not_evaluable", "skeleton", "I could not look at the repo")
        mark(tot, "not_evaluable", "deploy key", "I could not look at the repo")
        return
    if exists:
        mark(tot, "already", "GitHub repo")
    elif not write:
        mark(tot, "would", "GitHub repo", f"gh repo create private + topic {TOPIC}")
    else:
        try:
            _create_repo(owner, repo, org)
            mark(tot, "done", "GitHub repo", f"created private, topic {TOPIC}")
            exists = True
        except Error as e:
            mark(tot, "not_evaluable", "GitHub repo", str(e))
            mark(tot, "not_evaluable", "skeleton", "the repo never came to exist")
            mark(tot, "not_evaluable", "deploy key", "the repo never came to exist")
            return

    # ── step 2: the skeleton (ONLY over an empty repo) ────────────
    try:
        # A repo just created is empty by construction; only then is it
        # worth asking about the history of one that was already there.
        empty = True if not exists else not _has_history(owner, repo)
    except Error as e:
        mark(tot, "not_evaluable", "skeleton", str(e))
        empty = None
    if empty is False:
        mark(tot, "already", "skeleton", "the repo has history — it is never trampled")
    elif empty:
        staging, reason = _staging_for(c, url)
        if staging is None:
            mark(tot, "not_evaluable", "skeleton", f"empty repo and no skeleton: {reason}")
        elif not os.path.isdir(staging) or not os.listdir(staging):
            mark(tot, "not_evaluable", "skeleton",
                 f"empty repo and there is no staging area in "
                 f"{os.path.relpath(staging, PLATFORM_DIR)} — it is generated by aegis org apply")
        elif not write:
            n = sum(len(fs) for _, _, fs in os.walk(staging))
            mark(tot, "would", "skeleton",
                 f"push of {os.path.relpath(staging, PLATFORM_DIR)} ({n} file(s))")
        else:
            try:
                _plant(owner, repo, staging)
                mark(tot, "done", "skeleton",
                     f"planted from {os.path.relpath(staging, PLATFORM_DIR)}")
            except Error as e:
                mark(tot, "not_evaluable", "skeleton", str(e))

    # ── step 3: the deploy key ────────────────────────────────────
    try:
        public = _public_of(name)
        registered = _keys_of(owner, repo) if exists else []
    except Error as e:
        mark(tot, "not_evaluable", "deploy key", str(e))
        return
    mine = next((k for k in registered
                 if " ".join((k.get("key") or "").split()[:2]) == public), None)
    if mine and not mine.get("read_only", False):
        # It exists but WITH write access: it converged in presence and
        # violated the doctrine. It is not «fixed» on its own —deleting
        # and recreating a key is an act that cuts ArgoCD's sync for an
        # instant and deserves a human— but neither is it blessed.
        mark(tot, "not_evaluable", "deploy key",
             f"registered WITH write access ({mine.get('title')!r}) — it should be "
             f"read only: review it by hand in GitHub")
    elif mine:
        mark(tot, "already", "deploy key", f"{mine.get('title')!r}, read only")
    elif not exists:
        mark(tot, "would", "deploy key", f"register {KEY_TITLE} (read only)")
    elif not write:
        mark(tot, "would", "deploy key", f"register {KEY_TITLE} (read only)")
    else:
        try:
            _register_key(owner, repo, public)
            mark(tot, "done", "deploy key", f"{KEY_TITLE}, read only")
        except Error as e:
            mark(tot, "not_evaluable", "deploy key", str(e))


def apply_webhooks(write, tot):
    """Delegated ENTIRELY to `aegis webhook`, which owns the invariant.

    Its list comes out of Jenkins's values (every repo with a job, not
    only the ones of these contracts) and that is correct: the invariant
    is «if Jenkins has a job, the push reaches it», and it converges whole
    or it does not converge. With `apply` it also RE-SYNCS the HMAC of the
    existing hooks — GitHub does not let you read a hook's secret, so
    «it exists» does not prove «it is synced»; the idempotent PATCH is its
    way of not guessing.
    """
    print(f"\nwebhooks  {gray}(delegated to {cli.cmd('webhook')} — every repo with a job){reset}")
    # flush BEFORE giving up stdout: with the output piped python buffers
    # and what is delegated would appear above its own title.
    sys.stdout.flush()
    # The rc does not tell «created» from «only re-synced», and for
    # convergence that matters: a resync is maintenance of the idempotent
    # PATCH, not a change of state.
    #
    # Until 2026-08-23 that distinction was drawn by looking for the
    # phrase «webhook creado» in the delegate's output (A3 of the
    # register): one accent less over there broke the table over here, and
    # the symptom appeared in another command. Now the CONTRACT is read:
    # every step emits its state and --json returns them as a document.
    # (`cli` is the module-level import: a second `from aegis import cli`
    #  HERE made the name local to the whole function, and the print
    #  above it crashed with UnboundLocalError — first `aegis app apply`
    #  on a clean instance, 2026-08-27)
    try:
        rc, doc = cli.run_json("webhook", *(["apply"] if write else []))
    except cli.CouldNotEvaluate as e:
        mark(tot, "not_evaluable", "webhooks", str(e))
        return
    created = any(st["state"] == "done" for st in doc.get("steps", []))
    if rc == 0:
        mark(tot, "done" if created else "already", "webhooks",
             f"{len(doc.get('steps', []))} repos")
    elif rc == 1:
        missing = [st["step"] for st in doc.get("steps", []) if st["state"] == "wrong"]
        mark(tot, "would", "webhooks", f"{cli.cmd('webhook apply')} ({len(missing)} without a webhook)")
    else:
        mark(tot, "not_evaluable", "webhooks", f"{cli.cmd('webhook')} could not evaluate (rc 2)")


def main():
    p = argparse.ArgumentParser(prog=cli.cmd("app"), description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True)
    # Subcommands and not flags: `new` (journeys §3, files only) lives
    # next to `apply` (the world only), and the house's border is
    # precisely that line — the order of the help tells it.
    s = sub.add_parser("new",
                       help="writes the WHOLE sign-up into files: contract from a "
                            "template, skeleton, derivations, secrets. "
                            "It never touches the world")
    s.add_argument("organization", metavar="ORG",
                   help="the name of the new organization")
    s.add_argument("--template", metavar="T", dest="template",
                   help="instantiates the contract and the skeletons from "
                        "seed/templates/<T>/. Without this, artisan mode: the "
                        "contract is already yours and it only re-derives")
    s = sub.add_parser("apply",
                       help="executes the GitHub steps of each contract: "
                            "repo, skeleton, deploy key, webhook")
    s.add_argument("contracts", nargs="+", metavar="CONTRACT",
                   help="orgs/<n>.yaml or the name of the organization")
    s.add_argument("--check", action="store_true",
                   help="shows what it would do, without touching anything (the init's run_cmd culture)")
    a = p.parse_args()

    if a.cmd == "new":
        # Without a gh check ON PURPOSE: this side of the border talks to
        # nobody, and demanding a session in order to write files would be
        # lying about what it does.
        tot = {"already": 0, "done": 0, "would": 0, "not_evaluable": 0}
        rc = new(a.organization, a.template, tot)
        if tot["not_evaluable"]:
            print(f"\n  {yellow}there are files that differ and were not trampled{reset} "
                  f"{gray}— review them before applying{reset}")
            return 2
        return rc

    write = not a.check

    # Without gh nothing is evaluated, and saying so early is more honest
    # than three identical warnings per repo.
    r = _gh("auth", "status")
    if r.returncode != 0:
        print(f"  {yellow}!{reset} NOT EVALUATED — gh without a session: {r.stderr.strip().splitlines()[-1]}")
        print(f"    {gray}This is NOT approval: it is a check that did not run.{reset}")
        return 2

    tot = {"already": 0, "done": 0, "would": 0, "not_evaluable": 0}
    for arg in a.contracts:
        try:
            path, c = _contract(arg)
        except Error as e:
            print(f"{red}✗{reset} {e}", file=sys.stderr)
            return 2
        repos = _generator().repos_of(c)
        print(f"\n{c['organizacion']}  {gray}({os.path.relpath(path, PLATFORM_DIR)}){reset}")
        if not repos:
            print(f"  {gray}={reset} no repos declared — nothing to do in GitHub "
                  f"{gray}(pure-infrastructure organization){reset}")
            continue
        for url, name in sorted(repos.items()):
            apply_repo(c, url, name, write, tot)

    apply_webhooks(write, tot)

    print(f"\nsummary: {tot['already']} already · {tot['done']} done · "
          f"{tot['would']} to do · {tot['not_evaluable']} warning(s)")
    if tot["not_evaluable"]:
        print(f"  {yellow}there are steps NOT EVALUATED{reset} {gray}— a warning is not an approval: "
              f"sort out the cause and re-run{reset}")
        return 2
    if tot["would"]:
        print(f"  {gray}to do them: {cli.cmd('app apply')} {' '.join(a.contracts)}{reset}")
        return 1
    if write and tot["done"]:
        # What is left is human ON PURPOSE (journeys/design.md §3):
        print(f"  {gray}left human: commit+push of platform/ if aegis-org/aegis-secret\n"
              f"  left a diff (an act of government), and `tofu apply` of the edge (#46).{reset}")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Error as e:
        print(f"{red}✗{reset} {e}", file=sys.stderr)
        sys.exit(2)
