#!/usr/bin/env bash
# aegis-summary: The maintainer's tools (seed and acceptance tests)
# aegis-group:   dev
# aegis-subcommands: seed test-org test-types
# aegis-hidden:  true
#
# aegis-help:
# Usage: aegis dev seed diff|pull|excluded
#        aegis dev test-org <CONTRACT>
#        aegis dev test-types
#
# They are not the operator's: they belong to whoever builds the
# product. That is why they are hidden from the main menu — but they
# exist, they are verified, and they run inside `aegis verify` (H6: in
# v2 these two acceptance tests were orphans, nobody ever ran them).

set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} dev: readlink is missing" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }

case "${1:-}" in
    seed|test-org|test-types) VERB="$1"; shift ;;
    -h|--help|"")             usage; exit 0 ;;
    *) printf '%s dev: «%s» is not a subcommand (seed | test-org | test-types)\n' "${AEGIS_CMD:-aegis}" "$1" >&2
       exit 3 ;;
esac
exec "$AEGIS_ROOT/libexec/dev/$VERB" "$@"
