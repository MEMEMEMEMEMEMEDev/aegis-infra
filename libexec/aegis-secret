#!/usr/bin/env python3
# aegis-summary: Crea, rota y reubica los secretos cifrados de los contratos
# aegis-group:   apps
# aegis-subcommands: create rotate move
"""aegis-secret — crea un secreto cifrado SI FALTA. Nunca lo regenera.

Es la regla I2 del protocolo convertida en mecanismo. Hasta acá era una
promesa escrita: el generador LISTABA los secretos que hacían falta y
alguien los creaba a mano con sops. Eso tiene dos problemas y el segundo
es el grave:

  1. dar de alta una organización dejaba de ser "escribí el contrato".
  2. crear una credencial a mano significa que el material pasa por la
     terminal de alguien. El protocolo dice explícitamente que el
     operador NO ve el material (§6.2), y a mano eso no se puede
     sostener.

Acá el material se genera con `secrets`, se le pasa a `sops` POR STDIN y
lo único que queda en disco es el archivo cifrado. No pasa por argv, no
pasa por un temporal legible, y no se imprime.

    aegis secret k8s/organizations/org-blog/secret-db-credenciales.enc.yaml
    aegis secret create orgs/blog.yaml
    aegis secret --rotar <archivo>      # deliberado, ver abajo

── por qué NO regenera ─────────────────────────────────────────────

Si `aplicar` rotara credenciales, nadie correría el generador dos veces
sobre una organización viva — y un generador que da miedo no es
idempotente aunque lo sea. Reaplicar tiene que ser aburrido.

`--rotar` existe y es otro comando a propósito: rotar es un acto
deliberado, y el que lo hace tiene que saber que la credencial vieja
deja de servir en cuanto el pod se reinicie.

── lo que este comando NO hace ─────────────────────────────────────

No toca el cluster ni revoca nada del otro lado. Rotar la clave del
gateway acá genera una NUEVA, pero el gateway sigue aceptando la vieja
hasta que se la quiten de secret-ai-keys.enc.yaml — que es un archivo
compartido entre organizaciones y por eso no se edita solo. El comando
lo dice cuando corresponde.
"""
import argparse
import base64
import os
import secrets
import subprocess
import sys

try:
    import yaml
except ImportError:
    sys.exit("falta pyyaml (python3-yaml)")

# ── preámbulo canónico de python (V-102) ─────────────────────────────
# El producto sale de la variable (bin/aegis la exporta) o de este
# archivo; la INSTANCIA la decide lib/aegis/paths.py y nadie más.
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, paths             # noqa: E402

# RAIZ es la INSTANCIA (el checkout vivo de plataforma), no el producto.
# En v2 esta línea era `dirname(dirname(__file__))` y funcionaba porque
# el comando vivía DENTRO de la instancia. Al mudar el código al
# producto la misma línea siguió compilando y pasó a apuntar al lugar
# equivocado — la «dependencia invisible a un grep» de C1/C2.
RAIZ = str(paths.platform_dir())
DIR_ORGS = os.path.join(RAIZ, "orgs")
DIR_K8S = os.path.join(RAIZ, "k8s", "organizations")

rojo = "\033[31m"; verde = "\033[32m"; ama = "\033[33m"; gris = "\033[90m"; fin = "\033[0m"
if not sys.stdout.isatty():
    rojo = verde = ama = gris = fin = ""


class Error(Exception):
    pass


# ── generadores de material ─────────────────────────────────────────
#
# `secrets` y no `random`: random es un Mersenne Twister sembrado de
# forma predecible y sirve para simulaciones, no para credenciales.
#
# token_urlsafe(32) son 256 bits de entropía en 43 caracteres. Se usa
# urlsafe y no hex porque estas credenciales viajan en URLs de conexión
# (postgres://usuario:CLAVE@host) y en cabeceras, donde un carácter que
# haya que escapar es una fuente de bugs que aparecen semanas después.


def _palabra(n=32):
    return secrets.token_urlsafe(n)


def _clave_aegis():
    # Mismo formato que emite el gateway: prefijo reconocible para que
    # una credencial filtrada se pueda identificar de un vistazo (y para
    # que los escáneres de secretos de GitHub la puedan cazar).
    return "aegisk_" + secrets.token_urlsafe(32)


def _s3():
    # Garage acepta cualquier par; se imita la forma de AWS para que las
    # bibliotecas cliente no se sorprendan.
    return {
        "AWS_ACCESS_KEY_ID": "GK" + secrets.token_hex(12),
        "AWS_SECRET_ACCESS_KEY": secrets.token_hex(32),
    }


def _deploy_key(comentario):
    """Un par ed25519 para deploy key. Devuelve (privada, pública).

    ES LA ÚNICA RECETA QUE TOCA EL DISCO, y conviene decir por qué.

    El resto de este comando genera material con `secrets` y lo manda a
    sops por stdin: nunca hay un archivo en claro. `ssh-keygen` no sabe
    escribir a stdout —necesita un `-f`— así que acá el material pasa
    por un archivo.

    Ese archivo vive en **tmpfs** (`/dev/shm`), en un directorio 700, y
    se sobrescribe con `shred` antes de borrarlo. Es exactamente el
    mecanismo que el init usa para la PROPIA AGE KEY (lib/secrets.sh
    §SECRETS_TMP), que es la raíz de confianza de toda la plataforma. Si
    tmpfs alcanza para eso, alcanza para un deploy key de un repo.

    La alternativa era generar el par en proceso con `cryptography`, que
    conserva la garantía completa. Se descartó por lo que costaba y no
    por lo que daba: es una dependencia nueva que el preflight tendría
    que instalar y verificar, para ganar una propiedad que este proyecto
    ya decidió que tmpfs provee. `ssh-keygen` ya es requisito
    (lib/checks.sh) y no hay que declarar nada.
    """
    import shutil
    import tempfile
    if not os.path.isdir("/dev/shm"):
        raise Error("no hay /dev/shm: el material transitorio solo va a tmpfs")
    d = tempfile.mkdtemp(prefix="aegis-secret.", dir="/dev/shm")
    os.chmod(d, 0o700)
    priv = os.path.join(d, "k")
    try:
        r = subprocess.run(
            ["ssh-keygen", "-t", "ed25519", "-N", "", "-C", comentario, "-f", priv, "-q"],
            capture_output=True, text=True)
        if r.returncode != 0:
            raise Error(f"ssh-keygen falló: {r.stderr.strip()}")
        with open(priv, encoding="utf-8") as f:
            privada = f.read()
        with open(priv + ".pub", encoding="utf-8") as f:
            publica = f.read().strip()
        return privada, publica
    finally:
        # shred ANTES de borrar: un unlink deja los bloques con el
        # material hasta que algo los reutilice. En tmpfs el riesgo es
        # menor, pero el hábito es el que evita el descuido en el caso
        # en que sí importa.
        for p in (priv, priv + ".pub"):
            if os.path.exists(p):
                subprocess.run(["shred", "-u", p], capture_output=True)
        shutil.rmtree(d, ignore_errors=True)


# nombre del archivo -> (nombre del Secret, campos)
#
# El sufijo del archivo ES el contrato: `secret-<algo>.enc.yaml` produce
# el Secret `<algo>`. Sin esa regla, el generador y esto podrían discrepar
# y el síntoma sería un pod esperando un Secret que existe con otro
# nombre.
RECETAS = {
    "ai-gateway-key": lambda: {"clave": _clave_aegis()},
    # La credencial S3 de UNA organización contra el Garage compartido.
    # El material lo genera aegis (no Garage): así git es la fuente de
    # verdad y el Job de aprovisionamiento IMPORTA la clave en vez de
    # pedirle una nueva. Si la generara Garage, reaplicar produciría una
    # credencial distinta cada vez — justo lo que I2 prohíbe.
    "garage": _s3,
    # rpc_secret y admin_token del Garage COMPARTIDO. Son de plataforma,
    # no de una organización.
    #
    # rpc_secret: 32 bytes en hex, que es lo que Garage espera. No es un
    # largo elegido por gusto — con otro, el nodo no arranca.
    #
    # admin_token: quien lo tenga puede crear claves y darse permiso
    # sobre el bucket de cualquier organización. Es la credencial más
    # sensible de este subsistema.
    "garage-credentials": lambda: {
        "rpc_secret": secrets.token_hex(32),
        "admin_token": _palabra(),
    },
    # El HMAC con el que GitHub firma los webhooks y Jenkins los valida.
    #
    # La clave se llama `text` y no es capricho: el Secret lleva la
    # etiqueta jenkins.io/credentials-type: secretText, y Jenkins lee de
    # `text` el valor de ese tipo de credencial. Cambiarle el nombre deja
    # la credencial vacía sin un solo error.
    #
    # 32 bytes en hex, SIN salto de línea. El \n es el modo de fallo
    # clásico de este secreto: GitHub firma sobre un cuerpo y Jenkins
    # valida sobre otro, y el 403 resultante no dice por qué.
    # token_hex no lo agrega; el peligro está en generarlo a mano con
    # `openssl rand -hex 32 > archivo`, que sí.
    #
    # Los dos lados tienen que quedar con el MISMO valor: después de
    # rotar va bin/aegis-sync jenkins-secrets y después
    # bin/aegis-webhook --aplicar, que lo reescribe en GitHub leyéndolo
    # del cluster.
    "github-webhook-hmac": lambda: {"text": secrets.token_hex(32)},
}

# Dónde puede vivir un secreto y qué namespace le corresponde.
#
#   k8s/organizations/org-blog/secret-x.enc.yaml  -> namespace org-blog
#   k8s/base/garage-system/secret-x.enc.yaml      -> namespace garage-system
#
# El namespace sale de la RUTA y no de un argumento: un secreto escrito
# en el directorio de una organización con el namespace de otra es un
# error que nadie ve hasta que un pod no arranca.
def namespace_de(ruta):
    padre = os.path.basename(os.path.dirname(os.path.abspath(ruta)))
    abuelo = os.path.basename(os.path.dirname(os.path.dirname(os.path.abspath(ruta))))
    if abuelo == "organizations" and padre.startswith("org-"):
        return padre
    if abuelo == "base":
        return padre
    raise Error(f"{ruta}: se esperaba k8s/organizations/org-*/ o k8s/base/<namespace>/")


def receta_de(nombre_secreto):
    if nombre_secreto in RECETAS:
        return RECETAS[nombre_secreto]
    # Credenciales de base: `secret-<servicio>-credenciales.enc.yaml`.
    if nombre_secreto.endswith("-credenciales"):
        base = nombre_secreto[: -len("-credenciales")]
        return lambda: {"usuario": base, "password": _palabra()}
    return None


def _sops_cifrar(destino, documento):
    """Cifra `documento` con sops y lo escribe en `destino`.

    El plano entra por STDIN. No hay archivo temporal en claro ni un solo
    valor en argv: `sops --filename-override` le dice a sops qué regla de
    .sops.yaml aplicar sin que el archivo exista todavía.
    """
    plano = yaml.safe_dump(documento, sort_keys=False, allow_unicode=True)
    rel = os.path.relpath(destino, RAIZ)
    r = subprocess.run(
        ["sops", "--encrypt", "--filename-override", rel, "/dev/stdin"],
        input=plano, capture_output=True, text=True, cwd=RAIZ)
    if r.returncode != 0:
        # El stderr de sops no lleva material; el stdin sí, y no se toca.
        raise Error(f"sops falló ({r.returncode}): {r.stderr.strip()}")
    if "sops:" not in r.stdout:
        raise Error("la salida de sops no parece cifrada — no se escribe nada")
    with open(os.open(destino, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w",
              encoding="utf-8") as f:
        f.write(r.stdout)


def _b64(v):
    """Un campo `data:` de Secret, en claro. None si no está."""
    return base64.b64decode(v).decode() if v else None


def _sops_descifrar(ruta):
    """El documento en claro de un .enc.yaml, en memoria.

    Necesita la age key, y por eso solo lo usa `--rotar`: crear no la
    pide, rotar sí. No toca disco ni argv — sops escribe a stdout y se
    parsea acá. Quien lo llame NO debe imprimir lo que devuelve.
    """
    rel = os.path.relpath(ruta, RAIZ)
    r = subprocess.run(["sops", "--decrypt", rel],
                       capture_output=True, text=True, cwd=RAIZ)
    if r.returncode != 0:
        raise Error(
            f"no pude descifrar {rel} ({r.returncode}): {r.stderr.strip()}\n"
            f"  Rotar necesita la age key para PRESERVAR la forma del documento\n"
            f"  que ya existe. Apuntá SOPS_AGE_KEY_FILE al archivo de la llave.")
    doc = yaml.safe_load(r.stdout)
    if not isinstance(doc, dict) or doc.get("kind") != "Secret":
        raise Error(f"{rel}: no es un Secret — no se rota lo que no se entiende")
    return doc


def crear(ruta, rotar=False, espejos=()):
    """Crea el secreto de `ruta`, y el MISMO material en `espejos`.

    Los espejos existen porque una credencial puede hacer falta en dos
    namespaces a la vez. El caso concreto es la clave S3 de una
    organización: la consume su app (en su namespace) y la IMPORTA el
    Job de aprovisionamiento contra el Garage compartido (en
    garage-system). Son dos Secrets porque un Secret no cruza
    namespaces, pero tiene que ser el MISMO material o el bucket queda
    con una clave que nadie tiene.

    Se generan juntos, en una sola pasada, porque cifrar no necesita la
    age key pero RE-cifrar sí: si uno existiera y el otro no, no habría
    forma de derivar el segundo sin la llave privada. Por eso ese estado
    se detecta y se rechaza en vez de arreglarse a medias.
    """
    archivo = os.path.basename(ruta)
    if not archivo.startswith("secret-") or not archivo.endswith(".enc.yaml"):
        raise Error(f"{archivo}: el nombre debe ser secret-<algo>.enc.yaml")
    nombre = archivo[len("secret-"):-len(".enc.yaml")]

    # El namespace sale de la RUTA... salvo al ROTAR un archivo que ya
    # existe: ahí sale del DOCUMENTO, que es más fuerte que la ruta
    # porque es lo que de verdad se aplica.
    #
    # Además es lo que permite rotar los secretos de PLATAFORMA, que
    # viven en k8s/base/platform/<componente>/ y cuyo directorio NO es un
    # namespace (jenkins-secrets es el componente; el namespace es
    # jenkins-system). Para crearlos la regla de la ruta sigue mandando.
    if not (rotar and os.path.exists(ruta)):
        namespace_de(ruta)

    hay = [p for p in (ruta,) + tuple(espejos) if os.path.exists(p)]
    faltan = [p for p in (ruta,) + tuple(espejos) if not os.path.exists(p)]

    if hay and faltan and not rotar:
        raise Error(
            f"{archivo}: existe en {len(hay)} lugar(es) y falta en {len(faltan)}.\n"
            f"  Falta: {', '.join(os.path.relpath(p, RAIZ) for p in faltan)}\n"
            f"  No se puede completar el que falta sin la age key privada: el\n"
            f"  material del que existe está cifrado. Las salidas son rotar el\n"
            f"  conjunto entero (--rotar) o reubicar con --reubicar, que sí\n"
            f"  necesita la llave.")

    if hay and not rotar:
        # I2. No es un error: es el caso NORMAL de reaplicar.
        print(f"  {gris}={fin} {archivo}  {gris}ya existe — no se toca{fin}")
        return 0

    hacer = receta_de(nombre)
    if hacer is None:
        print(f"  {ama}?{fin} {archivo}  {ama}sin receta{fin}")
        print(f"      {gris}Este comando solo sabe crear los secretos cuyo material\n"
              f"      puede generar solo. `regcred-internal` no es uno: es una\n"
              f"      credencial de la PLATAFORMA que se copia, no se inventa\n"
              f"      (para eso está --reubicar).{fin}")
        return 0

    material = hacer()  # UNA vez, compartido por todos los destinos
    for p in (ruta,) + tuple(espejos):
        d = os.path.dirname(p)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        a = os.path.basename(p)
        if rotar and os.path.exists(p):
            # ROTAR CAMBIA EL MATERIAL, NO LA FORMA.
            #
            # Sin esto, rotar reescribía el documento desde cero con
            # metadata mínima —name y namespace— y se comía todo lo
            # demás. El caso que lo destapó: el Secret del HMAC del
            # webhook lleva la etiqueta jenkins.io/credentials-type:
            # secretText, que es LO QUE HACE que Jenkins lo tome como
            # credencial. Rotarlo con esta herramienta tal como estaba
            # habría dejado el material nuevo bien cifrado y la
            # credencial invisible para Jenkins, sin un solo error.
            #
            # Una trampa que espera a alguien es peor que un bug que
            # falla: el bug avisa.
            viejo = _sops_descifrar(p)
            viejo.pop("sops", None)      # por si alguna versión lo deja
            viejo.pop("data", None)      # el material va por stringData
            extra = sorted(set(viejo.get("metadata", {})) - {"name", "namespace"})
            if extra:
                # Nombres de campo, nunca valores.
                print(f"      {gris}metadata preservada: {', '.join(extra)}{fin}")
            doc = viejo
        else:
            doc = {
                "apiVersion": "v1",
                "kind": "Secret",
                "metadata": {"name": a[len("secret-"):-len(".enc.yaml")],
                             "namespace": namespace_de(p)},
                "type": "Opaque",
            }
        doc["stringData"] = material
        _sops_cifrar(p, doc)
    for p in espejos:
        print(f"  {verde}+{fin} {os.path.basename(p)}  "
              f"{gris}espejo en {namespace_de(p)} (mismo material){fin}")

    if rotar:
        print(f"  {ama}↻{fin} {archivo}  {ama}ROTADO{fin}")
        if nombre == "ai-gateway-key":
            print(f"      {rojo}la vieja SIGUE SIENDO VÁLIDA{fin} {gris}hasta que la quites de\n"
                  f"      k8s/base/ai-system/secret-ai-keys.enc.yaml, que es un archivo\n"
                  f"      compartido y no se edita solo. Rotar acá no revoca allá.{fin}")
        else:
            print(f"      {gris}el pod que la usa tiene que reiniciarse para tomarla{fin}")
    else:
        print(f"  {verde}+{fin} {archivo}  {gris}creado (nunca se imprimió el material){fin}")
    return 0


def reubicar(origen, destino):
    """Copia un secreto cifrado a otro namespace.

    Hace falta para las credenciales que la PLATAFORMA replica en cada
    namespace porque un Secret no cruza namespaces: `regcred-internal`
    es el caso, y todo namespace nuevo necesita su copia.

    NO alcanza con copiar el archivo y editar `metadata.namespace`,
    aunque ese campo no esté cifrado. Comprobado el 2026-08-04:

        MAC mismatch. File has C016A7F0..., computed 8AD98174...

    El MAC de SOPS cubre el árbol entero, no solo lo cifrado. Así que
    esto DESCIFRA Y VUELVE A CIFRAR, y por lo tanto **necesita la age
    key** — a diferencia de crear, que solo necesita el recipient
    público. Es la única operación de este comando que la pide, y
    conviene saberlo antes de correrla en una máquina donde la llave no
    está.

    El material no pasa por acá: lo mueve sops de un archivo al otro.
    """
    if os.path.exists(destino):
        print(f"  {gris}={fin} {os.path.basename(destino)}  {gris}ya existe — no se toca{fin}")
        return 0
    ns = namespace_de(destino)
    with open(origen, encoding="utf-8") as f:
        contenido = f.read()
    with open(os.open(destino, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w",
              encoding="utf-8") as f:
        f.write(contenido)

    r = subprocess.run(
        ["sops", "set", destino, '["metadata"]["namespace"]', f'"{ns}"'],
        capture_output=True, text=True, cwd=RAIZ)
    if r.returncode != 0:
        os.remove(destino)
        pista = ""
        if "no key could decrypt" in r.stderr.lower() or "age" in r.stderr.lower():
            pista = ("\n      Esto necesita la age key PRIVADA (a diferencia de crear).\n"
                     "      Exportá SOPS_AGE_KEY_FILE apuntando a tu copia resguardada.")
        raise Error(f"sops set falló: {r.stderr.strip()}{pista}")
    print(f"  {verde}+{fin} {os.path.basename(destino)}  {gris}reubicado a {ns}{fin}")
    return 0


def crear_repo(ruta, url, rotar=False):
    """La credencial con la que ArgoCD lee el repo de una organización.

    No es un secreto más y por eso no entra por `crear`:

      - vive en `argocd`, no en el namespace de la organización, porque
        el que lee el repo es ArgoCD y un Secret no cruza namespaces.
        Por eso el namespace va explícito y no sale de la ruta.
      - lleva la etiqueta `argocd.argoproj.io/secret-type: repository`,
        que es LO QUE HACE que ArgoCD lo mire. Sin ella el Secret existe,
        se descifra bien, y ArgoCD sigue diciendo que no tiene
        credenciales para ese repo.
      - la mitad PÚBLICA hay que registrarla en GitHub a mano. Eso es
        irreducible —GitHub no acepta que se la registre solo— así que
        se imprime acá y se dice qué hacer con ella. Un paso manual
        que el comando NOMBRA es distinto de uno que hay que adivinar.

    UNA CREDENCIAL POR REPO, no una compartida. Con una sola clave para
    toda la cuenta, filtrarla da acceso a todos los repos; con una por
    repo, da acceso a uno. Es el mismo criterio que hace que cada
    organización tenga su AppProject y no compartan uno.
    """
    archivo = os.path.basename(ruta)
    nombre = archivo[len("secret-"):-len(".enc.yaml")]
    if os.path.exists(ruta) and not rotar:
        print(f"  {gris}={fin} {archivo}  {gris}ya existe — no se toca{fin}")
        return 0

    privada, publica = _deploy_key(f"aegis {nombre}")
    os.makedirs(os.path.dirname(ruta), exist_ok=True)
    _sops_cifrar(ruta, {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
            "name": nombre,
            "namespace": "argocd",
            "labels": {"argocd.argoproj.io/secret-type": "repository"},
        },
        "type": "Opaque",
        "stringData": {
            # El nombre con el que ArgoCD muestra el repo en su UI. Es el
            # del REPO y no el de la organización —así lo tienen las dos
            # credenciales que ya existían— y sale de la URL para que no
            # puedan discrepar: `.../blog-aegis.git` -> `blog-aegis`.
            "name": url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git"),
            "type": "git",
            "url": url,
            "sshPrivateKey": privada,
        },
    })
    print(f"  {verde}+{fin} {archivo}  {gris}creado (la privada nunca se imprimió){fin}")
    # La pública SÍ se imprime: es pública, y sin este paso la credencial
    # no sirve para nada. Se dice el permiso exacto — SOLO LECTURA. Una
    # deploy key con escritura en el repo de una app deja que quien
    # tenga el cluster escriba en el repo, que es la dirección
    # equivocada.
    print(f"\n  {ama}FALTA UN PASO, y es a mano:{fin} registrá esta clave en GitHub")
    print(f"  {gris}{url} → Settings → Deploy keys → Add deploy key{fin}")
    print(f"  {gris}título:{fin} aegis-argocd-ro    {rojo}SIN{fin} \"Allow write access\"")
    print(f"\n{publica}\n")
    print(f"  {gris}Hasta que la registres, la App de esta organización va a\n"
          f"  quedar en 'repository not accessible'.{fin}")
    return 0


def repos_del_contrato(ruta):
    """(archivo de credencial, url) por cada repo que declara el contrato.

    La lista sale de `repos_de` del generador, que es la MISMA que
    decide qué Applications se crean y qué va en el `sourceRepos` del
    AppProject. Tres cosas de la misma fuente: si divergieran, la App
    existiría, el proyecto la dejaría leer, y la credencial sería de
    otro repo.
    """
    gen = _generador()
    c = yaml.safe_load(open(ruta, encoding="utf-8")) or {}
    return [(os.path.join(RAIZ, "k8s", "base", "platform", "argocd-secrets",
                          f"secret-{nombre}-repo.enc.yaml"), url)
            for url, nombre in sorted(gen.repos_de(c).items())]


def _generador():
    """El generador, como MÓDULO del paquete (antes: SourceFileLoader
    sobre el ejecutable — C1 del registro)."""
    from aegis import org
    return org


def secretos_del_contrato(ruta):
    """Los mismos que lista el generador, sin duplicar la regla."""
    gen = _generador()
    crudo = open(ruta, encoding="utf-8").read()
    planes = yaml.safe_load(open(os.path.join(RAIZ, "plans.yaml"), encoding="utf-8"))
    c = gen.validar(yaml.safe_load(crudo), planes)
    org = c["organizacion"]
    destino = os.path.join(DIR_K8S, "org-" + org)

    # (ruta principal, espejos). El espejo del bucket lo necesita el Job
    # de aprovisionamiento, que corre en garage-system y no puede leer
    # un Secret del namespace de la organización.
    entradas = []
    for s in gen.secretos_de(c):
        espejos = []
        if s == "secret-garage.enc.yaml":
            espejos.append(os.path.join(
                RAIZ, "k8s", "base", "garage-system", f"secret-garage-{org}.enc.yaml"))
        entradas.append((os.path.join(destino, s), espejos))
    return org, entradas


def main():
    # Regla 1 (verbos, no flags) y fricción 2 de A5: `--reubicar
    # DESTINO ORIGEN` ponía el destino ANTES que el origen, al revés
    # que cp, mv y que cualquier intuición. Ahora es
    # `move ORIGEN --to DESTINO`, que se lee como lo que hace.
    p = argparse.ArgumentParser(prog=cli.cmd("secret"), description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="verbo", required=True)
    s = sub.add_parser("create", help="crea los secretos que falten (de contratos o de archivos)")
    s.add_argument("rutas", nargs="+", metavar="CONTRATO|ARCHIVO")
    s = sub.add_parser("rotate", help="REEMPLAZA el material aunque el archivo exista")
    s.add_argument("rutas", nargs="+", metavar="ARCHIVO")
    s = sub.add_parser("move", help="copia un secreto cifrado a otro namespace (NECESITA la age key)")
    s.add_argument("rutas", nargs=1, metavar="ORIGEN")
    s.add_argument("--to", required=True, metavar="DESTINO", dest="destino")
    a = p.parse_args()
    # el contrato de adentro no cambia: `create` sobre contratos es lo
    # que antes era --todos, y sobre archivos sueltos es la creación
    # de a uno. Se distingue por la extensión, como siempre.
    a.todos = (a.verbo == "create")
    a.rotar = (a.verbo == "rotate")
    a.reubicar = a.destino if a.verbo == "move" else None

    if a.reubicar:
        if len(a.rutas) != 1:
            print(f"{rojo}✗{fin} --reubicar toma un solo origen", file=sys.stderr)
            return 2
        try:
            rc = reubicar(a.rutas[0], a.reubicar)
        except Error as e:
            print(f"{rojo}✗{fin} {e}", file=sys.stderr)
            rc = 1
        print()
        return rc

    if a.todos and a.rotar:
        # Rotar en lote es cómo se rota algo que no se quería rotar.
        print(f"{rojo}✗{fin} --todos y --rotar juntos no: rotar es de a uno y a propósito",
              file=sys.stderr)
        return 2

    if subprocess.run(["which", "sops"], capture_output=True).returncode != 0:
        print(f"{rojo}✗{fin} falta sops", file=sys.stderr)
        return 1

    rc = 0
    for ruta in a.rutas:
        try:
            if a.todos:
                org, entradas = secretos_del_contrato(ruta)
                print(f"\norganización {verde}{org}{fin}")
                for principal, espejos in entradas:
                    rc |= crear(principal, espejos=espejos)
                # Y la credencial con la que ArgoCD lee su repo. Va en
                # la misma pasada y no en un comando aparte: hasta el
                # 2026-08-05 estas credenciales no las creaba NADIE —
                # las dos que existen se hicieron a mano con sops y
                # nunca se cablearon. En una instancia nueva quedaban
                # cifradas con una age key que ya no existe (#48).
                for archivo, url in repos_del_contrato(ruta):
                    rc |= crear_repo(archivo, url)
            elif os.path.basename(ruta).endswith("-repo.enc.yaml") and \
                    os.path.basename(os.path.dirname(os.path.abspath(ruta))) == "argocd-secrets":
                # Una credencial de repositorio no la sabe hacer `crear`:
                # necesita la URL, y esa sale del contrato. Se busca en
                # todos, que es la misma fuente que usa --todos — si se
                # pidiera por argumento, un dedazo generaría una clave
                # perfectamente válida para el repo equivocado.
                objetivo = os.path.abspath(ruta)
                url = next((u for c in sorted(os.listdir(DIR_ORGS))
                            if c.endswith((".yaml", ".yml"))
                            for f, u in repos_del_contrato(os.path.join(DIR_ORGS, c))
                            if os.path.abspath(f) == objetivo), None)
                if url is None and a.rotar and os.path.exists(ruta):
                    # AL ROTAR, LA URL SALE DEL DOCUMENTO. Misma idea que
                    # el namespace: rotar cambia el material, no la forma,
                    # y lo que ya está aplicado es más fuerte que
                    # cualquier derivación.
                    #
                    # Existe por el CANARIO, que no tiene contrato Y ES
                    # DELIBERADO: prueba que el camino del inquilino
                    # funciona, así que no puede depender de ese camino.
                    # Sin esto, la única credencial de la plataforma que
                    # no se puede rotar con la herramienta es justo la
                    # del artefacto que existe para probar la plataforma.
                    viejo = _sops_descifrar(ruta)
                    url = ((viejo.get("stringData") or {}).get("url")
                           or _b64(((viejo.get("data") or {}).get("url"))))
                    if url:
                        print(f"      {gris}url tomada del documento: {url}{fin}")
                if url is None:
                    raise Error(
                        f"{os.path.basename(ruta)}: ningún contrato de orgs/ declara este repo.\n"
                        f"  Una credencial que no sale de un contrato es una credencial\n"
                        f"  que nadie rederiva ni barre. Llevá el repo al contrato.\n"
                        f"  (Al ROTAR una que ya existe, la URL se toma del documento.)")
                rc |= crear_repo(ruta, url, rotar=a.rotar)
            else:
                rc |= crear(ruta, rotar=a.rotar)
        except Error as e:
            print(f"{rojo}✗{fin} {e}", file=sys.stderr)
            rc = 1
        except FileNotFoundError as e:
            print(f"{rojo}✗{fin} no existe: {e.filename}", file=sys.stderr)
            rc = 1
    print()
    return rc


if __name__ == "__main__":
    sys.exit(main())
