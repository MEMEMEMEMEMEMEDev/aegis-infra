#!/usr/bin/env python3
# aegis-summary: Creates, rotates and moves the contracts' encrypted secrets
# aegis-group:   apps
# aegis-subcommands: create rotate move
"""aegis-secret — creates an encrypted secret IF IT IS MISSING. It never regenerates it.

It is rule I2 of the protocol turned into a mechanism. Until now it was a
written promise: the generator LISTED the secrets that were needed and
somebody created them by hand with sops. That has two problems and the
second is the serious one:

  1. signing an organization up stopped being "write the contract".
  2. creating a credential by hand means the material passes through
     somebody's terminal. The protocol says explicitly that the operator
     does NOT see the material (§6.2), and by hand that cannot be
     sustained.

Here the material is generated with `secrets`, handed to `sops` THROUGH
STDIN, and the only thing left on disk is the encrypted file. It does not
pass through argv, it does not pass through a readable temporary file, and
it is not printed.

    aegis secret k8s/organizations/org-blog/secret-db-credenciales.enc.yaml
    aegis secret create orgs/blog.yaml
    aegis secret rotate <file>      # deliberate, see below

── why it does NOT regenerate ──────────────────────────────────────

If `apply` rotated credentials, nobody would run the generator twice over
a live organization — and a generator that is frightening is not
idempotent even if it is. Re-applying has to be boring.

`rotate` exists and is another command on purpose: rotating is a
deliberate act, and whoever does it has to know that the old credential
stops working the moment the pod restarts.

── what this command does NOT do ───────────────────────────────────

It does not touch the cluster nor revoke anything on the other side.
Rotating the gateway's key here generates a NEW one, but the gateway goes
on accepting the old one until it is taken out of secret-ai-keys.enc.yaml
— which is a file shared between organizations and for that reason is not
edited on its own. The command says so where it applies.
"""
import argparse
import base64
import glob
import os
import secrets
import subprocess
import sys

try:
    import yaml
except ImportError:
    sys.exit("pyyaml is missing (python3-yaml)")

# ── canonical python preamble (V-102) ────────────────────────────────
# The product comes out of the variable (bin/aegis exports it) or out of
# this file; the INSTANCE is decided by lib/aegis/paths.py and nobody
# else.
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, paths             # noqa: E402

# PLATFORM_DIR is the INSTANCE (the live checkout of the platform), not
# the product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. On moving the
# code to the product the same line went on compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a grep».
PLATFORM_DIR = str(paths.platform_dir())
ORGS_DIR = os.path.join(PLATFORM_DIR, "orgs")
K8S_DIR = os.path.join(PLATFORM_DIR, "k8s", "organizations")

red = "\033[31m"; green = "\033[32m"; yellow = "\033[33m"; gray = "\033[90m"; reset = "\033[0m"
if not sys.stdout.isatty():
    red = green = yellow = gray = reset = ""


class Error(Exception):
    pass


# ── material generators ─────────────────────────────────────────────
#
# `secrets` and not `random`: random is a Mersenne Twister seeded in a
# predictable way and it is good for simulations, not for credentials.
#
# token_urlsafe(32) is 256 bits of entropy in 43 characters. urlsafe and
# not hex is used because these credentials travel in connection URLs
# (postgres://user:PASSWORD@host) and in headers, where a character that
# has to be escaped is a source of bugs that show up weeks later.


def _word(n=32):
    return secrets.token_urlsafe(n)


def _aegis_key():
    # Same format the gateway emits: a recognizable prefix so that a
    # leaked credential can be identified at a glance (and so that
    # GitHub's secret scanners can catch it).
    return "aegisk_" + secrets.token_urlsafe(32)


def _s3():
    # Garage accepts any pair; AWS's shape is imitated so that the client
    # libraries are not surprised.
    return {
        "AWS_ACCESS_KEY_ID": "GK" + secrets.token_hex(12),
        "AWS_SECRET_ACCESS_KEY": secrets.token_hex(32),
    }


def _deploy_key(comment):
    """An ed25519 pair for a deploy key. Returns (private, public).

    IT IS THE ONLY RECIPE THAT TOUCHES DISK, and it is worth saying why.

    The rest of this command generates material with `secrets` and sends
    it to sops through stdin: there is never a file in the clear.
    `ssh-keygen` does not know how to write to stdout —it needs an `-f`—
    so here the material passes through a file.

    That file lives in **tmpfs** (`/dev/shm`), in a 700 directory, and is
    overwritten with `shred` before being deleted. It is exactly the
    mechanism the init uses for the AGE KEY ITSELF (lib/secrets.sh
    §SECRETS_TMP), which is the root of trust of the whole platform. If
    tmpfs is enough for that, it is enough for a repo's deploy key.

    The alternative was to generate the pair in-process with
    `cryptography`, which keeps the guarantee complete. It was discarded
    for what it cost and not for what it gave: it is a new dependency the
    preflight would have to install and verify, to gain a property this
    project has already decided tmpfs provides. `ssh-keygen` is already a
    requirement (lib/checks.sh) and nothing has to be declared.
    """
    import shutil
    import tempfile
    if not os.path.isdir("/dev/shm"):
        raise Error("there is no /dev/shm: transient material only goes to tmpfs")
    d = tempfile.mkdtemp(prefix="aegis-secret.", dir="/dev/shm")
    os.chmod(d, 0o700)
    priv = os.path.join(d, "k")
    try:
        r = subprocess.run(
            ["ssh-keygen", "-t", "ed25519", "-N", "", "-C", comment, "-f", priv, "-q"],
            capture_output=True, text=True)
        if r.returncode != 0:
            raise Error(f"ssh-keygen failed: {r.stderr.strip()}")
        with open(priv, encoding="utf-8") as f:
            private = f.read()
        with open(priv + ".pub", encoding="utf-8") as f:
            public = f.read().strip()
        return private, public
    finally:
        # shred BEFORE deleting: an unlink leaves the blocks with the
        # material until something reuses them. On tmpfs the risk is
        # smaller, but the habit is what prevents the slip in the case
        # where it does matter.
        for p in (priv, priv + ".pub"):
            if os.path.exists(p):
                subprocess.run(["shred", "-u", p], capture_output=True)
        shutil.rmtree(d, ignore_errors=True)


# file name -> (Secret name, fields)
#
# The file's suffix IS the contract: `secret-<something>.enc.yaml` produces
# the Secret `<something>`. Without that rule, the generator and this could
# disagree and the symptom would be a pod waiting for a Secret that exists
# under another name.
RECIPES = {
    "ai-gateway-key": lambda: {"clave": _aegis_key()},
    # The S3 credential of ONE organization against the shared Garage.
    # The material is generated by aegis (not by Garage): that way git is
    # the source of truth and the provisioning Job IMPORTS the key instead
    # of asking for a new one. If Garage generated it, re-applying would
    # produce a different credential every time — exactly what I2 forbids.
    "garage": _s3,
    # rpc_secret and admin_token of the SHARED Garage. They belong to the
    # platform, not to an organization.
    #
    # rpc_secret: 32 bytes in hex, which is what Garage expects. It is not
    # a length chosen out of taste — with another one, the node does not
    # start.
    #
    # admin_token: whoever has it can create keys and grant themselves
    # permission over any organization's bucket. It is the most sensitive
    # credential of this subsystem.
    "garage-credentials": lambda: {
        "rpc_secret": secrets.token_hex(32),
        "admin_token": _word(),
    },
    # The HMAC with which GitHub signs the webhooks and Jenkins validates
    # them.
    #
    # The key is called `text` and that is not a whim: the Secret carries
    # the label jenkins.io/credentials-type: secretText, and Jenkins reads
    # the value of that kind of credential from `text`. Changing its name
    # leaves the credential empty without a single error.
    #
    # 32 bytes in hex, WITHOUT a line break. The \n is this secret's
    # classic failure mode: GitHub signs over one body and Jenkins
    # validates over another, and the resulting 403 does not say why.
    # token_hex does not add it; the danger is in generating it by hand
    # with `openssl rand -hex 32 > file`, which does.
    #
    # The two sides have to end up with the SAME value: after rotating
    # comes `aegis sync jenkins-secrets` and then `aegis webhook`
    # --aplicar, which rewrites it in GitHub by reading it from the
    # cluster.
    "github-webhook-hmac": lambda: {"text": secrets.token_hex(32)},
}

# Where a secret may live and which namespace corresponds to it.
#
#   k8s/organizations/org-blog/secret-x.enc.yaml  -> namespace org-blog
#   k8s/base/garage-system/secret-x.enc.yaml      -> namespace garage-system
#
# The namespace comes out of the PATH and not out of an argument: a secret
# written in one organization's directory with another one's namespace is
# an error nobody sees until a pod fails to start.
def namespace_of(path):
    parent = os.path.basename(os.path.dirname(os.path.abspath(path)))
    grandparent = os.path.basename(os.path.dirname(os.path.dirname(os.path.abspath(path))))
    if grandparent == "organizations" and parent.startswith("org-"):
        return parent
    if grandparent == "base":
        return parent
    raise Error(f"{path}: k8s/organizations/org-*/ or k8s/base/<namespace>/ was expected")


def recipe_for(secret_name):
    if secret_name in RECIPES:
        return RECIPES[secret_name]
    # Database credentials: `secret-<service>-credenciales.enc.yaml`.
    if secret_name.endswith("-credenciales"):
        base = secret_name[: -len("-credenciales")]
        return lambda: {"usuario": base, "password": _word()}
    return None


# ── credentials that are NOT invented ────────────────────────────────
#
# Some of what an organization's generator declares is not material this
# command can produce: it is the SAME credential another namespace
# already holds, replicated because a Secret does not cross namespaces.
# `regcred-internal` is that case today — every organization's generator
# lists it, phase 40 derives it for the namespaces that exist at init
# time, and every namespace born afterwards needs its copy.
#
# Until 2026-09-02 this command answered «no recipe» for it and carried
# on, exit 0. What that costs is not a missing credential: the ksops
# generator lists the file, so `kustomize build` of the WHOLE
# organization dies with «error reading
# secret-regcred-internal.enc.yaml: no such file or directory», the
# Application never renders, and ArgoCD reports nothing unhealthy
# because nothing was ever created. On one install it had to be copied
# by hand with `move` three times.
#
# REGENERATING IT IS NOT AN OPTION, and that is the whole reason this is
# a copy and not a recipe: the material is the internal registry's
# password, and the htpasswd the registry serves was derived from it IN
# THE SAME PROCESS (init lib/secrets.sh derive_htpasswd_and_regcreds,
# fired by phase 40 and again by phase 87). A freshly invented regcred
# is a credential the registry rejects, and the symptom is an
# ImagePullBackOff far away from here.
#
# The origin is DERIVED, never named: any namespace already holding a
# file with the same name holds the same credential. Both depths under
# k8s/base are globbed because the platform keeps its own secrets one
# level down (base/ai-system/) and its components two
# (base/platform/jenkins-secrets/) — a one-level glob is how a search
# stops seeing half of its subject and answers «there is no origin»
# about a tree that has four.
def copy_source_for(name, target):
    """The file `secret-<name>.enc.yaml` copies its material from, or None.

    Platform namespaces come first and the organizations afterwards: the
    platform's copies are the ones the init derives, so they are the
    closest thing to an original there is.
    """
    filename = "secret-%s.enc.yaml" % name
    target = os.path.abspath(target)
    k8s = os.path.join(PLATFORM_DIR, "k8s")
    candidates = sorted(glob.glob(os.path.join(k8s, "base", "*", filename))) \
        + sorted(glob.glob(os.path.join(k8s, "base", "*", "*", filename))) \
        + sorted(glob.glob(os.path.join(k8s, "organizations", "org-*", filename)))
    for c in candidates:
        if os.path.isfile(c) and os.path.abspath(c) != target:
            return c
    return None


def _sops_encrypt(target, document):
    """Encrypts `document` with sops and writes it to `target`.

    The plaintext goes in through STDIN. There is no temporary file in the
    clear and not a single value in argv: `sops --filename-override` tells
    sops which rule of .sops.yaml to apply without the file existing yet.
    """
    plain = yaml.safe_dump(document, sort_keys=False, allow_unicode=True)
    rel = os.path.relpath(target, PLATFORM_DIR)
    r = subprocess.run(
        ["sops", "--encrypt", "--filename-override", rel, "/dev/stdin"],
        input=plain, capture_output=True, text=True, cwd=PLATFORM_DIR)
    if r.returncode != 0:
        # sops's stderr carries no material; its stdin does, and it is not
        # touched.
        raise Error(f"sops failed ({r.returncode}): {r.stderr.strip()}")
    if "sops:" not in r.stdout:
        raise Error("sops's output does not look encrypted — nothing is written")
    with open(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w",
              encoding="utf-8") as f:
        f.write(r.stdout)


def _b64(v):
    """A Secret's `data:` field, in the clear. None if it is not there."""
    return base64.b64decode(v).decode() if v else None


def _sops_decrypt(path):
    """The cleartext document of a .enc.yaml, in memory.

    It needs the age key, and that is why only `rotate` uses it: creating
    does not ask for it, rotating does. It touches neither disk nor argv —
    sops writes to stdout and it is parsed here. Whoever calls it must NOT
    print what it returns.
    """
    rel = os.path.relpath(path, PLATFORM_DIR)
    r = subprocess.run(["sops", "--decrypt", rel],
                       capture_output=True, text=True, cwd=PLATFORM_DIR)
    if r.returncode != 0:
        raise Error(
            f"I could not decrypt {rel} ({r.returncode}): {r.stderr.strip()}\n"
            f"  Rotating needs the age key in order to PRESERVE the shape of the\n"
            f"  document that already exists. Point SOPS_AGE_KEY_FILE at the key file.")
    doc = yaml.safe_load(r.stdout)
    if not isinstance(doc, dict) or doc.get("kind") != "Secret":
        raise Error(f"{rel}: it is not a Secret — what is not understood is not rotated")
    return doc


def create(path, rotate=False, mirrors=()):
    """Creates the secret of `path`, and the SAME material in `mirrors`.

    The mirrors exist because a credential can be needed in two namespaces
    at once. The concrete case is an organization's S3 key: its app
    consumes it (in its namespace) and the provisioning Job IMPORTS it
    against the shared Garage (in garage-system). They are two Secrets
    because a Secret does not cross namespaces, but it has to be the SAME
    material or the bucket is left with a key nobody has.

    They are generated together, in a single pass, because encrypting does
    not need the age key but RE-encrypting does: if one existed and the
    other did not, there would be no way to derive the second without the
    private key. That is why that state is detected and rejected instead
    of being half fixed.
    """
    filename = os.path.basename(path)
    if not filename.startswith("secret-") or not filename.endswith(".enc.yaml"):
        raise Error(f"{filename}: the name must be secret-<something>.enc.yaml")
    name = filename[len("secret-"):-len(".enc.yaml")]

    # The namespace comes out of the PATH... except when ROTATING a file
    # that already exists: there it comes out of the DOCUMENT, which is
    # stronger than the path because it is what actually gets applied.
    #
    # It is also what makes it possible to rotate the PLATFORM secrets,
    # which live in k8s/base/platform/<component>/ and whose directory is
    # NOT a namespace (jenkins-secrets is the component; the namespace is
    # jenkins-system). To create them the path rule still rules.
    if not (rotate and os.path.exists(path)):
        namespace_of(path)

    present = [p for p in (path,) + tuple(mirrors) if os.path.exists(p)]
    missing = [p for p in (path,) + tuple(mirrors) if not os.path.exists(p)]

    if present and missing and not rotate:
        raise Error(
            f"{filename}: it exists in {len(present)} place(s) and is missing in {len(missing)}.\n"
            f"  Missing: {', '.join(os.path.relpath(p, PLATFORM_DIR) for p in missing)}\n"
            f"  The missing one cannot be completed without the private age key: the\n"
            f"  material of the one that exists is encrypted. The ways out are to rotate\n"
            f"  the whole set (rotate) or to relocate with move, which does need\n"
            f"  the key.")

    if present and not rotate:
        # I2. It is not an error: it is the NORMAL case of re-applying.
        print(f"  {gray}={reset} {filename}  {gray}already exists — it is not touched{reset}")
        return 0

    make = recipe_for(name)
    if make is None:
        # NO RECIPE IS NOT THE END OF THE ROAD. A credential this
        # command cannot invent may still be one it can DERIVE: the same
        # material another namespace already holds. That is the
        # mechanism `move` implements —one origin, re-encrypted for the
        # destination— run here, in the same pass, so that signing an
        # organization up goes on being "write the contract" and nothing
        # else. It is the same shape as the mirrors below: one origin,
        # every destination in a single process.
        #
        # It needs the PRIVATE age key, unlike inventing, and `relocate`
        # says so when it is missing.
        source = copy_source_for(name, path)
        if source is not None:
            if rotate:
                raise Error(
                    f"{filename}: this credential is copied, not invented — rotating it\n"
                    f"  here would produce material the registry's htpasswd does not match,\n"
                    f"  and every other namespace would keep the old one. It is rotated\n"
                    f"  where it is derived (the registry's password), and the copies are\n"
                    f"  remade from there.")
            rc = 0
            for p in (path,) + tuple(mirrors):
                rc |= relocate(source, p)
            return rc
        print(f"  {yellow}?{reset} {filename}  {yellow}no recipe and no origin{reset}")
        print(f"      {gray}This command invents the material it knows how to generate and\n"
              f"      copies the credentials that are replicated from another namespace.\n"
              f"      This one is neither: no directory under k8s/ holds a file with this\n"
              f"      name, so there is nothing to copy from.{reset}")
        return 0

    material = make()  # ONCE, shared by every destination
    for p in (path,) + tuple(mirrors):
        d = os.path.dirname(p)
        if d and not os.path.isdir(d):
            os.makedirs(d, exist_ok=True)
        a = os.path.basename(p)
        if rotate and os.path.exists(p):
            # ROTATING CHANGES THE MATERIAL, NOT THE SHAPE.
            #
            # Without this, rotating rewrote the document from scratch
            # with minimal metadata —name and namespace— and ate
            # everything else. The case that gave it away: the Secret of
            # the webhook's HMAC carries the label
            # jenkins.io/credentials-type: secretText, which is WHAT MAKES
            # Jenkins take it as a credential. Rotating it with this tool
            # as it stood would have left the new material nicely
            # encrypted and the credential invisible to Jenkins, without a
            # single error.
            #
            # A trap waiting for somebody is worse than a bug that fails:
            # the bug warns you.
            old = _sops_decrypt(p)
            old.pop("sops", None)        # in case some version leaves it
            old.pop("data", None)        # the material goes through stringData
            extra = sorted(set(old.get("metadata", {})) - {"name", "namespace"})
            if extra:
                # Field names, never values.
                print(f"      {gray}metadata preserved: {', '.join(extra)}{reset}")
            doc = old
        else:
            doc = {
                "apiVersion": "v1",
                "kind": "Secret",
                "metadata": {"name": a[len("secret-"):-len(".enc.yaml")],
                             "namespace": namespace_of(p)},
                "type": "Opaque",
            }
        doc["stringData"] = material
        _sops_encrypt(p, doc)
    for p in mirrors:
        print(f"  {green}+{reset} {os.path.basename(p)}  "
              f"{gray}mirror in {namespace_of(p)} (same material){reset}")

    if rotate:
        print(f"  {yellow}↻{reset} {filename}  {yellow}ROTATED{reset}")
        if name == "ai-gateway-key":
            print(f"      {red}the old one IS STILL VALID{reset} {gray}until you take it out of\n"
                  f"      k8s/base/ai-system/secret-ai-keys.enc.yaml, which is a shared\n"
                  f"      file and is not edited on its own. Rotating here does not revoke there.{reset}")
        else:
            print(f"      {gray}the pod that uses it has to restart to pick it up{reset}")
    else:
        print(f"  {green}+{reset} {filename}  {gray}created (the material was never printed){reset}")
    return 0


def relocate(source, target):
    """Copies an encrypted secret to another namespace.

    It is needed for the credentials the PLATFORM replicates in every
    namespace because a Secret does not cross namespaces:
    `regcred-internal` is the case, and every new namespace needs its copy.

    Copying the file and editing `metadata.namespace` is NOT enough, even
    though that field is not encrypted. Verified on 2026-08-04:

        MAC mismatch. File has C016A7F0..., computed 8AD98174...

    SOPS's MAC covers the whole tree, not only what is encrypted. So this
    DECRYPTS AND RE-ENCRYPTS, and therefore **it needs the age key** —
    unlike creating, which only needs the public recipient. It is the only
    operation of this command that asks for it, and it is worth knowing
    that before running it on a machine where the key is not there.

    The material does not pass through here: sops moves it from one file to
    the other.
    """
    if os.path.exists(target):
        print(f"  {gray}={reset} {os.path.basename(target)}  {gray}already exists — it is not touched{reset}")
        return 0
    ns = namespace_of(target)
    with open(source, encoding="utf-8") as f:
        content = f.read()
    with open(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w",
              encoding="utf-8") as f:
        f.write(content)

    r = subprocess.run(
        ["sops", "set", target, '["metadata"]["namespace"]', f'"{ns}"'],
        capture_output=True, text=True, cwd=PLATFORM_DIR)
    if r.returncode != 0:
        os.remove(target)
        hint = ""
        if "no key could decrypt" in r.stderr.lower() or "age" in r.stderr.lower():
            hint = ("\n      This needs the PRIVATE age key (unlike creating).\n"
                    "      Export SOPS_AGE_KEY_FILE pointing at your safeguarded copy.")
        raise Error(f"sops set failed: {r.stderr.strip()}{hint}")
    print(f"  {green}+{reset} {os.path.basename(target)}  {gray}moved to {ns}{reset}")
    return 0


def create_repo(path, url, rotate=False):
    """The credential with which ArgoCD reads an organization's repo.

    It is not one more secret and that is why it does not go through
    `create`:

      - it lives in `argocd`, not in the organization's namespace, because
        the one that reads the repo is ArgoCD and a Secret does not cross
        namespaces. That is why the namespace is explicit and does not come
        out of the path.
      - it carries the label `argocd.argoproj.io/secret-type: repository`,
        which is WHAT MAKES ArgoCD look at it. Without it the Secret
        exists, decrypts fine, and ArgoCD goes on saying it has no
        credentials for that repo.
      - the PUBLIC half has to be registered in GitHub by hand. That is
        irreducible —GitHub does not accept registering it on its own— so
        it is printed here and it is said what to do with it. A manual step
        the command NAMES is different from one you have to guess.

    ONE CREDENTIAL PER REPO, not a shared one. With a single key for the
    whole account, leaking it gives access to every repo; with one per
    repo, it gives access to one. It is the same criterion that makes each
    organization have its own AppProject and not share one.
    """
    filename = os.path.basename(path)
    name = filename[len("secret-"):-len(".enc.yaml")]
    if os.path.exists(path) and not rotate:
        print(f"  {gray}={reset} {filename}  {gray}already exists — it is not touched{reset}")
        return 0

    private, public = _deploy_key(f"aegis {name}")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    _sops_encrypt(path, {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
            "name": name,
            "namespace": "argocd",
            "labels": {"argocd.argoproj.io/secret-type": "repository"},
        },
        "type": "Opaque",
        "stringData": {
            # The name ArgoCD shows the repo under in its UI. It is the
            # REPO's and not the organization's —that is how the two
            # credentials that already existed have it— and it comes out
            # of the URL so that they cannot disagree:
            # `.../blog-aegis.git` -> `blog-aegis`.
            "name": url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git"),
            "type": "git",
            "url": url,
            "sshPrivateKey": private,
        },
    })
    print(f"  {green}+{reset} {filename}  {gray}created (the private half was never printed){reset}")
    # The public half IS printed: it is public, and without this step the
    # credential is good for nothing. The exact permission is stated —READ
    # ONLY. A deploy key with write access on an app's repo lets whoever
    # holds the cluster write into the repo, which is the wrong direction.
    print(f"\n  {yellow}ONE STEP IS MISSING, and it is by hand:{reset} register this key in GitHub")
    print(f"  {gray}{url} → Settings → Deploy keys → Add deploy key{reset}")
    print(f"  {gray}title:{reset} aegis-argocd-ro    {red}WITHOUT{reset} \"Allow write access\"")
    print(f"\n{public}\n")
    print(f"  {gray}Until you register it, this organization's App will stay in\n"
          f"  'repository not accessible'.{reset}")
    return 0


def repos_of_the_contract(path):
    """(credential file, url) for each repo the contract declares.

    The list comes out of the generator's `repos_of`, which is the SAME one
    that decides which Applications are created and what goes into the
    AppProject's `sourceRepos`. Three things from the same source: if they
    diverged, the App would exist, the project would let it read, and the
    credential would be for another repo.
    """
    gen = _generator()
    c = yaml.safe_load(open(path, encoding="utf-8")) or {}
    return [(os.path.join(PLATFORM_DIR, "k8s", "base", "platform", "argocd-secrets",
                          f"secret-{name}-repo.enc.yaml"), url)
            for url, name in sorted(gen.repos_of(c).items())]


def _generator():
    """The generator, as a MODULE of the package (before: SourceFileLoader
    over the executable — C1 of the register)."""
    from aegis import org
    return org


def secrets_of_the_contract(path):
    """The same ones the generator lists, without duplicating the rule."""
    gen = _generator()
    raw = open(path, encoding="utf-8").read()
    plans = yaml.safe_load(open(os.path.join(PLATFORM_DIR, "plans.yaml"), encoding="utf-8"))
    c = gen.validate(yaml.safe_load(raw), plans)
    org = c["organizacion"]
    target = os.path.join(K8S_DIR, "org-" + org)

    # (main path, mirrors). The bucket's mirror is needed by the
    # provisioning Job, which runs in garage-system and cannot read a
    # Secret from the organization's namespace.
    entries = []
    for s in gen.secrets_of(c):
        mirrors = []
        if s == "secret-garage.enc.yaml":
            mirrors.append(os.path.join(
                PLATFORM_DIR, "k8s", "base", "garage-system", f"secret-garage-{org}.enc.yaml"))
        entries.append((os.path.join(target, s), mirrors))
    return org, entries


def main():
    # Rule 1 (verbs, not flags) and friction 2 of A5: `--reubicar TARGET
    # SOURCE` put the target BEFORE the source, the other way round from
    # cp, mv and from any intuition. Now it is `move SOURCE --to TARGET`,
    # which reads like what it does.
    p = argparse.ArgumentParser(prog=cli.cmd("secret"), description=__doc__.split("\n")[0])
    sub = p.add_subparsers(dest="verb", required=True)
    s = sub.add_parser("create", help="creates the secrets that are missing (from contracts or from files)")
    s.add_argument("paths", nargs="+", metavar="CONTRACT|FILE")
    s = sub.add_parser("rotate", help="REPLACES the material even if the file exists")
    s.add_argument("paths", nargs="+", metavar="FILE")
    s = sub.add_parser("move", help="copies an encrypted secret to another namespace (NEEDS the age key)")
    s.add_argument("paths", nargs=1, metavar="SOURCE")
    s.add_argument("--to", required=True, metavar="TARGET", dest="target")
    a = p.parse_args()
    # the contract inside does not change: `create` over contracts is what
    # used to be --todos, and over loose files it is the one-by-one
    # creation. They are told apart by the extension, as always.
    a.create_all = (a.verb == "create")
    a.rotate = (a.verb == "rotate")
    a.relocate_to = a.target if a.verb == "move" else None

    if a.relocate_to:
        if len(a.paths) != 1:
            print(f"{red}✗{reset} move takes a single source", file=sys.stderr)
            return 2
        try:
            rc = relocate(a.paths[0], a.relocate_to)
        except Error as e:
            print(f"{red}✗{reset} {e}", file=sys.stderr)
            rc = 1
        print()
        return rc

    if a.create_all and a.rotate:
        # Rotating in bulk is how you rotate something you did not mean to
        # rotate.
        print(f"{red}✗{reset} create and rotate together, no: rotating is one at a time and on purpose",
              file=sys.stderr)
        return 2

    if subprocess.run(["which", "sops"], capture_output=True).returncode != 0:
        print(f"{red}✗{reset} sops is missing", file=sys.stderr)
        return 1

    rc = 0
    for path in a.paths:
        try:
            # `create` over a CONTRACT (orgs/x.yaml) makes everything the
            # contract implies; over a loose secret-<name>.enc.yaml it
            # makes that one file from its recipe. The docstring above
            # always said "told apart by the extension"; until 2026-08-27
            # the code did not tell them apart, and phase 40's first
            # request for garage-credentials on a clean instance was read
            # as a contract that "does not exist".
            if a.create_all and not os.path.basename(path).endswith(".enc.yaml"):
                org, entries = secrets_of_the_contract(path)
                print(f"\norganization {green}{org}{reset}")
                for main_path, mirrors in entries:
                    rc |= create(main_path, mirrors=mirrors)
                # And the credential with which ArgoCD reads its repo. It
                # goes in the same pass and not in a separate command:
                # until 2026-08-05 NOBODY created these credentials — the
                # two that exist were made by hand with sops and were
                # never wired up. On a new instance they were left
                # encrypted with an age key that no longer exists (#48).
                for filename, url in repos_of_the_contract(path):
                    rc |= create_repo(filename, url)
            elif os.path.basename(path).endswith("-repo.enc.yaml") and \
                    os.path.basename(os.path.dirname(os.path.abspath(path))) == "argocd-secrets":
                # `create` does not know how to make a repository
                # credential: it needs the URL, and that comes out of the
                # contract. It is looked for in all of them, which is the
                # same source `create` over contracts uses — if it were
                # asked for as an argument, a typo would generate a
                # perfectly valid key for the wrong repo.
                target_path = os.path.abspath(path)
                url = next((u for c in sorted(os.listdir(ORGS_DIR))
                            if c.endswith((".yaml", ".yml"))
                            for f, u in repos_of_the_contract(os.path.join(ORGS_DIR, c))
                            if os.path.abspath(f) == target_path), None)
                if url is None and a.rotate and os.path.exists(path):
                    # WHEN ROTATING, THE URL COMES OUT OF THE DOCUMENT.
                    # Same idea as the namespace: rotating changes the
                    # material, not the shape, and what is already applied
                    # is stronger than any derivation.
                    #
                    # It exists because of the CANARY, which has no
                    # contract AND THAT IS DELIBERATE: it proves that the
                    # tenant's path works, so it cannot depend on that
                    # path. Without this, the only platform credential
                    # that cannot be rotated with the tool would be
                    # precisely the one of the artifact that exists to
                    # prove the platform.
                    old = _sops_decrypt(path)
                    url = ((old.get("stringData") or {}).get("url")
                           or _b64(((old.get("data") or {}).get("url"))))
                    if url:
                        print(f"      {gray}url taken from the document: {url}{reset}")
                if url is None:
                    raise Error(
                        f"{os.path.basename(path)}: no contract in orgs/ declares this repo.\n"
                        f"  A credential that does not come out of a contract is a credential\n"
                        f"  nobody re-derives or sweeps. Take the repo to the contract.\n"
                        f"  (When ROTATING one that already exists, the URL is taken from the document.)")
                rc |= create_repo(path, url, rotate=a.rotate)
            else:
                rc |= create(path, rotate=a.rotate)
        except Error as e:
            print(f"{red}✗{reset} {e}", file=sys.stderr)
            rc = 1
        except FileNotFoundError as e:
            print(f"{red}✗{reset} does not exist: {e.filename}", file=sys.stderr)
            rc = 1
    print()
    return rc


if __name__ == "__main__":
    sys.exit(main())
