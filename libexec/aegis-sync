#!/usr/bin/env bash
# aegis-summary: Fires an ArgoCD sync without breaking the app
# aegis-group:   operate
# aegis-help:
# Usage: aegis sync <app> [<app> ...]
#        aegis sync --drifted
#
# Fires an ArgoCD sync of the named Application(s) WITHOUT passing
# syncOptions, so the app's own (RespectIgnoreDifferences among them)
# stay in force. --drifted syncs every app that is not Synced.

# aegis-sync — fires an ArgoCD sync WITHOUT breaking the app.
#
# ── why it exists ─────────────────────────────────────────────────
# The obvious command for syncing by hand is this one, and it is WRONG:
#
#   kubectl patch application X -n argocd --type merge -p \
#     '{"operation":{"sync":{"revision":"HEAD","syncOptions":["ServerSideApply=true"]}}}'
#
# Passing `syncOptions` in the operation REPLACES the Application's own
# instead of adding to them. And among the ones that get lost is
# RespectIgnoreDifferences, which is the only thing that makes an
# `ignoreDifferences` actually protect anything: without that option the
# ignore only affects the DIFF, and the apply overwrites all the same.
#
# Measured on 2026-08-03: syncing the ai-system app this way overwrote
# the ai-modo ConfigMap and returned the mode to "the initial state
# declared in git". The open AI window closed by itself and the engine
# switched off in the middle of a test. The command said "sync"; it did
# that and on top of it deleted operational state.
#
# This script does not pass syncOptions. Full stop. The app's own are
# the ones that count, which is what one wants 100% of the times one
# syncs by hand.

set -euo pipefail

red=$'\033[31m'; green=$'\033[32m'; gray=$'\033[90m'; reset=$'\033[0m'
[[ -t 1 ]] || { red=""; green=""; gray=""; reset=""; }

AEGIS_ROOT="${AEGIS_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
for a in "$@"; do case "$a" in -h|--help) usage; exit 0 ;; esac; done
if [[ $# -eq 0 ]]; then usage >&2; exit 3; fi

apps=("$@")
if [[ "${1:-}" == "--drifted" ]]; then
    mapfile -t apps < <(kubectl get applications -n argocd --no-headers \
        -o custom-columns='N:.metadata.name,S:.status.sync.status' \
        | awk '$2 != "Synced" {print $1}')
    if [[ ${#apps[@]} -eq 0 ]]; then
        echo "${green}every app is already Synced${reset}"
        exit 0
    fi
    echo "${gray}drifted: ${apps[*]}${reset}"
fi

for app in "${apps[@]}"; do
    if ! kubectl get application "$app" -n argocd >/dev/null 2>&1; then
        echo "  ${red}✗${reset} $app: does not exist" >&2
        continue
    fi
    # No syncOptions: the Application's own are respected.
    kubectl patch application "$app" -n argocd --type merge \
        -p "{\"operation\":{\"initiatedBy\":{\"username\":\"aegis-sync\"},\"sync\":{\"revision\":\"HEAD\"}}}" \
        >/dev/null
    echo "  ${green}→${reset} $app"
done
echo "${gray}fired. The result takes a while; watch it with: ${AEGIS_CMD:-aegis} check${reset}"
