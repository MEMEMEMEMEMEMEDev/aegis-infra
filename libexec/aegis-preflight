#!/usr/bin/env bash
# aegis-summary: Leaves the machine in the state the init needs
# aegis-group:   setup
# aegis-help:
# Usage: aegis preflight
#
# Leaves this machine in the state `aegis init` needs: sudo NOPASSWD,
# IPv6 off, per-interface DNS, clock, packages, git identity. It
# takes no arguments, and it ACTS — every step repairs what it can
# (with sudo) and reports OK / FAIL / WARN. Idempotent: re-running
# must end all OK.

# aegis-preflight — leaves a MACHINE in the state aegis-init needs before
# running (environment fixes discovered in the real runs). Idempotent:
# re-running must give all OK. Auto-repairs what it can (clock, DNS,
# packages, gh, git identity via prompt). Nothing here is tied to a
# particular user, domain or account: the customization lives in
# aegis.conf.
#
# It was born on a VirtualBox VM and, until 2026-08-27, it ASSUMED that
# shape everywhere: it pinned the NAT NIC's DNS to VirtualBox's resolver
# and installed a boot service to re-apply it — on a VPS whose only NIC
# is eth0 that service failed on every boot, and the leftovers check
# looked at a v2 path that exists on no customer's machine (and so was
# green). The first run on a real VPS found both. Now the VirtualBox
# shape is MEASURED (the NIC exists and sits on VirtualBox's NAT subnet)
# and everything else is generic.
set -u
AEGIS_ROOT="${AEGIS_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"      # AEGIS_STATE_DIR: where a previous init would have left its gates
usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
# Parsed BEFORE anything else: this command installs things with sudo,
# and until 2026-08-26 `aegis preflight --help` ran the whole
# installation instead of describing it.
for a in "$@"; do case "$a" in
    -h|--help) usage; exit 0 ;;
    *) echo "${AEGIS_CMD:-aegis} preflight takes no arguments (got '$a'); try --help" >&2; exit 3 ;;
esac; done
NAT_IF="${NAT_IF:-enp0s3}"                               # VirtualBox NAT NIC (only acted on if measured, see 3/9)
HOST_IF="${HOST_IF:-enp0s8}"                             # VirtualBox host-only/bridge NIC
NAT_DNS="${NAT_DNS:-10.0.2.3}"                           # DNS of VirtualBox's NAT
MAX_DRIFT="${MAX_DRIFT:-120}"                            # seconds of drift tolerated
PASS=0; FAIL=0; WARNS=0
ok(){   echo "  [OK]   $1"; PASS=$((PASS+1)); }
bad(){  echo "  [FAIL] $1"; FAIL=$((FAIL+1)); }
warn(){ echo "  [WARN] $1"; WARNS=$((WARNS+1)); }
info(){ echo "  [..]   $1"; }

# absolute drift (s) against github's Date header; empty if it could not be measured
clock_drift(){
  local remote_ts d
  remote_ts=$(date -d "$(curl -sI -4 --max-time 10 https://github.com \
    | grep -i '^date:' | cut -d' ' -f2-)" +%s 2>/dev/null)
  [ -z "${remote_ts:-}" ] && return 1
  [ "$remote_ts" -gt 0 ] 2>/dev/null || return 1
  d=$(( $(date +%s) - remote_ts )); echo "${d#-}"
}

echo "== 1/9 sudo NOPASSWD (the init only discovers it at phase 20) =="
if ! sudo -n true 2>/dev/null; then
  sudo bash -c "printf '%s ALL=(ALL) NOPASSWD:ALL\n' '$USER' > /etc/sudoers.d/010-aegis-init-nopasswd \
    && chmod 0440 /etc/sudoers.d/010-aegis-init-nopasswd && visudo -c >/dev/null"
fi
sudo -K
if sudo -n true 2>/dev/null; then ok "NOPASSWD active for $USER"; else bad "NOPASSWD did not stay active"; fi

echo "== 2/9 IPv6 persistently disabled (the RA advertises a v6 route with no way out) =="
# all + default cover every NIC, present and future; naming NICs here
# baked the VirtualBox ones into every machine.
sudo tee /etc/sysctl.d/99-disable-ipv6.conf >/dev/null <<EOF
net.ipv6.conf.all.disable_ipv6 = 1
net.ipv6.conf.default.disable_ipv6 = 1
EOF
sudo sysctl --system >/dev/null 2>&1
[ "$(cat /proc/sys/net/ipv6/conf/all/disable_ipv6 2>/dev/null)" = "1" ] \
  && ok "IPv6 off (runtime + /etc/sysctl.d/99-disable-ipv6.conf)" \
  || bad "IPv6 is still enabled - buildah tries v6 and the pulls die"

echo "== 3/9 DNS (on the VirtualBox shape the bridge NIC brings an unreachable DNS) =="
# The VirtualBox shape is MEASURED, not assumed: the NAT NIC exists and
# carries an address on VirtualBox's NAT subnet. Anywhere else the host's
# DNS is left exactly as it was configured — a VPS, a LAN box, a cloud
# VM each have their own, and none of them is 10.0.2.3.
is_vbox_nat=0
if ip -4 -o addr show "$NAT_IF" 2>/dev/null | grep -q ' inet 10\.0\.2\.'; then is_vbox_nat=1; fi
if [ "$is_vbox_nat" = 1 ]; then
sudo resolvectl dns "$NAT_IF" "$NAT_DNS" 2>/dev/null || warn "I could not set DNS on $NAT_IF"
ip link show "$HOST_IF" >/dev/null 2>&1 && sudo resolvectl dns "$HOST_IF" "" 2>/dev/null
# persistence: resolvectl is runtime-only -> a oneshot that re-applies on every boot
sudo tee /etc/systemd/system/aegis-dns-fix.service >/dev/null <<EOF
[Unit]
Description=aegis: DNS only through NAT ($NAT_IF -> $NAT_DNS), $HOST_IF without DNS
After=network-online.target systemd-resolved.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/resolvectl dns $NAT_IF $NAT_DNS
ExecStart=-/usr/bin/resolvectl dns $HOST_IF ""
[Install]
WantedBy=multi-user.target
EOF
sudo systemctl daemon-reload && sudo systemctl enable aegis-dns-fix.service >/dev/null 2>&1 \
  && ok "aegis-dns-fix.service enabled (survives a reboot)" \
  || bad "I could not enable aegis-dns-fix.service"
else
  ok "not the VirtualBox shape ($NAT_IF is not on 10.0.2.0/24): the host's DNS is left as configured"
  # a service from an earlier, VirtualBox-only version of this command
  # would fail on every boot here; it is repaired, not just reported
  if [ -e /etc/systemd/system/aegis-dns-fix.service ]; then
    sudo systemctl disable --now aegis-dns-fix.service >/dev/null 2>&1
    sudo rm -f /etc/systemd/system/aegis-dns-fix.service && sudo systemctl daemon-reload \
      && ok "removed a stale aegis-dns-fix.service (it named NICs this machine does not have)" \
      || bad "I could not remove the stale aegis-dns-fix.service"
  fi
fi
R=0; for i in 1 2 3; do resolvectl query github.com >/dev/null 2>&1 && R=$((R+1)); done
[ "$R" -eq 3 ] && ok "github.com resolves 3/3" || bad "unstable DNS ($R/3) - check resolvectl status"

echo "== 4/9 clock (TLS/ACME/cosign/apt depend on this) — auto-repairs =="
# Real lessons: NTPSynchronized=yes lied with 7 days of lag; and with chrony
# installed it corrects by slew (it would take weeks) and timedatectl is not
# trustworthy. The truth is the drift measured against an external source.
sudo timedatectl set-ntp true >/dev/null 2>&1
drift="$(clock_drift || echo '')"
if [ -z "$drift" ]; then
  warn "I could not measure the drift (no way out to github?) - check 7/9"
elif [ "$drift" -le "$MAX_DRIFT" ]; then
  ok "clock ok (drift ${drift}s vs github)"
else
  info "drift ${drift}s: forcing a resync..."
  for attempt in 1 2 3; do
    if command -v chronyc >/dev/null 2>&1; then
      sudo systemctl restart chrony >/dev/null 2>&1
      sudo chronyc makestep >/dev/null 2>&1     # chrony: immediate step
      sleep 4
    else
      sudo timedatectl set-ntp false >/dev/null 2>&1
      sleep 1
      sudo timedatectl set-ntp true  >/dev/null 2>&1
      sudo systemctl restart systemd-timesyncd >/dev/null 2>&1
      sleep 8
    fi
    drift="$(clock_drift || echo '')"
    [ -n "$drift" ] && [ "$drift" -le "$MAX_DRIFT" ] && break
    info "attempt $attempt: drift ${drift:-?}s, retrying..."
  done
  if [ -n "${drift:-}" ] && [ "$drift" -le "$MAX_DRIFT" ]; then
    command -v hwclock >/dev/null && sudo hwclock --systohc 2>/dev/null
    ok "clock corrected automatically (drift ${drift}s) - $(date -u)"
  else
    bad "clock is still off by ${drift:-?}s - check chronyc tracking / systemd-timesyncd"
  fi
fi

echo "== 5/9 packages the init does NOT install but does use =="
sudo apt-get update -qq 2>/dev/null || sudo apt-get update -qq || warn "apt update failed (look at the clock in 4/9)"
sudo apt-get install -y -qq tmux python3-yaml jq >/dev/null 2>&1
command -v tmux >/dev/null && ok "tmux installed (run the init inside it)" || bad "tmux not installed"
command -v jq   >/dev/null && ok "jq present (phase 00's bootstrap-bins gate)" || bad "jq missing"
python3 -c 'import yaml' 2>/dev/null && ok "PyYAML present (placeholder injection, phase 80)" || bad "PyYAML missing"
for b in curl git python3; do command -v "$b" >/dev/null && ok "$b present" || bad "$b MISSING"; done
# usable tmux: mouse (scroll + selection with Shift) and a long scrollback for capture-pane
[ -f "$HOME/.tmux.conf" ] || printf 'set -g mouse on\nset -g history-limit 100000\n' > "$HOME/.tmux.conf"
grep -q "mouse on" "$HOME/.tmux.conf" 2>/dev/null \
  && ok "~/.tmux.conf with mouse+scrollback (Shift+drag copies to the real clipboard)" \
  || warn "~/.tmux.conf without 'mouse on' - the scroll will move the command history"

echo "== 6/9 git/gh identity and auth (the init commits and clones with these) =="
g_name="$(git config --global user.name  2>/dev/null || true)"
g_mail="$(git config --global user.email 2>/dev/null || true)"
if [ -z "$g_name" ] || [ -z "$g_mail" ]; then
  if [ -t 0 ]; then
    echo "  git has no global identity (the init commits to the platform repo)."
    [ -z "$g_name" ] && read -r -p "  Name for the commits:  " g_name
    [ -z "$g_mail" ] && read -r -p "  Email for the commits: " g_mail
    [ -n "$g_name" ] && [ -n "$g_mail" ] \
      && { git config --global user.name "$g_name"; git config --global user.email "$g_mail"; }
  else
    warn "no TTY: I cannot ask for the git identity interactively"
  fi
fi
g_name="$(git config --global user.name  2>/dev/null || true)"
g_mail="$(git config --global user.email 2>/dev/null || true)"
[ -n "$g_name" ] && [ -n "$g_mail" ] \
  && ok "git with identity: $g_name <$g_mail>" \
  || bad "git without identity -> git config --global user.name/user.email (any valid one)"
# gh is THE GitHub credential of the whole init (phase 00, D10): the
# install is ours to do, the login is the operator's — it is the one
# step of this command that needs a human and a browser.
command -v gh >/dev/null || sudo apt-get install -y -qq gh >/dev/null 2>&1
if command -v gh >/dev/null; then
  # THE SCOPE IS MEASURED, not advised. Until 2026-08-31 this only
  # asked whether `gh auth status` succeeded, and named `repo,
  # delete_repo` in the FAILURE message — advice nobody reads on a
  # green run. A session with `repo` and nothing else therefore passed
  # here and discovered the missing scope much later, inside a phase.
  #
  # And `delete_repo` came OUT of the advice in the same change, for a
  # measured reason: nothing in this artifact deletes a repository.
  # `aegis destroy` says so explicitly. Asking for a scope no code path
  # uses is asking an operator to hand over more than the job needs,
  # and least privilege is not a rule this house applies only to
  # Cloudflare.
  if gh auth status >/dev/null 2>&1; then
    if gh auth status 2>&1 | grep -qE "Token scopes:.*'repo'"; then
      ok "gh authenticated as $(gh api user --jq .login 2>/dev/null || echo '?') with the repo scope"
    else
      bad "gh is authenticated but WITHOUT the 'repo' scope: phase 12 creates and seeds two repositories and would fail there -> gh auth refresh -h github.com -s repo"
    fi
  else
    bad "gh WITHOUT auth -> run 'gh auth login' (scope: repo) and re-run this command"
  fi
else
  bad "gh not installed and apt could not install it (the init assumes it at phase 00)"
fi

echo "== 7/9 real connectivity to the endpoints the phases use =="
# 404 is a VALID answer: api.cloudflare.com/client/v4 without a token answers 404 (the server responds)
for u in https://github.com https://api.github.com https://api.cloudflare.com/client/v4 \
         https://get.k3s.io https://registry-1.docker.io/v2/ https://dl.k8s.io; do
  code=$(curl -4 -s -o /dev/null --max-time 10 -w '%{http_code}' "$u" 2>/dev/null)
  case "$code" in 2*|3*|401|404) ok "reachable: $u ($code)";; *) bad "NOT reachable: $u (code=$code)";; esac
done

echo "== 8/9 the machine's resources =="
free_g=$(df -BG --output=avail / | tail -1 | tr -dc '0-9')
[ "${free_g:-0}" -ge 25 ] && ok "free disk on /: ${free_g}G (>=25G)" || bad "free disk ${free_g}G (<25G)"
mem_g=$(awk '/MemTotal/{printf "%d", $2/1024/1024}' /proc/meminfo)
[ "${mem_g:-0}" -ge 7 ] && ok "total RAM: ${mem_g}G" || warn "RAM ${mem_g}G - jenkins+kyverno+trivy end up tight, 8G+ is ideal"
[ -d /dev/shm ] && touch /dev/shm/.aegis-probe 2>/dev/null && rm -f /dev/shm/.aegis-probe \
  && ok "/dev/shm writable (age/cosign ceremonies)" || bad "/dev/shm not writable"

echo "== 9/9 leftovers of a previous instance on this host (the init expects none) =="
for p in "$AEGIS_STATE_DIR" /etc/rancher/k3s /var/lib/rancher/k3s; do
  [ -e "$p" ] && warn "$p exists - this host already carried an instance (aegis init would converge on it)" || ok "clean: $p"
done

echo
echo "================== SUMMARY =================="
echo "  OK: $PASS   WARN: $WARNS   FAIL: $FAIL"
if [ "$FAIL" -eq 0 ]; then
  echo "  Machine ready. Re-running this command must stay all OK; then: aegis init"
else
  echo "  Fix the FAILs, re-run this command, and only then: aegis init"
fi
# one of the four outcomes, not a count: rc 1 = something is missing or wrong
[ "$FAIL" -eq 0 ] && exit 0 || exit 1
