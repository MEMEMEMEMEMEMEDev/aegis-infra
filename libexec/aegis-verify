#!/usr/bin/env bash
# aegis-summary: Static verification of the artifact: everything checkable without a cluster
# aegis-group:   setup
# aegis-subcommands:
#
# aegis-help:
# Usage: aegis verify [--only NNN]... [--profile cloudflare|local|both]
#                     [--with-charts] [--teeth [NNN]] [--harness] [--list]
#
# Runs the checks in verify/checks/ against the product tree. Every check
# is one file, with a real, dated bug behind it.
#
#   --only NNN        run only that check (repeatable)
#   --profile         which edge profile is assumed (default: both)
#   --with-charts     also pull the pinned charts and render them
#   --teeth [NNN]     exercise the TEETH: mutate the tree on purpose and
#                     require the check to turn red
#   --harness         run the functional harnesses in verify/harness/
#   --list            list the checks and exit
#
# Exit codes:
#   0  everything PASS
#   1  there are FAILs — the artifact is wrong
#   3  a bug in the VERIFIER (a check with no verdict, with two, or not
#      deterministic across two passes) — neither green nor red about the
#      artifact
#
# Why there is no `pipefail` here is written down in verify/lib.sh.

set -u

# ── canonical preamble (V-102) ───────────────────────────────────────
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} verify: readlink is missing — I will not guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
VERIFY="$AEGIS_ROOT/verify"

ONLY=() PROFILES="" WITH_CHARTS=false DO_TEETH=false TEETH_ONLY="" DO_HARNESS=false DO_LIST=false
while (($#)); do case "$1" in
    --only)         ONLY+=("$2"); shift 2 ;;
    --profile)      PROFILES="$2"; shift 2 ;;
    --with-charts)  WITH_CHARTS=true; shift ;;
    --teeth)        DO_TEETH=true
                    if [[ "${2:-}" =~ ^[0-9] ]]; then TEETH_ONLY="$2"; shift; fi
                    shift ;;
    --harness)      DO_HARNESS=true; shift ;;
    --list)         DO_LIST=true; shift ;;
    -h|--help)      sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; exit 0 ;;
    *) echo "${AEGIS_CMD:-aegis} verify: unknown flag: $1" >&2; exit 3 ;;
esac; done
# DOES the local profile exist in the artifact? It is DERIVED, not
# assumed: it materialises with the `profile` class of placeholders
# (__EDGE_*__), which T-04 brings. Until they are there, running "both
# profiles" is running exactly the same thing twice: double the time
# and — worse — a check count that suggests coverage which does not
# exist. When T-04 lands, this turns itself on.
has_local_profile() { grep -rqI '__EDGE_' "$AEGIS_ROOT/seed" 2>/dev/null; }
PROFILE_NOTICE=""
case "${PROFILES:=both}" in
    cloudflare) PROFILE_LIST=(cloudflare) ;;
    local)
        if has_local_profile; then PROFILE_LIST=(local)
        else
            echo "COULD NOT EVALUATE: the local profile does not exist in the artifact yet" >&2
            echo "  (no __EDGE_*__ placeholders under seed/ — T-04 brings them)" >&2
            exit 2
        fi ;;
    both)
        if has_local_profile; then PROFILE_LIST=(cloudflare local)
        else
            PROFILE_LIST=(cloudflare)
            PROFILE_NOTICE="the local profile does not exist in the artifact yet (T-04): only cloudflare was verified"
        fi ;;
    *) echo "${AEGIS_CMD:-aegis} verify: --profile must be cloudflare, local or both" >&2; exit 3 ;;
esac
export AEGIS_VERIFY_WITH_CHARTS="$WITH_CHARTS"

# Hygiene: __pycache__ is GENERATED state, not artifact, and it was the
# prime suspect in the non-deterministic false red of run #15. The checks
# are a pure function of the VERSIONED tree.
find "$AEGIS_ROOT" -type d -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null

# ── the list is DERIVED, not written ─────────────────────────────────
# In v2, adding a check meant editing a 3938-line file and trusting you
# had not stepped on another one's state. Here the number comes from the
# filename and the order from the sort: there is no list to maintain, and
# therefore no list that can fall out of date.
mapfile -t ALL < <(find "$VERIFY/checks" -maxdepth 1 -name '[0-9][0-9][0-9]*.sh' -type f 2>/dev/null | sort)
[[ ${#ALL[@]} -gt 0 ]] || { echo "${AEGIS_CMD:-aegis} verify: no checks in $VERIFY/checks — a verifier with no checks is NOT green" >&2; exit 3; }

number_of() { local b; b="$(basename "$1")"; printf '%s\n' "${b%%-*}"; }
title_of()  { sed -n 's/^# title: //p' "$1" | head -1; }

if $DO_LIST; then
    for c in "${ALL[@]}"; do printf '%s  %s\n' "$(number_of "$c")" "$(title_of "$c")"; done
    exit 0
fi

# --only filter: accepts 3, 03, 003, 15a and 005b — the operator types
# the number as it appears in the output, not as the filesystem stores
# it. And `--only 15` runs 15a, 15b, 15c and 15d: a split check is still
# ONE bug with ONE date, and whoever invokes it by number wants them all.
selection() {
    local c n o n_num n_suf o_num o_suf
    if [[ ${#ONLY[@]} -eq 0 ]]; then printf '%s\n' "${ALL[@]}"; return; fi
    for c in "${ALL[@]}"; do
        n="$(number_of "$c")"; n_num="${n%%[!0-9]*}"; n_suf="${n#"$n_num"}"
        for o in "${ONLY[@]}"; do
            o_num="${o%%[!0-9]*}"; o_suf="${o#"$o_num"}"
            [[ -z "$o_num" ]] && continue
            if (( 10#$n_num == 10#$o_num )) && [[ -z "$o_suf" || "$o_suf" == "$n_suf" ]]; then
                printf '%s\n' "$c"; break
            fi
        done
    done
}
mapfile -t SELECTED < <(selection)
if [[ ${#SELECTED[@]} -eq 0 ]]; then
    echo "${AEGIS_CMD:-aegis} verify: --only selected no check (nonexistent number?)" >&2; exit 3
fi

# ── running ONE check ────────────────────────────────────────────────
# In its own subshell and with its own verdict file. The check cannot lie
# about its result: it does not write it, this counts it.
# FAILURES and BUG are the VERDICT of the whole run and accumulate across
# profiles. PASSED and SKIPPED count SUBJECTS, and a subject belongs to ONE
# profile: they are reset at the top of each profile's pass and reported per
# profile. Until 2026-08-26 all four were initialised here, outside the
# profile loop, so `--profile both` would have announced "ALL PASS (240
# checks)" over 120 subjects — a coverage number twice the reality, which is
# the exact disease this verifier exists to kill. It had no subject yet only
# because the local profile does not exist; it would have arrived WITH it.
FAILURES=0 BUG=0 PASSED=0 SKIPPED=0
PROFILE_TALLY=()
run_check() {
    local chk="$1" num tit vf rc n_pass n_fail n_skip
    num="$(number_of "$chk")"; tit="$(title_of "$chk")"
    printf '\033[1m══ %s. %s ══\033[0m\n' "${num#00}" "${tit:-(untitled)}"
    vf="$(mktemp)"
    (
        set -u
        AEGIS_VERDICT_FILE="$vf"
        # shellcheck source=/dev/null
        source "$VERIFY/lib.sh"
        # shellcheck source=/dev/null
        source "$chk"
        if ! declare -F check >/dev/null; then
            echo "the file does not define check()" >&2; exit 97
        fi
        check
    )
    rc=$?
    n_pass=$(grep -c '^PASS' "$vf" 2>/dev/null); n_fail=$(grep -c '^FAIL' "$vf" 2>/dev/null); n_skip=$(grep -c '^SKIP' "$vf" 2>/dev/null)
    local total=$(( n_pass + n_fail + n_skip ))
    rm -f "$vf"

    if [[ "$rc" == 97 ]]; then
        printf '\033[1;35mBUG\033[0m  %s: the file does not define check() — it is not a check, it is a loose file\n' "$num"
        BUG=1; return
    fi
    # THE MISSING LINE, impossible by construction: a check that said
    # nothing did not "pass". It is silence, and silence is red.
    if [[ "$total" == 0 ]]; then
        printf '\033[1;31mFAIL\033[0m %s: emitted no verdict (rc=%s) — a check that does not speak verifies nothing\n' "$num" "$rc"
        FAILURES=1; return
    fi
    # Two verdicts = the check contradicts itself, or counts two things
    # in one file. That is a bug in the VERIFIER, not the artifact: exit 3.
    if [[ "$total" -gt 1 ]]; then
        printf '\033[1;35mBUG\033[0m  %s: emitted %s verdicts (%s PASS / %s FAIL / %s SKIP) — one check, one verdict\n' \
            "$num" "$total" "$n_pass" "$n_fail" "$n_skip"
        BUG=1; return
    fi
    (( n_fail )) && FAILURES=1
    (( n_pass )) && PASSED=$((PASSED+1))
    (( n_skip )) && SKIPPED=$((SKIPPED+1))
    return 0
}

# ── does the check have a subject here? ──────────────────────────────
# A check with nothing to measure under a profile says so with skip(), and
# a skip is rc 0 — the same as a pass. `_one_tooth` demands rc 1 to call a
# mutation "biting", so EVERY red_N of a skipped check would be reported as
# DOES NOT BITE: a false accusation against a tooth that is perfectly fine,
# and one that would arrive in bulk the day the checks learn about profiles.
#
# The answer is DERIVED, never declared: the check is asked. A table saying
# "these teeth do not apply to local" is a table that drifts, and it drifts
# silently towards claiming protection that is not there.
_has_subject() {
    local chk="$1" vf spoke skipped
    vf="$(mktemp)"
    (
        set -u
        AEGIS_VERDICT_FILE="$vf"
        # shellcheck source=/dev/null
        source "$VERIFY/lib.sh"
        # shellcheck source=/dev/null
        source "$chk"
        declare -F check >/dev/null && check
    ) >/dev/null 2>&1
    spoke="$(grep -cE '^(PASS|FAIL|SKIP)' "$vf" 2>/dev/null)"
    skipped="$(grep -c '^SKIP' "$vf" 2>/dev/null)"
    rm -f "$vf"
    # ONLY the check whose single verdict is a skip has no subject. One that
    # emitted nothing, or two verdicts, is a different illness and run_check
    # is the one that has to name it — not this probe, quietly.
    [[ "$spoke" == 1 && "$skipped" == 1 ]] && return 1
    return 0
}

# ── the teeth ────────────────────────────────────────────────────────
# A check without a tooth is a promise without proof. `--teeth` mutates
# the tree on purpose (red_k) and demands FAIL; then it applies a
# legitimate change (control_k) and demands PASS. If the red does not
# bite, the check protects nothing; if the control turns red, the check
# bites too much.
#
# IN PARALLEL, and not for elegance: serially it is ~3 hours for 112
# checks — every mutation is a copy of the tree and a whole run of the
# check — and a test that takes three hours is a test that does not get
# run. Each job is independent by construction (its own copy in tmpfs),
# so the parallelism is free except for RAM.
current_profile() { printf '%s\n' "${AEGIS_VERIFY_PROFILE:-cloudflare}"; }

# mode + kind + path for every entry, which is what `diff -rq` does NOT
# look at: it compares content and nothing else.
_tree_modes() {
    ( cd "$1" 2>/dev/null && find . -path ./.git -prune -o -printf '%m %y %P\n' | sort )
}

# one job = one mutation. Runs isolated and leaves its verdict in a file;
# the parent is the one that aggregates.
_one_tooth() {
    local num="$1" kind="$2" k="$3" td="$4" res="$5"
    local tmp rc
    tmp="$(mktemp -d /dev/shm/aegis-teeth.XXXXXX)"
    cp -a "$AEGIS_ROOT/." "$tmp/" 2>/dev/null
    if ! ( set -u; AEGIS_ROOT="$tmp"; source "$td"; "${kind}_$k" ) >/dev/null 2>&1; then
        printf '%s\t%s\t%s\tBROKEN\n' "$num" "$kind" "$k" >> "$res"
        rm -rf "$tmp"; return
    fi
    # A mutation that leaves the tree IDENTICAL tests nothing, and until
    # 2026-08-25 it was reported as «the check does not bite» — pointing
    # at the innocent party. It happened twice: tooth 007 searched for a
    # file that did not exist, and tooth 113's red_1 for an anchor its
    # target file did not carry. Both times the message sent somebody to
    # harden a check that was fine.
    #
    # They are different faults and they need different fixes: a blind
    # check has to be rewritten, an inert mutation has to be re-aimed.
    # Telling them apart is the same rule as everywhere else here — a
    # test that did not run is not a test that passed.
    # CONTENT *and* MODE. The first version of this compared only
    # content with `diff -rq`, and the very first full run reported
    # tooth 101's red_3 —a plain `chmod -x`— as inert. A mutation that
    # takes the executable bit off a command mutates plenty; the
    # instrument was the blind one. An instrument that misses a whole
    # class of change is worse than none, because it accuses by name.
    if diff -rq --exclude=.git "$AEGIS_ROOT" "$tmp" >/dev/null 2>&1 \
       && [[ "$(_tree_modes "$AEGIS_ROOT")" == "$(_tree_modes "$tmp")" ]]; then
        printf '%s\t%s\t%s\tINERT\n' "$num" "$kind" "$k" >> "$res"
        rm -rf "$tmp"; return
    fi
    AEGIS_ROOT="$tmp" "$tmp/libexec/aegis-verify" --only "$num" --profile "$(current_profile)" >/dev/null 2>&1
    rc=$?
    rm -rf "$tmp"
    # 1 = the check turned RED: that is biting.
    # 0 = the mutation went unnoticed.
    # 3 = the check BROKE (two verdicts, or none): a bug in the verifier
    #     is not a defence.
    printf '%s\t%s\t%s\t%s\n' "$num" "$kind" "$k" "$rc" >> "$res"
}

run_teeth() {
    local chk num td k
    local -a JOBS_LIST=()
    for chk in "${SELECTED[@]}"; do
        num="$(number_of "$chk")"; td="$VERIFY/teeth/$num.sh"
        # The number is compared NUMERICALLY, the same way --only does
        # it. It used to be a string comparison against "$num" and
        # "${num#00}", which works for 007 (-> 7) and breaks for 039:
        # `${num#00}` only strips a leading "00", so 039 stayed 039 and
        # never matched a typed 39. `--teeth 39` then selected nothing,
        # printed "no teeth to run in this selection", and the caller
        # announced "TEETH: they all bite".
        #
        # A selection that matches nothing reported as success is the
        # disease this whole verifier exists to kill, and it was living
        # inside the verifier. Found on 2026-08-24 by typing `--teeth 39`
        # and getting a green from a check whose tooth had just been
        # written to fail.
        if [[ -n "$TEETH_ONLY" ]]; then
            local n_num="${num%%[!0-9]*}" o_num="${TEETH_ONLY%%[!0-9]*}"
            local n_suf="${num#"$n_num"}" o_suf="${TEETH_ONLY#"$o_num"}"
            [[ -n "$o_num" ]] || { echo "${AEGIS_CMD:-aegis} verify: --teeth '$TEETH_ONLY' is not a check number" >&2; return 3; }
            (( 10#$n_num == 10#$o_num )) || continue
            [[ -z "$o_suf" || "$o_suf" == "$n_suf" ]] || continue
        fi
        [[ -f "$td" ]] || continue          # check 199 is the one that claims it
        if ! _has_subject "$chk"; then
            printf '  \033[1;33m%s: no subject under profile %s — its teeth do not apply here\033[0m\n' \
                "$num" "$(current_profile)"
            continue
        fi
        for k in $(grep -oE '^red_[0-9]+' "$td" | sed 's/red_//' | sort -n); do
            JOBS_LIST+=("$num red $k $td")
        done
        for k in $(grep -oE '^control_[0-9]+' "$td" | sed 's/control_//' | sort -n); do
            JOBS_LIST+=("$num control $k $td")
        done
    done
    # An empty selection is NOT success. If the operator asked for a
    # specific check's teeth and nothing was selected, that is a typo or
    # a check with no tooth — either way it is a question that went
    # unanswered, and answering it with green is how the verifier would
    # lie about itself.
    if [[ ${#JOBS_LIST[@]} -eq 0 ]]; then
        if [[ -n "$TEETH_ONLY" ]]; then
            echo "${AEGIS_CMD:-aegis} verify: --teeth $TEETH_ONLY selected no mutation (nonexistent check, or one with no tooth — check 199 tracks those)" >&2
            return 3
        fi
        echo "no teeth to run in this selection"; return 0
    fi

    local RES; RES="$(mktemp)"
    local N=${#JOBS_LIST[@]} done_n=0
    local JOBS="${AEGIS_TEETH_JOBS:-$(nproc 2>/dev/null || echo 4)}"
    printf '%s mutations in %s parallel jobs\n' "$N" "$JOBS"
    for t in "${JOBS_LIST[@]}"; do
        while (( $(jobs -rp | wc -l) >= JOBS )); do wait -n; done
        # shellcheck disable=SC2086
        _one_tooth $t "$RES" &
        done_n=$((done_n+1))
        (( done_n % 20 == 0 )) && printf '  … %s/%s\n' "$done_n" "$N"
    done
    wait

    # aggregation: a check is healthy if ALL of its reds bite and NO
    # control turns red.
    local rc_total=0
    for chk in "${SELECTED[@]}"; do
        num="$(number_of "$chk")"
        grep -q "^$num	" "$RES" || continue
        local biting=0 total_r=0 healthy=0 total_c=0 kind kk rc
        while IFS=$'\t' read -r n kind kk rc; do
            [[ "$n" == "$num" ]] || continue
            if [[ "$kind" == red ]]; then
                total_r=$((total_r+1))
                case "$rc" in
                    1) biting=$((biting+1)) ;;
                    0) printf '  \033[1;31mred_%s DOES NOT BITE\033[0m (mutation applied and check %s stayed green)\n' "$kk" "$num" ;;
                    BROKEN) printf '  \033[1;35mred_%s could not be applied\033[0m (the tooth is broken, not the check)\n' "$kk" ;;
                    INERT) printf '  \033[1;35mred_%s left the tree UNCHANGED\033[0m (the tooth mutates nothing — re-aim the mutation; the check is not the one at fault)\n' "$kk" ;;
                    *) printf '  \033[1;35mred_%s broke check %s (exit %s)\033[0m — a bug in the verifier is not a defence\n' "$kk" "$num" "$rc" ;;
                esac
            else
                total_c=$((total_c+1))
                case "$rc" in
                    0) healthy=$((healthy+1)) ;;
                    BROKEN) printf '  \033[1;35mcontrol_%s could not be applied\033[0m\n' "$kk" ;;
                    INERT) printf '  \033[1;35mcontrol_%s left the tree UNCHANGED\033[0m (a control that changes nothing proves nothing: it would pass even against a check that bites everything)\n' "$kk" ;;
                    *) printf '  \033[1;31mcontrol_%s turned RED\033[0m (check %s bites a legitimate change)\n' "$kk" "$num" ;;
                esac
            fi
        done < "$RES"
        if [[ "$biting" == "$total_r" && "$healthy" == "$total_c" ]]; then
            printf '\033[1;32m  %s: %s/%s bite · %s/%s controls healthy\033[0m\n' "$num" "$biting" "$total_r" "$healthy" "$total_c"
        else
            printf '\033[1;31m  %s: %s/%s bite · %s/%s controls healthy\033[0m\n' "$num" "$biting" "$total_r" "$healthy" "$total_c"
            rc_total=1
        fi
    done
    rm -f "$RES"
    return $rc_total
}

# ── functional harnesses ─────────────────────────────────────────────
run_harness() {
    local rc_total=0 h rc
    for h in "$VERIFY"/harness/*.sh; do
        [[ -f "$h" ]] || continue
        printf '\033[1m── harness: %s ──\033[0m\n' "$(basename "$h" .sh)"
        AEGIS_ROOT="$AEGIS_ROOT" bash "$h"
        rc=$?
        # The THREE outcomes here too. The first version treated any rc
        # other than 0 as "FAILED", and on the VPS — where the v2 tree
        # the equivalence harness uses as a reference does not exist —
        # that turned "I could not measure" into a red. It is exactly the
        # confusion this whole project exists not to make: a red gets
        # investigated, an "I do not know" dressed as a red wastes the
        # time somewhere else.
        case $rc in
            0) printf '\033[1;32mOK\033[0m %s\n' "$(basename "$h" .sh)" ;;
            2) printf '\033[1;33mCOULD NOT EVALUATE\033[0m %s (this is not approval: it is a test that did not run)\n' "$(basename "$h" .sh)" ;;
            *) printf '\033[1;31mFAILED\033[0m %s\n' "$(basename "$h" .sh)"; rc_total=1 ;;
        esac
    done
    return $rc_total
}

# ── the run ──────────────────────────────────────────────────────────
if $DO_HARNESS; then
    run_harness; exit $?
fi

if $DO_TEETH; then
    for prof in "${PROFILE_LIST[@]}"; do
        export AEGIS_VERIFY_PROFILE="$prof"
        printf '\033[1;36m══════ TEETH · profile %s ══════\033[0m\n' "$prof"
        run_teeth || BUG=1
    done
    [[ "$BUG" == 0 ]] && { printf '\033[1;32m══ TEETH: they all bite ══\033[0m\n'; exit 0; }
    printf '\033[1;31m══ TEETH: there are checks that do not protect what they claim ══\033[0m\n'; exit 1
fi

for prof in "${PROFILE_LIST[@]}"; do
    export AEGIS_VERIFY_PROFILE="$prof"
    PASSED=0 SKIPPED=0
    [[ ${#PROFILE_LIST[@]} -gt 1 ]] && printf '\033[1;36m══════ profile %s ══════\033[0m\n' "$prof"
    for chk in "${SELECTED[@]}"; do run_check "$chk"; done
    PROFILE_TALLY+=("$prof:$PASSED:$SKIPPED")
done

echo
if [[ "$BUG" != 0 ]]; then
    printf '\033[1;35m══ VERIFIER BUG: there are checks that do not emit one verdict and only one ══\033[0m\n'
    exit 3
fi
if [[ "$FAILURES" == 0 ]]; then
    _tot_pass=0 _tot_skip=0
    for _t in "${PROFILE_TALLY[@]}"; do
        _p="${_t#*:}"; _tot_pass=$(( _tot_pass + ${_p%%:*} )); _tot_skip=$(( _tot_skip + ${_p#*:} ))
    done
    # NOTHING could be evaluated is not approval: it is the third outcome,
    # and it gets its own exit code so a caller can tell it from a pass.
    # `_one_tooth` reads exactly this to learn that a check has no subject
    # under a profile instead of accusing its teeth of not biting.
    if [[ "$_tot_pass" == 0 && "$_tot_skip" -gt 0 ]]; then
        printf '\033[1;33m══ COULD NOT EVALUATE: %s check(s) skipped, none measured ══\033[0m\n' "$_tot_skip"
        exit 2
    fi
    if [[ ${#PROFILE_TALLY[@]} -gt 1 ]]; then
        # One line PER PROFILE. A single number here would be a sum of
        # subjects that do not share a universe, and it would read as
        # coverage twice the size of the artifact.
        printf '\033[1;32m══ STATIC VERIFICATION: ALL PASS ══\033[0m\n'
        for _t in "${PROFILE_TALLY[@]}"; do
            _p="${_t#*:}"
            printf '\033[1;32m   profile %-11s %s checks, %s not evaluated\033[0m\n' \
                "${_t%%:*}" "${_p%%:*}" "${_p#*:}"
        done
    else
        printf '\033[1;32m══ STATIC VERIFICATION: ALL PASS (%s checks, %s not evaluated) ══\033[0m\n' "$_tot_pass" "$_tot_skip"
    fi
    [[ -n "${PROFILE_NOTICE:-}" ]] && printf '\033[1;33m   %s\033[0m\n' "$PROFILE_NOTICE"
    exit 0
fi
# H2 run #15: check 69 gave FAIL on the 1st pass of a freshly copied VM
# and stable PASS afterwards (3/3), with no change to the tree. A verdict
# that is not reproducible is a bug in the VERIFIER, not the artifact, and
# it deserves its own exit code instead of a red that sends you chasing
# ghosts.
if [[ -z "${AEGIS_VERIFY_RETRY:-}" ]]; then
    printf '\033[1;33mthere were FAILs — 2nd confirmation pass (H2: verifier determinism)\033[0m\n'
    if AEGIS_VERIFY_RETRY=1 "$0" "$@" >/dev/null 2>&1; then
        printf '\033[1;33m══ UNSTABLE CHECK (H2): the 2nd pass PASSED with no change to the tree — VERIFIER bug. exit 3 ══\033[0m\n'
        exit 3
    fi
    printf '\033[1;31mthe 2nd pass REPRODUCED the failures — RED verdict confirmed\033[0m\n'
fi
printf '\033[1;31m══ STATIC VERIFICATION: THERE ARE FAILURES ══\033[0m\n'
exit 1
