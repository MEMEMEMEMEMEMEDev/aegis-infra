#!/usr/bin/env bash
# aegis-summary: The lab VPS: user-data, tunnel token, shred
# aegis-group:   infra
# aegis-help:
# Usage: aegis vps render     # cloud-init user-data for the lab VPS
#        aegis vps entregar   # hand the tunnel token over (stdin/env, never argv)
#        aegis vps shred      # wipe the lab VPS's secrets locally
#
# The lab VPS. The tunnel token travels through a VARIABLE and through
# STDIN only: it is never printed and never appears in argv.

# aegis-subcommands: render entregar shred
# aegis-hidden:  true
# aegis-vps — render | entregar | shred
#
# MAINTAINER's tool for the lab VPS (not the friend's). Three verbs and
# one rule that governs all three: the tunnel's token is NEVER printed,
# never travels through argv (argv is visible in /proc to any process
# on the host), never touches disk outside /dev/shm.
#
#   render          builds the real user-data from the .tpl: token from
#                   the vps-lab env + the operator's public keys →
#                   /dev/shm/aegis-vps.XXXX/user-data.yaml (umask 077).
#                   Prints ONLY the path and the size. It is the owner
#                   of __CF_TUNNEL_TOKEN__ and __SSH_PUBKEY_*__ (check 3).
#   entregar <host> installs/updates the token on a VPS that is already
#                   running: output -raw tunnel_token | ssh <host> 'sudo
#                   cloudflared service install "$(cat)"' — through stdin.
#   shred           destroys the render directories in /dev/shm.
#
# Three outcomes like every command of the house: 0 done, 1 missing/wrong,
# 2 could not evaluate.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WRAPPER="$ROOT/tofu/tofu-apply.sh"
TPL="$ROOT/vps/clouding-lab.cloud-init.yaml.tpl"

die() { printf '%s vps: %s\n' "${AEGIS_CMD:-aegis}" "$*" >&2; exit "${2:-1}"; }

# --help answers BEFORE the wrapper precondition: asking what a command
# does must not require standing inside the live checkout.
AEGIS_ROOT="${AEGIS_ROOT:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}"
usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[[ -x "$WRAPPER" ]] || die "the wrapper $WRAPPER does not exist — are you in the live checkout (platform/)? The vps-lab env and its state live there, not in the seed" 2

read_token() {
    # into a variable, never into a file nor onto the screen. The
    # wrapper's stdout is sacred (H4): this captures the token and
    # nothing else.
    # FROM tofu/: the wrapper demands a RELATIVE -chdir (#46) and tofu
    # resolves it against the cwd — called from anywhere else the env
    # "does not exist" and the token comes out empty (real bug, first
    # delivery 2026-08-23: an empty token travelled all the way to the
    # VPS).
    (cd "$ROOT/tofu" && "$WRAPPER" -chdir=envs/vps-lab output -raw tunnel_token) \
        || die "I could not read tunnel_token from the vps-lab env (apply run? SOPS_AGE_KEY_FILE?)" 2
}

case "${1:-}" in
render)
    for k in ~/.ssh/aegis_vps_rsa.pub ~/.ssh/aegis_vps.pub; do
        [[ -f "$k" ]] || die "the public key $k is missing" 2
    done
    umask 077
    DIR="$(mktemp -d /dev/shm/aegis-vps.XXXX)"
    # the token enters the child process through the ENV (not through
    # argv); python substitutes the three placeholders and writes it in
    # one go.
    CF_TUNNEL_TOKEN="$(read_token)" \
    PUB_RSA="$(cat ~/.ssh/aegis_vps_rsa.pub)" \
    PUB_ED="$(cat ~/.ssh/aegis_vps.pub)" \
    TPL="$TPL" OUT="$DIR/user-data.yaml" python3 - <<'PY'
import os
t = open(os.environ["TPL"]).read()
for ph, env in (("__CF_TUNNEL_TOKEN__", "CF_TUNNEL_TOKEN"),
                ("__SSH_PUBKEY_RSA__", "PUB_RSA"),
                ("__SSH_PUBKEY_ED25519__", "PUB_ED")):
    v = os.environ[env].strip()
    if not v:
        raise SystemExit(f"{os.environ.get('AEGIS_CMD', 'aegis')} vps: {env} is empty")
    if ph not in t:
        raise SystemExit(f"{os.environ.get('AEGIS_CMD', 'aegis')} vps: the tpl has no {ph}")
    t = t.replace(ph, v)
if "__" in "".join(l for l in t.splitlines() if not l.lstrip().startswith("#")):
    raise SystemExit("aegis vps: a placeholder was left alive outside comments")
open(os.environ["OUT"], "w").write(t)
PY
    printf 'done: user-data rendered at %s (%s bytes)\n' \
        "$DIR/user-data.yaml" "$(wc -c < "$DIR/user-data.yaml")"
    printf 'paste it into the Clouding panel and afterwards: %s vps shred\n' "${AEGIS_CMD:-aegis}"
    ;;
entregar)
    HOST="${2:-}"
    [[ -n "$HOST" ]] || die "usage: ${AEGIS_CMD:-aegis} vps entregar <ssh-host>"
    read_token | ssh "$HOST" 'sudo cloudflared service install "$(cat)" && sudo systemctl restart cloudflared' \
        || die "the delivery to $HOST failed — the token was NOT installed"
    printf 'done: token delivered to %s through stdin; cloudflared restarted\n' "$HOST"
    ;;
shred)
    FOUND=0
    for d in /dev/shm/aegis-vps.*; do
        [[ -d "$d" ]] || continue
        FOUND=1
        find "$d" -type f -exec shred -u {} +
        rmdir "$d"
        printf 'done: %s destroyed\n' "$d"
    done
    [[ "$FOUND" == 1 ]] || printf 'already: nothing to destroy in /dev/shm\n'
    ;;
*)
    printf 'usage: %s vps render | entregar <host> | shred\n' "${AEGIS_CMD:-aegis}" >&2
    exit 1
    ;;
esac
