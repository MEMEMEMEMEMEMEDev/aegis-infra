#!/usr/bin/env bash
# aegis-summary: Runs the init leaving a dossier of the whole run
# aegis-group:   setup
# aegis-help:
# Usage: aegis init-log [the same flags as `aegis init`]
#
# Runs `aegis init` under `script`, leaving a dossier of the WHOLE
# run in <instance>/.init-state/runs/<timestamp>-<profile>.log. The
# dossier path is printed BEFORE the run starts, so it is known even
# if the run dies. Every flag is passed through to the init untouched.

#
# Minimal stage C: NO run of the init without a dossier. Today the
# init's stderr is lost with the terminal, and a failure three hours in
# leaves nothing to read. This wrapper wraps the init with script(1):
# it keeps the TTY (the wizard goes on asking) and captures
# stdout+stderr — the init's real rc gets through (-e), not script's.
#
# In v3 this ends up INSIDE the orchestrator (plan/04 §5: run-id,
# meta.json, `aegis runs pack`). This file is the bridge until then.
#
# WHERE the dossier ends up: in the INSTANCE, not in the product. In v2
# it landed in init/.init-logs/ of the repo itself, and a .gitignore
# line was needed so that a distracted `git add` would not version the
# whole run with the host's stderr inside. Now it lives under
# $AEGIS_HOME/.init-state/runs/, which is this machine's state by
# definition: there is nothing to exclude because it is not in the
# product's tree.

set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} init-log: readlink is missing — I cannot guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"

RUNS="$AEGIS_STATE_DIR/runs"
# The dossier carries the WHOLE run, stderr included — whatever any tool
# printed, the tofu wrapper's redaction notwithstanding — so it is born
# 0600 in a 0700 dir whatever the operator's umask. Until 2026-10-14
# script(1) created it under the default umask: 0644 in a 0755 dir,
# readable by every account on the host (review of 2026-10-13, A-9).
# Only the dossier: the init itself runs with the operator's umask, as
# it does without this wrapper. Check 287.
mkdir -p "$RUNS"; chmod 700 "$RUNS"

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
for a in "$@"; do case "$a" in -h|--help) usage; exit 0 ;; esac; done

# the profile only to name the file; if it does not come, it shows.
PROFILE="no-profile"
prev=""
for a in "$@"; do
    [[ "$prev" == "--profile" ]] && PROFILE="$a"
    prev="$a"
done

LOG="$RUNS/$(date -u +%Y%m%dT%H%M%SZ)-$PROFILE.log"
# BEFORE running: if the run hangs or dies in the worst possible way,
# the operator already knows where to read. Printing it at the end is
# printing it only when it is not needed.
printf 'dossier: %s\n' "$LOG"

# script -qefc: -q no banners, -e returns the command's rc, -f flush
# per line (a kill -9 does not take the buffer with it), -c the
# command. printf %q builds the command proof against spaces in the
# args.
CMD="$(printf '%q ' "$AEGIS_ROOT/libexec/aegis-init" "$@")"
( umask 077; : > "$LOG" )   # born 0600: script(1) truncates it and keeps the mode
if script -qefc "$CMD" "$LOG"; then
    printf 'dossier: %s (rc 0)\n' "$LOG"
else
    rc=$?
    printf 'FAILED (rc %s) — the complete dossier, stderr included: %s\n' "$rc" "$LOG" >&2
    exit "$rc"
fi
