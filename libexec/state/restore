#!/usr/bin/env bash
# aegis-summary: Restores the three states from a bundle
# aegis-group:   backup
# aegis state restore — restores the 3 states from a bundle produced by
# `aegis state backup` (W-09 / R4). The exact inverse: it decrypts with the
# private age key (the operator's irreducible) and puts each state back in
# its place. It is the half that makes the premise "the age key recovers
# everything" actually true.
#
# DESTRUCTIVE: it overwrites live state. By default it REFUSES to step on a
# destination that already exists (so as not to break a machine that is
# halfway through); --force enables that explicitly. Without the age key it
# does nothing: the bundle without the key is useless, and that is how it
# should be.
#
# Usage: aegis state restore <bundle.age> [--force]
set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
# The PRODUCT is resolved from this file itself, following symlinks
# (phase 05 installs /usr/local/bin/aegis as a symlink: without
# readlink -f, AEGIS_ROOT would be /usr/local). If bin/aegis already
# exported it, that is respected. The INSTANCE is decided by
# lib/paths.sh, never by this file.
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "aegis state restore: readlink is missing — I will not guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"

STATE_SECRETS="$AEGIS_HOME/.state-secrets"
INIT_STATE="${AEGIS_STATE_DIR:-$AEGIS_HOME/.init-state}"
TUNNEL_ENV="$AEGIS_HOME/platform/tofu/envs/cloudflare-tunnel"

say()  { printf '[restore] %s\n' "$*"; }
die()  { printf '[restore] FATAL: %s\n' "$*" >&2; exit 1; }

# --force is a FLAG, accepted wherever it stands: until 2026-09-20 it
# was read as the second word only, so `restore --force <bundle>` was
# silently a restore without it, refused at the first live directory.
BUNDLE=""; FORCE=0
for _a in "$@"; do
    case "$_a" in
        --force) FORCE=1 ;;
        -*) die "unknown flag $_a (usage: aegis state restore <bundle.age> [--force])" ;;
        *) [[ -z "$BUNDLE" ]] || die "one bundle at a time (got $BUNDLE and $_a)"; BUNDLE="$_a" ;;
    esac
done
[[ -n "$BUNDLE" && -f "$BUNDLE" ]] || die "usage: aegis state restore <bundle.age> [--force]"

KEY="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/aegis.key}"
[[ -f "$KEY" ]] || die "no private age key ($KEY) — it is the irreducible; without it the bundle does not decrypt"

# ── decrypt into a staging dir and show the manifest ─────────────────────
# The staging lives in tmpfs and is SHREDDED on every way out: the bundle
# may carry a plaintext edge state from an instance before #46. Until
# 2026-10-14 it went to `mktemp -d` under /tmp and left with a plain
# rm -rf, only on EXIT (review of 2026-10-13, A-9). Check 286.
umask 077
SHM=/dev/shm; [[ -d "$SHM" && -w "$SHM" ]] || SHM="${TMPDIR:-/tmp}"
TMP="$(mktemp -d "$SHM/aegis-state.XXXXXX")"
stage_cleanup() {
  [[ -n "${TMP:-}" && -d "$TMP" ]] || return 0
  find "$TMP" -type f -exec shred -u {} \;
  rm -rf "$TMP"
}
trap 'stage_cleanup; exit 130' INT TERM
trap 'stage_cleanup' EXIT
PAY="$TMP/payload"; mkdir -p "$PAY"
age -d -i "$KEY" "$BUNDLE" | tar -C "$PAY" -xzf - \
  || die "the bundle does not decrypt/unpack with this key — wrong key, or a corrupt bundle?"
say "the bundle's manifest:"
sed 's/^/    /' "$PAY/MANIFEST.txt" 2>/dev/null || true

# ── place each state, as a separate step, never overwriting without --force
# The bundle stores the CONTENTS under <label>/ (symmetric to collect()).
# The existence guard is the concrete FILE/dir that would indicate live
# state (for tfstate it is NOT the tofu env dir — that one always exists in
# the seed — but the terraform.tfstate itself).
place() {  # place <label> <dest-dir> <guard-path>
  local label="$1" dest="$2" guard="$3"
  local src="$PAY/$label"
  if [[ ! -d "$src" ]]; then say "$label: not in the bundle — skipped"; return 0; fi
  if [[ -e "$guard" && $FORCE -eq 0 ]]; then
    die "$label: $guard ALREADY exists — aborted (use --force to overwrite; I do not break live state blindly)"
  fi
  mkdir -p "$dest"
  cp -a "$src"/. "$dest"/
  say "$label → $dest (restored)"
}
place state-secrets "$STATE_SECRETS" "$STATE_SECRETS"
place init-state    "$INIT_STATE"    "$INIT_STATE"
# The edge's state is the ENCRYPTED copy (2026-10-10), and that one is also
# in git: a clone of the platform repo already brings it. So the guard is
# not «a file is there» —it always is— but «a file is there and SAYS
# SOMETHING ELSE»: the bundle's copy would take the edge back to an older
# state in silence. Identical bytes are not a conflict.
place_tfstate() {
  local src="$PAY/tfstate" f clash=""
  if [[ ! -d "$src" ]]; then say "tfstate: not in the bundle — skipped"; return 0; fi
  for f in "$src"/*; do
    [[ -e "$TUNNEL_ENV/$(basename "$f")" ]] || continue
    cmp -s "$f" "$TUNNEL_ENV/$(basename "$f")" || clash="$clash $(basename "$f")"
  done
  if [[ -n "$clash" && $FORCE -eq 0 ]]; then
    die "tfstate:$clash ALREADY exists in $TUNNEL_ENV with other contents — aborted (use --force to overwrite; I do not break live state blindly)"
  fi
  mkdir -p "$TUNNEL_ENV"
  cp -a "$src"/. "$TUNNEL_ENV"/
  say "tfstate → $TUNNEL_ENV (restored)"
}
place_tfstate

say "restore complete. Next: resume the init if appropriate (aegis init --from <phase>)."
