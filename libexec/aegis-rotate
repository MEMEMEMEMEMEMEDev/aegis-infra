#!/usr/bin/env bash
# aegis-summary: The rotation protocol, made executable
# aegis-group:   infra
# aegis-subcommands: list check run continue
# aegis-rotate — THE ROTATION PROTOCOL, MADE EXECUTABLE.
#
# ── what changed and why ────────────────────────────────────────────
# Until 2026-08-12 this script did ONE step: pull the .enc out of the
# store so that `gen_or_restore` would generate new material instead of
# restoring the old one. That step is the right one and is still the
# heart of everything — without it, "rotating by re-running the phase"
# is a silent no-op, because restore_secret returns rc 0 and the phase
# reuses.
#
# But it ended there. It printed prose pointing at rotation-checklist.md
# and the operator executed by hand: run the phase, sync, withdraw the
# old credential from the third party, and confirm that the platform was
# still alive. Four steps, three of them forgettable, and the last one
# —the only one that tells "I rotated" apart from "I rotated and it
# works"— nobody did.
#
# That is exactly the disease the rest of the stack chases: a signal
# that does not tell "it passed" apart from "it was not evaluated".
# Rotation had it right in the middle.
#
# Now the cycle closes here: menu, confirmation with the BLAST RADIUS in
# plain view, regeneration, sync, VERIFICATION that can fail, and
# withdrawal of the old credential.
#
# ── what this script does NOT reimplement ───────────────────────────
# It is an ORCHESTRATOR. Everything hard was already written and tested:
#   gen_or_restore        lib/secrets.sh   the rotation switch
#   aegis-init --only     aegis-init.sh    runs ONE phase, idempotent
#   add_deploy_key        phase 15         registers on GitHub AND DELETES THE OLD ONE
#   make_repo_webhook     phase 15         PATCH of the HMAC on the live hook
#   _cf_call              phase 15         mints scoped Cloudflare tokens
#   retry_net             lib/common.sh    backoff 5/15/45/90s
#   aegis-registry        libexec/         the whole registry, 10 targets
#   aegis-webhook         libexec/         rewrites the HMAC on every hook
#   aegis-sync            libexec/         pushes the Secret to the cluster
#   aegis-check           libexec/         the routine check
# If any of that changes, it changes over there. Here things are only
# put in order.
#
# ── usage ───────────────────────────────────────────────────────────
#   aegis rotate                       interactive menu
#   aegis rotate list                  inventory, without touching anything
#   aegis rotate check [<name>...]     does the credential WORK? (no rotation)
#   aegis rotate continue              resumes an interrupted batch
#   aegis rotate <name>...             DRY-RUN (compat: as before)
#   aegis rotate --yes <name>...       rotates for real, no menu
#
# It does NOT commit and does NOT push. It leaves the files written and
# coherent and prints the steps. That the commit be given by a person is
# the same decision aegis-registry already took.

set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
# The PRODUCT is resolved from this file itself, following symlinks
# (phase 05 installs /usr/local/bin/aegis as a symlink: without readlink
# -f, AEGIS_ROOT would be /usr/local). If bin/aegis already exported it,
# that is respected. The INSTANCE is decided by lib/paths.sh, never by
# this file.
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} rotate: readlink is missing — I cannot guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"
STATE_SECRETS="$AEGIS_HOME/.state-secrets"
PREVIOUS="$STATE_SECRETS/.previo"
# The commands have lived in the PRODUCT since 02 §1. This line used to
# say "$PLATFORM_DIR/bin", which is where they were in v2 — and with the
# code moved it pointed at a directory that no longer exists: the four
# invocations below would have fallen into a silent «it is not there»,
# which is exactly the failure mode rule 5.1 exists to kill. aegis_exec
# is used, which tells «does not exist» from «could not» from «said no».
PBIN="$AEGIS_ROOT/libexec"
JOURNAL="$AEGIS_HOME/.init-state/rotacion"

# common.sh provides retry_net, log_*, die, mark_done/is_done. It needs
# AEGIS_ROOT, which is already exported above:
# shellcheck source=lib/common.sh
source "$AEGIS_ROOT/lib/common.sh"
# secrets.sh provides secrets_workdir (tmpfs with shred) and
# make_enc_secret (--from-file byte-preserving → mv to the repo →
# encrypt → ROUNDTRIP). Rotating the tunnel writes a Secret to the repo
# and is NOT going to reimplement that order: it is rule A5/A6 turned
# into code, and getting it wrong costs an HMAC.
# shellcheck source=lib/secrets.sh
source "$AEGIS_ROOT/lib/secrets.sh"

CONF="$AEGIS_HOME/aegis.conf"
[[ -f "$CONF" ]] && source "$CONF"
: "${GH_OWNER:=}" "${APP_REPO:=}" "${PLATFORM_REPO:=}" "${ROOT_DOMAIN:=}"

cyan=$'\033[36m'; yellow=$'\033[33m'; red=$'\033[31m'; green=$'\033[32m'
gray=$'\033[90m'; bold=$'\033[1m'; reset=$'\033[0m'
[[ -t 1 ]] || { cyan=""; yellow=""; red=""; green=""; gray=""; bold=""; reset=""; }

# ═══════════════════════════════════════════════════════════════════
#  THE RECIPE TABLE
# ═══════════════════════════════════════════════════════════════════
# ONE entry per credential in the store. Declarative on purpose: the
# alternative —spreading the knowledge through the code— is what left
# the checklist out of date for weeks.
#
# class:
#   normal       invalidate → phase → sync → verify → withdraw
#   delegada     another tool owns it; here it is only invoked
#   irreducible  rotating it breaks things silently; refused with a reason
#   prohibida    rotating it the normal way UNDOES an earlier fix
#
# fields: name|class|phase|app_sync|verifier|third_party|blast_radius
RECIPES=$(cat <<'TABLA'
hmac_argocd|normal|15-third-parties|argocd-secrets|check_hmac_argocd|GitHub|ArgoCD stops finding out about pushes
hmac_jenkins|normal|15-third-parties|jenkins-secrets|check_hmac_jenkins|GitHub|pushes stop building
dk_ops|normal|15-third-parties|argocd-secrets|check_dk_ops|GitHub|ArgoCD cannot read the platform repo
dk_app_ro|normal|15-third-parties|jenkins-secrets|check_dk_app_ro|GitHub|Jenkins cannot clone the app
dk_app_argocd_ro|normal|15-third-parties|argocd-secrets|check_dk_app_argocd|GitHub|ArgoCD cannot read the app's repo
jenkins_admin_pass|normal|50-jenkins|jenkins-secrets|check_jenkins_admin|-|nobody gets into Jenkins
redis_auth|normal|30-argocd|-|check_redis|-|ArgoCD stops answering
cf_api_token|normal|15-third-parties|jenkins-secrets|check_cf_api|Cloudflare|tofu cannot apply the edge
cf_dns_token|normal|15-third-parties|cert-manager-issuers|check_cf_dns|Cloudflare|cert-manager does not renew certificates
cf_access_token|normal|15-third-parties|-|check_cf_access|Cloudflare|tofu cannot manage Access: the operator plane stays as it is
grafana_admin_pass|normal|85-observability|observability-base|check_grafana_admin|-|nobody gets into Grafana with its own login (Access is still in front)
ntfy_bridge_token|normal|85-observability|observability-base|check_ntfy_bridge|-|alerts stop arriving: the bridge cannot publish to ntfy
ntfy_operador_pass|normal|85-observability|observability-base|check_ntfy_operador|phone|the phone app stops reading the alerts until the new credential is reloaded
registry_pass|delegada|-|-|check_registry|-|no pod can pull images
cosign_key|irreducible|-|-|-|-|invalidates ALL signatures already issued
cosign_pass|irreducible|-|-|-|-|invalidates ALL signatures already issued
cosign_pub|irreducible|-|-|-|-|invalidates ALL signatures already issued
TABLA
)

# The tunnel's token does NOT live in the store (tofu produces it, phase
# 25), so it does not show up in the store listing — but it is a
# rotatable platform credential and it has to be in the menu. It is
# declared separately and the inventory joins them.
#
# The two halves of the Access service token DO live in the store, and
# since #88 phase 25 produces them from tofu's outputs — not a hand, as
# was the case until 2026-08-13. They go with class `tofu` because the
# owner is the state, not the store: invalidating the .enc rotates
# nothing.
#
# argocd_admin_pass and argocd_server_secretkey are still `manual`, and
# that is NOT the same thing: they are a declared debt (#86). The right
# thing is for phase 30 to produce them like any other credential. In
# the meantime, a new instance is born with the password the ArgoCD
# installer generates — exactly what #77 found unrotated for eighteen
# days.
RECIPES_EXTRA=$(cat <<'TABLA'
tunnel_token|tofu|25-edge-tofu|-|check_tunnel|Cloudflare|ALL the public hostnames go down
access_st_id|tofu|25-edge-tofu|-|check_access_st|Cloudflare|automation stops crossing Access (it is rotated together with the secret)
access_st_secret|tofu|25-edge-tofu|-|check_access_st|Cloudflare|automation stops crossing Access (it is rotated together with the id)
r2_access_key_id|manual|15-third-parties|-|check_r2_pair|Cloudflare|the backups stop leaving the machine (rotated together with the secret)
r2_secret_access_key|manual|15-third-parties|-|check_r2_pair|Cloudflare|the backups stop leaving the machine (rotated together with the id)
argocd_admin_pass|manual|-|-|check_argocd_admin|-|nobody gets into ArgoCD through the UI
argocd_server_secretkey|manual|-|-|-|-|ALL ArgoCD sessions are closed
TABLA
)

# ── the edge, and the recipes that have no subject on it ────────────
# Three recipes rotate credentials of Cloudflare. With EDGE=local this
# instance has no Cloudflare account: those secrets were never minted
# (phase 15 says so as it skips them) and the store does not hold them.
# Offering to rotate them would be offering to rotate something that
# does not exist, and reporting them as a failure in `--check` would be
# reporting a defect where there is only an edge that does not use them.
#
# It is DERIVED from the table's own «external system» column, not from
# a list of names written here: the day a fourth Cloudflare credential
# appears it is already covered.
edge_of_instance() {
    [[ -f "$CONF" ]] || { printf 'cloudflare\n'; return; }
    local v
    v="$(sed -n 's/^EDGE=["'"'"']\{0,1\}\([a-z]*\).*/\1/p' "$CONF" | head -1)"
    printf '%s\n' "${v:-cloudflare}"
}
recipe_has_subject() {   # <recipe line> → 0 if it applies on this edge
    local third; third="$(printf '%s' "$1" | cut -d'|' -f6)"
    [[ "$third" == "Cloudflare" && "$(edge_of_instance)" == "local" ]] && return 1
    return 0
}

recipe_for() {   # <name> → the line, or empty
    printf '%s\n%s\n' "$RECIPES" "$RECIPES_EXTRA" \
        | awk -F'|' -v n="$1" '$1 == n {print; exit}'
}
field() { printf '%s' "$1" | cut -d'|' -f"$2"; }

# ═══════════════════════════════════════════════════════════════════
#  ANTI-DRIFT: the store and the table have to agree
# ═══════════════════════════════════════════════════════════════════
# An .enc without a recipe is a credential nobody knows how to rotate,
# and it does not warn. It is the same principle as the
# EXCLUSIONES/DELIBERADAS tables of aegis dev seed: an entry that is
# surplus or missing is an ERROR, not a detail. verify-static checks it
# too, statically.
orphans() {
    local n
    for n in $(store_names); do
        [[ -n "$(recipe_for "$n")" ]] || printf '%s\n' "$n"
    done
}
store_names() {
    [[ -d "$STATE_SECRETS" ]] || return 0
    find "$STATE_SECRETS" -maxdepth 1 -name '*.enc' -printf '%f\n' 2>/dev/null \
        | sed 's/\.enc$//' | grep -v '\.pub$' | sort
}

# ═══════════════════════════════════════════════════════════════════
#  NETWORK PREFLIGHT — the cheapest thing that avoids the dearest problem
# ═══════════════════════════════════════════════════════════════════
# This machine runs over WiFi, has its MTU 170 bytes above the real path
# (#69) and restarts k3s during storms (#73). A cut in the middle of a
# batch leaves credentials half synced, which is the most expensive
# state in the whole system to diagnose.
#
# Checking the network BEFORE invalidating the first .enc turns that
# expensive problem into a free one: the rotation does not start. It
# does not cover a cut that begins forty seconds in —nothing covers
# that— but it eliminates the frequent case, which is starting with the
# network already down.
preflight_network() {
    local failures=0 needs_gh="$1" needs_cf="$2"
    printf '%s\n' "${gray}preflight: checking that everything can be reached before touching anything${reset}"

    if kubectl get --raw='/readyz' >/dev/null 2>&1; then
        printf '  %s✓%s the cluster answers\n' "$green" "$reset"
    else
        printf '  %s✗%s the cluster does NOT answer (kubectl get --raw=/readyz)\n' "$red" "$reset"
        failures=$((failures + 1))
    fi

    if [[ "$needs_gh" == "yes" ]]; then
        if gh api rate_limit >/dev/null 2>&1; then
            printf '  %s✓%s GitHub answers and the gh session authenticates\n' "$green" "$reset"
        else
            printf '  %s✗%s GitHub does NOT answer or `gh auth` has expired\n' "$red" "$reset"
            failures=$((failures + 1))
        fi
    fi

    if [[ "$needs_cf" == "yes" ]]; then
        if curl -sf --max-time 10 https://api.cloudflare.com/client/v4/ips \
             >/dev/null 2>&1; then
            printf '  %s✓%s the Cloudflare API answers\n' "$green" "$reset"
        else
            printf '  %s✗%s the Cloudflare API does NOT answer\n' "$red" "$reset"
            failures=$((failures + 1))
        fi
    fi

    # The age key: without it NOTHING in the store gets decrypted or
    # encrypted, and the failure would only show up halfway through.
    local k="${SOPS_AGE_KEY_FILE:-$HOME/.config/sops/age/aegis.key}"
    if [[ -f "$k" ]]; then
        printf '  %s✓%s age key present (%s)\n' "$green" "$reset" "$k"
    else
        printf '  %s✗%s the age key is NOT at %s — sops is going to fail\n' "$red" "$reset" "$k"
        failures=$((failures + 1))
    fi

    (( failures == 0 )) || die "preflight FAILED ($failures) — nothing was invalidated. Fix what is above and come back."
    printf '  %spreflight OK — we can begin%s\n\n' "$green" "$reset"
}

# ═══════════════════════════════════════════════════════════════════
#  CROSSING CLOUDFLARE ACCESS (#76)
# ═══════════════════════════════════════════════════════════════════
# _cf_access_config, curl_access and edge_origin_responds have lived in
# lib/access.sh since #87. They used to be here, defined inline, and
# phase 35 and phase 60 need them just the same: two copies of the same
# knowledge is how the rotation checklist went out of date for weeks.
# shellcheck source=lib/access.sh
source "$AEGIS_ROOT/lib/access.sh"

# ═══════════════════════════════════════════════════════════════════
#  VERIFIERS — each one EXERCISES the real consumer
# ═══════════════════════════════════════════════════════════════════
# Codes, and the difference between 1 and 2 is what makes the retries
# honest:
#   0  verified: the real consumer worked
#   1  negative VERDICT: the remote answered, and it answered no.
#      It is NOT retried — retrying is doing the wrong thing three
#      times.
#   2  TRANSPORT: it could not be reached. Retryable with retry_net.
#   3  NOT VERIFIABLE: there is no tooth written for this. It is
#      reported LOUDLY and does NOT count as green. We prefer "I did not
#      measure" to a green that does not distinguish.

check_hmac_jenkins() {
    [[ -x "$PBIN/aegis-webhook" ]] || return 3
    # The double tooth of checklist §6: a ping has to give 200 AND a
    # made-up signature has to give 400. Without the second, the 200 is
    # not saying anything — it could be accepting anything at all.
    local hooks id rc=0
    hooks="$(retry_net 3 gh api "repos/$GH_OWNER/$APP_REPO/hooks" 2>/dev/null)" || return 2
    id="$(printf '%s' "$hooks" | python3 -c '
import json,sys
h=json.load(sys.stdin)
print(next((x["id"] for x in h if "jenkins" in x.get("config",{}).get("url","")), ""))' 2>/dev/null)"
    [[ -n "$id" ]] || { log_warn "I did not find the Jenkins hook in $APP_REPO"; return 3; }
    retry_net 3 gh api -X POST "repos/$GH_OWNER/$APP_REPO/hooks/$id/pings" >/dev/null 2>&1 || return 2
    sleep 6
    local last
    last="$(gh api "repos/$GH_OWNER/$APP_REPO/hooks/$id/deliveries" 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["status_code"] if d else "")' 2>/dev/null)" || return 2
    if [[ "$last" == "200" ]]; then
        printf '    %swebhook ping → 200%s\n' "$gray" "$reset"
        rc=0
    else
        log_error "the ping of the Jenkins webhook gave '$last', not 200"
        rc=1
    fi
    return $rc
}

check_hmac_argocd() {
    # The same tooth against the platform repo.
    local hooks id
    hooks="$(retry_net 3 gh api "repos/$GH_OWNER/$PLATFORM_REPO/hooks" 2>/dev/null)" || return 2
    id="$(printf '%s' "$hooks" | python3 -c '
import json,sys
h=json.load(sys.stdin)
print(next((x["id"] for x in h if "argocd" in x.get("config",{}).get("url","")), ""))' 2>/dev/null)"
    [[ -n "$id" ]] || { log_warn "I did not find the ArgoCD hook in $PLATFORM_REPO"; return 3; }
    retry_net 3 gh api -X POST "repos/$GH_OWNER/$PLATFORM_REPO/hooks/$id/pings" >/dev/null 2>&1 || return 2
    sleep 6
    local last
    last="$(gh api "repos/$GH_OWNER/$PLATFORM_REPO/hooks/$id/deliveries" 2>/dev/null \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d[0]["status_code"] if d else "")' 2>/dev/null)" || return 2
    [[ "$last" == "200" ]] || { log_error "the ping of the ArgoCD webhook gave '$last', not 200"; return 1; }
    printf '    %swebhook ping → 200%s\n' "$gray" "$reset"
}

# _ssh_from_secret <ns> <secret> <repo> — the deploy keys' tooth: it uses
# the key from the LIVE Secret (not the store's, not the repo's) against
# the real GitHub. It is the only way of knowing that the material the
# consumer is holding authenticates.
_ssh_from_secret() {
    local ns="$1" secret="$2" repo="$3" k rc=0
    # ArgoCD keeps the private key in `sshPrivateKey`; Jenkins, in
    # `privateKey`. They are each consumer's conventions, not an
    # oversight. This verifier only looked at ArgoCD's, so against a
    # Jenkins Secret it gave "could not read" — a false TRANSPORT
    # failure, which was also retried three times before lying. Caught
    # on 2026-08-12 by mapping which key each consumer uses, before
    # running it.
    local field
    k="$(mktemp /dev/shm/aegis-verif.XXXXXX)"; chmod 600 "$k"
    for field in sshPrivateKey privateKey; do
        kubectl -n "$ns" get secret "$secret" \
            -o jsonpath="{.data.$field}" 2>/dev/null | base64 -d > "$k" 2>/dev/null
        [[ -s "$k" ]] && break
    done
    if [[ ! -s "$k" ]]; then
        rm -f "$k"
        log_warn "I did not find a private key in $ns/$secret (neither sshPrivateKey nor privateKey)"
        return 2
    fi
    local output
    output="$(GIT_SSH_COMMAND="ssh -i $k -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
        git ls-remote "git@github.com:$GH_OWNER/$repo.git" HEAD 2>&1)" || rc=$?
    rm -f "$k"
    if (( rc == 0 )); then
        printf '    %sthe key of %s/%s authenticates against %s%s\n' "$gray" "$ns" "$secret" "$repo" "$reset"
        return 0
    fi
    # Permission denied = verdict (the key does not work). Anything else
    # = probably transport. The distinction is what keeps the retry from
    # repeating a real failure.
    if printf '%s' "$output" | grep -qiE 'permission denied|publickey'; then
        log_error "GitHub rejected the key of $ns/$secret (Permission denied)"
        return 1
    fi
    log_warn "could not reach GitHub while verifying $ns/$secret: $(printf '%s' "$output" | head -1)"
    return 2
}

# One per consumer: each key is verified against the Secret THAT
# consumer really reads. A shared verifier would not say which of the
# two broke.
check_dk_ops()        { _ssh_from_secret argocd         ops-stack-repo   "$PLATFORM_REPO"; }
check_dk_app_ro()     { _ssh_from_secret jenkins-system hello-aegis-repo "$APP_REPO"; }
check_dk_app_argocd() { _ssh_from_secret argocd         hello-aegis-repo "$APP_REPO"; }

check_jenkins_admin() {
    # The checklist has been dragging "(NOT VERIFIED)" along in item 11
    # since it was written: nobody checked whether the chart re-reads
    # existingSecret or demands a restart. This tooth settles it the
    # first time it is run — it attempts a REAL login with the
    # credential from the live Secret.
    # The Secret's keys are `username`/`password` (phase 50, line 28),
    # not `jenkins-admin-user`/`jenkins-admin-password` as the Jenkins
    # chart names them. I guessed the chart's names instead of reading
    # the phase, and the result was a login with an EMPTY user → 401,
    # that is, «the consumer rejects it» over a healthy credential.
    local u p rc=0
    u="$(kubectl -n jenkins-system get secret jenkins-admin -o jsonpath='{.data.username}' 2>/dev/null | base64 -d)" || return 2
    [[ -n "$u" ]] || { log_warn "jenkins-admin without 'username' — did the shape of the Secret change?"; return 3; }
    p="$(mktemp /dev/shm/aegis-verif.XXXXXX)"; chmod 600 "$p"
    kubectl -n jenkins-system get secret jenkins-admin \
        -o jsonpath='{.data.password}' 2>/dev/null | base64 -d > "$p" || { rm -f "$p"; return 2; }
    [[ -s "$p" ]] || { rm -f "$p"; log_warn "jenkins-admin without 'password'"; return 3; }
    local code
    # --netrc-file: the password NEVER through argv (A27).
    printf 'machine jenkins.%s login %s password %s\n' "$ROOT_DOMAIN" "$u" "$(cat "$p")" > "$p.netrc"
    chmod 600 "$p.netrc"
    code="$(curl_access -s -o /dev/null -w '%{http_code}' --max-time 25 \
        --netrc-file "$p.netrc" "https://jenkins.$ROOT_DOMAIN/api/json" 2>/dev/null)" || rc=2
    rm -f "$p" "$p.netrc"
    (( rc == 0 )) || return 2
    case "$code" in
        200) printf '    %slogin to Jenkins with the new credential → 200%s\n' "$gray" "$reset"
             printf '    %s(settles the "(NOT VERIFIED)" of item 11: the chart re-reads without a restart)%s\n' "$gray" "$reset"
             return 0 ;;
        401|403) log_error "Jenkins rejected the new credential (HTTP $code) — does the statefulset need a restart?"
             return 1 ;;
        000) return 2 ;;
        *)   log_error "Jenkins answered HTTP $code while verifying the login"; return 1 ;;
    esac
}

check_redis() {
    # redis_auth has no third party: the tooth is that ArgoCD keeps
    # working. An out-of-sync auth leaves the repo-server without a
    # cache and the Apps stop reconciling.
    kubectl -n argocd rollout status deploy/argocd-repo-server --timeout=90s >/dev/null 2>&1 || return 2
    local bad_ones
    bad_ones="$(kubectl get applications -n argocd --no-headers \
        -o custom-columns='N:.metadata.name,H:.status.health.status' 2>/dev/null \
        | awk '$2 == "Degraded" {print $1}' | tr '\n' ' ')" || return 2
    if [[ -n "${bad_ones// /}" ]]; then
        log_error "after rotating redis_auth there are Degraded Apps: $bad_ones"
        return 1
    fi
    printf '    %sArgoCD answers and no App was left Degraded%s\n' "$gray" "$reset"
}

check_cf_api() {
    # The real consumer of the API token is tofu. A clean plan is the
    # proof that the new token has the permissions that are needed.
    [[ -x "$PLATFORM_DIR/tofu/tofu-apply.sh" ]] || return 3
    local rc=0
    # TWO bugs this verifier had on its first run, and both gave the
    # SAME symptom —«the consumer rejects it»— over a token that worked
    # perfectly:
    #
    #  1. `-chdir=envs/cloudflare-tunnel` is RELATIVE, and the verifier
    #     runs from wherever the operator is standing, not from tofu/.
    #     The subshell with cd anchors it.
    #  2. `local rc=$?` AFTER an `if` does not read the command's
    #     status: an `if` whose condition fails and that has no else
    #     returns 0. Which means that -detailed-exitcode's code 2
    #     («there are changes, the token DOES work») could never be told
    #     apart from 1 («it really failed»), and everything ended in the
    #     return 1 below.
    #
    # A verifier that goes red over something healthy is worse than not
    # having one: it trains people not to believe it.
    # retry_net is NO USE here (this verifier's third bug, same symptom
    # as the two above): -detailed-exitcode returns 2 as a VERDICT
    # («there are changes — the token WORKS») and retry_net treats
    # everything non-zero as a failure: it retried three times and
    # returned it flattened to 1. That is how the false «the consumer
    # REJECTS it» of 2026-08-21 was born. Only the 1 (a real failure,
    # perhaps the network) deserves a retry; 0 and 2 are answers:
    local _attempt
    for _attempt in 1 2 3; do
        rc=0
        ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh \
            -chdir=envs/cloudflare-tunnel plan -detailed-exitcode ) >/dev/null 2>&1 || rc=$?
        (( rc == 1 )) || break
        (( _attempt < 3 )) && sleep 5
    done
    case $rc in
      0) printf '    %stofu plan clean with the token: no changes%s\n' "$gray" "$reset"; return 0 ;;
      2) log_warn "tofu plan worked but reports pending changes — the token WORKS (the drift is another matter)"
         return 0 ;;
      *) log_error "tofu plan failed with the token (exit $rc)"; return 1 ;;
    esac
}

check_cf_dns() {
    # cert-manager uses the DNS token for the DNS-01 challenge. The
    # tooth is a certificate that is genuinely Ready.
    local bad_ones
    bad_ones="$(kubectl get certificates -A --no-headers \
        -o custom-columns='NS:.metadata.namespace,N:.metadata.name,R:.status.conditions[0].status' 2>/dev/null \
        | awk '$3 != "True" {print $1"/"$2}' | tr '\n' ' ')" || return 2
    if [[ -n "${bad_ones// /}" ]]; then
        log_error "certificates that are not Ready after rotating the DNS token: $bad_ones"
        return 1
    fi
    printf '    %sall the certificates are still Ready%s\n' "$gray" "$reset"
}

# ── the negative teeth: the wrong credential is MANUFACTURED ─────────
# Three of the verifiers below prove that a service REJECTS a credential
# that is not the good one. Until 2026-08-29 that wrong credential was a
# LITERAL in this file: one password written out three times, once inside
# a JSON body and twice as the base64 of a Basic header.
#
# It opened nothing — the forensics of that morning compared it by sha256
# against the whole encrypted store and it matched no entry — but that is
# not the point. A public repository that carries anything
# credential-SHAPED costs an automated alert and then a morning spent
# proving a negative, and the next reader has no way of telling this one
# apart from a leak that is real. The literal was also the thing that
# needed a `gitleaks:allow` marker at the end of a continued line, and
# that marker is what broke all three calls (see the note in
# check_argocd_admin). A tree with zero literals needs no argument and no
# marker.
#
# So the wrong password is MINTED: 32 bytes out of /dev/urandom, which
# have never been anybody's credential and are gone when the verifier
# returns. It cannot collide with the real one — that is 256 bits — and
# it cannot be mistaken for a secret by a scanner, because it is not in
# the file at all.
#
# HEX, and the reason is not cosmetic: the same value has to survive TWO
# formats. A netrc field ends at the first whitespace, and a JSON string
# has to escape a quote and a backslash. base64's alphabet carries `+`,
# `/` and the padding `=`, and a random draw produces them rarely enough
# that the shape bug would show up weeks later, on somebody else's
# instance. Hex has sixteen characters and none of them is special in
# either format; 32 bytes still come out as 64 of them, which is longer
# than any password this platform issues.
#
# `od` and not openssl/base64: coreutils is the one dependency a verifier
# can assume on a host where the userland install may be what is being
# diagnosed.
#
# It travels through a FILE and never through argv, exactly like the real
# credential beside it. Not because a thrown-away password needs hiding,
# but because rule A27 (check 075) is uniform on purpose: whoever audits
# a curl in this tree must not have to work out which of its arguments
# were the safe ones.
# IT REPORTS ITS OWN FAILURE, and the reason is a trap this file is
# already standing in. Both callers of a check_* function invoke it as
# `"$fn" || rc=$?`, and an AND-OR list SUSPENDS errexit for everything
# inside the call — measured, not assumed: a `false` inside a function
# inside a function called that way does not stop the script. So a mint
# that failed (a full /dev/shm, a missing od) would NOT abort here: it
# would leave the file EMPTY, the netrc or the JSON body would carry an
# empty password, the service would answer 401 to it exactly as it does
# to a random one, and the negative tooth would come out GREEN having
# measured nothing. That is the failure this stack exists to refuse —
# the one that looks like a pass. Returning 1 lets the caller answer
# COULD NOT EVALUATE (2), which is the honest verdict, and lets it clean
# up the tmpfs files that DO hold the real credential.
_wrong_password() {          # <path> — mints it and leaves it at 600
    local f="$1"
    : > "$f" || return 1
    chmod 600 "$f" || return 1
    od -An -tx1 -N32 /dev/urandom | tr -d ' \n' > "$f" || return 1
    [[ -s "$f" ]] || return 1     # an empty draw is the silent case above
}

check_argocd_admin() {
    # The double tooth: the store's password has to GET IN (200) and a
    # made-up one has to be REJECTED (401). Without the second, an
    # ArgoCD that accepted anything would come out green all the same.
    local p code_ok code_bad
    p="$(mktemp /dev/shm/aegis-verif.XXXXXX)"; chmod 600 "$p"
    sops -d --input-type binary --output-type binary \
        "$STATE_SECRETS/argocd_admin_pass.enc" > "$p" 2>/dev/null || { rm -f "$p"; return 2; }
    [[ -s "$p" ]] || { rm -f "$p"; return 3; }
    python3 -c 'import json,sys; print(json.dumps({"username":"admin","password":open(sys.argv[1]).read().strip()}))' \
        "$p" > "$p.body"; chmod 600 "$p.body"
    code_ok="$(curl_access -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
        --max-time 30 -d @"$p.body" "https://argocd.$ROOT_DOMAIN/api/v1/session" 2>/dev/null)"
    # The negative tooth: the SAME request with a manufactured password,
    # so that the only difference between the two is the password itself.
    # The body is built by the same one-liner as the positive — a JSON
    # assembled by hand here is a second way of writing the same thing,
    # and the two would drift.
    #
    # THIS CALL WAS DEAD between 2026-08-29 03:xx and this commit, and
    # only reading it out loud found it: the line above ended in `\` and
    # two spaces before the `gitleaks:allow` marker, which bash reads as
    # an escaped space and NOT as a continuation, so the `#` opened a
    # comment and the URL on the next line became a command of its own.
    # curl ran with no URL, code_bad came back empty, and the verifier
    # would have reported "false password -> (expected 401)" over a
    # perfectly healthy ArgoCD. A marker that has to be appended to code
    # is a marker that can break the code; not needing one is the fix.
    _wrong_password "$p.bad" || { rm -f "$p" "$p.body" "$p.bad"; return 2; }
    python3 -c 'import json,sys; print(json.dumps({"username":"admin","password":open(sys.argv[1]).read().strip()}))' \
        "$p.bad" > "$p.bad-body"; chmod 600 "$p.bad-body"
    code_bad="$(curl_access -s -o /dev/null -w '%{http_code}' -X POST -H 'Content-Type: application/json' \
        --max-time 30 -d @"$p.bad-body" "https://argocd.$ROOT_DOMAIN/api/v1/session" 2>/dev/null)"
    rm -f "$p" "$p.body" "$p.bad" "$p.bad-body"
    [[ "$code_ok" == "000" || "$code_bad" == "000" ]] && return 2
    if [[ "$code_ok" == "200" && "$code_bad" == "401" ]]; then
        printf '    %sthe store password gets in (200) and a false one is rejected (401)%s\n' "$gray" "$reset"
        return 0
    fi
    log_error "ArgoCD: good password → $code_ok (expected 200), false password → $code_bad (expected 401)"
    return 1
}

check_r2_pair() {
    # The pair that carries the backups off this machine. It is checked
    # by ASKING THE DESTINATION, not by looking at the store: a pair
    # that is present and no longer opens the bucket is exactly the
    # failure this whole lane exists to prevent — an off-site copy that
    # exists on paper and fails on the day it is needed.
    #
    # `remote status` reaches R2 and reports the ages. Its rc 2 is a
    # destination that could NOT be reached, which is NOT a destination
    # with a dead credential: reporting them alike sends the operator to
    # mint a token when the problem is a network.
    local rc=0
    "${AEGIS_CMD:-aegis}" data remote status >/dev/null 2>&1 || rc=$?
    case "$rc" in
        0) return 0 ;;
        2) log_warn "the R2 destination did not answer: the pair is NOT proved dead, it is unproved"; return 3 ;;
        *) log_error "the stored pair no longer opens the backups bucket"; return 1 ;;
    esac
}

# WHY `manual` AND NOT `normal`: rotating this pair is not generating a
# new value here. The secret half is the sha256 of a Cloudflare token's
# VALUE, and Cloudflare shows that value once, at creation. So a
# rotation means minting a new scoped token with the master credential
# — which the instance deliberately does not keep — and adopting the
# derived pair. `aegis init --from 15-third-parties` is that procedure,
# and it already refuses to store a pair the destination rejects.
check_cf_access() {
    # The consumer of the Access token is tofu. That the env's `plan`
    # runs clean proves that the token can still READ the 4
    # applications; if it had lost permissions, tofu would see them as
    # «to add» again.
    [[ -x "$PLATFORM_DIR/tofu/tofu-apply.sh" ]] || return 3
    local output rc=0
    output="$( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh \
        -chdir=envs/cloudflare-tunnel plan -no-color 2>&1 )" || rc=$?
    (( rc == 0 )) || { log_error "tofu plan failed with the Access token (exit $rc)"; return 1; }
    if printf '%s' "$output" | grep -qE 'module\.access\..* will be created'; then
        log_error "tofu wants to RE-CREATE Access resources: either they were deleted from the panel, or the token stopped seeing them, or the STATE went stale (an apply whose re-encrypted enc.json nobody committed? — seen 2026-08-21)"
        return 1
    fi
    printf '    %sthe 4 Access applications are still in the state and the token sees them%s\n' "$gray" "$reset"
}

# check_access_st — the service token, with BOTH teeth (#87).
#
# The first tooth on its own proves nothing: if Access were down or the
# policies deleted, EVERYBODY would reach the origin and this verifier
# would be just as green. It would be Disease E all over again, this
# time over the very thing Access exists to prevent. That is why the
# second tooth is NEGATIVE: without the token, Access has to intercept.
check_access_st() {
    [[ -n "$ROOT_DOMAIN" ]] || return 3
    [[ -f "$STATE_SECRETS/access_st_id.enc" && \
       -f "$STATE_SECRETS/access_st_secret.enc" ]] || {
        log_error "there is no service token in the store (access_st_id/_secret)"
        return 1; }
    local url="https://argocd.$ROOT_DOMAIN"

    # TOOTH 1 — WITH the token the ORIGIN is reached.
    local rc=0
    edge_origin_responds "$url" '^(200|404)$' || rc=$?
    case $rc in
      0) ;;
      2) return 2 ;;
      *) log_error "the store's service token does NOT cross Access"; return 1 ;;
    esac

    # TOOTH 2 — WITHOUT the token, Access intercepts. A bare curl on
    # purpose: not curl_access.
    local out loc
    out="$(curl -sS -m 20 -o /dev/null -w '%{http_code} %{redirect_url}' \
        "$url" 2>/dev/null)" || return 2
    loc="${out#* }"
    if [[ "$loc" != *cloudflareaccess.com* ]]; then
        log_error "WITHOUT a service token the origin is reached TOO: Access is not protecting $url"
        return 1
    fi
    printf '    %swith token → ORIGIN; without token → Access intercepts%s\n' "$gray" "$reset"
}

# ── the three observability credentials (phase 85) ──────────────────
# They go LITERAL, one function per credential and NOT a loop nor a
# shared verifier: check 89 extracts the names by parsing the table, and
# dispatch by NAME (not by class) is the precedent that closed the
# Access service token — a generic "rotate the 85 stuff" would make
# tomorrow's new credential rotate the wrong one in silence. Rotating
# them re-runs `--only 85-observability`, which converges over a live
# instance (the ntfy hashes are re-derived and REPLACED when the store's
# password no longer verifies — without that the rotation would be a
# silent no-op).

check_grafana_admin() {
    # The double tooth (check_argocd_admin's pattern): the credential
    # from the LIVE Secret has to GET IN (200) and a made-up one has to
    # be REJECTED (401). It goes through the public hostname crossing
    # Access (curl_access): it is the path the real operator uses.
    local u p code_ok code_bad rc=0
    u="$(kubectl -n observability get secret grafana-admin \
        -o jsonpath='{.data.admin-user}' 2>/dev/null | base64 -d)" || return 2
    [[ -n "$u" ]] || { log_warn "grafana-admin without 'admin-user' — did the shape of the Secret change?"; return 3; }
    p="$(mktemp /dev/shm/aegis-verif.XXXXXX)"; chmod 600 "$p"
    kubectl -n observability get secret grafana-admin \
        -o jsonpath='{.data.admin-password}' 2>/dev/null | base64 -d > "$p" \
        || { rm -f "$p"; return 2; }
    [[ -s "$p" ]] || { rm -f "$p"; log_warn "grafana-admin without 'admin-password'"; return 3; }
    # --netrc-file: the password NEVER through argv (A27).
    printf 'machine grafana.%s login %s password %s\n' \
        "$ROOT_DOMAIN" "$u" "$(cat "$p")" > "$p.netrc"
    chmod 600 "$p.netrc"
    code_ok="$(curl_access -s -o /dev/null -w '%{http_code}' --max-time 25 \
        --netrc-file "$p.netrc" "https://grafana.$ROOT_DOMAIN/api/user" 2>/dev/null)" || rc=2
    # The negative: the same request with a manufactured password. A
    # second netrc and NOT a hand-built Basic header, for two reasons —
    # the two requests then differ only in the password (the header was
    # a second implementation of the same authentication), and nothing
    # credential-shaped is written down here. The broken continuation
    # described in check_argocd_admin was in this line too, so this call
    # was reaching curl with no URL either.
    _wrong_password "$p.bad" || { rm -f "$p" "$p.netrc" "$p.bad"; return 2; }
    printf 'machine grafana.%s login %s password %s\n' \
        "$ROOT_DOMAIN" "$u" "$(cat "$p.bad")" > "$p.bad-netrc"
    chmod 600 "$p.bad-netrc"
    code_bad="$(curl_access -s -o /dev/null -w '%{http_code}' --max-time 25 \
        --netrc-file "$p.bad-netrc" "https://grafana.$ROOT_DOMAIN/api/user" 2>/dev/null)" || rc=2
    rm -f "$p" "$p.netrc" "$p.bad" "$p.bad-netrc"
    (( rc == 0 )) || return 2
    [[ "$code_ok" == "000" || "$code_bad" == "000" ]] && return 2
    if [[ "$code_ok" == "200" && "$code_bad" == "401" ]]; then
        printf '    %sthe Secret credential gets in (200) and a false one is rejected (401)%s\n' "$gray" "$reset"
        return 0
    fi
    log_error "Grafana: good credential → $code_ok (expected 200), false one → $code_bad (expected 401)"
    return 1
}

check_ntfy_bridge() {
    # The real consumer is the bridge PUBLISHING to the topic. The
    # double tooth: with the credential from the live Secret it
    # publishes (200) and without a credential it is rejected (403,
    # deny-all). The positive sends a REAL message to the phone — it is
    # the price of measuring the channel for real, and it says it is a
    # test.
    local p code_ok code_anon
    p="$(mktemp /dev/shm/aegis-verif.XXXXXX)"; chmod 600 "$p"
    # the credential lives INSIDE the Secret's scfg (key `config`):
    kubectl -n observability get secret ntfy-bridge-token \
        -o jsonpath='{.data.config}' 2>/dev/null | base64 -d \
        | awk '$1 == "password" {print $2; exit}' | tr -d '\n' > "$p" \
        || { rm -f "$p"; return 2; }
    [[ -s "$p" ]] || { rm -f "$p"; log_warn "ntfy-bridge-token without a 'password' line in the scfg — did the contract of ntfy-bridge.yaml change?"; return 3; }
    printf 'machine ntfy.%s login puente password %s\n' \
        "$ROOT_DOMAIN" "$(cat "$p")" > "$p.netrc"
    chmod 600 "$p.netrc"
    code_ok="$(curl -s -o /dev/null -w '%{http_code}' --max-time 25 \
        --netrc-file "$p.netrc" \
        -d 'bridge rotation test (aegis-rotate check_ntfy_bridge)' \
        "https://ntfy.$ROOT_DOMAIN/aegis-alertas" 2>/dev/null)"
    code_anon="$(curl -s -o /dev/null -w '%{http_code}' --max-time 25 \
        -d 'anonymous test (must be rejected)' \
        "https://ntfy.$ROOT_DOMAIN/aegis-alertas" 2>/dev/null)"
    rm -f "$p" "$p.netrc"
    [[ "$code_ok" == "000" || "$code_anon" == "000" ]] && return 2
    if [[ "$code_ok" == "200" && "$code_anon" == "403" ]]; then
        printf '    %sthe bridge publishes (200) and the anonymous one is rejected (403 — deny-all alive)%s\n' "$gray" "$reset"
        return 0
    fi
    log_error "ntfy: publishing with the bridge credential → $code_ok (expected 200), without a credential → $code_anon (expected 403)"
    return 1
}

check_ntfy_operador() {
    # The consumer is the phone app; its measurable equivalent is
    # READING the topic with the store's credential (only the hash lives
    # in the cluster). Double tooth: the store's one reads (200) and a
    # made-up one is rejected (401/403).
    local p code_ok code_bad
    [[ -f "$STATE_SECRETS/ntfy_operador_pass.enc" ]] || {
        log_error "there is no ntfy_operador_pass in the store"; return 1; }
    p="$(mktemp /dev/shm/aegis-verif.XXXXXX)"; chmod 600 "$p"
    sops -d --input-type binary --output-type binary \
        "$STATE_SECRETS/ntfy_operador_pass.enc" > "$p" 2>/dev/null \
        || { rm -f "$p"; return 2; }
    [[ -s "$p" ]] || { rm -f "$p"; return 3; }
    printf 'machine ntfy.%s login operador password %s\n' \
        "$ROOT_DOMAIN" "$(cat "$p")" > "$p.netrc"
    chmod 600 "$p.netrc"
    code_ok="$(curl -s -o /dev/null -w '%{http_code}' --max-time 25 \
        --netrc-file "$p.netrc" \
        "https://ntfy.$ROOT_DOMAIN/aegis-alertas/json?poll=1" 2>/dev/null)"
    # The negative: the same read with a manufactured password, through a
    # second netrc so that the two requests differ only in the password.
    # ntfy answers 401 to a login that does not verify and 403 to a
    # request with no credential at all, which is why the acceptance
    # below takes either — the value here produces the first one.
    # This line carried the same broken continuation as the other two.
    _wrong_password "$p.bad" || { rm -f "$p" "$p.netrc" "$p.bad"; return 2; }
    printf 'machine ntfy.%s login operador password %s\n' \
        "$ROOT_DOMAIN" "$(cat "$p.bad")" > "$p.bad-netrc"
    chmod 600 "$p.bad-netrc"
    code_bad="$(curl -s -o /dev/null -w '%{http_code}' --max-time 25 \
        --netrc-file "$p.bad-netrc" \
        "https://ntfy.$ROOT_DOMAIN/aegis-alertas/json?poll=1" 2>/dev/null)"
    rm -f "$p" "$p.netrc" "$p.bad" "$p.bad-netrc"
    [[ "$code_ok" == "000" || "$code_bad" == "000" ]] && return 2
    if [[ "$code_ok" == "200" && "$code_bad" =~ ^40[13]$ ]]; then
        printf '    %sthe store credential reads the topic (200) and a false one is rejected (%s)%s\n' "$gray" "$code_bad" "$reset"
        printf '    %sremember to reload the NEW password in the phone app (that is why the third party is «phone»)%s\n' "$yellow" "$reset"
        return 0
    fi
    log_error "ntfy: reading with the operator credential → $code_ok (expected 200), false one → $code_bad (expected 401/403)"
    return 1
}

check_registry() {
    [[ -x "$PBIN/aegis-registry" ]] || return 3
    if aegis_exec registry check >/dev/null 2>&1; then
        printf '    %s%s registry check: the targets are aligned%s\n' "$gray" "${AEGIS_CMD:-aegis}" "$reset"
        return 0
    fi
    log_error "${AEGIS_CMD:-aegis} registry check says the targets are NOT aligned"
    return 1
}

# ── the tunnel: compared against a BEFORE, not against baked-in codes ─
# The hostnames do not all return the same thing (jenkins gives 403
# without a session, the front ends give 200) and baking that list in
# leaves it stale at the first change — it is exactly error C15, "a
# check tied to a PLACE lies as soon as something moves". So the tooth
# is: whatever was answering before has to keep answering the same.
HOSTNAMES_BEFORE=""
snapshot_hostnames() {
    local h out=""
    for h in $(public_hostnames); do
        out+="$h=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 "https://$h/" 2>/dev/null) "
    done
    printf '%s' "$out"
}
public_hostnames() {
    local m="$PLATFORM_DIR/tofu/envs/cloudflare-tunnel/main.tf"
    [[ -f "$m" ]] || return 0
    grep -oE 'public_hostnames *= *\[[^]]*\]' "$m" \
        | grep -oE '"[a-z0-9-]+"' | tr -d '"' \
        | while read -r s; do printf '%s.%s\n' "$s" "$ROOT_DOMAIN"; done
}
check_tunnel() {
    [[ -n "$HOSTNAMES_BEFORE" ]] || { log_warn "there is no previous snapshot of the hostnames"; return 3; }
    local after; after="$(snapshot_hostnames)"
    local pair name before now diff=0
    for pair in $HOSTNAMES_BEFORE; do
        name="${pair%%=*}"; before="${pair##*=}"
        now="$(printf '%s' "$after" | tr ' ' '\n' | awk -F= -v n="$name" '$1==n {print $2}')"
        if [[ "$before" == "$now" ]]; then
            printf '    %s%-34s %s (same as before)%s\n' "$gray" "$name" "$now" "$reset"
        else
            printf '    %s%-34s %s → %s%s\n' "$red" "$name" "$before" "$now" "$reset"
            diff=$((diff + 1))
        fi
    done
    (( diff == 0 )) || { log_error "$diff hostname(s) changed behaviour after rotating the tunnel"; return 1; }
    printf '    %sthe %s hostnames answer the same as before rotating%s\n' \
        "$gray" "$(printf '%s' "$HOSTNAMES_BEFORE" | wc -w)" "$reset"
}

# ═══════════════════════════════════════════════════════════════════
#  THE REPORT OF THE FOUR PLACES
# ═══════════════════════════════════════════════════════════════════
# When the verification fails there is NO automatic rollback. By the
# time it failed, the third party ALREADY has the new credential
# (add_deploy_key deleted the old one, make_repo_webhook did the PATCH);
# restoring the store's .enc would leave the store with the old one and
# GitHub with the new one — which is exactly the desynchronisation all
# of this exists to avoid.
#
# What is useful is to say where each half ended up, so that the repair
# is one command and not an investigation.
four_places_report() {   # <name> <app_sync> <third_party>
    local n="$1" app="$2" third="$3"
    printf '\n%s  ┌─ where each copy of %s ended up%s\n' "$yellow" "$n" "$reset"
    printf '%s  │%s\n' "$yellow" "$reset"
    printf '%s  │%s  store     %sNEW%s     (the previous one is in %s)\n' \
        "$yellow" "$reset" "$green" "$reset" "$PREVIOUS/$n.enc"
    printf '%s  │%s  git       %sNEW%s     uncommitted — review it with: git -C platform status\n' \
        "$yellow" "$reset" "$green" "$reset"
    if [[ "$third" != "-" ]]; then
        printf '%s  │%s  %-9s %sNEW%s     the phase already synced and WITHDREW the old one\n' \
            "$yellow" "$reset" "$third" "$green" "$reset"
    fi
    if [[ "$app" != "-" ]]; then
        printf '%s  │%s  cluster   %s??%s      this is the one that usually lags. Close it with:\n' \
            "$yellow" "$reset" "$red" "$reset"
        printf '%s  │%s              cd platform && git add -A && git commit && git push\n' "$yellow" "$reset"
        printf '%s  │%s              %s sync %s\n' "$yellow" "$reset" "${AEGIS_CMD:-aegis}" "$app"
    else
        printf '%s  │%s  cluster   %s??%s      this credential does not go through GitOps — see phase %s\n' \
            "$yellow" "$reset" "$red" "$reset" "$n"
    fi
    printf '%s  └─ and run again: %s rotate continue%s\n\n' "$yellow" "${AEGIS_CMD:-aegis}" "$reset"
}

# ═══════════════════════════════════════════════════════════════════
#  THE FIVE PARTS OF A ROTATION
# ═══════════════════════════════════════════════════════════════════

archive_and_invalidate() {   # <name>
    local n="$1" enc="$STATE_SECRETS/$n.enc"
    mkdir -p "$PREVIOUS"; chmod 700 "$PREVIOUS"
    if [[ -f "$enc" ]]; then
        # Archive, do NOT delete. The rm -f of this script's previous
        # version left the full backup as the only way back.
        # The .enc is still encrypted with the age key: archiving it
        # does not expose it.
        cp -a "$enc" "$PREVIOUS/$n.enc"
        rm -f "$enc"
        printf '  %s·%s store: %s archived in .previo/ and invalidated\n' "$cyan" "$reset" "$n"
    fi
    if [[ -f "$STATE_SECRETS/$n.pub.enc" ]]; then
        cp -a "$STATE_SECRETS/$n.pub.enc" "$PREVIOUS/$n.pub.enc"
        rm -f "$STATE_SECRETS/$n.pub.enc"
        printf '  %s·%s store: %s.pub archived and invalidated\n' "$cyan" "$reset" "$n"
    fi
}

regenerate_with_phase() {   # <phase>
    local phase="$1"
    printf '  %s·%s running phase %s (regenerates ONLY what was invalidated and syncs the third party)\n' \
        "$cyan" "$reset" "$phase"
    "$AEGIS_ROOT/init/aegis-init.sh" --only "$phase"
}

apply_to_cluster() {   # <app|->
    local app="$1"
    [[ "$app" != "-" ]] || return 0
    [[ -x "$PBIN/aegis-sync" ]] || { log_warn "${AEGIS_CMD:-aegis} sync is not there — sync the app $app by hand"; return 0; }
    printf '  %s·%s the new Secret has to be COMMITTED and PUSHED before the sync\n' "$yellow" "$reset"
    printf '    (this tool does not commit: that decision belongs to a person)\n'
}

# run_verification <verifier> — applies the retry policy: transport
# retries, a verdict does not.
run_verification() {
    local fn="$1" attempt rc
    for attempt in 1 2 3; do
        rc=0; "$fn" || rc=$?
        case $rc in
            0) return 0 ;;
            1) return 1 ;;   # verdict: the remote said no. Do NOT retry.
            3) return 3 ;;   # there is no tooth: retrying does not invent one.
            2) if (( attempt < 3 )); then
                   log_warn "verification: could not be reached (attempt $attempt/3) — retrying in $((attempt * 10))s"
                   sleep $((attempt * 10))
               fi ;;
        esac
    done
    return 2
}

# ═══════════════════════════════════════════════════════════════════
#  THE TUNNEL: why it does NOT go through phase 25
# ═══════════════════════════════════════════════════════════════════
# First attempt, 2026-08-12: the recipe delegated to `--only
# 25-edge-tofu`, like all the others. The phase stopped at a RED gate:
#
#   leftovers of an earlier run in Cloudflare (dirty cloud):
#     tunnel 'aegis-tunnel' = cb969180-...
#     CNAME aegis / argocd / jenkins / blog / ejemplo / portafolio
#   ══ RED ══ DELETE them from Cloudflare and recreate clean
#
# Phase 25 is GREENFIELD: finding an already existing tunnel can only
# mean leftovers of a failed start-up, so it offers to delete. On a
# GROWN instance those "leftovers" are production — the seven public
# hostnames. Answering YES would have destroyed the whole edge in order
# to rotate one secret.
#
# It is exactly the same case as registry_pass, which this tool already
# refuses for the same reason: the phase has a newborn instance in front
# of it, and reality is something else. The gate failed CLOSED and
# nothing was touched, which is the only reason this is an anecdote and
# not an incident.
#
# So the tunnel is rotated here, without the phase, but WITHOUT
# reimplementing its guarantees: make_enc_secret from lib/secrets.sh is
# reused (mv-to-the-repo → encrypt → roundtrip) and its two gates over
# the token are repeated.
rotate_tunnel() {
    local TE="$PLATFORM_DIR/tofu/envs/cloudflare-tunnel"
    local DEST="$PLATFORM_DIR/k8s/base/ingress/cloudflare-tunnel/secret-cloudflared-tunnel-token.enc.yaml"
    printf '\n%s━━ rotating tunnel_token (tofu directly, NOT phase 25) ━━%s\n' "$bold" "$reset"

    HOSTNAMES_BEFORE="$(snapshot_hostnames)"
    printf '  %s·%s snapshot of the hostnames BEFORE: %s\n' "$cyan" "$reset" "$HOSTNAMES_BEFORE"

    # 1. dirty the origin. Without this the apply is a silent no-op: the
    #    tunnel_secret is a random_id, and tofu does not regenerate what
    #    it already has in the state.
    printf '  %s·%s marking the tunnel_secret as tainted\n' "$cyan" "$reset"
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        taint module.tunnel.random_id.tunnel_secret ) >/dev/null 2>&1 \
        || { log_error "could not taint the tunnel_secret — nothing was touched"; return 1; }

    # 2. apply. The plan measured on 2026-08-12: the tunnel is updated
    #    IN-PLACE (it is not recreated), so the tunnel_id does not change
    #    and the CNAMEs are not touched. The only thing that rotates is
    #    the secret.
    printf '  %s·%s tofu apply (the tunnel is updated in-place; the CNAMEs are not touched)\n' "$cyan" "$reset"
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        apply -auto-approve ) >/dev/null 2>&1 \
        || { log_error "tofu apply FAILED — a partial apply leaves token/CNAMEs poisoned. DO NOT continue."; return 1; }

    # 2b. the tfstate at 600, as phase 25 does. It holds the
    # tunnel_secret and the token IN THE CLEAR; tofu rewrites it with
    # the process' umask and the .backup is left at 664 —readable by any
    # user of the machine—. Measured on 2026-08-12: after rotating this
    # way, .tfstate was left at 600 and .tfstate.backup at 664, because
    # this recipe did not replicate the phase's chmod. Caught by
    # re-auditing, not by rotating.
    for f in "$TE/terraform.tfstate" "$TE/terraform.tfstate.backup"; do
        [[ -f "$f" ]] && chmod 600 "$f"
    done

    # 3. the new token to tmpfs, and phase 25's TWO gates over it.
    secrets_workdir
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        output -raw tunnel_token ) > "$SECRETS_TMP/tunnel_token" 2>/dev/null
    (( $(wc -c < "$SECRETS_TMP/tunnel_token") > 50 )) \
        || { log_error "the new token came out empty or far too short"; return 1; }

    local TUNNEL_ID CF_ACCOUNT
    TUNNEL_ID="$( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh \
        -chdir=envs/cloudflare-tunnel output -raw tunnel_id 2>/dev/null )"
    CF_ACCOUNT="$(kubectl -n jenkins-system get secret cloudflare-account-id \
        -o jsonpath='{.data.text}' 2>/dev/null | base64 -d)"
    # STRUCTURAL shape-check, without printing the secret: the connector
    # token is base64(JSON{a,t,s}) and it has to point at THIS account
    # and at THIS tunnel. A valid token belonging to another tunnel would
    # only blow up later, in cloudflared's CrashLoop.
    base64 -d < "$SECRETS_TMP/tunnel_token" 2>/dev/null \
      | jq -e --arg a "$CF_ACCOUNT" --arg t "$TUNNEL_ID" \
          '.a == $a and .t == $t and (.s | length > 0)' >/dev/null \
      || { log_error "the new token does NOT point at this account/tunnel — the Secret is not written"; return 1; }
    printf '  %s·%s new token valid and pointing at tunnel %s\n' "$cyan" "$reset" "${TUNNEL_ID:0:8}…"

    # 4. to the repo, encrypted, with the roundtrip make_enc_secret does.
    make_enc_secret cloudflared-tunnel-token infra-edge "$DEST" \
        "TUNNEL_TOKEN=$SECRETS_TMP/tunnel_token" \
        || { log_error "could not encrypt the token's Secret"; return 1; }

    printf '\n  %sWhat this tool does not do on its own is still missing:%s\n' "$yellow" "$reset"
    printf '      cd platform && git add -A && git commit && git push\n'
    printf '      %s sync cloudflare-tunnel\n' "${AEGIS_CMD:-aegis}"
    printf '      kubectl -n infra-edge rollout restart deploy/cloudflared\n'
    printf '  %sAnd afterwards: %s rotate check tunnel_token%s\n\n' "$gray" "${AEGIS_CMD:-aegis}" "$reset"
    mkdir -p "$JOURNAL"; : > "$JOURNAL/tunnel_token.parcial"
    return 0
}

# rotate_access_st — the Cloudflare Access service token (#87/#88).
#
# access_st_id and access_st_secret are ONE credential in two halves:
# Cloudflare issues them together and rotating one without the other
# leaves the pair useless. That is why both entries in the table point
# here and this function rotates BOTH, whichever one the operator names.
# Declaring them separately in the table and rotating them together in
# the code is not incoherence: the table lists what lives in the store
# —and there are two files— and the mechanism respects what the
# credential is.
rotate_access_st() {
    # rc LOCAL on purpose: bash has dynamic scope and this function is
    # called from rotate_one, which also has an rc. Without the local, a
    # failure here would overwrite the caller's rc.
    local rc=0
    local TE="$PLATFORM_DIR/tofu/envs/cloudflare-tunnel"
    printf '\n%s━━ rotating the Access service token (id + secret together) ━━%s\n' "$bold" "$reset"
    printf '  %s·%s they are two halves of ONE credential: they are always rotated together\n' "$cyan" "$reset"

    # 1. dirty the origin, the same as with the tunnel_secret: without
    #    the taint the apply is a no-op and the rotation would be a
    #    silent lie.
    #    CAREFUL with what the plan is going to show: the
    #    `automatizacion` policy references the token's .id, so when the
    #    token is replaced the policy changes too. That is expected, not
    #    drift.
    printf '  %s·%s marking the service token as tainted\n' "$cyan" "$reset"
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        taint module.access.cloudflare_zero_trust_access_service_token.aegis ) \
        >/dev/null 2>&1 \
        || { log_error "could not taint the service token — nothing was touched"; return 1; }

    printf '  %s·%s tofu apply (new token + the policy that references it)\n' "$cyan" "$reset"
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        apply -auto-approve ) >/dev/null 2>&1 \
        || { log_error "tofu apply FAILED — if it was left half done, the policy may reference a token that no longer exists: nobody crosses Access. Review the plan by hand BEFORE continuing."; return 1; }

    # the tfstate holds the client_secret in the clear, just like the
    # tunnel_secret. Same rule as phase 25 and as rotate_tunnel:
    for f in "$TE/terraform.tfstate" "$TE/terraform.tfstate.backup"; do
        [[ -f "$f" ]] && chmod 600 "$f"
    done

    # 2. the two new halves to tmpfs and to the store.
    secrets_workdir
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        output -raw access_service_token_client_id ) \
        > "$SECRETS_TMP/access_st_id" 2>/dev/null
    ( cd "$PLATFORM_DIR/tofu" && ./tofu-apply.sh -chdir=envs/cloudflare-tunnel \
        output -raw access_service_token_client_secret ) \
        > "$SECRETS_TMP/access_st_secret" 2>/dev/null
    (( $(wc -c < "$SECRETS_TMP/access_st_id") > 20 )) \
        || { log_error "the new client_id came out empty — the store was NOT touched"; return 1; }
    (( $(wc -c < "$SECRETS_TMP/access_st_secret") > 20 )) \
        || { log_error "the new client_secret came out empty — the store was NOT touched"; return 1; }
    persist_secret access_st_id     "$SECRETS_TMP/access_st_id" \
        || { log_error "could not persist access_st_id"; return 1; }
    persist_secret access_st_secret "$SECRETS_TMP/access_st_secret" \
        || { log_error "could not persist access_st_secret"; return 1; }
    printf '  %s·%s the two new halves are in the store\n' "$cyan" "$reset"

    # 3. exercise it NOW, right here. Access propagation takes seconds,
    #    and this is the only point where we know that the store's pair
    #    is the one just born. If it does not cross, now is when we have
    #    to find out — not three phases later.
    if [[ -n "$ROOT_DOMAIN" ]]; then
        if edge_origin_responds "https://argocd.$ROOT_DOMAIN" '^(200|404)$'; then
            printf '  %s·%s the new token crosses Access and reaches the ORIGIN\n' "$green" "$reset"
        else
            log_error "the new token does NOT cross Access yet. The store already has the new pair (correct); retry 'rotate check' in a minute in case it is propagation."
            rc=1
        fi
    fi

    printf '\n  %sNo commit is needed: this pair does NOT live in the repo, only in the store.%s\n' "$gray" "$reset"
    printf '  %sBut the encrypted tfstate DID change:%s\n' "$yellow" "$reset"
    printf '      cd platform && git add tofu/envs/cloudflare-tunnel/terraform.tfstate.enc.json && git commit && git push\n'
    printf '  %sAnd afterwards: %s rotate check cf_access_token%s\n\n' "$gray" "${AEGIS_CMD:-aegis}" "$reset"
    mkdir -p "$JOURNAL"; : > "$JOURNAL/access_st.parcial"
    return "${rc:-0}"
}

rotate_one() {   # <name>
    local n="$1" line class phase app verifier third radius rc=0
    line="$(recipe_for "$n")"
    [[ -n "$line" ]] || die "'$n' has no recipe. If it is a new credential, add it to RECIPES (and the verify-static check was going to demand it of you anyway)."
    if ! recipe_has_subject "$line"; then
        printf '  %-22s %sNOT EVALUATED — EDGE=local: this instance has no Cloudflare account, so %s was never minted and there is nothing to rotate%s\n' \
            "$n" "$yellow" "$n" "$reset"
        return 2
    fi
    class="$(field "$line" 2)"; phase="$(field "$line" 3)"
    app="$(field "$line" 4)";   verifier="$(field "$line" 5)"
    third="$(field "$line" 6)"; radius="$(field "$line" 7)"

    case "$class" in
      irreducible)
        printf '\n%s%s is IRREDUCIBLE — it is not rotated here.%s\n' "$red" "$n" "$reset"
        printf '  %s\n' "$radius"
        printf '  The mandatory order (re-signing what is deployed BEFORE the new pub\n'
        printf '  enters the ClusterPolicy) is in docs/protocols/issue-cosign-keypair.md §5.\n'
        return 0 ;;
      prohibida)
        printf '\n%s%s: rotating it the normal way UNDOES an earlier fix.%s\n' "$red" "$n" "$reset"
        printf '  %s\n' "$radius"
        printf '  Phase 15 registers it with --allow-write and points ArgoCD at it.\n'
        printf '  On GitHub that key NO LONGER EXISTS (it was withdrawn in #49/#59):\n'
        printf '  re-running the phase would create it again. Fix the init first (#83).\n'
        return 0 ;;
      tofu)
        # Dispatch is BY NAME, not by class: the class says who the
        # owner is (tofu's state), not how it is rotated. A generic
        # `tofu) rotate_tunnel` meant that adding any second tofu
        # credential would rotate the TUNNEL in its place — a dangerous
        # no-op dressed up as success. It was closed when the Access
        # service token was added (#87).
        case "$n" in
          tunnel_token)                  rotate_tunnel;     return $? ;;
          access_st_id|access_st_secret) rotate_access_st;  return $? ;;
          *) log_error "'$n' is class tofu but has no rotator of its own — add it here before declaring it in the table"; return 1 ;;
        esac ;;
      manual)
        printf '\n%s%s is not produced by any init phase yet.%s\n' "$yellow" "$n" "$reset"
        printf '  %s\n' "$radius"
        printf '  It is a declared DEBT (#86): the right thing is for phase 30 to\n'
        printf '  generate it like any other credential. In the meantime it is rotated\n'
        printf '  by hand and persisted to the store, and `rotate check` does measure it.\n'
        printf '  The procedure is in docs/protocols/rotation-checklist.md.\n'
        return 2 ;;
      delegada)
        printf '\n%s%s has a tool of its own.%s\n' "$yellow" "$n" "$reset"
        printf '  The registry lives in TEN places (one htpasswd + nine dockerconfigjson).\n'
        printf '  %s registry discovers the targets from the repo, contrasts them\n' "${AEGIS_CMD:-aegis}"
        printf '  against the cluster and stops dead if they do not match. Run it yourself:\n\n'
        printf '      cd platform && %s registry rotate\n\n' "${AEGIS_CMD:-aegis}"
        return 0 ;;
    esac

    # ── SIDE EFFECT OF RUNNING A WHOLE PHASE ────────────────────────
    # Rotating by phase is the right thing —the phase already knows how
    # to sync the third party— but the phase does ALL of its own work,
    # not only what belongs to the invalidated secret. And phase 15
    # registers `aegis-iu-write --allow-write` without asking: rotating
    # the Jenkins HMAC would create on GitHub, all over again, the WRITE
    # deploy key that #49 withdrew, and ArgoCD would authenticate with
    # it again. Real damage, caused by rotating something completely
    # unrelated.
    #
    # The guard is MEASURED against the artifact instead of being baked
    # in: the day #83 takes the --allow-write out of phase 15, this
    # block disappears on its own. A guard you have to remember to
    # remove is a guard that stays.
    if [[ "$phase" == 15-third-parties ]] && \
       grep -qE '^\s*add_deploy_key .*--allow-write' \
            "$AEGIS_ROOT/init/phases/15-third-parties.sh"; then
        printf '\n%s%s cannot be rotated yet.%s\n' "$red" "$n" "$reset"
        printf '  It is rotated by running phase 15, and phase 15 still registers\n'
        printf '  the WRITE deploy key (add_deploy_key ... --allow-write).\n'
        printf '  Rotating this would RE-CREATE on GitHub the key that #49 withdrew,\n'
        printf '  and ArgoCD would authenticate with it again. Real damage from\n'
        printf '  rotating something completely unrelated.\n\n'
        printf '  %sFix #83 first. This block lifts on its own once the%s\n' "$yellow" "$reset"
        printf '  %s--allow-write is no longer in the phase.%s\n' "$yellow" "$reset"
        return 2
    fi

    printf '\n%s━━ rotating %s ━━%s\n' "$bold" "$n" "$reset"

    # The THREE Cloudflare tokens are minted together or not at all:
    # phase 15 asks for the master key if ANY of the three .enc is
    # missing, and mints all three anew. So rotating one rotates the
    # three, and along the way it is going to prompt for the master.
    # That is not a strange effect —it is how minting from an ephemeral
    # master works— but finding out halfway through would be an ugly
    # surprise.
    case "$n" in
      cf_api_token|cf_dns_token|cf_access_token)
        printf '  %s⚠ the THREE CF tokens (api, dns, access) are re-minted together,%s\n' "$yellow" "$reset"
        printf '  %s  and the phase is going to ASK for the Cloudflare master credential.%s\n' "$yellow" "$reset"
        printf '  %s  Have it at hand; it dies in tmpfs as soon as the phase ends.%s\n' "$yellow" "$reset" ;;
    esac

    # the BEFORE, for the verifiers that compare against a snapshot
    [[ "$verifier" == "check_tunnel" ]] && HOSTNAMES_BEFORE="$(snapshot_hostnames)"

    archive_and_invalidate "$n"
    regenerate_with_phase "$phase"
    apply_to_cluster "$app"

    printf '  %s·%s verifying that the REAL consumer works…\n' "$cyan" "$reset"
    local rc=0; run_verification "$verifier" || rc=$?
    case $rc in
      0) printf '  %s✓ %s rotated AND VERIFIED%s\n' "$green" "$n" "$reset"
         mkdir -p "$JOURNAL"; : > "$JOURNAL/$n.done"
         return 0 ;;
      3) printf '  %s⚠ %s rotated, but there is NO TOOTH that verifies it.%s\n' "$yellow" "$n" "$reset"
         printf '    This does NOT count as green: it was left unmeasured. Write the verifier.\n'
         return 0 ;;
      1) printf '  %s✗ %s: the verification gave a NEGATIVE VERDICT.%s\n' "$red" "$n" "$reset"
         printf '    The consumer answered, and it answered no. It is not retried.\n'
         four_places_report "$n" "$app" "$third"
         return 1 ;;
      2) printf '  %s✗ %s: could not REACH it to verify after 3 attempts.%s\n' "$red" "$n" "$reset"
         printf '    The rotation may be fine: what failed is the measurement.\n'
         four_places_report "$n" "$app" "$third"
         return 1 ;;
    esac
}

# ═══════════════════════════════════════════════════════════════════
#  INVENTORY AND MENU
# ═══════════════════════════════════════════════════════════════════

age_of() {   # <name> → "18d" or "?"
    # The store's material ages with its .enc. The tunnel's token does
    # not live in the store —tofu produces it— so its age comes from the
    # tfstate, which is where it really got recorded.
    local f="$STATE_SECRETS/$1.enc"
    [[ "$1" == "tunnel_token" ]] && \
        f="$PLATFORM_DIR/tofu/envs/cloudflare-tunnel/terraform.tfstate"
    [[ -f "$f" ]] || { printf '%s' "?"; return; }
    printf '%dd' $(( ( $(date +%s) - $(stat -c %Y "$f") ) / 86400 ))
}

ROTATABLE=()
inventory() {
    ROTATABLE=()
    printf '\n  %s%s rotate%s — the rotation protocol%s\n' "$bold" "${AEGIS_CMD:-aegis}" "$reset" \
        "${ROOT_DOMAIN:+   $gray instance: $ROOT_DOMAIN$reset}"
    printf '\n   %s#  credential          age    third party  blast radius if this fails%s\n' "$gray" "$reset"
    local line n class i=0
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        n="$(field "$line" 1)"; class="$(field "$line" 2)"
        case "$class" in irreducible|prohibida) continue ;; esac
        i=$((i + 1)); ROTATABLE+=("$n")
        printf '  %2d  %-19s %-6s %-12s %s\n' \
            "$i" "$n" "$(age_of "$n")" "$(field "$line" 6)" "$(field "$line" 7)"
    done < <(printf '%s\n%s\n' "$RECIPES" "$RECIPES_EXTRA")

    printf '\n  %sNOT rotated here:%s\n' "$gray" "$reset"
    while IFS= read -r line; do
        [[ -n "$line" ]] || continue
        case "$(field "$line" 2)" in
          irreducible) printf '   %s· %-19s %s%s\n' "$gray" "$(field "$line" 1)" "$(field "$line" 7)" "$reset" ;;
          prohibida)   printf '   %s· %-19s %s%s\n' "$red" "$(field "$line" 1)" "$(field "$line" 7)" "$reset" ;;
        esac
    done < <(printf '%s\n' "$RECIPES")

    local h; h="$(orphans)"
    if [[ -n "$h" ]]; then
        printf '\n  %s⚠ there is material in the store with NO RECIPE — nobody knows how to rotate it:%s\n' "$red" "$reset"
        printf '   %s· %s\n' "$red" $h
        printf '   %sAdd it to RECIPES or declare it irreducible.%s\n' "$red" "$reset"
    fi
}

confirm() {   # <blast-radius-text>
    printf '\n  %sIf this goes wrong:%s %s\n' "$yellow" "$reset" "$1"
    local r
    read -rp "  are you sure? [y/N] " r || return 1
    [[ "$r" == "y" || "$r" == "Y" ]]
}

menu() {
    inventory
    printf '\n  %s[1-%d]%s one   %s[a]%s all   %s[r]%s review without touching   %s[q]%s quit\n' \
        "$bold" "${#ROTATABLE[@]}" "$reset" "$bold" "$reset" "$bold" "$reset" "$bold" "$reset"
    local op; read -rp "  > " op || exit 0

    case "$op" in
      q|Q|"") exit 0 ;;
      r|R) aegis_exec check 2>/dev/null || log_warn "could not run ${AEGIS_CMD:-aegis} check"; exit 0 ;;
      a|A)
        printf '\n  You are about to rotate %s credentials:\n' "${#ROTATABLE[@]}"
        printf '    %s\n' "${ROTATABLE[*]}"
        printf '\n  %sThere is ONE single confirmation: nobody answers well eleven times in a row.%s\n' "$gray" "$reset"
        confirm "the platform is left half synced until the batch finishes" || { printf '  cancelled.\n'; exit 0; }
        preflight_network yes yes
        local n failed=0 rc
        for n in "${ROTATABLE[@]}"; do
            if [[ -f "$JOURNAL/$n.done" ]]; then
                printf '\n  %s· %s already rotated in this batch — skipped (continue)%s\n' "$gray" "$n" "$reset"
                continue
            fi
            rc=0; rotate_one "$n" || rc=$?
            # rc 2 = blocked by a known cause. It does NOT abort the
            # batch: skipping it and going on is the right thing — what
            # cannot happen is for it to be silenced, and that is why it
            # is counted.
            (( rc == 2 )) && { SKIPPED+=("$n"); continue; }
            (( rc == 0 )) || { failed=$((failed + 1)); break; }
        done
        finish "$failed" ;;
      *)
        [[ "$op" =~ ^[0-9]+$ ]] && (( op >= 1 && op <= ${#ROTATABLE[@]} )) \
            || { printf '  invalid option.\n'; exit 2; }
        local n="${ROTATABLE[$((op - 1))]}" line
        line="$(recipe_for "$n")"
        printf '\n  You are about to rotate: %s%s%s\n' "$bold" "$n" "$reset"
        printf '  What gets touched: git · cluster%s · store\n' \
            "$([[ "$(field "$line" 6)" != "-" ]] && printf ' · %s' "$(field "$line" 6)")"
        confirm "$(field "$line" 7)" || { printf '  cancelled.\n'; exit 0; }
        preflight_network \
            "$([[ "$(field "$line" 6)" == "GitHub" ]] && echo yes || echo no)" \
            "$([[ "$(field "$line" 6)" == "Cloudflare" ]] && echo yes || echo no)"
        local rc1=0; rotate_one "$n" || rc1=$?
        (( rc1 == 2 )) && { SKIPPED+=("$n"); finish 0; }
        (( rc1 == 0 )) || finish 1
        finish 0 ;;
    esac
}

SKIPPED=()
finish() {   # <failed>
    local f="$1"
    printf '\n%s────────────────────────────────────────────────────────%s\n' "$gray" "$reset"
    if (( ${#SKIPPED[@]} > 0 )); then
        # For a batch to "finish" leaving credentials unrotated and not
        # say so would be the same old disease, one level up.
        printf '%sNOT ROTATED%s (blocked by a known cause, not by a failure):\n' "$yellow" "$reset"
        printf '   · %s\n' "${SKIPPED[@]}"
        printf 'Each one printed its reason above.\n\n'
    fi
    if (( f > 0 )); then
        printf '%sThe batch stopped.%s What was already rotated is written down in the journal;\n' "$red" "$reset"
        printf 'after closing the gap above, resume with:\n\n'
        printf '    %s rotate continue\n\n' "${AEGIS_CMD:-aegis}"
        exit 1
    fi
    printf '%sRotation complete.%s What this tool does NOT do on purpose is still missing:\n\n' "$green" "$reset"
    printf '    cd platform && git add -A && git commit && git push\n'
    printf '    %s sync --drifted\n' "${AEGIS_CMD:-aegis}"
    printf '    %s check          # the whole check, over the entire system\n\n' "${AEGIS_CMD:-aegis}"
    rm -rf "$JOURNAL"
    exit 0
}

# ═══════════════════════════════════════════════════════════════════
#  ENTRY
# ═══════════════════════════════════════════════════════════════════
# --help BEFORE touching anything: until 2026-08-27 asking for help on a
# machine with no store died with "the store does not exist" (same class
# as `preflight --help`, fixed the day before).
for a in "$@"; do case "$a" in -h|--help) sed -n '1,56p' "$0"; exit 0 ;; esac; done
[[ -d "$STATE_SECRETS" ]] || die "the store $STATE_SECRETS does not exist (did you run the init?)"

YES=0; NAMES=(); CONTINUE=0; CHECK=0
for a in "$@"; do
  case "$a" in
    --yes)       YES=1 ;;
    # Rule 1: verbs. The old flags (--revisar/--verificar/--continuar)
    # were modes dressed up as options, and one of them ROTATES material
    # — the difference between looking and breaking cannot depend on a
    # single letter.
    continue)    CONTINUE=1 ;;
    list)        inventory; echo; exit 0 ;;
    check)       CHECK=1 ;;
    run)         : ;;
    -h|--help)   sed -n '1,56p' "$0"; exit 0 ;;
    -*)          die "unknown flag: $a" ;;
    *)           NAMES+=("$a") ;;
  esac
done

# ── check: ask whether a credential WORKS, without rotating it ──────
# It was missing, and it is what one wants 90% of the time. Without it,
# the only way to exercise a verifier was to rotate — that is, to know
# whether something worked you had to break it first. It also makes the
# result auditable AFTER a rotation done by hand, which is exactly the
# case of #83.
if (( CHECK )); then
    (( ${#NAMES[@]} > 0 )) || mapfile -t NAMES < <(
        printf '%s\n%s\n' "$RECIPES" "$RECIPES_EXTRA" \
        | awk -F'|' '$5 != "-" && $5 != "" {print $1}')
    failure=0
    for n in "${NAMES[@]}"; do
        line="$(recipe_for "$n")"
        [[ -n "$line" ]] || { printf '  %-22s %sno recipe%s\n' "$n" "$red" "$reset"; continue; }
        if ! recipe_has_subject "$line"; then
            printf '  %-22s %sNOT EVALUATED (EDGE=local: no Cloudflare account on this instance)%s\n' \
                "$n" "$yellow" "$reset"
            continue
        fi
        v="$(field "$line" 5)"
        [[ "$v" != "-" && -n "$v" ]] || { printf '  %-22s %s— (it has no verifier)%s\n' "$n" "$gray" "$reset"; continue; }
        # the tunnel's snapshot is taken right here: verifying without
        # rotating can only say "it answers", not "it answers THE SAME
        # as before".
        [[ "$v" == "check_tunnel" ]] && HOSTNAMES_BEFORE="$(snapshot_hostnames)"
        rc=0; "$v" >/dev/null 2>&1 || rc=$?
        case $rc in
          0) printf '  %-22s %s✓ works%s\n' "$n" "$green" "$reset" ;;
          1) printf '  %-22s %s✗ the consumer REJECTS it%s\n' "$n" "$red" "$reset"; failure=1 ;;
          2) printf '  %-22s %s? could not reach it to measure%s\n' "$n" "$yellow" "$reset" ;;
          3) printf '  %-22s %s! no tooth written — this is NOT green%s\n' "$n" "$yellow" "$reset" ;;
        esac
    done
    exit "$failure"
fi

if (( CONTINUE )); then
    [[ -d "$JOURNAL" ]] || die "there is no half-finished batch ($JOURNAL does not exist)"
    printf '  resuming the interrupted batch…\n'
    inventory
    preflight_network yes yes
    failed=0
    for n in "${ROTATABLE[@]}"; do
        [[ -f "$JOURNAL/$n.done" ]] && continue
        rc=0; rotate_one "$n" || rc=$?
        (( rc == 2 )) && { SKIPPED+=("$n"); continue; }
        (( rc == 0 )) || { failed=1; break; }
    done
    finish "$failed"
fi

# no arguments → the mini-app
(( ${#NAMES[@]} > 0 )) || menu

# ── compat: the previous behaviour, by name ─────────────────────────
# It still works because rotation-checklist.md references it this way
# and because a script that changes its contract breaks whoever
# automated it.
for n in "${NAMES[@]}"; do
    line="$(recipe_for "$n")"
    if [[ -z "$line" ]]; then
        printf '%s: no recipe — it is not touched.\n' "$n"; continue
    fi
    if (( YES )); then
        preflight_network \
            "$([[ "$(field "$line" 6)" == "GitHub" ]] && echo yes || echo no)" \
            "$([[ "$(field "$line" 6)" == "Cloudflare" ]] && echo yes || echo no)"
        # exit 2 = blocked by a known cause; exit 1 = really failed.
        # Telling them apart matters to whoever automates this.
        rcx=0; rotate_one "$n" || rcx=$?
        (( rcx == 0 )) || exit "$rcx"
    else
        printf '\n%s── %s ──%s\n' "$bold" "$n" "$reset"
        printf '  class:   %s\n' "$(field "$line" 2)"
        printf '  radius:  %s\n' "$(field "$line" 7)"
        printf '  touches: git · cluster · store%s\n' \
            "$([[ "$(field "$line" 6)" != "-" ]] && printf ' · %s' "$(field "$line" 6)")"
        printf '  %s[DRY-RUN] pass --yes to rotate for real%s\n' "$gray" "$reset"
    fi
done
