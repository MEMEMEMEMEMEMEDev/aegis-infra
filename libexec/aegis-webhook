#!/usr/bin/env python3
# aegis-summary: That a push reaches Jenkins, in every repo
# aegis-group:   infra
# aegis-subcommands: check apply
"""aegis-webhook — that a push reaches Jenkins, in every repo.

THE PROBLEM IT SOLVES
─────────────────────
The init creates the GitHub webhook for the TWO repos of the bootstrap
(`make_repo_webhook` in phase 15, invoked with $PLATFORM_REPO and
$APP_REPO). Every repo added afterwards was left without a webhook.

Measured on 2026-08-05: of the four repos with a multibranch job in
Jenkins, TWO had no webhook —`ai-gateway` and `blog-aegis`— so they
only built when the periodic scan ran. Nobody found out: the build
eventually passed, late and with no visible relation to the push. It is
the same failure mode as the edge (#35): there is no error, there is an
absence.

THE LIST COMES FROM JENKINS, NOT FROM HERE
──────────────────────────────────────────
The repos are derived from the jobs declared in Jenkins' values.yaml.
That is the honest definition of the invariant:

    if Jenkins has a job for a repo, a push to that repo has to
    reach it.

Writing the list here would be a second place to remember, which is
exactly what this project has been getting rid of.

THE HMAC COMES FROM THE CLUSTER
───────────────────────────────
And not from the encrypted file, on purpose: the one that matters is
the one Jenkins VALIDATES, not the one git says it ought to validate.
If they differed, reading the file would come out green while GitHub
signs with one and Jenkins expects another — a permanent 400 on every
delivery. Reading it from the live Secret, that cannot happen.

The value is never printed, never travels through argv and is never
written to disk: it goes from kubectl to memory and from there into the
JSON body that `gh` consumes.

    aegis webhook check      # says what is missing, touches nothing
    aegis webhook apply      # creates or re-syncs the webhooks

Returns 0 if they are all there, 1 if some are missing, 2 if it COULD
NOT EVALUATE. That third code is deliberate: not being able to look is
not approval.
"""
import argparse
import base64
import json
import os
import re
import subprocess
import sys

# ── canonical python preamble (V-102) ────────────────────────────────
# The product comes from the variable (bin/aegis exports it) or from
# this file; the INSTANCE is decided by lib/aegis/paths.py and nobody
# else.
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, outcomes, paths  # noqa: E402

# PLATFORM is the INSTANCE (the live checkout of the platform), not the
# product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. When the code
# moved to the product the same line kept compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a
# grep».
PLATFORM = str(paths.platform_dir())
HERE = os.path.join(_AEGIS_ROOT, "libexec")
JENKINS_VALUES = os.path.join(PLATFORM, "k8s", "base", "platform", "jenkins", "values.yaml")
EDGE = os.path.join(PLATFORM, "edge.yaml")

red = "\033[31m"; green = "\033[32m"; yellow = "\033[33m"; gray = "\033[90m"; reset = "\033[0m"
if not sys.stdout.isatty():
    red = green = yellow = gray = reset = ""


class Error(Exception):
    pass


def repos_with_job():
    """(owner, repo) of every multibranch job declared in Jenkins.

    It is read with a regex and not by parsing the YAML because the
    value is a block of Job DSL (Groovy) embedded as a string: to the
    YAML it is plain text. What is looked for are the two fields that
    identify the repo, which in Job DSL are literals.
    """
    try:
        text = open(JENKINS_VALUES, encoding="utf-8").read()
    except FileNotFoundError:
        raise Error(f"{os.path.relpath(JENKINS_VALUES, PLATFORM)} is not there")
    # Every `github { ... }` of a branchSource carries owner and repository.
    blocks = re.findall(
        r"repoOwner\('([^']+)'\)\s*\n\s*repository\('([^']+)'\)", text)
    if not blocks:
        raise Error("no multibranch job in Jenkins' values.yaml — "
                    "did the shape of the Job DSL change?")
    # Stable order and no duplicates.
    return sorted(set(blocks))


def root_domain():
    try:
        import yaml
        return (yaml.safe_load(open(EDGE, encoding="utf-8")) or {})["root_domain"]
    except Exception as e:
        raise Error(f"could not read root_domain out of edge.yaml: {e}")


def hmac_from_cluster():
    """The HMAC Jenkins validates, read from the live Secret. Never printed."""
    r = subprocess.run(
        ["kubectl", "get", "secret", "github-webhook-hmac", "-n", "jenkins-system",
         "-o", "jsonpath={.data.text}"],
        capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        raise Error("could not read the Secret jenkins-system/github-webhook-hmac "
                    "(is kubectl configured? did the jenkins-secrets App sync?)")
    value = base64.b64decode(r.stdout.strip()).decode()
    if value != value.strip():
        # The init already caught this once: a trailing \n makes GitHub
        # sign over one body and Jenkins validate over another, and the
        # 400 does not say why. It is rejected instead of being "fixed"
        # in silence.
        raise Error("the cluster's HMAC has whitespace or \\n at the edge — "
                    "GitHub and Jenkins would sign differently (see assert_no_newline)")
    return value


def hooks_of(owner, repo):
    r = subprocess.run(["gh", "api", f"repos/{owner}/{repo}/hooks"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        raise Error(f"could not list the hooks of {owner}/{repo}: {r.stderr.strip()}")
    return json.loads(r.stdout)


def ensure(owner, repo, url, hmac, write):
    """Creates or RE-SYNCS the webhook. Returns 'ok' | 'missing' | 'created' | 'resync'."""
    existing = next((h for h in hooks_of(owner, repo)
                     if (h.get("config") or {}).get("url") == url), None)
    if not write:
        return "ok" if existing else "missing"

    # The secret is ALWAYS rewritten, whether the hook exists or not.
    # GitHub never returns `config.secret` of an existing hook, so
    # "it already exists" does NOT imply "it is in sync": a surviving
    # hook may be signing with an old HMAC while Jenkins validates with
    # the new one, and the symptom is a permanent 400 that does not say
    # why. Same reason and same remedy as `make_repo_webhook` of phase
    # 15.
    body = {"active": True, "events": ["push"],
            "config": {"url": url, "content_type": "json",
                       "secret": hmac, "insecure_ssl": "0"}}
    if existing:
        path = f"repos/{owner}/{repo}/hooks/{existing['id']}"
        method = "PATCH"
    else:
        body["name"] = "web"        # POST demands it; PATCH rejects it
        path = f"repos/{owner}/{repo}/hooks"
        method = "POST"
    # The body goes in through STDIN: the HMAC does not travel through
    # argv, where anybody with /proc would see it.
    r = subprocess.run(["gh", "api", "-X", method, path, "--input", "-"],
                       input=json.dumps(body), capture_output=True, text=True)
    if r.returncode != 0:
        raise Error(f"the {method} of the webhook of {owner}/{repo} failed: {r.stderr.strip()}")
    return "resync" if existing else "created"


def main():
    p = argparse.ArgumentParser(prog=cli.cmd("webhook"), description=__doc__.split("\n")[0])
    # Rule 2 of the design: a single «look without touching» mode, and
    # it is a VERB. `check` measures; `apply` creates the missing ones
    # and re-syncs the HMAC of the ones that are there. No arguments =
    # check, which is what the round invokes.
    sub = p.add_subparsers(dest="verb")
    sub.add_parser("check", help="measures: do all the repos with a job have a webhook?")
    sub.add_parser("apply", help="creates the missing ones and re-syncs the HMAC")
    # The exit CONTRACT (03 §3). Until today, whoever wanted to know
    # whether this command had CREATED something —and not merely
    # re-synced— had to read the sentence «webhook creado» in the
    # narration: aegis-app:722 did exactly that, and a change of
    # wording here broke the table over there (A3 of the register). Now
    # the state is emitted; the prose is left for people.
    p.add_argument("--json", action="store_true", dest="json_mode",
                   help="replaces the narration with the document of states")
    a = p.parse_args()
    a.do_apply = (a.verb == "apply")
    steps = outcomes.Steps(json_mode=a.json_mode)
    narrate = not a.json_mode

    try:
        repos = repos_with_job()
        url = f"https://jenkins.{root_domain()}/github-webhook/"
        hmac = hmac_from_cluster() if a.do_apply else None
    except Error as e:
        if narrate:
            print(f"  {yellow}!{reset} webhooks NOT EVALUATED — {e}")
            print(f"    {gray}This is NOT approval: it is a check that did not run.{reset}")
        steps.not_evaluable("webhooks", reason=str(e).replace(" ", "_"))
        steps.finish()

    missing = 0
    for owner, repo in repos:
        name = f"webhook:{owner}/{repo}"
        try:
            state = ensure(owner, repo, url, hmac, a.do_apply)
        except Error as e:
            if narrate:
                print(f"  {yellow}!{reset} {owner}/{repo}: {e}")
            steps.not_evaluable(name, reason=str(e).replace(" ", "_"))
            steps.finish()
        if state == "missing":
            if narrate:
                print(f"  {red}✗{reset} {owner}/{repo} {gray}no webhook — it only builds "
                      f"when the periodic scan runs{reset}")
            steps.wrong(name)
            missing += 1
        elif state == "created":
            if narrate:
                print(f"  {green}+{reset} {owner}/{repo} {gray}webhook created{reset}")
            steps.done(name)
        elif state == "resync":
            if narrate:
                print(f"  {gray}~{reset} {owner}/{repo} {gray}HMAC re-synced{reset}")
            # re-syncing the HMAC is maintenance of the idempotent
            # PATCH, not a change of state: «already».
            steps.already(name, hmac="resynced")
        else:
            if narrate:
                print(f"  {green}✓{reset} {owner}/{repo}")
            steps.already(name)

    if narrate:
        if missing:
            print(f"\n  {gray}to create them:  {cli.cmd('webhook apply')}{reset}")
        elif not a.do_apply:
            print(f"  {green}✓{reset} the {len(repos)} repos with a job in Jenkins have a webhook")
    steps.finish()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Error as e:
        print(f"{red}✗{reset} {e}", file=sys.stderr)
        sys.exit(2)
