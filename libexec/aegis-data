#!/usr/bin/env python3
# aegis-summary: Captura y restaura los DATOS de los inquilinos
# aegis-group:   backup
# aegis-subcommands: backup list restore
"""aegis-data — captura y restaura los DATOS de los inquilinos.

Es la otra mitad de `aegis state backup`. Aquél respalda el ESTADO de
la plataforma —los secretos del store, la traza del init, el tfstate del
borde—; éste respalda lo que los inquilinos GENERARON: sus bases y sus
objetos. Ninguna de las dos mitades sirve sola: con el estado se levanta
una plataforma vacía, con los datos se tiene un dump que no se sabe
dónde poner.

    aegis data --capturar              # un bundle POR ORGANIZACIÓN
    aegis data --listar <bundle.age>   # qué hay adentro, sin restaurar
    aegis data --restaurar <bundle.age> --org ejemplo [--force]

── UN BUNDLE POR ORGANIZACIÓN, EN SU PROPIA CARPETA ────────────────

    $AEGIS_RESPALDOS/
      .aegis-destino                       <- la marca del disco (ver abajo)
      plataforma/
        aegis-estado-<ts>.age              <- lo escribe aegis state backup
      org-ejemplo/
        aegis-datos-org-ejemplo-<ts>.age
      org-portafolio/
        aegis-datos-org-portafolio-<ts>.age

Hasta el 2026-08-11 era UN bundle con todo adentro. Separarlo por
organización cambia tres cosas que importan:

  · restaurar una no obliga a abrir el resguardo de las demás — y ese
    resguardo lleva datos de terceros;
  · dar de baja una organización es borrar su carpeta, no editar un
    archivo compartido;
  · y la que de verdad pesa: la pregunta honesta deja de ser "¿hay
    respaldo?" y pasa a ser "¿tiene respaldo CADA organización?".

Esa última es la razón de fondo. Con un bundle único, una organización
nueva que nunca se respaldó era INVISIBLE: el archivo existía, tenía
fecha reciente, y adentro no estaba. Ahora la ausencia tiene forma de
carpeta que falta, y `aegis check` la enumera contra los
contratos.

── LA MARCA DEL DISCO (.aegis-destino) ─────────────────────────────

El destino típico es un segundo disco, y en un escritorio ese disco
suele montarlo el entorno gráfico al iniciar sesión — no está en fstab
y NO está montado durante el arranque. Si el respaldo corre en ese
hueco, la ruta existe igual (es un directorio vacío en el disco raíz) y
el bundle se escribe ahí: éxito reportado, cero protección, y la copia
que tenía que sobrevivir al disco vive en el disco.

Por eso la primera captura anota el UUID del filesystem de destino en
`<raiz>/.aegis-destino`, y las siguientes lo verifican. Si no coincide
—no está montado, o es otro disco— NO se escribe. Se compara el UUID y
no el punto de montaje porque el punto de montaje es exactamente lo que
miente en este fallo.

── POR QUÉ CORRE DEL LADO DEL OPERADOR Y NO DENTRO DEL CLUSTER ─────

No es una preferencia: es lo único que la plataforma permite sin
aflojarla. Medido el 2026-08-09:

  1. Los namespaces con datos son TODOS `restricted` (org-*,
     garage-system, ai-system). Un Job ahí NO puede montar un hostPath,
     así que no puede escribir en el directorio de respaldos.
  2. El egreso de un namespace de inquilino está cerrado salvo DNS. Un
     pod ahí adentro puede volcar la base —`allow-intra-namespace` se lo
     permite— pero no puede SACAR el volcado por red.
  3. Garage es distroless: sin shell. Su respaldo va por la API S3, no
     por el filesystem.
  4. /var/lib/rancher/k3s/storage no es legible sin root, y sus rutas
     llevan el UUID del PVC — que en una instancia nueva es OTRO. O sea
     que restaurar tampoco puede ser "copiar el directorio de vuelta".

La alternativa —un CronJob adentro— exige un namespace laxo, una regla
de red por cada inquilino y una identidad permanente capaz de leer todas
las bases. Eso es un blanco, y es mucha maquinaria para una plataforma
de un nodo. Acá el transporte es `kubectl exec` (verificado sin pérdida:
5136 bytes adentro, 5136 en el host) y `kubectl port-forward` para S3,
que además esquiva la NetworkPolicy legítimamente porque el tráfico
nace en el nodo.

Para el modo PROGRAMADO, esto se dispara desde un timer del host. Es más
honesto que un CronJob: el que respalda no vive dentro de lo que respalda.

── QUÉ SE CAPTURA Y CÓMO, QUE ES DONDE ESTÁ LA CORRECCIÓN ──────────

postgres  `pg_dumpall`, NO `pg_dump`. Medido: los ROLES viven fuera de
          cualquier base, y un `pg_dump` normal los pierde. Restaurar sin
          ellos da una base sin dueños y una app que no puede entrar.
          `pg_dumpall` también trae las OTRAS bases (hay una `postgres`
          además de la del contrato).

bucket    Listado y descarga por S3 con firma SigV4. El objeto se guarda
          con su clave y su ETag, y el ETag se re-verifica al restaurar.

LA CONTRASEÑA NO SE COPIA AL BUNDLE, se guarda su HUELLA. El dump de
globals ya trae el hash SCRAM de cada rol, así que la base restaurada
acepta la contraseña original — la que sigue viviendo en el Secret. Lo
que puede salir mal es que el Secret haya rotado ENTRE la captura y la
restauración: ahí la base restaurada esperaría una contraseña y el pod
presentaría otra. Por eso el manifiesto guarda el sha256 de la que había,
y `--restaurar` COMPARA. Copiar el secreto habría escondido esa
discrepancia creándola en silencio; guardar la huella la detecta.
"""
import argparse
import base64
import datetime
import hashlib
import hmac
import json
import os
import shutil
import socket
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

try:
    import yaml
except ImportError:
    sys.exit("falta pyyaml (python3-yaml)")

# ── preámbulo canónico de python (V-102) ─────────────────────────────
# El producto sale de la variable (bin/aegis la exporta) o de este
# archivo; la INSTANCIA la decide lib/aegis/paths.py y nadie más.
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, paths             # noqa: E402

# RAIZ es la INSTANCIA (el checkout vivo de plataforma), no el producto.
# En v2 esta línea era `dirname(dirname(__file__))` y funcionaba porque
# el comando vivía DENTRO de la instancia. Al mudar el código al
# producto la misma línea siguió compilando y pasó a apuntar al lugar
# equivocado — la «dependencia invisible a un grep» de C1/C2.
RAIZ = str(paths.platform_dir())
DIR_ORGS = os.path.join(RAIZ, "orgs")
SERVICIOS = os.path.join(RAIZ, "services.yaml")
DESTINO_DEF = os.environ.get(
    "AEGIS_RESPALDOS", os.path.join(os.path.expanduser("~"), "aegis-respaldos"))

rojo = "\033[31m"; verde = "\033[32m"; ama = "\033[33m"; gris = "\033[90m"; fin = "\033[0m"
if not sys.stdout.isatty():
    rojo = verde = ama = gris = fin = ""


def morir(msg):
    print(f"{rojo}✗{fin} {msg}", file=sys.stderr)
    sys.exit(1)


# ── el destino: que sea el disco que creemos ────────────────────────
def uuid_de(ruta):
    """UUID del filesystem donde vive `ruta` (o None si no se puede)."""
    r = subprocess.run(["findmnt", "-no", "UUID", "--target", ruta],
                       capture_output=True, text=True)
    return r.stdout.strip() or None


def preparar_raiz(raiz):
    """Crea la raíz de respaldos y verifica que sea el disco de siempre.

    El fallo que esto evita no es teórico y no avisa solo: un segundo
    disco montado por el escritorio no está montado durante el arranque,
    la ruta sigue existiendo como directorio vacío del disco raíz, y el
    respaldo aterriza ahí creyendo que salió. Se descubre el día que se
    necesita.
    """
    raiz = os.path.abspath(os.path.expanduser(raiz))
    os.makedirs(raiz, exist_ok=True)
    marca = os.path.join(raiz, ".aegis-destino")
    actual = uuid_de(raiz)
    if actual is None:
        print(f"  {ama}!{fin} no pude leer el UUID del filesystem de {raiz} "
              f"(¿findmnt?): sigo, pero SIN la guarda de disco")
        return raiz
    if os.path.exists(marca):
        try:
            prev = json.load(open(marca, encoding="utf-8"))
        except Exception:
            prev = {}
        anotado = prev.get("uuid")
        if anotado and anotado != actual:
            morir(
                f"el destino de respaldos cambió de DISCO y no se escribe nada.\n"
                f"      anotado : {anotado}\n"
                f"      ahora   : {actual}\n"
                f"      {raiz}\n"
                f"      Lo habitual es que el disco de respaldos no esté montado y\n"
                f"      esta ruta sea un directorio vacío del disco raíz — o sea, el\n"
                f"      resguardo caería en el mismo disco que tiene que sobrevivir.\n"
                f"      Montalo y repetí. Si el cambio es a propósito, borrá\n"
                f"      {marca} y la próxima captura lo vuelve a anotar.")
    else:
        json.dump({
            "uuid": actual,
            "anotado": datetime.datetime.now(datetime.timezone.utc)
                        .strftime("%Y-%m-%dT%H:%M:%SZ"),
            "porque": "si este UUID no coincide, el disco de respaldos no está "
                      "montado y el bundle caería en el disco que debe sobrevivir",
        }, open(marca, "w", encoding="utf-8"), indent=2, ensure_ascii=False)
        ok(f"destino anotado: {raiz} (fs {actual})")
    if uuid_de("/") == actual:
        print(f"  {ama}!{fin} el destino está en el MISMO filesystem que / — un "
              f"fallo de ese disco se lleva los datos y sus respaldos")
    return raiz


def paso(msg):
    print(f"  {gris}·{fin} {msg}")


def ok(msg):
    print(f"  {verde}✓{fin} {msg}")


def kubectl(args, binario=False, entrada=None):
    r = subprocess.run(["kubectl"] + args, capture_output=True,
                       input=entrada, **({} if binario else {"text": True}))
    return r


# ── descubrimiento ──────────────────────────────────────────────────
#
# Igual que aegis registry y por el mismo motivo: la lista NO se
# escribe. Sale de los contratos y se CONTRASTA contra el cluster. Una
# fuente que está en un lado y no en el otro es exactamente la condición
# que hace peligroso el respaldo —capturar de menos sin enterarse— así
# que es un error y no una advertencia.
def fuentes():
    bases, buckets = [], []
    for f in sorted(os.listdir(DIR_ORGS)):
        if not f.endswith(".yaml"):
            continue
        d = yaml.safe_load(open(os.path.join(DIR_ORGS, f), encoding="utf-8"))
        org = d.get("organizacion") or d.get("nombre")
        ns = f"org-{org}"
        for s in d.get("servicios", []) or []:
            if s.get("tipo") == "postgres":
                bases.append({"org": org, "ns": ns, "servicio": s["nombre"],
                              "pod": f"{s['nombre']}-0",
                              "secreto": f"{s['nombre']}-credenciales"})
        if (d.get("almacenamiento") or {}).get("bucket"):
            buckets.append({"org": org, "ns": ns, "bucket": org})

    # contraste contra el cluster
    r = kubectl(["get", "statefulset", "-A", "-l", "aegis.dev/component=datos",
                 "--no-headers", "-o",
                 "custom-columns=NS:.metadata.namespace,N:.metadata.name"])
    if r.returncode != 0:
        morir("no pude leer los StatefulSet del cluster (¿kubeconfig?)")
    vivos = {tuple(l.split()) for l in r.stdout.splitlines() if l.strip()}
    declarados = {(b["ns"], b["servicio"]) for b in bases}
    if vivos != declarados:
        for x in sorted(vivos - declarados):
            print(f"  {rojo}!{fin} {x[0]}/{x[1]} vive en el CLUSTER y no sale de ningún "
                  f"contrato — quedaría SIN respaldar")
        for x in sorted(declarados - vivos):
            print(f"  {rojo}!{fin} {x[0]}/{x[1]} sale de un contrato y no está en el "
                  f"cluster — o no sincronizó, o el contrato miente")
        morir("los contratos y el cluster no coinciden: no se respalda a ciegas")
    return bases, buckets


# ── firma SigV4, mínima y sin dependencias ──────────────────────────
def _sign(key, msg):
    return hmac.new(key, msg.encode(), hashlib.sha256).digest()


def s3(metodo, host, ruta, query, ak, sk, region="garage", cuerpo=b""):
    t = datetime.datetime.now(datetime.timezone.utc)
    amz = t.strftime("%Y%m%dT%H%M%SZ")
    dia = t.strftime("%Y%m%d")
    hpay = hashlib.sha256(cuerpo).hexdigest()
    qs = "&".join(f"{urllib.parse.quote(k, safe='')}={urllib.parse.quote(v, safe='')}"
                  for k, v in sorted(query.items()))
    cr = (f"{metodo}\n{urllib.parse.quote(ruta)}\n{qs}\n"
          f"host:{host}\nx-amz-content-sha256:{hpay}\nx-amz-date:{amz}\n\n"
          f"host;x-amz-content-sha256;x-amz-date\n{hpay}")
    alcance = f"{dia}/{region}/s3/aws4_request"
    sts = (f"AWS4-HMAC-SHA256\n{amz}\n{alcance}\n"
           f"{hashlib.sha256(cr.encode()).hexdigest()}")
    k = _sign(_sign(_sign(_sign(("AWS4" + sk).encode(), dia), region), "s3"), "aws4_request")
    firma = hmac.new(k, sts.encode(), hashlib.sha256).hexdigest()
    cab = {
        "Authorization": (f"AWS4-HMAC-SHA256 Credential={ak}/{alcance}, "
                          f"SignedHeaders=host;x-amz-content-sha256;x-amz-date, "
                          f"Signature={firma}"),
        "x-amz-content-sha256": hpay, "x-amz-date": amz, "Host": host,
    }
    url = f"http://{host}{urllib.parse.quote(ruta)}" + (f"?{qs}" if qs else "")
    req = urllib.request.Request(url, data=cuerpo or None, headers=cab, method=metodo)
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return r.status, r.read(), dict(r.headers)
    except urllib.error.HTTPError as e:
        return e.code, e.read(), dict(e.headers)


class Tunel:
    """port-forward al S3 de Garage.

    Hace falta porque el 3900 sólo acepta tráfico de namespaces de
    inquilino, y el operador no es uno. El port-forward no viola esa
    regla: el tráfico nace en el nodo, que es donde vive el que respalda.
    """

    def __init__(self, ns, svc, puerto):
        self.ns, self.svc, self.puerto = ns, svc, puerto
        self.p = None
        self.local = None

    def __enter__(self):
        s = socket.socket(); s.bind(("127.0.0.1", 0))
        self.local = s.getsockname()[1]; s.close()
        self.p = subprocess.Popen(
            ["kubectl", "port-forward", "-n", self.ns, f"svc/{self.svc}",
             f"{self.local}:{self.puerto}"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(50):
            try:
                c = socket.create_connection(("127.0.0.1", self.local), 0.3); c.close()
                return self
            except OSError:
                time.sleep(0.2)
        self.__exit__(None, None, None)
        morir(f"el port-forward a {self.ns}/{self.svc}:{self.puerto} no levantó")

    def __exit__(self, *a):
        if self.p:
            self.p.terminate()
            try:
                self.p.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.p.kill()

    @property
    def host(self):
        return f"127.0.0.1:{self.local}"


# ── captura ─────────────────────────────────────────────────────────
def huella_credencial(ns, secreto):
    """sha256 de la contraseña viva, SIN traerla al bundle."""
    r = kubectl(["get", "secret", secreto, "-n", ns, "-o",
                 "jsonpath={.data.password}"])
    if r.returncode != 0 or not r.stdout.strip():
        return None
    return hashlib.sha256(base64.b64decode(r.stdout.strip())).hexdigest()


def psql(ns, pod, base, sql):
    """Una consulta de una línea contra una base, devuelve stdout."""
    r = kubectl(["exec", "-n", ns, pod, "--", "sh", "-c",
                 f'psql -U "$POSTGRES_USER" -d {base} -Atc {json.dumps(sql)}'])
    return (r.stdout or "").strip(), r.returncode


def inventario(ns, pod, base):
    """Tablas y filas de una base. Es contra esto que se verifica el restore.

    No alcanza con que psql termine sin gritar: el simulacro del
    2026-08-09 dejó la base BORRADA y el comando reportó éxito. Un
    restore tiene que MEDIR lo que consiguió, no confiar en su código de
    salida.
    """
    out, rc = psql(ns, pod, base,
                   "SELECT schemaname||'.'||relname FROM pg_stat_user_tables ORDER BY 1")
    if rc != 0:
        return None
    tablas = []
    for t in [x for x in out.splitlines() if x.strip()]:
        n, rc2 = psql(ns, pod, base, f'SELECT count(*) FROM {t}')
        tablas.append({"tabla": t, "filas": int(n) if rc2 == 0 and n.isdigit() else -1})
    return tablas


def bases_de(ns, pod):
    out, _ = psql(ns, pod, "postgres",
                  "SELECT datname FROM pg_database WHERE NOT datistemplate "
                  "AND datallowconn ORDER BY 1")
    return [x for x in out.splitlines() if x.strip()]


def capturar_base(b, destino):
    """Globals aparte, y una base por archivo. NO se usa pg_dumpall entero.

    Las dos razones salieron del simulacro, y la segunda casi rompe la
    organización de verdad:

    1. Sin `--clean`, restaurar sobre una base con datos los DUPLICA. Por
       poco no se ve: la primera prueba pareció salir bien porque la
       tabla que sobrevivía tenía primary key y rechazaba los INSERT
       repetidos. Con una tabla SIN restricción única, tres filas se
       convirtieron en seis.

    2. Pero `pg_dumpall --clean` emite `DROP DATABASE` y `DROP ROLE`, y
       el DROP ROLE del rol con el que uno está conectado FALLA SIEMPRE.
       Con ON_ERROR_STOP=1 eso aborta el restore JUSTO DESPUÉS de haber
       dropeado la base: la base desaparece y no se recrea. Pasó, en
       vivo, y encima el comando reportó éxito.

    La forma correcta es no dropear bases nunca: `pg_dumpall
    --globals-only` para los roles (que un `pg_dump` normal pierde) y un
    `pg_dump --clean --if-exists` por base, que borra y recrea los
    OBJETOS de adentro sin tocar el contenedor.
    """
    pod, ns = b["pod"], b["ns"]
    v = kubectl(["exec", "-n", ns, pod, "--", "postgres", "--version"])

    g = kubectl(["exec", "-n", ns, pod, "--", "sh", "-c",
                 'pg_dumpall -U "$POSTGRES_USER" --globals-only'], binario=True)
    if g.returncode != 0 or not g.stdout:
        morir(f"pg_dumpall --globals-only falló sobre {ns}/{pod}: "
              f"{(g.stderr or b'').decode(errors='replace')[:200]}")
    fg = f"{b['org']}-{b['servicio']}-globals.sql"
    open(os.path.join(destino, fg), "wb").write(g.stdout)

    bases = []
    for base in bases_de(ns, pod):
        d = kubectl(["exec", "-n", ns, pod, "--", "sh", "-c",
                     f'pg_dump -U "$POSTGRES_USER" --clean --if-exists -d {base}'],
                    binario=True)
        if d.returncode != 0:
            morir(f"pg_dump de {base} falló: "
                  f"{(d.stderr or b'').decode(errors='replace')[:200]}")
        fn = f"{b['org']}-{b['servicio']}-{base}.sql"
        open(os.path.join(destino, fn), "wb").write(d.stdout)
        bases.append({"nombre": base, "archivo": fn, "bytes": len(d.stdout),
                      "sha256": hashlib.sha256(d.stdout).hexdigest(),
                      "tablas": inventario(ns, pod, base)})

    return {
        "tipo": "postgres", "org": b["org"], "servicio": b["servicio"], "ns": ns,
        "motor": (v.stdout or "").strip(),
        "globals": {"archivo": fg, "bytes": len(g.stdout),
                    "sha256": hashlib.sha256(g.stdout).hexdigest()},
        "bases": bases,
        "bytes": len(g.stdout) + sum(x["bytes"] for x in bases),
        "credencial_sha256": huella_credencial(ns, b["secreto"]),
        "secreto": b["secreto"],
    }


def capturar_bucket(bk, destino):
    r = kubectl(["get", "secret", "garage", "-n", bk["ns"], "-o", "json"])
    if r.returncode != 0:
        morir(f"sin credencial S3 en {bk['ns']}/garage")
    d = json.loads(r.stdout)["data"]
    ak = base64.b64decode(d["AWS_ACCESS_KEY_ID"]).decode().strip()
    sk = base64.b64decode(d["AWS_SECRET_ACCESS_KEY"]).decode().strip()

    dir_obj = os.path.join(destino, f"{bk['org']}-bucket")
    os.makedirs(dir_obj, exist_ok=True)
    objetos = []
    with Tunel("garage-system", "garage", 3900) as t:
        cont, token = True, None
        while cont:
            q = {"list-type": "2"}
            if token:
                q["continuation-token"] = token
            st, cuerpo, _ = s3("GET", t.host, f"/{bk['bucket']}", q, ak, sk)
            if st != 200:
                morir(f"listar {bk['bucket']} dio HTTP {st}: {cuerpo[:200]!r}")
            raiz = ET.fromstring(cuerpo)
            nsx = {"s3": raiz.tag.split("}")[0].strip("{")} if "}" in raiz.tag else {}
            def h(n, p):
                return n.find(f"s3:{p}", nsx) if nsx else n.find(p)
            for c in (raiz.findall("s3:Contents", nsx) if nsx else raiz.findall("Contents")):
                clave = h(c, "Key").text
                st2, datos, cab = s3("GET", t.host,
                                     f"/{bk['bucket']}/{clave}", {}, ak, sk)
                if st2 != 200:
                    morir(f"bajar {clave} dio HTTP {st2}")
                seguro = clave.replace("/", "%2F")
                open(os.path.join(dir_obj, seguro), "wb").write(datos)
                objetos.append({"clave": clave, "archivo": seguro,
                                "bytes": len(datos),
                                "sha256": hashlib.sha256(datos).hexdigest()})
            tr = h(raiz, "IsTruncated")
            cont = tr is not None and tr.text == "true"
            nt = h(raiz, "NextContinuationToken")
            token = nt.text if nt is not None else None
    return {"tipo": "bucket", "org": bk["org"], "bucket": bk["bucket"],
            "directorio": f"{bk['org']}-bucket", "objetos": objetos,
            "total_bytes": sum(o["bytes"] for o in objetos)}


def edad_bundle(p):
    return (time.time() - os.path.getmtime(p)) / 3600.0


def capturar(raiz):
    """Un bundle por organización, cada uno en su carpeta.

    El recorrido sale de `fuentes()`, que ya cruza los contratos con el
    cluster y se niega a respaldar si discrepan. Acá solo se agrupa: una
    organización = una carpeta = un bundle.
    """
    raiz = preparar_raiz(raiz)
    print(f"{gris}fuentes (contratos ∩ cluster):{fin}")
    bases, buckets = fuentes()
    for b in bases:
        print(f"  {gris}·{fin} postgres  {b['ns']}/{b['servicio']}")
    for b in buckets:
        print(f"  {gris}·{fin} bucket    {b['bucket']}  {gris}(garage compartido){fin}")
    if not bases and not buckets:
        morir("ningún contrato declara datos que respaldar")

    pororg = {}
    for b in bases:
        pororg.setdefault(b["org"], ([], []))[0].append(b)
    for bk in buckets:
        pororg.setdefault(bk["org"], ([], []))[1].append(bk)

    sello = time.strftime("%Y%m%d-%H%M%S")
    rc = 0
    hechas = []
    for org in sorted(pororg):
        ob, obk = pororg[org]
        carpeta = os.path.join(raiz, f"org-{org}")
        os.makedirs(carpeta, exist_ok=True)
        # El nombre repite la organización aunque la carpeta ya lo diga:
        # un bundle que viaja solo —copiado a otro disco, adjuntado a un
        # ticket— tiene que poder decir qué es sin su contexto.
        salida = os.path.join(carpeta, f"aegis-datos-org-{org}-{sello}.age")
        print(f"\n{gris}── organización {org}{fin}")
        r = capturar_org(org, ob, obk, salida)
        rc |= r
        if r == 0:
            hechas.append(org)
    escribir_leeme(raiz, sorted(pororg), hechas, sello)
    return rc


def escribir_leeme(raiz, esperadas, hechas, sello):
    """El mapa del árbol de respaldos, para quien lo abra dentro de un año.

    Vive en la RAÍZ del destino y no en el repo, porque el momento en que
    hace falta es justamente aquél en el que no hay repo: un disco
    enchufado a otra máquina después de perder ésta. Un resguardo que no
    se sabe leer es medio resguardo.

    Y se REESCRIBE en cada captura en vez de escribirse una vez, por la
    razón de siempre: un archivo que se redacta a mano envejece y termina
    describiendo un árbol que ya no existe — con la particularidad de que
    acá nadie lo iba a contrastar nunca, porque este directorio no está
    versionado ni lo mira ningún chequeo de git. Derivado, no puede
    mentir más de lo que dura hasta la próxima corrida.

    Enumera las organizaciones que los CONTRATOS declaran, no las
    carpetas que hay: una carpeta que falta es exactamente el hallazgo, y
    listar el directorio la escondería.
    """
    faltan = [o for o in esperadas if o not in hechas]
    lineas = [
        "# Respaldos de aegis — cómo está armado esto",
        "",
        f"Última captura: {sello} (sello de los bundles de esa corrida).",
        "ESTE ARCHIVO LO ESCRIBE `aegis data --capturar`. No lo edites:",
        "la próxima captura lo pisa.",
        "",
        "## Qué hay en cada carpeta",
        "",
        "```",
        ".aegis-destino    la marca del disco. Si su UUID no coincide con el",
        "                  filesystem donde está esta carpeta, el disco de",
        "                  respaldos NO está montado y la captura se niega a",
        "                  escribir — sin eso el bundle caería en el mismo",
        "                  disco que tiene que sobrevivir.",
        "plataforma/       el ESTADO: secretos del store, traza del init,",
        "                  tfstate del borde. Lo escribe aegis state backup.",
        "org-<nombre>/     los DATOS de UNA organización: sus bases y sus",
        "                  objetos. Un bundle por organización, nunca",
        "                  compartido.",
        "```",
        "",
        "**Las dos mitades hacen falta.** Con el estado se levanta una",
        "plataforma vacía; con los datos se tiene un dump que no se sabe dónde",
        "poner.",
        "",
        "## Las organizaciones, según los contratos",
        "",
    ]
    for o in esperadas:
        if o in hechas:
            lineas.append(f"- `org-{o}/` — respaldada en esta corrida.")
        else:
            lineas.append(f"- `org-{o}/` — **SIN respaldo en esta corrida**: su "
                          "captura falló. Lo que haya en su carpeta es más viejo.")
    if faltan:
        lineas += ["",
                   "> Una organización que aparece acá y no tiene carpeta es una que",
                   "> NUNCA se respaldó. `aegis check` la enumera contra los",
                   "> contratos justamente para que esa ausencia tenga forma."]
    lineas += [
        "",
        "## El cifrado, y la única forma de perder todo esto",
        "",
        "Cada `.age` está cifrado con la clave PÚBLICA del par de aegis y se abre",
        "con la privada: `~/.config/sops/age/aegis.key`, la misma que usa SOPS",
        "para los `.enc` del repo. Un solo par para las dos cosas.",
        "",
        "**Esa clave NO está en ningún bundle**, a propósito y con una guarda que",
        "aborta la captura si aparece adentro. El huevo y la gallina en el mismo",
        "canasto no protegen de nada. Lo que se sigue de eso hay que decirlo:",
        "",
        "> **Si perdiste la age key, todo lo que hay en este disco es un**",
        "> **ladrillo.** No hay recuperación, ni parcial ni por fuerza bruta.",
        "> La clave va a un resguardo offline, y ése tiene que ser un lugar",
        "> DISTINTO de este disco — si viven juntos, un accidente se lleva las",
        "> dos mitades.",
        "",
        "El cifrado no es ceremonia: el bundle de `plataforma/` lleva el tfstate",
        "del túnel con su token EN CLARO. El `age` del bundle es lo único que lo",
        "protege.",
        "",
        "## Cómo se abre uno",
        "",
        "Sin nada de aegis, que es el caso para el que existe este archivo —",
        "este disco enchufado a otra máquina, sin repo. Alcanza con `age` y",
        "`tar`, y sale SQL y archivos planos:",
        "",
        "```",
        "age -d -i ~/.config/sops/age/aegis.key <bundle>.age | tar -xzvf -",
        "```",
        "",
        "Con el repo a mano hay comodidad —valida el manifiesto, compara",
        "credenciales, restaura contra la base correcta—, pero no es un formato",
        "propietario:",
        "",
        "```",
        "aegis data --listar    org-<org>/aegis-datos-org-<org>-<ts>.age",
        "aegis data --restaurar org-<org>/aegis-datos-org-<org>-<ts>.age --org <org>",
        "```",
        "",
        "`--listar` abre el bundle y dice qué trae sin restaurar nada.",
        "",
        "Todo bundle se verificó al escribirse: la herramienta lo descifra recién",
        "creado y lo compara byte a byte con lo que capturó. Si alguno dice",
        "NO-VERIFICADO, es que se produjo sin la clave privada a mano.",
        "",
        "## legado/",
        "",
        "Si existe, son bundles del formato viejo (anteriores al 2026-08-11) con",
        "TODAS las organizaciones adentro de un solo archivo. Su propio LEER.md",
        "lo explica. No se mueven a una carpeta `org-*` porque no son de una",
        "organización: contarlos como respaldo de una sería mentira.",
        "",
    ]
    with open(os.path.join(raiz, "LEER.md"), "w", encoding="utf-8") as f:
        f.write("\n".join(lineas))
    ok(f"LEER.md al día en {raiz} ({len(esperadas)} organización(es) según los contratos)")


def capturar_org(org, bases, buckets, salida):
    stage = tempfile.mkdtemp(prefix="aegis-resp-")
    pay = os.path.join(stage, "payload"); os.makedirs(pay)
    try:
        piezas = []
        for b in bases:
            m = capturar_base(b, pay); piezas.append(m)
            paso(f"postgres {m['org']}/{m['servicio']}: {m['bytes']} bytes "
                 f"({m['motor']})")
        for bk in buckets:
            m = capturar_bucket(bk, pay); piezas.append(m)
            paso(f"bucket {m['bucket']}: {len(m['objetos'])} objetos, "
                 f"{m['total_bytes']} bytes")

        man = {
            "version": 2,          # v2: un bundle = una organización
            "organizacion": org,
            "capturado": datetime.datetime.now(datetime.timezone.utc)
                          .strftime("%Y-%m-%dT%H:%M:%SZ"),
            "instancia": subprocess.run(
                ["kubectl", "get", "ns", "kube-system", "-o", "jsonpath={.metadata.uid}"],
                capture_output=True, text=True).stdout.strip(),
            "piezas": piezas,
        }
        with open(os.path.join(pay, "MANIFIESTO.json"), "w", encoding="utf-8") as f:
            json.dump(man, f, indent=2, ensure_ascii=False)

        # GUARDA DURA, la misma que aegis state backup: la age key jamás
        # entra al bundle. El huevo y la gallina no viajan juntos.
        for r_, _, fs in os.walk(pay):
            for x in fs:
                if x in ("aegis.key", "keys.txt") or x.endswith(".agekey"):
                    morir("el payload contiene material de la age key — ABORTADO")

        tgz = os.path.join(stage, "bundle.tgz")
        with tarfile.open(tgz, "w:gz") as tf:
            tf.add(pay, arcname=".")

        pub = os.environ.get("AGE_PUBLIC") or ""
        if not pub:
            key = os.environ.get("SOPS_AGE_KEY_FILE",
                                 os.path.expanduser("~/.config/sops/age/aegis.key"))
            if not os.path.exists(key):
                morir("sin AGE_PUBLIC ni age key para derivar el destinatario")
            pub = subprocess.run(["age-keygen", "-y", key],
                                 capture_output=True, text=True).stdout.strip()
        os.makedirs(os.path.dirname(salida) or ".", exist_ok=True)
        r = subprocess.run(["age", "-r", pub, "-o", salida, tgz],
                           capture_output=True, text=True)
        if r.returncode != 0:
            morir(f"age falló: {r.stderr.strip()[:200]}")
        os.chmod(salida, 0o600)
        ok(f"bundle age-cifrado → {salida} ({os.path.getsize(salida)} bytes)")

        # ── ROUNDTRIP. Sin esto es "tenemos backups", no restauración
        # probada. Se descifra de verdad y se compara byte a byte.
        key = os.environ.get("SOPS_AGE_KEY_FILE",
                             os.path.expanduser("~/.config/sops/age/aegis.key"))
        if not os.path.exists(key):
            print(f"  {ama}!{fin} sin age key privada: el bundle existe pero NO se "
                  f"verificó (DR sin prueba de restauración)")
            return 0
        ver = tempfile.mkdtemp(prefix="aegis-ver-")
        try:
            d = subprocess.run(["age", "-d", "-i", key, salida], capture_output=True)
            if d.returncode != 0:
                morir("el bundle no descifra con la age key — NO confiar en él")
            with tarfile.open(fileobj=__import__("io").BytesIO(d.stdout), mode="r:gz") as tf:
                tf.extractall(ver, filter="data")
            malas = []
            for p in piezas:
                if p["tipo"] == "postgres":
                    for pieza in [p["globals"]] + p["bases"]:
                        q = os.path.join(ver, pieza["archivo"])
                        if not os.path.exists(q) or \
                           hashlib.sha256(open(q, "rb").read()).hexdigest() != pieza["sha256"]:
                            malas.append(f"{p['org']}/{p['servicio']}:{pieza['archivo']}")
                else:
                    for o in p["objetos"]:
                        q = os.path.join(ver, p["directorio"], o["archivo"])
                        if not os.path.exists(q) or \
                           hashlib.sha256(open(q, "rb").read()).hexdigest() != o["sha256"]:
                            malas.append(f"{p['bucket']}:{o['clave']}")
            if malas:
                morir(f"ROUNDTRIP FALLÓ — no reproduce: {', '.join(malas)}")
            ok(f"ROUNDTRIP OK — el bundle descifra y reproduce las "
               f"{len(piezas)} piezas byte a byte")
        finally:
            shutil.rmtree(ver, ignore_errors=True)
    finally:
        shutil.rmtree(stage, ignore_errors=True)

    sink = os.environ.get("AEGIS_BACKUP_SINK")
    if sink:
        r = subprocess.run(["bash", "-c", sink, "aegis-sink", salida])
        if r.returncode != 0:
            morir(f"el sink FALLÓ — el bundle está en {salida} pero no salió de acá")
        ok("sink OK — el bundle salió de la máquina")
    else:
        print(f"  {ama}!{fin} sin AEGIS_BACKUP_SINK: el bundle queda en la MISMA "
              f"máquina que se quiere sobrevivir")
    return 0


# ── lectura y restauración ──────────────────────────────────────────
def abrir(bundle):
    key = os.environ.get("SOPS_AGE_KEY_FILE",
                         os.path.expanduser("~/.config/sops/age/aegis.key"))
    if not os.path.exists(key):
        morir(f"sin age key privada ({key}) — es el irreducible; sin ella el "
              f"bundle no descifra, y así debe ser")
    d = subprocess.run(["age", "-d", "-i", key, bundle], capture_output=True)
    if d.returncode != 0:
        morir(f"no descifra: {d.stderr.decode(errors='replace')[:200]}")
    tmp = tempfile.mkdtemp(prefix="aegis-rest-")
    with tarfile.open(fileobj=__import__("io").BytesIO(d.stdout), mode="r:gz") as tf:
        tf.extractall(tmp, filter="data")
    man = json.load(open(os.path.join(tmp, "MANIFIESTO.json"), encoding="utf-8"))
    return tmp, man


def listar(bundle):
    tmp, man = abrir(bundle)
    try:
        print(f"{gris}capturado:{fin} {man['capturado']}   "
              f"{gris}instancia:{fin} {man['instancia'][:12]}…")
        print(f"{gris}antigüedad:{fin} {edad_bundle(bundle):.1f} h\n")
        for p in man["piezas"]:
            if p["tipo"] == "postgres":
                print(f"  postgres  {p['org']}/{p['servicio']:10} {p['bytes']:>9} bytes  "
                      f"{gris}{p['motor']}{fin}")
                for b_ in p["bases"]:
                    tt = b_["tablas"] or []
                    print(f"            {gris}base {b_['nombre']}: {b_['bytes']} B, "
                          f"{len(tt)} tablas, {sum(x['filas'] for x in tt)} filas{fin}")
                print(f"            {gris}credencial esperada sha256:"
                      f"{(p.get('credencial_sha256') or '?')[:16]}…{fin}")
            else:
                print(f"  bucket    {p['bucket']:20} {len(p['objetos'])} objetos, "
                      f"{p['total_bytes']} bytes")
                for o in p["objetos"][:5]:
                    print(f"            {gris}{o['clave']}  {o['bytes']} B{fin}")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return 0


def bajar_consumidores(ns):
    """Escala a cero lo que pueda tener la base abierta, y recuerda a cuánto.

    ArgoCD tiene selfHeal en estas apps, así que va a querer devolver las
    réplicas. La ventana es de segundos y el restore es más rápido, pero
    si alguna vez deja de serlo el síntoma sería un DROP DATABASE que
    falla, no datos corrompidos — que es el modo de fallar correcto.
    """
    r = kubectl(["get", "deploy", "-n", ns, "-o",
                 "jsonpath={range .items[*]}{.metadata.name} {.spec.replicas}{\"\\n\"}{end}"])
    previos = {}
    for l in (r.stdout or "").splitlines():
        if not l.strip():
            continue
        n, rep = l.split()
        previos[n] = int(rep)
    for n, rep in previos.items():
        if rep:
            kubectl(["scale", "deploy", n, "-n", ns, "--replicas=0"])
    if previos:
        paso(f"consumidores abajo: {', '.join(f'{n}({r})' for n, r in previos.items())}")
        for _ in range(30):
            q = kubectl(["get", "pods", "-n", ns, "-l", "!aegis.dev/component",
                         "--no-headers"])
            if not (q.stdout or "").strip():
                break
            time.sleep(2)
    return previos


def subir_consumidores(ns, previos):
    for n, rep in previos.items():
        if rep:
            kubectl(["scale", "deploy", n, "-n", ns, f"--replicas={rep}"])
    if previos:
        paso(f"consumidores arriba de nuevo: "
             f"{', '.join(f'{n}({r})' for n, r in previos.items())}")


def cortar_conexiones(ns, pod):
    """Las sesiones que queden después de bajar los pods.

    Un pod que se está yendo puede dejar la conexión un rato, y basta UNA
    para que DROP DATABASE falle.
    """
    kubectl(["exec", "-n", ns, pod, "--", "sh", "-c",
             'psql -U "$POSTGRES_USER" -d postgres -Atc '
             '"SELECT pg_terminate_backend(pid) FROM pg_stat_activity '
             'WHERE pid <> pg_backend_pid() AND datname IS NOT NULL;"'])


def restaurar(bundle, org, force):
    tmp, man = abrir(bundle)
    try:
        piezas = [p for p in man["piezas"] if p["org"] == org]
        if not piezas:
            morir(f"el bundle no tiene nada de {org!r}. Hay: "
                  f"{', '.join(sorted({p['org'] for p in man['piezas']}))}")
        for p in piezas:
            if p["tipo"] != "postgres":
                print(f"  {ama}!{fin} {p['bucket']}: la restauración de objetos "
                      f"todavía no está implementada; el bundle SÍ los tiene")
                continue

            # LA GUARDA QUE EVITA "restauré y no conecta": el dump trae
            # el hash SCRAM del rol, así que la base restaurada volverá a
            # esperar la contraseña que había AL CAPTURAR. Si el Secret
            # rotó desde entonces, restaurar deja la base pidiendo una y
            # el pod presentando otra, y el síntoma —auth failed— no se
            # parece a la causa.
            viva = huella_credencial(p["ns"], p["secreto"])
            esperada = p.get("credencial_sha256")
            if esperada and viva and viva != esperada:
                msg = (f"la credencial de {p['ns']}/{p['secreto']} ROTÓ después de "
                       f"esta captura.\n"
                       f"      El dump reinstalará la contraseña vieja y el pod "
                       f"presentará la nueva.\n"
                       f"      Restaurá también el Secret desde git al commit de "
                       f"esa fecha, o rotá\n"
                       f"      la credencial DESPUÉS de restaurar.")
                if not force:
                    morir(msg)
                print(f"  {ama}!{fin} {msg}\n      {ama}--force: sigo igual{fin}")

            pod = f"{p['servicio']}-0"
            for pieza in [p["globals"]] + p["bases"]:
                b_ = open(os.path.join(tmp, pieza["archivo"]), "rb").read()
                if hashlib.sha256(b_).hexdigest() != pieza["sha256"]:
                    morir(f"{pieza['archivo']} no coincide con su sha256 del manifiesto")

            # ── EL PROTOCOLO, que es más que un `psql <` ────────────
            #
            # Se bajan los consumidores porque un pg_dump con --clean
            # dropea objetos que la app puede estar usando. Y se vuelven
            # a subir PASE LO QUE PASE: si el restore muere a la mitad,
            # dejar la organización en cero réplicas convertiría una
            # restauración fallida en una caída.
            consumidores = bajar_consumidores(p["ns"])
            try:
                cortar_conexiones(p["ns"], pod)

                # Globals SIN ON_ERROR_STOP: los roles ya existen y
                # decirlo es ruido esperado, no una falla.
                g = open(os.path.join(tmp, p["globals"]["archivo"]), "rb").read()
                kubectl(["exec", "-i", "-n", p["ns"], pod, "--", "sh", "-c",
                         'psql -U "$POSTGRES_USER" -d postgres -v ON_ERROR_STOP=0'],
                        binario=True, entrada=g)
                paso(f"roles restaurados ({len(g)} bytes)")

                for base in p["bases"]:
                    vivas = bases_de(p["ns"], pod)
                    if base["nombre"] not in vivas:
                        psql(p["ns"], pod, "postgres",
                             f'CREATE DATABASE "{base["nombre"]}"')
                        paso(f"base {base['nombre']} no existía: recreada")
                    sql = open(os.path.join(tmp, base["archivo"]), "rb").read()
                    r = kubectl(["exec", "-i", "-n", p["ns"], pod, "--", "sh", "-c",
                                 f'psql -U "$POSTGRES_USER" -d {base["nombre"]} '
                                 f'-v ON_ERROR_STOP=1'],
                                binario=True, entrada=sql)
                    err = (r.stderr or b"").decode(errors="replace")
                    graves = [l for l in err.splitlines() if "ERROR" in l]
                    if graves:
                        print(f"  {rojo}!{fin} psql sobre {base['nombre']}:")
                        for l in graves[:8]:
                            print(f"      {gris}{l}{fin}")
                    paso(f"base {base['nombre']} aplicada ({len(sql)} bytes)")
            finally:
                subir_consumidores(p["ns"], consumidores)

            # ── VERIFICACIÓN, la parte que faltaba ──────────────────
            #
            # El 2026-08-09 una restauración dejó la base BORRADA y
            # reportó éxito, porque miraba el código de salida de psql y
            # no el resultado. Ahora se vuelve a medir el inventario y se
            # compara contra el que se guardó al capturar. Si no
            # coincide, no está restaurado, diga lo que diga psql.
            problemas = []
            vivas = bases_de(p["ns"], pod)
            for base in p["bases"]:
                if base["nombre"] not in vivas:
                    problemas.append(f"la base {base['nombre']} NO EXISTE")
                    continue
                ahora = {t["tabla"]: t["filas"] for t in (inventario(p["ns"], pod, base["nombre"]) or [])}
                for t in base["tablas"] or []:
                    if t["tabla"] not in ahora:
                        problemas.append(f"{base['nombre']}: falta la tabla {t['tabla']}")
                    elif ahora[t["tabla"]] != t["filas"]:
                        problemas.append(
                            f"{base['nombre']}.{t['tabla']}: {ahora[t['tabla']]} filas, "
                            f"se esperaban {t['filas']}")
            if problemas:
                for x in problemas[:12]:
                    print(f"  {rojo}✗{fin} {x}")
                morir(f"{p['org']}/{p['servicio']}: la restauración NO reproduce lo "
                      f"capturado — no la doy por buena")
            n_t = sum(len(b_["tablas"] or []) for b_ in p["bases"])
            ok(f"{p['org']}/{p['servicio']} restaurado y VERIFICADO "
               f"({len(p['bases'])} bases, {n_t} tablas, filas coinciden)")
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    return 0


def main():
    # Regla 1: verbos, no flags. Y el mismo par de nombres que
    # `aegis state`, porque son la misma operación sobre otra cosa:
    # `state` es la MÁQUINA, `data` son los DATOS de los inquilinos.
    ap = argparse.ArgumentParser(prog=cli.cmd("data"))
    sub = ap.add_subparsers(dest="verbo", required=True)
    s = sub.add_parser("backup", help=f"un bundle por organización (default: {DESTINO_DEF})")
    s.add_argument("directorio", nargs="?", default="", metavar="DIRECTORIO")
    s = sub.add_parser("list", help="qué hay adentro de un bundle, sin restaurar")
    s.add_argument("bundle", metavar="BUNDLE.age")
    s = sub.add_parser("restore", help="restaura los datos de UNA organización")
    s.add_argument("bundle", metavar="BUNDLE.age")
    s.add_argument("--org", required=True,
                   help="restaurar TODO de una vez no es una operación que convenga hacer fácil")
    s.add_argument("--force", action="store_true",
                    help="seguir aunque la credencial haya rotado desde la captura")
    a = ap.parse_args()
    a.capturar  = a.directorio if a.verbo == "backup" else None
    a.listar    = a.bundle if a.verbo == "list" else None
    a.restaurar = a.bundle if a.verbo == "restore" else None
    if a.verbo != "restore":
        a.org = None
        a.force = False

    if a.listar:
        return listar(a.listar)
    if a.restaurar:
        return restaurar(a.restaurar, a.org, a.force)

    return capturar(a.capturar or DESTINO_DEF)


if __name__ == "__main__":
    sys.exit(main())
