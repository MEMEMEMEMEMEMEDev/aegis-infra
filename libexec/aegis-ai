#!/usr/bin/env bash
# aegis-summary: The operator's control over the AI substrate
# aegis-group:   operate
# aegis-subcommands: status start stop open demo max logs engine-logs
# ai — the operator's control over the AI substrate.
#
# ONE SINGLE SOURCE OF TRUTH: this script writes the ai-modo ConfigMap and
# nothing else. It scales nothing, it touches no pods, it does not talk to
# the gateway. The one that scales is ai-modo-controller, which watches
# that ConfigMap. If tomorrow the mode is changed from somewhere else (a
# panel, a webhook), the effect is the same because the effect is produced
# by the controller, not by whoever writes.
#
# THE AUTOMATION ONLY SHUTS DOWN. This script is the ONLY thing that turns
# on, and it is a deliberate human act. There is no auto-open, there is no
# scale-from-zero per request: if somebody enters the portfolio at 4 AM
# they see the world asleep, and that is correct.
#
# The VRAM check lives HERE and not in the cluster because here is where
# nvidia-smi really exists. Starting the engine with the desktop occupying
# VRAM cuts the KV cache PERMANENTLY until the next restart (35,616 ->
# 27,840 tokens measured, -22%) and with that it halves the real
# concurrency. Zero complexity inside the cluster for a problem that lives
# outside it.

set -euo pipefail

NS=ai-system
CM=ai-modo
# The fleet (#97): they all go up and down with the mode, through the
# controller.
ENGINES="engine-llm engine-charla"
# HOW MUCH FOREIGN VRAM IS TOLERATED BEFORE STARTING THE ENGINE.
#
# The number is NOT a matter of taste: it comes out of the profile's
# GPU_MEM_UTIL (k8s/base/ai-system/engine-llm.yaml). They measure the two
# halves of the same pie.
#
# HISTORY, because every move cost something:
#
#   900   inherited from the ai-server preflight on metal. It became
#         INCONSISTENT on 2026-08-07 when GPU_MEM_UTIL dropped from 0.90 to
#         0.87 (the startup OOM): by reserving less, the desktop could use
#         more, but the threshold stayed at the old number and went on
#         blocking startups that already fitted. It showed up with 916
#         MiB in use — it cut off over SIXTEEN megs while ~430 were to
#         spare.
#   1100  with GPU_MEM_UTIL 0.87.
#   1700  with 0.82 (2026-08-15): the operator's desktop grazed the
#         ceiling at rest and turning on meant closing windows.
#   4390  with 0.60 (2026-08-15), on moving from qwen3-4b to Hy-MT2-1.8B.
#
# The profile's comment already said "if one day the preflight's threshold
# moves, this number moves with it". That holds in both directions, and
# the first time it was needed it was the other way round.
#
# The two numbers are ONE single decision spread across two files, and
# moving them separately is exactly the OOM of 2026-08-07 or a preflight
# that lies.
#
# The arithmetic of today's number (#97, two engines coexisting):
#
#   total 12227 MiB - (0.38 + 0.38) * 12227 = 2934 free
#   minus ~400 that the TWO vLLMs go over their budget by (~200 each)
#   minus ~300 of margin
#   = 2200 MiB of desktop tolerated
#
#   (history: 4390 with a single engine at 0.60, 2026-08-15→08-17)
#
# The desktop gives up cushion in exchange for the second model: Chrome
# with video fits by a hair, and if one day it gets tight, the way out is
# the 4090 — not going back to a single lane.
VRAM_LIMIT_MIB=2200

red()   { printf '\033[31m%s\033[0m\n' "$*"; }
green() { printf '\033[32m%s\033[0m\n' "$*"; }
gray()  { printf '\033[90m%s\033[0m\n' "$*"; }

usage() {
  cat <<'EOF'
aegis ai — control of the AI substrate

  aegis ai status                what is happening right now
  aegis ai start [hours]         opens the working day: turns the GPU on for
                                 N hours (default 8; it closes itself — or
                                 earlier with stop)
  aegis ai stop [reason]         turns the GPU off
  aegis ai open [--until HH:MM]  turns the GPU on (checks the VRAM first)
  aegis ai demo [minutes]        turns on with wide budgets and a TTL
                                 (default 60 min; it closes itself)
  aegis ai max [--until HH:MM]   wide budgets without a TTL
  aegis ai logs [-f]             the gateway's logs
  aegis ai engine-logs [-f]      the engine's logs

`start` and not `init`: `init` is already the name of the command that
installs the whole platform, and two things with the same name doing
different things is exactly the kind of collision that gets paid for at
3 AM. The `abrir`/`cerrar` aliases died: they were two names for the same
gesture, and the one that survives is the one that states the duration.

Options:
  --force    skips the VRAM check (know what you are doing: starting with
             dirty VRAM cuts the KV cache permanently)

The mode lives in the ai-modo ConfigMap of ai-system. This script is the
only thing that writes it by hand; the controller applies it.
EOF
}

vram_used_mib() {
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    echo -1; return
  fi
  nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits 2>/dev/null | head -1 | tr -d ' '
}

who_is_using_the_gpu() {
  nvidia-smi --query-compute-apps=pid,process_name,used_memory \
    --format=csv,noheader 2>/dev/null || true
}

vram_preflight() {
  # IF THE ENGINE IS ALREADY UP, THIS CHECK DOES NOT APPLY.
  #
  # It exists to protect ONE moment: vLLM's startup, which reserves its
  # KV cache in one go and for good. If it starts with a dirty GPU, it is
  # left with less cache until somebody restarts it. None of that is about
  # to happen if the engine is already running: `ai open` over a started
  # engine only moves the mode and its expiry.
  #
  # And without this exit the check bites its own tail, because
  # `nvidia-smi` reports the TOTAL VRAM in use and the engine itself is
  # ~10.4 GB of that. It happened twice on 2026-08-08: `ai demo` refused
  # to extend an already open window by counting the engine's own memory
  # as foreign, and sending you to "close that and retry" — where "that"
  # was precisely what you wanted to keep alive. The only way out was
  # --force, which skips the whole check (#38).
  local e reps
  for e in $ENGINES; do
    reps=$(kubectl get deploy "$e" -n "$NS" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 0)
    if [ "${reps:-0}" -gt 0 ] 2>/dev/null; then
      green "  the fleet is already up ($e with replicas): there is no startup to protect"
      gray  "  (this preflight looks after the KV cache reservation, which is made ONCE at startup)"
      return 0
    fi
  done

  local used; used=$(vram_used_mib)
  if [ "$used" = "-1" ]; then
    gray "  (no nvidia-smi: the VRAM could not be checked)"
    return 0
  fi
  if [ "$used" -le "$VRAM_LIMIT_MIB" ]; then
    green "  VRAM free: ${used} MiB in use (limit ${VRAM_LIMIT_MIB})"
    return 0
  fi
  red "  DIRTY VRAM: ${used} MiB in use, above ${VRAM_LIMIT_MIB}."
  echo
  echo "  Starting like this cuts the engine's KV cache permanently"
  echo "  (until the next restart) and halves the real concurrency."
  echo
  echo "  What is using the GPU right now:"
  who_is_using_the_gpu | sed 's/^/    /'
  echo
  echo "  Close that and retry, or force it with:  ${AEGIS_CMD:-aegis} ai open --force"
  return 1
}

# expiry_from_hhmm HH:MM -> RFC3339 in UTC. If the hour has already gone
# by today, it is understood to be tomorrow.
expiry_from_hhmm() {
  local hhmm="$1" ts now
  ts=$(date -d "today $hhmm" +%s 2>/dev/null) || {
    red "invalid hour: $hhmm (HH:MM expected)"; exit 1; }
  now=$(date +%s)
  [ "$ts" -le "$now" ] && ts=$(date -d "tomorrow $hhmm" +%s)
  date -u -d "@$ts" +%Y-%m-%dT%H:%M:%SZ
}

write_mode() {
  local mode="$1" expiry="$2" reason="$3"
  kubectl patch configmap "$CM" -n "$NS" --type merge -p "$(cat <<EOF
{"data":{"modo":"$mode","vence":"$expiry","motivo":"$reason","actualizado":"$(date -u +%Y-%m-%dT%H:%M:%SZ)"}}
EOF
)" >/dev/null
}

cmd_status() {
  local mode expiry reason updated used
  mode=$(kubectl get cm "$CM" -n "$NS" -o jsonpath='{.data.modo}' 2>/dev/null || echo "?")
  expiry=$(kubectl get cm "$CM" -n "$NS" -o jsonpath='{.data.vence}' 2>/dev/null || true)
  reason=$(kubectl get cm "$CM" -n "$NS" -o jsonpath='{.data.motivo}' 2>/dev/null || true)
  updated=$(kubectl get cm "$CM" -n "$NS" -o jsonpath='{.data.actualizado}' 2>/dev/null || true)
  used=$(vram_used_mib)

  # An unknown mode is NOT painted green. The case that matters is "the
  # ConfigMap does not exist": with an optimistic green, the operator
  # would believe it is closed when in fact they know nothing.
  case "$mode" in
    cerrado)          red   "mode: cerrado" ;;
    abierto|demo|max) green "mode: $mode" ;;
    ""|"?")           red   "mode: UNKNOWN — the ConfigMap $CM in $NS could not be read" ;;
    *)                red   "mode: $mode (INVALID — the controller will treat it as cerrado)" ;;
  esac
  [ -n "$reason" ] && gray "  reason: $reason"
  [ -n "$expiry" ] && gray "  expires: $expiry (UTC)  ->  $(date -d "$expiry" '+%H:%M' 2>/dev/null || echo '?') local"
  [ -n "$updated" ] && gray "  updated: $updated"

  echo
  local e replicas ready
  for e in $ENGINES; do
    replicas=$(kubectl get deploy "$e" -n "$NS" -o jsonpath='{.spec.replicas}' 2>/dev/null || echo "?")
    ready=$(kubectl get deploy "$e" -n "$NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo 0)
    if [ "${ready:-0}" = "1" ]; then
      green "$e: ready"
    elif [ "$replicas" = "1" ]; then
      echo "$e: warming up... (measured startup: ~62 s)"
    else
      gray "$e: off"
    fi
  done
  [ "$used" != "-1" ] && gray "  VRAM: ${used} MiB in use"

  echo
  local gw
  gw=$(kubectl get deploy ai-gateway -n "$NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo 0)
  if [ "${gw:-0}" = "1" ]; then
    green "gateway: up"
  else
    red "gateway: NOT available"
  fi
  local ctl
  ctl=$(kubectl get deploy ai-modo-controller -n "$NS" -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo 0)
  if [ "${ctl:-0}" = "1" ]; then
    green "controller: up"
  else
    red "controller: NOT available  (the mode is not going to be applied)"
  fi
}

main() {
  local cmd="${1:-status}"; shift || true
  local force=0 until_hhmm="" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --until) until_hhmm="${2:-}"; shift ;;
      *) args+=("$1") ;;
    esac
    shift
  done

  case "$cmd" in
    status) cmd_status ;;

    # init/stop — the two everyday gestures, to be typed without looking
    # at the help: `ai init` opens the working day and `ai stop` ends it.
    # They are sugar over open/close: same mode, same ConfigMap, same
    # controller. The difference from `open` is that the expiry is given
    # in HOURS FROM NOW (not in clock time) and that there is ALWAYS one:
    # a working day opened with no scheduled end depends on the operator
    # remembering to close it, and a GPU left on in the small hours is no
    # longer a deliberate human act — it is a slip.
    start)
      local hours="${args[0]:-8}"
      case "$hours" in
        ''|*[!0-9]*) red "invalid hours: $hours (an integer is expected)"; exit 1 ;;
      esac
      echo "Starting the working day (${hours} h)..."
      if [ "$force" -eq 0 ]; then vram_preflight || exit 1
      else gray "  (--force: VRAM check skipped)"; fi
      local expiry; expiry=$(date -u -d "+${hours} hours" +%Y-%m-%dT%H:%M:%SZ)
      write_mode "abierto" "$expiry" "working day of ${hours} h (${AEGIS_CMD:-aegis} ai start)"
      green "mode abierto until $expiry UTC ($(date -d "$expiry" '+%H:%M' 2>/dev/null || echo '?') local) — it closes itself"
      gray "  the engine takes ~62 s to be ready; watch it with: ${AEGIS_CMD:-aegis} ai status"
      gray "  to cut it short: ai stop"
      ;;

    open)
      echo "Opening..."
      if [ "$force" -eq 0 ]; then vram_preflight || exit 1
      else gray "  (--force: VRAM check skipped)"; fi
      local expiry=""
      [ -n "$until_hhmm" ] && expiry=$(expiry_from_hhmm "$until_hhmm")
      write_mode "abierto" "$expiry" "${args[0]:-opened by the operator}"
      green "mode abierto${expiry:+ until $expiry UTC}"
      gray "  the engine takes ~62 s to be ready; watch it with: ${AEGIS_CMD:-aegis} ai status"
      ;;

    demo)
      local minutes="${args[0]:-60}"
      echo "Demo for ${minutes} min..."
      if [ "$force" -eq 0 ]; then vram_preflight || exit 1
      else gray "  (--force: VRAM check skipped)"; fi
      local expiry; expiry=$(date -u -d "+${minutes} minutes" +%Y-%m-%dT%H:%M:%SZ)
      write_mode "demo" "$expiry" "demo of ${minutes} min"
      green "mode demo until $expiry UTC — it closes itself"
      ;;

    max)
      echo "Mode max..."
      if [ "$force" -eq 0 ]; then vram_preflight || exit 1
      else gray "  (--force: VRAM check skipped)"; fi
      local expiry=""
      [ -n "$until_hhmm" ] && expiry=$(expiry_from_hhmm "$until_hhmm")
      write_mode "max" "$expiry" "${args[0]:-max by the operator}"
      green "mode max${expiry:+ until $expiry UTC}"
      [ -z "$expiry" ] && gray "  without an expiry: remember to close it (or use --until)"
      ;;

    stop)
      write_mode "cerrado" "" "${args[0]:-closed by the operator}"
      green "mode cerrado — the controller brings the engine down in seconds"
      ;;

    # ${args[@]+...} and not ${args[@]}: with `set -u` an expansion of an
    # empty array is an error in bash, and `ai log` with no arguments is
    # the normal case.
    logs)        kubectl logs -n "$NS" deploy/ai-gateway ${args[@]+"${args[@]}"} ;;
    engine-logs) kubectl logs -n "$NS" deploy/"$ENGINE" ${args[@]+"${args[@]}"} ;;

    -h|--help|help) usage ;;
    *) red "unknown command: $cmd"; echo; usage; exit 1 ;;
  esac
}

main "$@"
