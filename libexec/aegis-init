#!/usr/bin/env bash
# aegis-summary: Levanta la plataforma entera, fase por fase
# aegis-group:   setup
# aegis-init — orquestador del bootstrap completo de aegis (v2).
#
# USO:
#   ./aegis-init.sh [--profile greenfield|hetzner] [--from FASE]
#                   [--only FASE] [--check] [--configure] [--list]
#                   [--reset-state] [--non-interactive]
#
# --non-interactive (P0 auditoría 2026-07-18): corrida SIN operador
# (VM desechable / CI del init). human_step y gate_red se
# auto-confirman (logueado); los secretos de entrada van por archivo:
#   CF_MASTER_FILE        credencial maestra CF (tmpfs, se consume)
#   AEGIS_AGE_BACKUP_FILE destino del resguardo de la age key (tmpfs
#                         del OPERADOR — el init la escribe ahí en
#                         vez de mostrarla; moverla a resguardo real
#                         es responsabilidad de quien lanzó la corrida)
# Requiere aegis-init.conf pre-hecho (el wizard no corre sin TTY) y
# sudo NOPASSWD ya configurado (la fase 00 lo verifica temprano).
#
# CONFIG: guiada e interactiva (el wizard pregunta campo por campo
# con defaults y validación — lib/config.sh). Corre sola la primera
# vez (fase 00) o con --configure; un aegis-init.conf pre-hecho se
# respeta (re-corridas/automatización). El operador NUNCA "completa
# un archivo en blanco".
#
# DISEÑO (ver platform/docs/architecture/bootstrap.md):
#  - Fases numeradas idempotentes en phases/NN-nombre.sh, ejecutadas
#    en orden lexicográfico ESTRICTO (no saltar: el orden es el
#    contrato — dependencias reales, doc 26 Parte V).
#  - Estado en .init-state/ (un marker por fase completa): --from
#    retoma tras cualquier corte (pausas humanas incluidas — son el
#    caso normal, no la excepción).
#  - --check: dry-run (muta nada; las LECTURAS sí corren).
#  - Perfiles: greenfield (default) | hetzner (deltas: cilium,
#    registries.yaml por nodo, storageclass, réplicas). El perfil
#    re-bootstrap NO está implementado en v1 (límite conocido:
#    import de recursos vivos sin procedimiento — 27 §2.4/H5).
#
# ESTADO ARTEFACTO: estructura y detalle completos (E1-E10); queda
# la validación en entorno virgen (ver PROGRESO.md / bootstrap.md).

set -euo pipefail

# El PRODUCTO: este archivo vive en $AEGIS_ROOT/libexec/. readlink -f
# y no dirname a secas porque la fase 05 instala /usr/local/bin/aegis
# como SYMLINK al producto (03 §7): sin resolverlo, AEGIS_ROOT sería
# /usr/local y el init no encontraría ni sus fases ni sus libs.
# Si bin/aegis ya lo exportó, se respeta (no se recalcula seis veces).
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} init: falta readlink — no adivino dónde vive el producto" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT

export PROFILE=greenfield CHECK_MODE=false FORCE_CONFIGURE=false
export AEGIS_NONINTERACTIVE="${AEGIS_ASSUME_YES:-false}"
FROM_PHASE="" ONLY_PHASE="" DO_LIST=false DO_RESET=false

while (($#)); do case "$1" in
    --profile)     PROFILE="$2"; shift 2 ;;
    --from)        FROM_PHASE="$2"; shift 2 ;;
    --only)        ONLY_PHASE="$2"; shift 2 ;;
    --check)       CHECK_MODE=true; shift ;;
    --configure)   FORCE_CONFIGURE=true; shift ;;
    --list)        DO_LIST=true; shift ;;
    --reset-state) DO_RESET=true; shift ;;
    --non-interactive) AEGIS_NONINTERACTIVE=true; shift ;;
    *) echo "flag desconocida: $1" >&2; exit 2 ;;
esac; done

case "$PROFILE" in greenfield|hetzner) ;; *)
    echo "perfil '$PROFILE' no soportado en v1 (greenfield|hetzner)" >&2
    exit 2 ;;
esac

# shellcheck source=lib/common.sh
source "$AEGIS_ROOT/lib/common.sh"
# shellcheck source=lib/checks.sh
source "$AEGIS_ROOT/lib/checks.sh"
# shellcheck source=lib/secrets.sh
source "$AEGIS_ROOT/lib/secrets.sh"
# shellcheck source=lib/jenkins.sh
source "$AEGIS_ROOT/lib/jenkins.sh"
# shellcheck source=lib/config.sh
source "$AEGIS_ROOT/lib/config.sh"
# access.sh aporta edge_origen_responde/curl_access: desde #76 los
# hostnames del plano de operador están detrás de Cloudflare Access, y
# las fases 35 y 60 los sondean. Sin esto, esas sondas miden el borde
# de Cloudflare y no el cluster (#87).
# shellcheck source=lib/access.sh
source "$AEGIS_ROOT/lib/access.sh"

$DO_RESET && { clear_state; log_ok "estado reseteado"; }

# ── guard temprano de TTY (P0 auditoría 2026-07-18) ─────────────────
# Sin TTY y sin --non-interactive, la corrida iba a morir en el
# PRIMER read (EOF) — a veces a 30 min de camino. Morir ACÁ, con la
# remediación en el mensaje:
if ! ni_mode && [[ "$CHECK_MODE" != "true" && ! -t 0 ]] \
   && ! $DO_LIST; then
    die "sin terminal (stdin no es TTY) y sin --non-interactive — para corridas desatendidas: --non-interactive + aegis-init.conf pre-hecho + CF_MASTER_FILE/AEGIS_AGE_BACKUP_FILE"
fi

mapfile -t PHASES < <(find "$AEGIS_ROOT/init/phases" -name '[0-9][0-9]-*.sh' \
                      | sort)
# P3 auditoría: phases/ vacío caía al log final "todas las fases
# solicitadas completas" con exit 0 — un falso TODO-OK estructural:
(( ${#PHASES[@]} > 0 )) || \
    die "no hay fases en $AEGIS_ROOT/init/phases (¿artefacto a medias?) — nada que ejecutar NO es éxito"

if $DO_LIST; then
    for p in "${PHASES[@]}"; do
        local_name="$(basename "$p" .sh)"
        state=" "
        is_done "$local_name" && state="✔"
        printf ' [%s] %s\n' "$state" "$local_name"
    done
    exit 0
fi

# ── validar nombres de fase ANTES del loop (bug corrida #10) ────────
# --from con un nombre inexistente (p.ej. "30-helm" cuando la fase se
# llama "30-argocd") hacía que el loop skipeara TODO y reportara
# "todas las fases solicitadas completas" — un falso "todo listo".
# Nombre desconocido = error duro, con la lista real a mano.
# P3 auditoría: el match por prefijo aceptaba AMBIGÜEDAD en silencio
# (--from 1 matcheaba 10/12/15 y arrancaba en la 10 sin aviso). Un
# prefijo vale SOLO si identifica exactamente UNA fase:
phase_check_unique() {   # <flag> <query>
    local flag="$1" q="$2" p matches=()
    for p in "${PHASES[@]}"; do
        [[ "$(basename "$p" .sh)" == "$q"* ]] && matches+=("$(basename "$p" .sh)")
    done
    (( ${#matches[@]} == 1 )) && return 0
    if (( ${#matches[@]} == 0 )); then
        die "fase desconocida en $flag: '$q' — fases: $PHASE_NAMES"
    fi
    die "$flag '$q' es AMBIGUO — matchea: ${matches[*]} (usar el prefijo numérico completo)"
}
PHASE_NAMES="$(basename -s .sh "${PHASES[@]}" | tr '\n' ' ')"
[[ -z "$FROM_PHASE" ]] || phase_check_unique --from "$FROM_PHASE"
[[ -z "$ONLY_PHASE" ]] || phase_check_unique --only "$ONLY_PHASE"

log_info "${AEGIS_CMD:-aegis} init — perfil=$PROFILE check=$CHECK_MODE"
log_info "root=$AEGIS_ROOT"

# ── estado re-derivable por fase (bug 5 corrida #2) ─────────────────
# NINGUNA fase depende del export de una fase anterior: todo estado
# necesario se RE-DERIVA acá desde su fuente en disco, antes de CADA
# fase. Misma familia que el bug AGE_PUBLIC: estado que muere en el
# límite de proceso — el fix es derivar, no acarrear.
phase_env() {
    local age_ops="$HOME/.config/sops/age/aegis.key"
    [[ -f "$age_ops" ]] && export SOPS_AGE_KEY_FILE="$age_ops"
    [[ -f "$AEGIS_HOME/.age-public" ]] && \
        AGE_PUBLIC="$(cat "$AEGIS_HOME/.age-public")" && \
        export AGE_PUBLIC
    # bug 5 validación #3: aun con esto, el entorno tuvo huecos en el
    # camino --from. La red de seguridad REAL es sops_env() en cada
    # función de lib/secrets.sh que use sops (derivación en el punto
    # de uso). Esto queda como primera capa + aviso temprano:
    [[ -f "$age_ops" || ! -f "$AEGIS_HOME/.age-public" ]] || \
        log_warn "hay .age-public pero NO la age key en $age_ops — los sops van a fallar (¿fase 10 incompleta en esta máquina?)"
    return 0
}

started=false
for p in "${PHASES[@]}"; do
    name="$(basename "$p" .sh)"

    # bug corrida #11: --from 15 con marker previo SALTABA la fase que
    # el operador pidió por nombre — y el recurso externo que esa fase
    # garantiza (el webhook, borrado fuera del init) nunca se recreó.
    # Pedir una fase explícita ES pedir que corra: la fase nombrada en
    # --from se re-ejecuta aunque tenga marker (las fases son
    # idempotentes por diseño; --only ya se comportaba así). Las
    # POSTERIORES siguen respetando sus markers.
    force_run=false
    if [[ -n "$ONLY_PHASE" ]]; then
        [[ "$name" == "$ONLY_PHASE"* ]] || continue
    elif [[ -n "$FROM_PHASE" && $started == false ]]; then
        [[ "$name" == "$FROM_PHASE"* ]] || continue
        started=true
        force_run=true
    fi

    if is_done "$name" && [[ -z "$ONLY_PHASE" ]] && ! $force_run; then
        log_info "fase $name ya completa — skip (marker en .init-state)"
        continue
    fi

    printf '\n\033[1m════════ FASE %s ════════\033[0m\n' "$name"
    # para el registro máquina-legible de gates (P2.13 reporte in-VM):
    export AEGIS_PHASE="$name"
    phase_env
    # subshell: una fase no contamina el entorno de la siguiente.
    # F-A corrida #15 (RESUELVE el misterio abierto desde la #9 "por
    # qué set -e no cortó"): el patrón anterior era
    # `if ( source fase )` — bash IGNORA errexit en TODO lo que corre
    # dentro de la condición de un if (semántica documentada), y el
    # `set -euo pipefail` interno de la fase queda IMPOTENTE en ese
    # contexto → ningún fallo no-gate cortó jamás (en vivo #15:
    # argo_sync terminó Error y la fase siguió; #9: push caído que
    # siguió de largo). La fase corre como comando PLANO — errexit
    # VIVO adentro — y el rc se captura con errexit del padre off:
    set +e
    ( source "$p" )
    _phase_rc=$?
    set -e
    if (( _phase_rc == 0 )); then
        [[ "$CHECK_MODE" == "true" ]] || mark_done "$name"
        log_ok "fase $name completa"
    else
        log_error "fase $name FALLÓ."
        # Hallazgo C v1.1: el comando de retome era RELATIVO y el
        # operador lo copió tal cual desde otro directorio → "No such
        # file or directory". Un comando que se imprime para
        # copiar-pegar se imprime ABSOLUTO, siempre:
        log_error "Resume: ${AEGIS_CMD:-aegis} init --profile $PROFILE --from $name"
        exit 1
    fi
done

log_ok "${AEGIS_CMD:-aegis} init: todas las fases solicitadas completas."
log_info "Siguiente: validar gates finales (fase 80 los lista) y"
log_info "archivar el resumen en docs/logbook del repo de plataforma."
