#!/usr/bin/env bash
# aegis-summary: Brings up the whole platform, phase by phase
# aegis-group:   setup
# aegis-help:
# Usage: aegis init [--profile greenfield|hetzner] [--from N] [--only N]
#                   [--check] [--configure] [--list] [--reset-state]
#                   [--non-interactive]
#
# The orchestrator: brings the platform up phase by phase, recording
# a gate per step in the instance's .init-state/. Re-running converges:
# phases already passed are skipped unless --from/--only say otherwise.
#
#   --profile P        the target (default greenfield)
#   --from N           start at phase N (skip the earlier ones)
#   --only N           run phase N alone
#   --check            measure, change nothing
#   --configure        re-ask the configuration even if it exists
#   --list             print the phases and exit
#   --reset-state      forget every gate and start over
#   --non-interactive  never prompt (same as AEGIS_ASSUME_YES=true)

# aegis-init — the orchestrator of aegis' whole bootstrap.
#
# USAGE:
#   aegis init [--profile greenfield|hetzner] [--from PHASE]
#              [--only PHASE] [--check] [--configure] [--list]
#              [--reset-state] [--non-interactive]
#
# --non-interactive (P0 of the 2026-07-18 audit): a run with NO operator
# (throwaway VM / the init's own CI). human_step and gate_red
# auto-confirm (and it is logged); input secrets arrive by file:
#   CF_MASTER_FILE        the CF master credential (tmpfs, consumed)
#   AEGIS_AGE_BACKUP_FILE where the age key backup goes (the OPERATOR's
#                         tmpfs — the init writes it there instead of
#                         showing it; moving it to real safekeeping is
#                         the responsibility of whoever launched the run)
# Requires a pre-made aegis-init.conf (the wizard does not run without a
# TTY) and sudo NOPASSWD already configured (phase 00 checks that early).
#
# CONFIG: guided and interactive (the wizard asks field by field, with
# defaults and validation — lib/config.sh). It runs by itself the first
# time (phase 00) or with --configure; a pre-made aegis-init.conf is
# respected (re-runs / automation). The operator NEVER "fills in a blank
# file".
#
# DESIGN (see seed/platform/docs/architecture/bootstrap.md):
#  - Numbered idempotent phases in phases/NN-name.sh, executed in
#    STRICT lexicographic order (do not skip: the order IS the contract
#    — they are real dependencies, doc 26 Part V).
#  - State in .init-state/ (one marker per completed phase): --from
#    resumes after any interruption (human pauses included — those are
#    the normal case, not the exception).
#  - --check: dry run (mutates nothing; the READS do run).
#  - Profiles: greenfield (default) | hetzner (deltas: cilium, a
#    per-node registries.yaml, storageclass, replicas). The re-bootstrap
#    profile is NOT implemented in v1 (a known limit: importing live
#    resources has no procedure — 27 §2.4/H5).
#
# ARTIFACT STATUS: structure and detail complete (E1-E10); what remains
# is validation on a virgin environment (see bootstrap.md).

set -euo pipefail

# The PRODUCT: this file lives in $AEGIS_ROOT/libexec/. readlink -f and
# not a plain dirname, because phase 05 installs /usr/local/bin/aegis as
# a SYMLINK to the product (03 §7): without resolving it, AEGIS_ROOT
# would be /usr/local and the init would find neither its phases nor its
# libs. If bin/aegis already exported it, that is respected (it is not
# recomputed six times).
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} init: readlink is missing — I will not guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT

export PROFILE=greenfield CHECK_MODE=false FORCE_CONFIGURE=false
export AEGIS_NONINTERACTIVE="${AEGIS_ASSUME_YES:-false}"
FROM_PHASE="" ONLY_PHASE="" DO_LIST=false DO_RESET=false

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
while (($#)); do case "$1" in
    -h|--help)     usage; exit 0 ;;
    --profile)     PROFILE="$2"; shift 2 ;;
    --from)        FROM_PHASE="$2"; shift 2 ;;
    --only)        ONLY_PHASE="$2"; shift 2 ;;
    --check)       CHECK_MODE=true; shift ;;
    --configure)   FORCE_CONFIGURE=true; shift ;;
    --list)        DO_LIST=true; shift ;;
    --reset-state) DO_RESET=true; shift ;;
    --non-interactive) AEGIS_NONINTERACTIVE=true; shift ;;
    *) echo "unknown flag: $1" >&2; exit 2 ;;
esac; done

case "$PROFILE" in greenfield|hetzner) ;; *)
    echo "profile '$PROFILE' is not supported in v1 (greenfield|hetzner)" >&2
    exit 2 ;;
esac

# shellcheck source=lib/common.sh
source "$AEGIS_ROOT/lib/common.sh"
# shellcheck source=lib/checks.sh
source "$AEGIS_ROOT/lib/checks.sh"
# shellcheck source=lib/secrets.sh
source "$AEGIS_ROOT/lib/secrets.sh"
# shellcheck source=lib/jenkins.sh
source "$AEGIS_ROOT/lib/jenkins.sh"
# shellcheck source=lib/config.sh
source "$AEGIS_ROOT/lib/config.sh"
# access.sh provides edge_origin_responds/curl_access: since #76 the
# operator-plane hostnames sit behind Cloudflare Access, and phases 35
# and 60 probe them. Without this, those probes measure Cloudflare's
# edge and not the cluster (#87).
# shellcheck source=lib/access.sh
source "$AEGIS_ROOT/lib/access.sh"

$DO_RESET && { clear_state; log_ok "state reset"; }

# ── early TTY guard (P0 of the 2026-07-18 audit) ────────────────────
# With no TTY and no --non-interactive, the run was going to die at the
# FIRST read (EOF) — sometimes thirty minutes in. Die HERE, with the
# remedy in the message:
if ! ni_mode && [[ "$CHECK_MODE" != "true" && ! -t 0 ]] \
   && ! $DO_LIST; then
    die "no terminal (stdin is not a TTY) and no --non-interactive — for unattended runs: --non-interactive + a pre-made aegis-init.conf + CF_MASTER_FILE/AEGIS_AGE_BACKUP_FILE"
fi

mapfile -t PHASES < <(find "$AEGIS_ROOT/init/phases" -name '[0-9][0-9]-*.sh' \
                      | sort)
# P3 of the audit: an empty phases/ fell through to the final log "all
# requested phases complete" with exit 0 — a structural false ALL-OK:
(( ${#PHASES[@]} > 0 )) || \
    die "there are no phases in $AEGIS_ROOT/init/phases (a half-built artifact?) — nothing to execute is NOT success"

if $DO_LIST; then
    for p in "${PHASES[@]}"; do
        local_name="$(basename "$p" .sh)"
        state=" "
        is_done "$local_name" && state="✔"
        printf ' [%s] %s\n' "$state" "$local_name"
    done
    exit 0
fi

# ── validate phase names BEFORE the loop (bug from run #10) ─────────
# --from with a name that does not exist (say "30-helm" when the phase
# is called "30-argocd") made the loop skip EVERYTHING and report "all
# requested phases complete" — a false "all done".
# An unknown name is a hard error, with the real list at hand.
# P3 of the audit: prefix matching accepted AMBIGUITY in silence
# (--from 1 matched 10/12/15 and started at 10 with no warning). A
# prefix counts ONLY if it identifies exactly ONE phase:
phase_check_unique() {   # <flag> <query>
    local flag="$1" q="$2" p matches=()
    for p in "${PHASES[@]}"; do
        [[ "$(basename "$p" .sh)" == "$q"* ]] && matches+=("$(basename "$p" .sh)")
    done
    (( ${#matches[@]} == 1 )) && return 0
    if (( ${#matches[@]} == 0 )); then
        die "unknown phase in $flag: '$q' — phases: $PHASE_NAMES"
    fi
    die "$flag '$q' is AMBIGUOUS — it matches: ${matches[*]} (use the full numeric prefix)"
}
PHASE_NAMES="$(basename -s .sh "${PHASES[@]}" | tr '\n' ' ')"
[[ -z "$FROM_PHASE" ]] || phase_check_unique --from "$FROM_PHASE"
[[ -z "$ONLY_PHASE" ]] || phase_check_unique --only "$ONLY_PHASE"

log_info "${AEGIS_CMD:-aegis} init — profile=$PROFILE check=$CHECK_MODE"
log_info "root=$AEGIS_ROOT"

# ── per-phase re-derivable state (bug 5 of run #2) ──────────────────
# NO phase depends on a previous phase's export: every piece of state it
# needs is RE-DERIVED here from its source on disk, before EACH phase.
# Same family as the AGE_PUBLIC bug: state that dies at the process
# boundary — the fix is to derive, not to carry.
phase_env() {
    local age_ops="$HOME/.config/sops/age/aegis.key"
    [[ -f "$age_ops" ]] && export SOPS_AGE_KEY_FILE="$age_ops"
    [[ -f "$AEGIS_HOME/.age-public" ]] && \
        AGE_PUBLIC="$(cat "$AEGIS_HOME/.age-public")" && \
        export AGE_PUBLIC
    # bug 5, validation #3: even with this, the environment had holes on
    # the --from path. The REAL safety net is sops_env() in every
    # function of lib/secrets.sh that uses sops (derivation at the point
    # of use). This stays as a first layer plus an early warning:
    [[ -f "$age_ops" || ! -f "$AEGIS_HOME/.age-public" ]] || \
        log_warn "there is an .age-public but NOT the age key at $age_ops — the sops calls will fail (is phase 10 incomplete on this machine?)"
    return 0
}

started=false
for p in "${PHASES[@]}"; do
    name="$(basename "$p" .sh)"

    # bug from run #11: --from 15 with a previous marker SKIPPED the
    # phase the operator asked for by name — and the external resource
    # that phase guarantees (the webhook, deleted outside the init) was
    # never recreated. Asking for a phase explicitly IS asking for it to
    # run: the phase named in --from re-executes even if it has a marker
    # (the phases are idempotent by design; --only already behaved this
    # way). The LATER ones keep respecting their markers.
    force_run=false
    # --configure re-asks the configuration, and the wizard has ONE owner:
    # phase 00 calls ensure_config. Until 2026-08-26 the flag was consumed
    # by nobody on an instance that had already run: the loop skipped phase
    # 00 by its marker BEFORE ensure_config could ever see FORCE_CONFIGURE,
    # so `aegis init --configure` on any initialised instance did exactly
    # nothing, and said nothing about it. Asking to reconfigure IS asking
    # for the phase that configures to run.
    $FORCE_CONFIGURE && [[ "$name" == 00-* ]] && force_run=true
    if [[ -n "$ONLY_PHASE" ]]; then
        [[ "$name" == "$ONLY_PHASE"* ]] || continue
    elif [[ -n "$FROM_PHASE" && $started == false ]]; then
        [[ "$name" == "$FROM_PHASE"* ]] || continue
        started=true
        force_run=true
    fi

    if is_done "$name" && [[ -z "$ONLY_PHASE" ]] && ! $force_run; then
        log_info "phase $name already complete — skipping (marker in .init-state)"
        continue
    fi

    printf '\n\033[1m════════ PHASE %s ════════\033[0m\n' "$name"
    # for the machine-readable gate record (P2.13, the in-VM report):
    export AEGIS_PHASE="$name"
    phase_env
    # subshell: one phase does not contaminate the next one's
    # environment.
    # F-A of run #15 (this RESOLVES the mystery open since #9, "why did
    # set -e not stop it"): the previous pattern was
    # `if ( source phase )` — bash IGNORES errexit in EVERYTHING that
    # runs inside an if's condition (documented semantics), and the
    # phase's own `set -euo pipefail` is POWERLESS in that context → no
    # non-gate failure ever stopped anything (live in #15: argo_sync
    # ended in Error and the phase carried on; #9: a failed push that
    # went straight past). The phase now runs as a PLAIN command —
    # errexit ALIVE inside it — and the rc is captured with the parent's
    # errexit off:
    set +e
    ( source "$p" )
    _phase_rc=$?
    set -e
    if (( _phase_rc == 0 )); then
        [[ "$CHECK_MODE" == "true" ]] || mark_done "$name"
        log_ok "phase $name complete"
    else
        log_error "phase $name FAILED."
        # Finding C v1.1: the resume command was RELATIVE and the
        # operator pasted it verbatim from another directory → "No such
        # file or directory". A command printed to be copy-pasted is
        # printed ABSOLUTE, always:
        log_error "Resume: ${AEGIS_CMD:-aegis} init --profile $PROFILE --from $name"
        exit 1
    fi
done

log_ok "${AEGIS_CMD:-aegis} init: all requested phases complete."
log_info "Next: validate the final gates (phase 80 lists them) and"
log_info "archive the summary in docs/logbook of the platform repo."
