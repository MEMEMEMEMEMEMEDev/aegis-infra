#!/usr/bin/env python3
# aegis-summary: Do the hostnames the contracts declare exist and answer?
# aegis-group:   infra
# aegis-subcommands: check
"""aegis-edge — do the hostnames the contracts declare EXIST?

WHY IT EXISTS. The edge's failure mode is the worst there is: if a
hostname was not applied, it simply DOES NOT EXIST. No error, no alarm,
nothing red — the cluster's IngressRoute is perfect, the certificate is
issued, and nobody arrives. It happened with ai.__ROOT_DOMAIN__ (#35)
and it nearly happened with blog on 2026-08-03.

WHY IT DOES NOT USE TOFU'S STATE. Two reasons, and the second is the
one that matters:

  1. The state needs the age key to be decrypted (#46), and the age key
     does not go into CI. This check has to be able to run there.

  2. More fundamentally: the state says what tofu BELIEVES exists. This
     check asks what REALLY exists. If the two always agreed neither of
     them would be needed; the only reason to look is that they can
     differ. A drift detector that reads the same file as the applier
     detects nothing.

WHAT THIS CHECK DOES NOT COVER, said up front: it looks at the zone's
CNAMEs, which is exactly the failure of #35. It does NOT look at the
tunnel's ingress rules — a CNAME that exists with a tunnel that does
not route it gives a 404, and this script does not see that. To look at
that one would need the tunnel_id, which lives in the state. It is
written down as a limit and not as "already covered", because a check
that promises too much is worse than not having it.

Usage:
    aegis edge                 # compares and reports
    TF_VAR_cloudflare_api_token=... aegis edge    # CI mode

Exit: 0 everything declared exists · 1 some are missing · 2 could not evaluate
"""
import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

# ── canonical python preamble (V-102) ────────────────────────────────
# The product comes from the variable (bin/aegis exports it) or from
# this file; the INSTANCE is decided by lib/aegis/paths.py and nobody
# else.
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, outcomes, paths   # noqa: E402

# PLATFORM is the INSTANCE (the live checkout of the platform), not the
# product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. When the code
# moved to the product the same line kept compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a
# grep».
PLATFORM = str(paths.platform_dir())
TOKENS = os.path.join(PLATFORM, "tofu", "secrets", "tokens.enc.yaml")
red = "\033[31m"; green = "\033[32m"; yellow = "\033[33m"; gray = "\033[90m"; reset = "\033[0m"
if not sys.stdout.isatty():
    red = green = yellow = gray = reset = ""


def generator():
    """The generator, as a MODULE of the package — the hostname list
    comes from THERE.

    Reimplementing the derivation here would mean two sources for the
    same list, which is the duplication #45 came to eliminate. If the
    two drift apart, the check compares against something nobody
    deploys and always passes.

    Until 2026-08-24 this loaded `<instance>/platform/bin/aegis-org`
    with SourceFileLoader — register case C1, and a path that stopped
    existing when the code moved to the product: `aegis edge check`
    died with FileNotFoundError on the very line that was going to
    tell it what the hostnames should be. Now it is a real import: if
    the package is missing, it fails here with the reason.
    """
    from aegis import org
    return org


def from_conf(key):
    """Reads a key out of the instance's aegis.conf without sourcing it.

    Through lib/aegis/paths.read_conf — the ONE reader. Until
    2026-08-27 this function opened a path of its own that named the
    v2 file (aegis-init.conf); on the first clean instance it found
    nothing, took EDGE for cloudflare, and told an EDGE=local operator
    that "the Cloudflare token is missing" — the exact lie the comment
    below it warns against."""
    return paths.read_conf().get(key)


def credentials():
    """(token, zone_id). The environment takes PRECEDENCE — the same rule
    as tofu-apply.sh, and for the same reason: that way CI runs without
    the age key."""
    token = (os.environ.get("TF_VAR_cloudflare_api_token")
             or os.environ.get("CF_API_TOKEN"))
    zone = (os.environ.get("TF_VAR_cloudflare_zone_id")
            or os.environ.get("CF_ZONE_ID") or from_conf("CF_ZONE_ID"))

    if not token:
        if not os.environ.get("SOPS_AGE_KEY_FILE"):
            return None, zone
        try:
            # The token does NOT travel through argv: sops writes to
            # stdout and it is read in here.
            raw = subprocess.run(["sops", "-d", TOKENS], check=True,
                                 capture_output=True, text=True).stdout
        except (subprocess.CalledProcessError, FileNotFoundError):
            return None, zone
        import yaml
        doc = yaml.safe_load(raw) or {}
        v = (doc.get("cloudflare") or {}).get("api_token")
        token = v.get("value") if isinstance(v, dict) else v
    return token, zone


def live_cnames(token, zone):
    """The CNAMEs Cloudflare says exist, paginating for real.

    Without paginating, a zone with more than 100 records would report
    as missing things that do exist — a false positive that teaches
    people to ignore the check.
    """
    live = set()
    page = 1
    while True:
        url = (f"https://api.cloudflare.com/client/v4/zones/{zone}/dns_records"
               f"?type=CNAME&per_page=100&page={page}")
        req = urllib.request.Request(url, headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            body = json.load(r)
        if not body.get("success"):
            raise RuntimeError(f"the Cloudflare API answered with errors: "
                               f"{body.get('errors')}")
        for rec in body.get("result") or []:
            live.add(rec["name"])
        info = body.get("result_info") or {}
        if page >= (info.get("total_pages") or 1):
            return live
        page += 1


def main():
    # One verb, even though today it is the only one: `aegis edge check`
    # says what it does, and leaves room for the ones that come after
    # (apply, for instance) without the default changing meaning
    # halfway through. With no arguments it works too: that is what the
    # round invokes.
    ap = cli.parser("edge", __doc__.split("\n")[0],
                    protocol="docs/protocols/edge.md")
    # --json HAS TO BE ACCEPTED AFTER THE VERB TOO, and it is a contract
    # and not a courtesy: `cli.run_json` appends `--json` at the END of
    # whatever it was handed, so a delegating command always says
    # `edge check --json`. Same shape as aegis-webhook, and for the same
    # reason it was written there on 2026-09-03.
    #
    # default=SUPPRESS is the whole trick: without it the subparser
    # would write its own False over a --json that arrived BEFORE the
    # verb, and `edge --json check` would break while fixing
    # `edge check --json`.
    flags = argparse.ArgumentParser(add_help=False)
    flags.add_argument("--json", action="store_true", dest="json_mode",
                       default=argparse.SUPPRESS,
                       help="the exit contract instead of the narration")
    sub = ap.add_subparsers(dest="verb")
    sub.add_parser("check", parents=[flags],
                   help="compares the live hostnames against the ones derived from the contracts")
    ap.add_argument("--json", action="store_true", dest="json_mode",
                    help="the exit contract instead of the narration")
    # ASSIGNED. Until 2026-09-11 this line was a bare `ap.parse_args()`:
    # the flag parsed and the value was thrown away on the same line, so
    # `aegis edge --json` printed the very same coloured prose and a
    # consumer that trusted the flag got ANSI escapes where it expected a
    # document. Nothing failed; that is what made it last.
    a = ap.parse_args()
    steps = outcomes.Steps(json_mode=a.json_mode)
    narrate = not a.json_mode

    g = generator()
    import yaml
    edge = yaml.safe_load(open(os.path.join(PLATFORM, "edge.yaml"), encoding="utf-8"))
    root_domain = edge["root_domain"]
    expected = {f"{e}.{root_domain}" for e in g.edge_labels()}

    # The edge with no zone has NO SUBJECT here, and that is different
    # from "the credential is missing". Under EDGE=local there is no
    # Cloudflare account, no zone and no CNAMEs: this comparison cannot
    # be made, and it never will be. Saying "the token is missing" would
    # send the operator hunting for a secret that by design does not
    # exist — a message that is technically true and practically a lie.
    if (from_conf("EDGE") or "cloudflare") == "local":
        if narrate:
            print(f"  {yellow}!{reset} edge NOT EVALUATED — EDGE=local: this instance "
                  f"has no Cloudflare zone")
            print(f"    {gray}There are no CNAMEs to compare: the platform is reached\n"
                  f"    through the host bridge, not through a tunnel and a zone.\n"
                  f"    This is NOT approval: it is a check with no subject on this edge.{reset}")
        steps.not_evaluable("edge", why="no-zone", edge="local")
        steps.finish()

    token, zone = credentials()
    # It does NOT fall silent, and it does not give itself the benefit
    # of the doubt. "Could not evaluate" is a different result from "it
    # passed", and confusing them is Disease E
    # (docs/failure-modes.md).
    if not token or not zone:
        missing_piece = "the Cloudflare token" if not token else "CF_ZONE_ID"
        if narrate:
            print(f"  {yellow}!{reset} edge NOT EVALUATED — {missing_piece} is missing")
            print(f"    {gray}Export TF_VAR_cloudflare_api_token, or SOPS_AGE_KEY_FILE\n"
                  f"    so that it gets decrypted out of tofu/secrets/tokens.enc.yaml.\n"
                  f"    This is NOT approval: it is a check that did not run.{reset}")
        steps.not_evaluable("edge", why="no-credential",
                            missing="token" if not token else "zone")
        steps.finish()

    try:
        live = live_cnames(token, zone)
    except (urllib.error.URLError, RuntimeError, KeyError) as e:
        if narrate:
            print(f"  {yellow}!{reset} edge NOT EVALUATED — the Cloudflare API did not answer")
            print(f"    {gray}{e}{reset}")
        steps.not_evaluable("edge", why="api-silent", detail=str(e))
        steps.finish()

    missing = sorted(expected - live)
    # Only the CNAMEs of the root domain: the zone may hold records of
    # other things belonging to the operator that aegis neither manages
    # nor should lay claim to.
    ours = {v for v in live if v.endswith("." + root_domain)}
    extra = sorted(ours - expected)

    if missing:
        if narrate:
            print(f"  {red}✗{reset} {len(missing)} declared hostname(s) that DO NOT EXIST:")
            for h in missing:
                print(f"      {h}")
            print(f"    {gray}Nobody reaches those sites and nothing else is going to say so.\n"
                  f"    Apply the edge:  cd platform/tofu && \\\n"
                  f"      SOPS_AGE_KEY_FILE=~/.config/sops/age/aegis.key \\\n"
                  f"      ./tofu-apply.sh -chdir=envs/cloudflare-tunnel apply{reset}")
        # One step per absent hostname: a consumer that wants to name
        # them does not have to split a sentence to find out which.
        for h in missing:
            steps.wrong(f"hostname:{h}", why="absent-in-cloudflare")
    else:
        if narrate:
            print(f"  {green}✓{reset} the {len(expected)} hostnames of the contracts exist in Cloudflare")
        steps.already("edge", hostnames=len(expected))

    if extra:
        if narrate:
            print(f"  {yellow}!{reset} {len(extra)} CNAME(s) that no contract asks for:")
            for h in extra:
                print(f"      {h}")
            print(f"    {gray}What is left over at the edge is what is no longer in git. Deleting\n"
                  f"    them is an apply WITH destroy, so it goes by hand and with the plan read.{reset}")
        # SURPLUS TRAVELS AS DATA, NEVER AS A STATE, and that is the
        # whole point of this line. Before today a surplus CNAME did not
        # move the rc — the narration mentioned it and the exit code
        # stayed 0 — and the round already reads that rc. Filing it as
        # `wrong` would silently turn every instance with one leftover
        # record red. The state stays `already`; what is left over rides
        # along as a field, visible to whoever asks and mute to the rc.
        steps.already("surplus-cnames", count=len(extra), hostnames=extra)

    steps.finish()


if __name__ == "__main__":
    sys.exit(main())
