#!/usr/bin/env bash
# aegis-summary: Undoes the init's footprint on the cloud edge and this host
# aegis-group:   setup
# aegis-help:
# Usage: aegis destroy [--yes] [--purge-secrets] [--k3s]
#
# Undoes the footprint the init left on the EDGE and on THIS HOST:
# the Cloudflare tunnel, DNS and Access (through tofu, when there is a
# state), the EDGE=local host bridge, and — with --k3s — the cluster.
# It does NOT delete the GitHub repos: they carry the init's marker
# topic, a re-run reuses them, and deleting a repo is a decision taken
# by hand. (Until 2026-08-27 this text claimed the repos too; the code
# never did it.) Without --yes it is a DRY-RUN that only says what it
# would remove.
#
#   --yes             act (default: dry-run)
#   --purge-secrets   also wipe the instance's secret store
#   --k3s             also uninstall k3s from this host

# aegis-destroy — teardown of the EXTERNAL footprint the init creates and
# that survives a snapshot revert (W-10 / R5). Today the only cleanup is
# COUPLED to the creation path (25-edge-tofu only deletes the "dirty cloud"
# if you create it again); this decouples it into a verb of its own and
# makes validation runs cheap.
#
# What it destroys:
#   - Cloudflare tunnel + config + CNAMEs → `tofu destroy` THROUGH THE WRAPPER
#     (A14: never raw tofu; the wrapper injects the token from SOPS and the
#     TF_VARs, avoiding phantom destroys of count-gated resources).
#   - the local tfstate (with TUNNEL_TOKEN in the clear).
#   - optional --purge-secrets: the .state-secrets store + .init-state.
#   - the EDGE=local host bridge: the four systemd units, their
#     drop-ins and /etc/aegis/edge.env, freeing ports 80 and 443.
#   - optional --k3s: k3s-uninstall.sh (nuke of the local cluster).
#
# The k3s cluster, if you do not pass --k3s, is cleaned by reverting the
# VM's snapshot (the operator's practice). The CF resources of ANOTHER VM
# without a local tfstate are swept anyway by phase 25's pre-check when
# re-creating.
#
# Usage:
#   aegis destroy                 # DRY-RUN: shows the destruction plan
#   aegis destroy --yes           # destroys CF + purges the local tfstate
#   aegis destroy --yes --purge-secrets --k3s   # total teardown

set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
# The PRODUCT is resolved from the file itself, following symlinks
# (phase 05 installs /usr/local/bin/aegis as a symlink: without
# readlink -f, AEGIS_ROOT would be /usr/local). If bin/aegis already
# exported it, that is respected. The INSTANCE is decided by
# lib/paths.sh, never by this file.
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} destroy: readlink is missing — I cannot guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"
TOFU="$PLATFORM_DIR/tofu/tofu-apply.sh"
TUNNEL_ENV="$PLATFORM_DIR/tofu/envs/cloudflare-tunnel"
STATE_SECRETS="$AEGIS_HOME/.state-secrets"
INIT_STATE="${AEGIS_STATE_DIR:-$AEGIS_HOME/.init-state}"
CONF="$AEGIS_HOME/aegis.conf"

say()  { printf '[destroy] %s\n' "$*"; }

# _disconnect_tunnel: leave the tunnel with NO live connections before
# asking Cloudflare to delete it.
#
# MEASURED 2026-09-02, tearing down the house instance for a clean
# reinstall. `aegis destroy --yes --k3s` cannot succeed on a live
# instance and never could: the edge is destroyed FIRST and the
# cluster LAST, so when tofu asks Cloudflare to delete the tunnel,
# cloudflared is still running in the cluster this same command has
# not touched yet, and the API refuses with
#
#     1022 This tunnel has active connections. Please stop all
#          cloudflared replicas, or wait a few minutes...
#
# The `die` that followed stopped the run, so `--k3s` never ran either:
# the operator got a FATAL, an edge half destroyed (the CNAMEs DO get
# deleted before the tunnel, so every hostname is already dark) and no
# hint that the way out is to stop a Deployment they were not thinking
# about.
#
# Scaling to zero is not enough on its own, and that is the part that
# is easy to miss: ArgoCD's automated syncPolicy has selfHeal, so it
# puts the replica back within seconds. Measured: the pod came back
# with a NEW name in under four minutes while we watched. So the hand
# comes off the Application first, and only then the Deployment goes
# to zero.
#
# Everything here is best-effort and silent about absences: no
# kubectl, no cluster, no Deployment — all of them mean there is
# nothing connected, which is exactly the state this wants.
_disconnect_tunnel() {
  command -v kubectl >/dev/null 2>&1 || return 0
  kubectl cluster-info >/dev/null 2>&1 || return 0
  kubectl -n infra-edge get deploy cloudflared >/dev/null 2>&1 || return 0

  if kubectl -n argocd get application cloudflare-tunnel >/dev/null 2>&1; then
    say "edge: taking ArgoCD's hand off cloudflare-tunnel (selfHeal would undo the scale-down)"
    kubectl -n argocd patch application cloudflare-tunnel --type merge \
      -p '{"spec":{"syncPolicy":{"automated":null}}}' >/dev/null 2>&1 || true
  fi

  say "edge: stopping cloudflared so the tunnel has no live connections"
  kubectl -n infra-edge scale deploy cloudflared --replicas=0 >/dev/null 2>&1 || true

  local i
  for i in $(seq 1 60); do
    kubectl -n infra-edge get pods --no-headers 2>/dev/null \
      | grep -q '^cloudflared-' || { say "edge: cloudflared is down"; return 0; }
    sleep 2
  done
  say "WARNING: cloudflared did not stop in 120s — Cloudflare may still refuse to delete the tunnel"
}
die()  { printf '[destroy] FATAL: %s\n' "$*" >&2; exit 1; }

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
YES=0; PURGE_SECRETS=0; K3S=0
for a in "$@"; do
  case "$a" in
    -h|--help)        usage; exit 0 ;;
    --yes)            YES=1 ;;
    --purge-secrets)  PURGE_SECRETS=1 ;;
    --k3s)            K3S=1 ;;
    *) die "unknown flag: $a (usage: ${AEGIS_CMD:-aegis} destroy [--yes] [--purge-secrets] [--k3s])" ;;
  esac
done

# the config carries CF_ACCOUNT_ID/CF_ZONE_ID/ROOT_DOMAIN that the wrapper
# exports as TF_VARs (config.sh wrote them here). Without it I do not know
# what to destroy.
[[ -f "$CONF" ]] || die "$CONF does not exist — without config there is nothing to destroy (did you run the init?)"
# shellcheck source=/dev/null
source "$CONF"
export CF_ACCOUNT_ID CF_ZONE_ID ROOT_DOMAIN

say "mode: $([[ $YES -eq 1 ]] && echo 'DESTROY (--yes)' || echo 'DRY-RUN (pass --yes to act)')"

# ── 1) Cloudflare through tofu destroy (through the wrapper) ─────────────
if [[ -f "$TUNNEL_ENV/terraform.tfstate" ]]; then
  say "cloudflare-tunnel: init of the env…"
  "$TOFU" -chdir="$TUNNEL_ENV" init -input=false >/dev/null \
    || die "tofu init failed (are the age key / SOPS available to the wrapper?)"
  if [[ $YES -eq 1 ]]; then
    _disconnect_tunnel
    say "cloudflare-tunnel: DESTROY…"
    _dlog="$(mktemp)"
    if ! "$TOFU" -chdir="$TUNNEL_ENV" destroy -auto-approve 2>&1 | tee "$_dlog"; then
      # A tunnel with live connections is the ONE failure worth retrying:
      # Cloudflare closes them on its own once the last replica is gone,
      # and it does not always notice within the same second.
      if grep -q 'active connections' "$_dlog"; then
        say "edge: Cloudflare still sees connections; waiting 60s and retrying ONCE"
        sleep 60
        "$TOFU" -chdir="$TUNNEL_ENV" destroy -auto-approve \
          || { rm -f "$_dlog"; die "tofu destroy failed twice — the tunnel still reports connections. Something outside this cluster is running cloudflared with this instance's token"; }
      else
        rm -f "$_dlog"
        die "tofu destroy failed — check the state of CF by hand before re-creating"
      fi
    fi
    rm -f "$_dlog"
    say "cloudflare-tunnel destroyed (tunnel + config + CNAMEs)"
  else
    say "cloudflare-tunnel: destruction plan (DRY-RUN):"
    "$TOFU" -chdir="$TUNNEL_ENV" plan -destroy || true
  fi
else
  say "no local tfstate in $TUNNEL_ENV — nothing to destroy through tofu"
  say "  (leftovers from another VM without state: phase 25's pre-check sweeps them when re-creating)"
fi

# ── 2) purge of the local tfstate (only with --yes) ──────────────────────
if [[ $YES -eq 1 ]]; then
  rm -f "$TUNNEL_ENV/terraform.tfstate" "$TUNNEL_ENV/terraform.tfstate.backup"
  say "local tfstate purged"
fi

# ── 3) optional purge of the secrets store + .init-state ─────────────────
if [[ $PURGE_SECRETS -eq 1 ]]; then
  if [[ $YES -eq 1 ]]; then
    rm -rf "$STATE_SECRETS" "$INIT_STATE"
    say "PURGED the .state-secrets store and .init-state (unrecoverable without a prior \`${AEGIS_CMD:-aegis} state backup\`)"
  else
    say "[DRY-RUN] --purge-secrets would delete $STATE_SECRETS and $INIT_STATE (do a \`${AEGIS_CMD:-aegis} state backup\` BEFORE)"
  fi
fi

# ── 4) the host bridge (EDGE=local) ──────────────────────────────────────
# The bridge is the only thing the local edge leaves OUTSIDE the cluster
# and outside the repo: four units in /etc/systemd/system, an env file,
# and two sockets HOLDING ports 80 and 443 of this host. A teardown that
# leaves them behind leaves the machine answering on the edge's ports for
# a cluster that no longer exists — and the next init finds them there,
# already listening, which is the dirtiest possible starting point for
# the re-install this command exists to make possible.
#
# It runs regardless of EDGE and asks the DISK, not the conf: the whole
# point of a teardown is that it works on a machine whose conf may
# already be gone, or may say something the host no longer reflects.
EDGE_UNITS=(aegis-edge-http.socket aegis-edge-http.service
            aegis-edge-https.socket aegis-edge-https.service)
BRIDGE_FOUND=0
for u in "${EDGE_UNITS[@]}"; do
  [[ -f "/etc/systemd/system/$u" ]] && BRIDGE_FOUND=1
done
[[ -f /etc/aegis/edge.env ]] && BRIDGE_FOUND=1
if [[ $BRIDGE_FOUND -eq 1 ]]; then
  if [[ $YES -eq 1 ]]; then
    say "host bridge: stopping and removing the units that hold 80/443…"
    # stop the SOCKETS first: stopping only the service leaves systemd
    # holding the port, ready to start it again on the next connection.
    sudo systemctl disable --now aegis-edge-http.socket aegis-edge-https.socket 2>/dev/null || true
    sudo systemctl stop aegis-edge-http.service aegis-edge-https.service 2>/dev/null || true
    for u in "${EDGE_UNITS[@]}"; do
      sudo rm -rf "/etc/systemd/system/$u" "/etc/systemd/system/$u.d"
    done
    sudo rm -f /etc/aegis/edge.env
    sudo rmdir /etc/aegis 2>/dev/null || true
    sudo systemctl daemon-reload
    sudo systemctl reset-failed 2>/dev/null || true
    if ss -ltn 2>/dev/null | grep -qE ':(80|443) '; then
      say "WARNING: something is STILL listening on 80/443 — it is not aegis' bridge any more, but check what it is before re-installing"
    else
      say "host bridge removed: 80 and 443 are free"
    fi
  else
    say "[DRY-RUN] would stop and remove the host bridge (4 units + drop-ins + /etc/aegis/edge.env) and free ports 80/443"
  fi
else
  say "no host bridge on this machine (EDGE=cloudflare, or already removed)"
fi

# ── 5) optional teardown of k3s ──────────────────────────────────────────
if [[ $K3S -eq 1 ]]; then
  UNINSTALL="$(command -v k3s-uninstall.sh || echo /usr/local/bin/k3s-uninstall.sh)"
  if [[ $YES -eq 1 ]]; then
    [[ -x "$UNINSTALL" ]] || die "--k3s asked for but I cannot find k3s-uninstall.sh"
    say "k3s: uninstall (nuke of the cluster)…"; "$UNINSTALL"
    say "k3s uninstalled"
  else
    say "[DRY-RUN] --k3s would run $UNINSTALL (deletes the whole cluster)"
  fi
fi

echo
if [[ $YES -eq 1 ]]; then
  say "teardown complete. For a clean start: re-run the init (or revert the snapshot)."
else
  say "DRY-RUN — nothing was destroyed. Repeat with --yes to act."
fi
