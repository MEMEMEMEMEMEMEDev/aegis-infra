#!/usr/bin/env bash
# aegis-summary: Undoes what the init created outside (cloud and repos)
# aegis-group:   setup
# aegis-help:
# Usage: aegis destroy [--yes] [--purge-secrets] [--k3s]
#
# Undoes the EXTERNAL footprint the init created: Cloudflare (tunnel,
# DNS, Access) and the GitHub repos. Without --yes it is a DRY-RUN
# that only says what it would remove.
#
#   --yes             act (default: dry-run)
#   --purge-secrets   also wipe the instance's secret store
#   --k3s             also uninstall k3s from this host

# aegis-destroy — teardown of the EXTERNAL footprint the init creates and
# that survives a snapshot revert (W-10 / R5). Today the only cleanup is
# COUPLED to the creation path (25-edge-tofu only deletes the "dirty cloud"
# if you create it again); this decouples it into a verb of its own and
# makes validation runs cheap.
#
# What it destroys:
#   - Cloudflare tunnel + config + CNAMEs → `tofu destroy` THROUGH THE WRAPPER
#     (A14: never raw tofu; the wrapper injects the token from SOPS and the
#     TF_VARs, avoiding phantom destroys of count-gated resources).
#   - the local tfstate (with TUNNEL_TOKEN in the clear).
#   - optional --purge-secrets: the .state-secrets store + .init-state.
#   - optional --k3s: k3s-uninstall.sh (nuke of the local cluster).
#
# The k3s cluster, if you do not pass --k3s, is cleaned by reverting the
# VM's snapshot (the operator's practice). The CF resources of ANOTHER VM
# without a local tfstate are swept anyway by phase 25's pre-check when
# re-creating.
#
# Usage:
#   aegis destroy                 # DRY-RUN: shows the destruction plan
#   aegis destroy --yes           # destroys CF + purges the local tfstate
#   aegis destroy --yes --purge-secrets --k3s   # total teardown
set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
# The PRODUCT is resolved from the file itself, following symlinks
# (phase 05 installs /usr/local/bin/aegis as a symlink: without
# readlink -f, AEGIS_ROOT would be /usr/local). If bin/aegis already
# exported it, that is respected. The INSTANCE is decided by
# lib/paths.sh, never by this file.
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} destroy: readlink is missing — I cannot guess where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"
TOFU="$PLATFORM_DIR/tofu/tofu-apply.sh"
TUNNEL_ENV="$PLATFORM_DIR/tofu/envs/cloudflare-tunnel"
STATE_SECRETS="$AEGIS_HOME/.state-secrets"
INIT_STATE="${AEGIS_STATE_DIR:-$AEGIS_HOME/.init-state}"
CONF="$AEGIS_HOME/aegis.conf"

say()  { printf '[destroy] %s\n' "$*"; }
die()  { printf '[destroy] FATAL: %s\n' "$*" >&2; exit 1; }

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
YES=0; PURGE_SECRETS=0; K3S=0
for a in "$@"; do
  case "$a" in
    -h|--help)        usage; exit 0 ;;
    --yes)            YES=1 ;;
    --purge-secrets)  PURGE_SECRETS=1 ;;
    --k3s)            K3S=1 ;;
    *) die "unknown flag: $a (usage: ${AEGIS_CMD:-aegis} destroy [--yes] [--purge-secrets] [--k3s])" ;;
  esac
done

# the config carries CF_ACCOUNT_ID/CF_ZONE_ID/ROOT_DOMAIN that the wrapper
# exports as TF_VARs (config.sh wrote them here). Without it I do not know
# what to destroy.
[[ -f "$CONF" ]] || die "$CONF does not exist — without config there is nothing to destroy (did you run the init?)"
# shellcheck source=/dev/null
source "$CONF"
export CF_ACCOUNT_ID CF_ZONE_ID ROOT_DOMAIN

say "mode: $([[ $YES -eq 1 ]] && echo 'DESTROY (--yes)' || echo 'DRY-RUN (pass --yes to act)')"

# ── 1) Cloudflare through tofu destroy (through the wrapper) ─────────────
if [[ -f "$TUNNEL_ENV/terraform.tfstate" ]]; then
  say "cloudflare-tunnel: init of the env…"
  "$TOFU" -chdir="$TUNNEL_ENV" init -input=false >/dev/null \
    || die "tofu init failed (are the age key / SOPS available to the wrapper?)"
  if [[ $YES -eq 1 ]]; then
    say "cloudflare-tunnel: DESTROY…"
    "$TOFU" -chdir="$TUNNEL_ENV" destroy -auto-approve \
      || die "tofu destroy failed — check the state of CF by hand before re-creating"
    say "cloudflare-tunnel destroyed (tunnel + config + CNAMEs)"
  else
    say "cloudflare-tunnel: destruction plan (DRY-RUN):"
    "$TOFU" -chdir="$TUNNEL_ENV" plan -destroy || true
  fi
else
  say "no local tfstate in $TUNNEL_ENV — nothing to destroy through tofu"
  say "  (leftovers from another VM without state: phase 25's pre-check sweeps them when re-creating)"
fi

# ── 2) purge of the local tfstate (only with --yes) ──────────────────────
if [[ $YES -eq 1 ]]; then
  rm -f "$TUNNEL_ENV/terraform.tfstate" "$TUNNEL_ENV/terraform.tfstate.backup"
  say "local tfstate purged"
fi

# ── 3) optional purge of the secrets store + .init-state ─────────────────
if [[ $PURGE_SECRETS -eq 1 ]]; then
  if [[ $YES -eq 1 ]]; then
    rm -rf "$STATE_SECRETS" "$INIT_STATE"
    say "PURGED the .state-secrets store and .init-state (unrecoverable without a prior \`${AEGIS_CMD:-aegis} state backup\`)"
  else
    say "[DRY-RUN] --purge-secrets would delete $STATE_SECRETS and $INIT_STATE (do a \`${AEGIS_CMD:-aegis} state backup\` BEFORE)"
  fi
fi

# ── 4) optional teardown of k3s ──────────────────────────────────────────
if [[ $K3S -eq 1 ]]; then
  UNINSTALL="$(command -v k3s-uninstall.sh || echo /usr/local/bin/k3s-uninstall.sh)"
  if [[ $YES -eq 1 ]]; then
    [[ -x "$UNINSTALL" ]] || die "--k3s asked for but I cannot find k3s-uninstall.sh"
    say "k3s: uninstall (nuke of the cluster)…"; "$UNINSTALL"
    say "k3s uninstalled"
  else
    say "[DRY-RUN] --k3s would run $UNINSTALL (deletes the whole cluster)"
  fi
fi

echo
if [[ $YES -eq 1 ]]; then
  say "teardown complete. For a clean start: re-run the init (or revert the snapshot)."
else
  say "DRY-RUN — nothing was destroyed. Repeat with --yes to act."
fi
