#!/usr/bin/env python3
# aegis-summary: Rotates the internal registry credential, all of it
# aegis-group:   infra
# aegis-subcommands: check rotate
"""aegis-registry — rotates the internal registry credential, ALL OF IT.

The registry's password does not live in one place: it lives in TEN. One
htpasswd (what the registry validates) and nine dockerconfigjson (what
the kubelet presents in order to pull), one per namespace, because a
Secret does not cross namespaces. If those ten drift apart, the cluster
stops being able to pull images.

    aegis registry check      # without touching anything: are the ten aligned?
    aegis registry rotate     # generates new material and rewrites the ten

── why this command exists and the init is not enough ──────────────

The documented path for rotating `registry_pass` is to invalidate it in
the store and re-run phase 40. MEASURED on 2026-08-08 against the live
instance: that phase writes the htpasswd and THREE regcred
(jenkins-system, kyverno, org-canary). The instance has NINE. Running it
would have left six namespaces —ai-system, garage-system and four
organizations— with the old credential against a new htpasswd, and the
symptom would have been ImagePullBackOff appearing bit by bit, as each
pod happened to restart. Hours later, and with no apparent relation to
the rotation.

The underlying cause is that the phase has the list written by hand and
the organizations were born afterwards. That is why here the list is NOT
written: it is discovered from the repo and CONTRASTED against the
cluster. If the two sets do not match exactly, the command stops dead. A
target that exists in the cluster and not in git, or the other way
round, is precisely the condition that makes rotation dangerous — so it
is an error, not a warning.

── what this command does NOT do ───────────────────────────────────

It does not commit, it does not sync and it does not restart the
registry. It leaves the ten files written and coherent with each other,
and prints the steps that follow. Rotating is deliberate; that the
commit be given by a person, too.
"""
import argparse
import base64
import json
import os
import secrets
import shutil
import subprocess
import sys
import tempfile

try:
    import yaml
except ImportError:
    sys.exit("pyyaml is missing (python3-yaml)")

# ── canonical python preamble (V-102) ────────────────────────────────
# The product comes from the variable (bin/aegis exports it) or from
# this file; the INSTANCE is decided by lib/aegis/paths.py and nobody
# else.
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, paths             # noqa: E402

# PLATFORM is the INSTANCE (the live checkout of the platform), not the
# product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. When the code
# moved to the product the same line kept compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a
# grep».
PLATFORM = str(paths.platform_dir())
USERNAME = "aegis-dev"
HOST = "registry.registry-system.svc.cluster.local:5000"
HTPASSWD = "k8s/base/registry-system/registry-htpasswd.enc.yaml"

red = "\033[31m"; green = "\033[32m"; yellow = "\033[33m"; gray = "\033[90m"; reset = "\033[0m"
if not sys.stdout.isatty():
    red = green = yellow = gray = reset = ""


def sh(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, cwd=PLATFORM, **kw)


def die(msg):
    print(f"{red}✗{reset} {msg}", file=sys.stderr)
    sys.exit(1)


def targets():
    """The repo's regcred, contrasted against the cluster's.

    Neither of the two sources rules on its own. The repo says what is
    going to be rewritten; the cluster says what is going to break if
    something is left unwritten. They are only useful if they say the
    same thing.
    """
    r = sh(["git", "ls-files"])
    if r.returncode != 0:
        die("could not list the repo (are you inside the platform repo?)")
    in_git = {}
    for line in r.stdout.splitlines():
        base = os.path.basename(line)
        if not base.startswith("secret-regcred") or not base.endswith(".enc.yaml"):
            continue
        d = yaml.safe_load(open(os.path.join(PLATFORM, line), encoding="utf-8"))
        in_git[(d["metadata"]["namespace"], d["metadata"]["name"])] = line

    r = sh(["kubectl", "get", "secret", "-A",
            "--field-selector", "type=kubernetes.io/dockerconfigjson",
            "--no-headers", "-o",
            "custom-columns=NS:.metadata.namespace,N:.metadata.name"])
    if r.returncode != 0:
        die("could not read the cluster's secrets (kubeconfig?)")
    in_cluster = {tuple(l.split()) for l in r.stdout.splitlines() if l.strip()}

    missing_in_git = in_cluster - set(in_git)
    extra_in_git = set(in_git) - in_cluster
    if missing_in_git or extra_in_git:
        for ns, n in sorted(missing_in_git):
            print(f"  {red}!{reset} {ns}/{n} lives in the CLUSTER and is not in git — "
                  f"rotating would leave it with the old credential")
        for ns, n in sorted(extra_in_git):
            print(f"  {red}!{reset} {ns}/{n} is in GIT and not in the cluster — "
                  f"either the file is surplus, or the app did not sync")
        die("the repo and the cluster do not match: nothing is rotated blind")
    return dict(sorted(in_git.items()))


def pass_of(path):
    """The password INSIDE an encrypted dockerconfigjson."""
    r = sh(["sops", "-d", "--extract", '["data"][".dockerconfigjson"]',
            os.path.join(PLATFORM, path)])
    if r.returncode != 0:
        die(f"could not decrypt {path}: {r.stderr.strip()[:160]}")
    cfg = json.loads(base64.b64decode(r.stdout.strip()))
    auth = next(iter(cfg["auths"].values()))
    return auth["password"], auth["username"]


def check(dests):
    """Are the ten talking about the same credential?"""
    fingerprints = {}
    for (ns, name), path in dests.items():
        p, u = pass_of(path)
        fingerprints.setdefault((u, p), []).append(f"{ns}/{name}")
    ok = len(fingerprints) == 1
    for (u, _), who in fingerprints.items():
        mark = f"{green}={reset}" if ok else f"{red}!{reset}"
        print(f"  {mark} user {u}: {len(who)} targets "
              f"{gray}({', '.join(who)}){reset}")
    if not ok:
        die("the regcred do NOT share the same credential — fix that "
            "BEFORE rotating (rotating on top hides the divergence)")

    # and the htpasswd has to validate that very password
    _, password = next(iter(fingerprints))
    with tempfile.TemporaryDirectory() as tmp:
        hp = os.path.join(tmp, "htpasswd")
        r = sh(["sops", "-d", "--extract", '["data"]["htpasswd"]',
                os.path.join(PLATFORM, HTPASSWD)])
        if r.returncode != 0:
            die(f"could not decrypt {HTPASSWD}")
        open(hp, "wb").write(base64.b64decode(r.stdout.strip()))
        v = subprocess.run(["htpasswd", "-vi", hp, USERNAME],
                           input=password, capture_output=True, text=True)
        if v.returncode != 0:
            die("the registry's htpasswd does NOT validate the password of the "
                "regcred: the cluster is already broken or about to be")
    print(f"  {green}={reset} the htpasswd validates that very password")
    return True


def encrypt_in_place(doc, target):
    """Writes the Secret in the clear and encrypts it IN-PLACE at its final path.

    At its final path and not in a temporary one: the rules of
    .sops.yaml are by path_regex, so encrypting in /tmp would pick
    another rule (or none) and the file would end up with the wrong
    shape.
    """
    path = os.path.join(PLATFORM, target)
    backup = path + ".rotating"
    if os.path.exists(path):
        shutil.copy2(path, backup)
    try:
        with open(path, "w", encoding="utf-8") as f:
            yaml.safe_dump(doc, f, sort_keys=False)
        r = sh(["sops", "-e", "--in-place", path])
        if r.returncode != 0:
            raise RuntimeError(f"sops -e failed on {target}: {r.stderr.strip()[:160]}")
    except Exception:
        if os.path.exists(backup):
            shutil.move(backup, path)
        raise
    if os.path.exists(backup):
        os.remove(backup)


def rotate(dests):
    password = base64.b64encode(secrets.token_bytes(32)).decode()

    # htpasswd bcrypt and dockerconfig COME OUT OF THE SAME material, in
    # the same process. The password never travels through argv at any
    # point.
    r = subprocess.run(["htpasswd", "-nBi", USERNAME], input=password,
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"htpasswd failed: {r.stderr.strip()[:160]}")
    htpasswd_txt = r.stdout if r.stdout.endswith("\n") else r.stdout + "\n"

    cfg = json.dumps({"auths": {HOST: {
        "username": USERNAME, "password": password,
        "auth": base64.b64encode(f"{USERNAME}:{password}".encode()).decode()}}},
        indent=2) + "\n"

    written = []
    encrypt_in_place({
        "apiVersion": "v1", "kind": "Secret",
        "metadata": {"name": "registry-htpasswd", "namespace": "registry-system"},
        "data": {"htpasswd": base64.b64encode(htpasswd_txt.encode()).decode()},
    }, HTPASSWD)
    written.append(HTPASSWD)
    print(f"  {green}↻{reset} {HTPASSWD}")

    for (ns, name), path in dests.items():
        encrypt_in_place({
            "apiVersion": "v1", "kind": "Secret",
            "type": "kubernetes.io/dockerconfigjson",
            "metadata": {"name": name, "namespace": ns},
            "data": {".dockerconfigjson": base64.b64encode(cfg.encode()).decode()},
        }, path)
        written.append(path)
        print(f"  {green}↻{reset} {path}")

    # ROUNDTRIP: sops is not trusted to have written what it was given.
    for (ns, name), path in dests.items():
        p, u = pass_of(path)
        if (u, p) != (USERNAME, password):
            die(f"{path} does not contain the new credential after encrypting — ABORTED")
    with tempfile.TemporaryDirectory() as tmp:
        hp = os.path.join(tmp, "htpasswd")
        r = sh(["sops", "-d", "--extract", '["data"]["htpasswd"]',
                os.path.join(PLATFORM, HTPASSWD)])
        open(hp, "wb").write(base64.b64decode(r.stdout.strip()))
        v = subprocess.run(["htpasswd", "-vi", hp, USERNAME], input=password,
                           capture_output=True, text=True)
        if v.returncode != 0:
            die("the new htpasswd does NOT validate the new password — ABORTED")
    print(f"  {green}✓{reset} roundtrip: the {len(written)} files talk about "
          f"the SAME new credential")
    del password
    return written


def main():
    # Rule 1 of the design: VERBS, not flags. `--revisar/--rotar` were
    # two mutually exclusive modes dressed up as options; they are two
    # things the command does, and one of them destroys material.
    p = argparse.ArgumentParser(prog=cli.cmd("registry"))
    sub = p.add_subparsers(dest="verb", required=True)
    sub.add_parser("check", help="touches nothing: verifies that the ten are aligned")
    sub.add_parser("rotate", help="generates a new credential and rewrites the ten")
    a = p.parse_args()

    print(f"{gray}targets (repo ∩ cluster):{reset}")
    dests = targets()
    for (ns, name), path in dests.items():
        print(f"  {gray}·{reset} {ns}/{name}  {gray}{path}{reset}")
    print()

    if a.verb == "check":
        check(dests)
        print(f"\n{green}✓{reset} the registry credential is ONE single one in "
              f"{len(dests) + 1} places")
        return 0

    print(f"{gray}state beforehand:{reset}")
    check(dests)
    print(f"\n{gray}rotating:{reset}")
    written = rotate(dests)
    print(f"""
{yellow}WHAT THIS COMMAND DOES NOT DO IS STILL MISSING:{reset}
  1. git add {len(written)} files + commit + push
  2. wait for the apps to sync (registry, ai-system, garage, kyverno,
     jenkins-secrets and the organizations)
  3. kubectl rollout restart -n registry-system deploy/registry
     {gray}(the registry reads the htpasswd at startup){reset}
  4. VERIFY with a real pull, not with a `get secret`: delete a pod that
     pulls an image from the internal registry and watch it come back
     Running.
""")
    return 0


if __name__ == "__main__":
    sys.exit(main())
