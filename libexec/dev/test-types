#!/usr/bin/env python3
# aegis-summary: Acceptance test of the service types
# aegis-group:   dev
# aegis-hidden:  true
"""Acceptance test #2 — that `tipo` should mean something.

Until 2026-08-04 a service's `tipo` field was validated against a list
and after that nobody consumed it: you could declare a public `worker`
on port 443, or a static front with `usa: [ai]` —that is, with a
credential that ends up published in the browser— and the generator said
yes.

A type that restricts nothing is not a type, it is a label.

This test walks every rule with its COUNTEREXAMPLE and demands that the
generator reject it. It is the opposite of test #1: that one checks that
the good is reproduced, this one that the bad does not get through.
Without the second, I could relax any validation and nothing would say
so.

    aegis dev test-types
"""
import importlib.machinery
import importlib.util
import os
import sys

import yaml

# ── canonical python preamble (V-102) ────────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import paths                  # noqa: E402

# PLATFORM_DIR is the INSTANCE (the live checkout of the platform), not
# the product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. On moving the
# code to the product the same line went on compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a grep».
PLATFORM_DIR = str(paths.platform_dir())
HERE = os.path.join(_AEGIS_ROOT, "libexec")

# The generator is a MODULE, not an executable loaded by its path: if
# the package is missing, this blows up here and does not pass for «does
# not apply» (A2).
from aegis import org as gen             # noqa: E402

red = "\033[31m"; green = "\033[32m"; gray = "\033[90m"; reset = "\033[0m"
if not sys.stdout.isatty():
    red = green = gray = reset = ""

BASE = """\
version: 1
organizacion: prueba
dominio: prueba.__ROOT_DOMAIN__
cuota: pequena
repo: git@github.com:ejemplo/repo.git
ai:
  plan: basico
  tareas:
    - {nombre: chat.x, capacidad: chat.rapido, prompt: g.txt}
servicios:
"""

# (what is tested, services, fragment the error MUST name)
#
# The third field matters: a rejection for the wrong reason would go
# green just the same, and it would be the same mistake already made
# four times this week — a guard that approves or rejects on account of
# something else.
#
# THE FRAGMENTS ARE THE MESSAGES' OWN WORDS: they are matched against
# the error text of lib/aegis/org.py, so they only move when that
# module's messages do — together, in one change.
BAD = [
    ("estatico with usa: the credential would end up in the browser",
     "  - {nombre: f, tipo: estatico, publico: /, usa: [ai]}", "estatico and declares usa"),
    ("estatico with a port of its own",
     "  - {nombre: f, tipo: estatico, publico: /, puerto: 3000}", "declares puerto"),
    ("estatico that nobody can visit",
     "  - {nombre: f, tipo: estatico}", "does not declare `publico`"),
    ("http without a port: the traffic would not arrive, and silently",
     "  - {nombre: a, tipo: http, publico: /api}", "does not declare `puerto`"),
    ("worker with a port: a worker does not listen",
     "  - {nombre: w, tipo: worker, puerto: 9000}", "worker and declares `puerto`"),
    ("published worker",
     "  - {nombre: w, tipo: worker, publico: /w}", "worker and declares `publico`"),
    ("postgres with repo: the database is provided by the platform",
     "  - {nombre: d, tipo: postgres, repo: 'git@github.com:x/y.git'}", "postgres and declares `repo`"),
    ("postgres published to the internet",
     "  - {nombre: d, tipo: postgres, publico: /db}", "postgres and declares `publico`"),
    ("postgres consuming services",
     "  - {nombre: d, tipo: postgres, usa: [ai]}", "postgres and declares usa"),
    ("usa:[postgres] without a single database declared",
     "  - {nombre: a, tipo: http, puerto: 8080, usa: [postgres]}", "did not declare any service of type postgres"),
    ("invented type",
     "  - {nombre: x, tipo: lambda, publico: /}", "unknown"),
]

# The contract that DOES have to pass. Without this case, a validation
# that rejected everything would come out green on the eleven above.
GOOD = """\
  - {nombre: front, tipo: estatico, publico: /}
  - {nombre: api,   tipo: http, puerto: 8080, publico: /api, usa: [ai, postgres]}
  - {nombre: cron,  tipo: worker, usa: [postgres]}
  - {nombre: db,    tipo: postgres}
"""


# ── WHOLE contracts ───────────────────────────────────────────────
#
# These cannot be tested with BASE, because what is being tested is
# precisely the ABSENCE of `repo` or of `dominio`. They go complete.
#
# The two rules say the same thing from two sides: a contract declares
# what its services need, no more and no less. Demanding `repo` from a
# pure-infrastructure organization forced it to invent an empty one;
# demanding `dominio` from something that publishes nothing forced it to
# invent a CNAME that nobody afterwards knows why it is there.
BAD_CONTRACTS = [
    ("an http without a repo anywhere: nobody builds that image", """\
version: 1
organizacion: prueba
cuota: pequena
servicios:
  - {nombre: api, tipo: http, puerto: 8080}
""", "are BUILT: api (http)"),

    ("something public without a domain: it starts and never receives traffic", """\
version: 1
organizacion: prueba
cuota: pequena
repo: git@github.com:ejemplo/repo.git
servicios:
  - {nombre: front, tipo: estatico, publico: /}
""", "'dominio' is required"),

    ("a domain with nothing public: a CNAME to a site that does not exist", """\
version: 1
organizacion: prueba
dominio: prueba.__ROOT_DOMAIN__
cuota: pequena
servicios:
  - {nombre: db, tipo: postgres}
""", "no service is"),
]

# And the one that HAS to pass: pure infrastructure. Without a repo
# because nothing is built, and without a domain because it publishes
# nothing. It is the natural order for assembling an organization —first
# the database and the bucket, then the app— and it was forbidden.
INFRA_CONTRACT = """\
version: 1
organizacion: prueba
cuota: pequena
almacenamiento:
  bucket: true
servicios:
  - {nombre: datos, tipo: postgres}
"""


def validate(services):
    """Returns None if it validates, or the text of the error."""
    return validate_contract(BASE + services)


def validate_contract(text):
    plans = yaml.safe_load(open(os.path.join(PLATFORM_DIR, "plans.yaml"), encoding="utf-8"))
    try:
        gen.validate(yaml.safe_load(text), plans)
        return None
    except gen.Invalid as e:
        return str(e)


def main():
    print(f"\n{'=' * 66}\nACCEPTANCE TEST #2 — `tipo` restricts\n{'=' * 66}")
    failures = 0

    for what, services, expected in BAD:
        err = validate(services)
        if err is None:
            print(f"  {red}✗{reset} {what}\n      {red}ACCEPTED — the rule does not exist or is not applied{reset}")
            failures += 1
        elif expected not in err:
            print(f"  {red}✗{reset} {what}\n      {red}rejected for ANOTHER reason{reset}: {err.splitlines()[0]}")
            failures += 1
        else:
            print(f"  {green}✓{reset} {what}")

    print(f"\n  {gray}and the complete contract with the four types:{reset}")
    err = validate(GOOD)
    if err is not None:
        print(f"  {red}✗{reset} a valid contract was rejected:\n      {err.splitlines()[0]}")
        failures += 1
    else:
        print(f"  {green}✓{reset} estatico + http + worker + postgres validates")

    print(f"\n  {gray}and the contract declares what its services need:{reset}")
    for what, text, expected in BAD_CONTRACTS:
        err = validate_contract(text)
        if err is None:
            print(f"  {red}✗{reset} {what}\n      {red}ACCEPTED — the rule does not exist or is not applied{reset}")
            failures += 1
        elif expected not in err:
            print(f"  {red}✗{reset} {what}\n      {red}rejected for ANOTHER reason{reset}: {err.splitlines()[0]}")
            failures += 1
        else:
            print(f"  {green}✓{reset} {what}")

    err = validate_contract(INFRA_CONTRACT)
    if err is not None:
        print(f"  {red}✗{reset} pure infrastructure (postgres + bucket, without repo or domain)"
              f"\n      {red}rejected{reset}: {err.splitlines()[0]}")
        failures += 1
    else:
        print(f"  {green}✓{reset} pure infrastructure validates: without repo and without domain")

    print()
    if failures:
        print(f"{red}{failures} rule(s) with no effect.{reset}\n")
        return 1
    print(f"{green}The {len(BAD) + len(BAD_CONTRACTS)} rules reject, "
          f"and the two valid contracts pass.{reset}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
