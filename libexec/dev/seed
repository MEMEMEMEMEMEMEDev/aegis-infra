#!/usr/bin/env python3
# aegis-summary: Compares and pulls changes from the instance into the seed
# aegis-group:   dev
# aegis-hidden:  true
"""aegis dev seed — compare and pull changes from the INSTANCE into the SEED.

This tool is for whoever MAINTAINS the product, not for whoever operates
an instance. It lives at the root of the aegis-v2 repo and works over two
trees that sit side by side:

    seed/platform/   the ARTIFACT   (what is delivered, with placeholders)
    platform/        the INSTANCE   (what runs, with the values filled in)

WHY IT EXISTS
=============

Until 2026-08-05 the two were the same folder. Separating them (commit
0b40587) removed the risk of trampling the running instance, but left the
debt: the seed stayed at 2026-07-28 and returning an improvement demands
UN-RENDERING the placeholders. As long as that is done by eye, it goes
out of sync again on its own. `semilla/PENDIENTE.md` §3.4 asks for exactly
this.

The problem is not copying files, it is that copying WITHOUT un-rendering
bakes an instance inside the product:

    SEED:      repoURL: git@github.com:__GH_OWNER__/__PLATFORM_REPO__.git
    INSTANCE:  repoURL: git@github.com:<owner>/<platform repo>.git

and the failure does not show up here: it shows up at the next startup, on
another machine, with a repo that does not exist. `pull` does that inverse
replacement as PART of the copy, not as a step somebody has to remember.

WHAT IT DOES NOT DO
===================

It does not decide what to migrate. `diff` says what differs; the judgment
of whether something belongs to the product or to this instance belongs to
whoever reads. The only thing the tool imposes is that nothing gets
EXCLUDED in silence: every exclusion is declared with its reason, is
printed, and a rule that matches nothing is an ERROR (a rule pruned by the
passage of time stops protecting and nobody finds out — the same disease
this project has been hunting: a signal that does not tell "it passed"
from "it was not evaluated").

USAGE
=====

    aegis dev seed diff                  what differs, grouped
    aegis dev seed diff <path>           the textual diff of one file
    aegis dev seed pull <path>...        copy from the live tree into the
                                            seed, un-rendering on the way
    aegis dev seed excluded              the policy, with reasons

The <path>s are relative to the root of each tree (`bin/aegis-org`, not
`platform/bin/aegis-org`).
"""

from __future__ import annotations

import difflib
import fnmatch
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# ── canonical python preamble (V-102) ────────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import paths                  # noqa: E402

# This tool is the ONLY one that needs both sides at once: the artifact
# (in the product) and the live tree (in the instance). That they now
# live in different repos is precisely what makes the comparison
# meaningful — in v2 they were two folders of the same repo and the drift
# went unnoticed (F1-F4).
#
# And it no longer compares bin/: the code stopped having a copy (02 §1).
# It goes on looking after k8s/, tofu/ and docs/, which is where the
# instance does learn things the seed has to inherit.
ROOT = paths.aegis_root()
SEED = ROOT / "seed" / "platform"
LIVE = paths.platform_dir()
CONF = paths.conf()

RED, GREEN, YELLOW, BLUE, GRAY, RESET = (
    "\033[1;31m", "\033[1;32m", "\033[1;33m", "\033[1;34m", "\033[0;90m", "\033[0m"
)
if not sys.stdout.isatty():
    RED = GREEN = YELLOW = BLUE = GRAY = RESET = ""


def die(msg: str) -> None:
    print(f"{RED}error:{RESET} {msg}", file=sys.stderr)
    sys.exit(1)


# ── the exclusion policy ────────────────────────────────────────────
#
# Each entry: (glob pattern over the relative path, reason).
#
# The reason is NOT decorative: it is what allows the policy to be
# reviewed without re-reading the code, and what makes it obvious when an
# exclusion stopped being true. `excluded` prints them all.
#
# Hard rule: a pattern that matches NO file of the live tree is an error,
# not a no-op. Otherwise the policy ages and goes on saying that
# everything is covered.
EXCLUSIONS = [
    ("*.enc.yaml",
     "secret of THIS instance. The init creates them and commits them "
     "afterwards; in the seed there is not a single one and that is right "
     "(verify-static check 18 does not demand that they be versioned, "
     "precisely because of this)."),
    (".sops.yaml",
     "phase 10 RENDERS it from .sops.yaml.tpl, which IS in the seed. "
     "Pulling it would bake this instance's age public key in."),
    ("k8s/base/platform/cosign/cosign.pub",
     "phase 80 produces it when generating the signing pair. It is "
     "generated material, not artifact."),
    ("tofu/envs/*/terraform.tfstate.enc.json",
     "the edge state of THIS instance: the tunnel's token travels inside "
     "it. Never into the product."),
    ("tofu/envs/*/.terraform.lock.hcl",
     "`tofu init` creates it during the run and phase 25 itself commits it "
     "(the «the init creates it and commits it afterwards» pattern, same "
     "family as *.enc.yaml and cosign.pub). Pulling it would pin THIS "
     "instance's providers into the product."),
    ("orgs/*.yaml",
     "the contracts of THIS instance (blog, portafolio, ejemplo). The seed "
     "carries at most one example contract, and it carries it written on "
     "purpose, not dragged in (PENDIENTE.md §3.3)."),
    # The organizations of THIS instance are NOT listed here: they are
    # derived from the contracts, further down. See `_instance_organizations`.
    ("k8s/organizations/org-ecommerce/*",
     "organization of THIS instance, derived from a contract that today "
     "does not exist in orgs/ (created by hand before the generator). It "
     "goes by hand because it is the only one with no contract to derive "
     "it from."),
    ("k8s/argocd-apps/tenants-heredados.yaml",
     "the organizations PRIOR to the generator, by hand and on purpose. It "
     "is this instance's debt (org-ecommerce without a contract): a new "
     "instance inherits nothing."),
    # WITHDRAWN on 2026-08-24: `aegis dev test-org`.
    #
    # It excluded the acceptance test that compares the generator's
    # output against the manifests written BY HAND for org-portafolio
    # —of THIS instance—, because in the seed it would have no subject
    # and would pass for empty. The reason was a good one and it is
    # still true; what changed is that it stopped being needed: in v3
    # the code lives in the PRODUCT and not in the seed (02 §1), so
    # this tool no longer compares `bin/` and there is no file the rule
    # could match.
    #
    # And that is why it stopped the run instead of doing nothing, which
    # is exactly what it was asked to do: a rule pruned by time stops
    # protecting without warning. It stays written here, without a
    # pattern, so that the reasoning is not lost with it.
]


def _instance_organizations() -> list[tuple[str, str]]:
    """One exclusion rule per CONTRACT, derived and not written.

    The manifests of `k8s/organizations/org-<X>/` are produced by
    `aegis org` out of `orgs/<X>.yaml`: they belong to THIS instance and
    do not belong to the product. The seed carries only org-canary, which
    has no contract because it is part of the substrate.

    They were listed BY HAND —blog, portafolio, ejemplo— and that already
    failed: org-shop was born on 2026-08-21, nobody added its rule, and
    ever since then `diff` had been offering to copy this instance's
    hardware store into the product. It is exactly the same defect as the
    vmagent probes block of 2026-08-22, and the same lesson this repo
    carries written into several checks: a hand-written list protects
    until somebody adds something and forgets, and it does not warn when
    it stops protecting.

    It is derived from the contracts directory, which is the source of
    truth about who exists. A new organization is covered the day it is
    born.
    """
    orgs_dir = LIVE / "orgs"
    if not orgs_dir.is_dir():
        return []
    rules = []
    for c in sorted(orgs_dir.glob("*.yaml")):
        org = c.stem
        # only if its manifests EXIST: a rule that matches nothing aborts
        # the tool (and rightly so), and a contract just written has not
        # derived anything yet.
        if (LIVE / "k8s" / "organizations" / f"org-{org}").is_dir():
            rules.append((f"k8s/organizations/org-{org}/*",
                          f"organization of THIS instance, derived from orgs/{org}.yaml "
                          f"(rule DERIVED from the contract, not hand-written)."))
    return rules


# ── DELIBERATE differences ──────────────────────────────────────────
#
# Files that exist in both trees and differ ON PURPOSE. Without this
# table, every run of `diff` reports them again and sooner or later
# somebody "fixes" the difference — which is exactly the accident this
# tool has to prevent.
#
# Same rule as EXCLUSIONS: an entry that no longer differs is an ERROR.
# Either the difference was lost (and that has to be found out) or the
# note went stale.
DELIBERATE = [
    ("k8s/base/kyverno-policies/kustomization.yaml",
     "in the seed it goes as `resources: []`. Phase 80 adds the entry in the "
     "SAME commit that injects cosign's public key (the runtime-entry "
     "pattern, checks 18/18b/39): listing it here would make kustomize ask "
     "for a file without a key during the whole startup."),
    ("k8s/bootstrap/appprojects-tenants.yaml",
     "DERIVED from orgs/*.yaml. In the seed it goes without documents because "
     "there are no contracts; in the instance it carries its organizations."),
    ("k8s/argocd-apps/tenants.yaml",
     "DERIVED from orgs/*.yaml, same case as appprojects-tenants.yaml."),
    ("k8s/bootstrap/appprojects.yaml",
     "the instance may have organizations here that are PRIOR to the "
     "generator (with no contract to derive them from). That is that "
     "instance's debt: the seed carries only the substrate and the canary."),
    ("ai/tasks.yaml",
     "the CLASSES travel, the TASKS do not: a task exists because some "
     "organization declared it in its contract, and the seed has no "
     "contracts."),
    ("orgs/README.md",
     "only in the seed, and that is the point: in the instance that directory "
     "has real contracts and the README adds nothing."),
    ("tofu/envs/cloudflare-tunnel/main.tf",
     "it differs in ONE line: public_hostnames is DERIVED by `aegis org edge` "
     "from the instance's contracts (here: blog, ejemplo, portafolio); the "
     "seed carries only the base that phase 25 applies (aegis, argocd, "
     "jenkins); grafana and ntfy are in edge.yaml out of the box but `edge` "
     "only adds them at phase 85, which is when there is something to serve "
     "(fase-85 §6 step 6). Same family as tenants.yaml. Without this "
     "un-deriving, phase 25 of a new instance would create CNAMEs of foreign "
     "apps out of thin air (seen 2026-08-19, Access's return to the seed)."),
]

# ── blocks DERIVED from the contracts ───────────────────────────────
#
# There is a third way of baking an instance inside the product, and
# neither un-rendering nor excluding covers it: a file that is HALF
# artifact and half derived. `aegis org` writes each organization's
# probes INSIDE vmagent/values.yaml, between two markers. The rest of the
# file is product and has to travel.
#
# Without this table, `pull` copied the whole file: the un-rendering
# turned blog.<the operator's domain> into blog.__ROOT_DOMAIN__ and the guard passed
# happily, because THIS instance's value was no longer there. But the
# NAMES were: the seed was left with probes to blog, ejemplo, portafolio
# and shop —four organizations that only exist here— and a new instance
# was born probing four nonexistent sites on its own domain. Four probes
# permanently red and four SitioDeInquilinoCaido on day one: the chronic
# false red, factory fitted. Found on 2026-08-22, one day after adding the
# derivation.
#
# It is the same family as appprojects-tenants.yaml and tenants.yaml (the
# derived ones that go in the seed WITHOUT documents), except that here
# the derived thing is not the whole file but a region of it.
UNDERIVED = {
    "k8s/base/observability/vmagent/values.yaml": (
        "    # --- DERIVED by aegis-org (tenant probes): do not edit by hand ---",
        "    # --- END DERIVED ---",
        "the per-organization probes are written by `aegis org apply` from the "
        "contracts; the seed has no contracts, so the block goes empty."),
}


def underive(path: str, text: str) -> str:
    """Empties the blocks a generator fills in from the contracts.

    The markers are left: they are the anchor where the generator writes,
    and without them the first run of `aegis org` on the new instance
    would have nowhere to put anything.
    """
    if path not in UNDERIVED:
        return text
    start, end, _ = UNDERIVED[path]
    i, f = text.find(start), text.find(end)
    if i < 0 or f < 0:
        die(f"{path}: the markers of the derived block were not found.\n"
            "  Either the generator changed the markers and this table went\n"
            "  stale, or the file lost the anchor. In both cases copying\n"
            "  without looking puts this instance's organizations inside the\n"
            "  product.")
    return text[:i + len(start)] + "\n" + text[f:]


# GENERATED-class placeholders: they do not come out of aegis-init.conf,
# the init produces them (phases 10 and 80). They are un-rendered by
# SHAPE, because the value changes on every instance and there is nowhere
# to read it from.
GENERATED = [
    (re.compile(r"-----BEGIN PUBLIC KEY-----.*?-----END PUBLIC KEY-----",
                re.DOTALL), "__COSIGN_PUB__"),
    (re.compile(r"-----BEGIN CERTIFICATE-----.*?-----END CERTIFICATE-----",
                re.DOTALL), "__AEGIS_CA_PEM__"),
    (re.compile(r"age1[0-9a-z]{20,}"), "__AGE_PUBLIC__"),
]

# The config-class ones, in the order lib/common.sh:235 declares them
# (_CONFIG_PLACEHOLDERS).
CONFIG_KEYS = ["GH_OWNER", "PLATFORM_REPO", "APP_REPO",
               "ROOT_DOMAIN", "REGISTRY_CLUSTER_IP", "ACME_EMAIL"]


def read_config() -> dict[str, str]:
    """The values phase 10 rendered THIS instance with.

    Without them un-rendering is impossible, and half un-rendering is
    worse than not doing it: it leaves the artifact with an instance
    inside and looking as if it were fine. That is why a missing config is
    fatal.
    """
    if not CONF.exists():
        # The WHOLE path, not relative to ROOT: the conf lives in the
        # INSTANCE and the instance can be anywhere. This
        # `relative_to(ROOT)` came from when product and instance were
        # the same folder, and it blew up with a traceback on exactly the
        # path that exists to explain why one cannot go on.
        die(f"{CONF} does not exist: without the values of this "
            "instance no un-rendering is possible")
    vals: dict[str, str] = {}
    for line in CONF.read_text().splitlines():
        m = re.match(r'\s*([A-Z_]+)\s*=\s*"?([^"#]*?)"?\s*(?:#.*)?$', line)
        if m and m.group(1) in CONFIG_KEYS:
            vals[m.group(1)] = m.group(2)
    missing = [k for k in CONFIG_KEYS if not vals.get(k)]
    if missing:
        die(f"{paths.conf()} does not define: {', '.join(missing)}")
    return vals


def unrender(text: str, vals: dict[str, str]) -> str:
    """The inverse of render_platform_placeholders (lib/common.sh).

    From longest to shortest: if one value is a substring of another, the
    short one first would leave the long one split down the middle.
    """
    for regex, ph in GENERATED:
        text = regex.sub(ph, text)
    for key in sorted(CONFIG_KEYS, key=lambda k: -len(vals[k])):
        text = text.replace(vals[key], f"__{key}__")
    return text


def tracked(tree: Path) -> list[str]:
    r = subprocess.run(["git", "-C", str(tree), "ls-files"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        die(f"{tree} is not a git repo ({r.stderr.strip()})")
    return sorted(x for x in r.stdout.splitlines() if x)


def classify(live: list[str]) -> tuple[list[str], dict[str, str]]:
    """Splits the live tree's list into (comparable, {excluded: reason}).

    And verifies that every rule of the policy still bites something.
    """
    excluded: dict[str, str] = {}
    orphans = []
    for pattern, reason in EXCLUSIONS + _instance_organizations():
        matched = [f for f in live if fnmatch.fnmatch(f, pattern)]
        if not matched:
            orphans.append(pattern)
        for f in matched:
            excluded.setdefault(f, reason)
    if orphans:
        die("exclusion rules that no longer match anything: "
            + ", ".join(orphans)
            + "\n  a rule pruned by time stops protecting without warning."
              "\n  Delete it from EXCLUSIONS or fix the pattern.")
    return [f for f in live if f not in excluded], excluded


def compare(vals: dict[str, str]):
    seed = [f[len("seed/platform/"):]
            for f in tracked(ROOT) if f.startswith("seed/platform/")]
    all_live = tracked(LIVE)
    live, excluded = classify(all_live)

    set_s, set_v = set(seed), set(live)
    missing = sorted(set_v - set_s)
    extra = sorted(set_s - set_v)
    differs = []
    for f in sorted(set_s & set_v):
        try:
            a = (SEED / f).read_text()
            b = underive(f, unrender((LIVE / f).read_text(), vals))
        except UnicodeDecodeError:
            a = (SEED / f).read_bytes().decode("utf-8", "replace")
            b = (LIVE / f).read_bytes().decode("utf-8", "replace")
        if a != b:
            differs.append(f)
    return missing, extra, differs, excluded


def cmd_diff(argv: list[str]) -> int:
    vals = read_config()
    if argv:
        path = argv[0]
        a_p, b_p = SEED / path, LIVE / path
        if not b_p.exists():
            die(f"{path} does not exist in the live tree")
        a = a_p.read_text().splitlines(keepends=True) if a_p.exists() else []
        b = underive(path, unrender(b_p.read_text(), vals)).splitlines(keepends=True)
        out = list(difflib.unified_diff(
            a, b, fromfile=f"seed/{path}", tofile=f"live(un-rendered)/{path}"))
        if not out:
            print(f"{GREEN}identical{RESET} (after un-rendering): {path}")
            return 0
        sys.stdout.writelines(out)
        return 1

    missing, extra, differs, excluded = compare(vals)

    # The deliberate ones are set aside from the three piles, and one that
    # stopped differing is an error: either the difference was lost or the
    # note aged.
    declared = {r: m for r, m in DELIBERATE}
    without_effect = [r for r in declared
                      if r not in differs and r not in extra and r not in missing]
    if without_effect:
        die("differences declared DELIBERATE that no longer differ: "
            + ", ".join(without_effect)
            + "\n  either the difference was lost (and that has to be found out),"
              "\n  or the note went stale. Review it in aegis dev seed.")
    on_purpose = [r for r in declared if r in differs or r in extra or r in missing]
    missing = [f for f in missing if f not in declared]
    differs = [f for f in differs if f not in declared]
    extra = [f for f in extra if f not in declared]

    print(f"{BLUE}══ MISSING from the seed ({len(missing)}) ══{RESET}")
    for f in missing:
        print(f"  + {f}")
    print(f"\n{BLUE}══ DIFFERS, after un-rendering ({len(differs)}) ══{RESET}")
    for f in differs:
        print(f"  ~ {f}")
    print(f"\n{BLUE}══ EXTRA in the seed ({len(extra)}) ══{RESET}")
    for f in extra:
        print(f"  - {f}")
    print(f"\n{GRAY}══ differ ON PURPOSE ({len(on_purpose)}) ══{RESET}")
    for f in sorted(on_purpose):
        print(f"  {GRAY}= {f}{RESET}")
        print(f"    {GRAY}{declared[f]}{RESET}")
    print(f"\n{GRAY}══ excluded by policy: {len(excluded)} files "
          f"({len(EXCLUSIONS) + len(_instance_organizations())} rules, "
          f"{len(_instance_organizations())} derived from the contracts). "
          f"`aegis dev seed excluded` details them ══{RESET}")

    total = len(missing) + len(differs) + len(extra)
    if total == 0:
        print(f"\n{GREEN}the seed is up to date with the instance{RESET}")
        return 0
    print(f"\n{YELLOW}{total} differences{RESET}")
    return 1


def cmd_pull(argv: list[str]) -> int:
    if not argv:
        die("pull needs at least one path (relative to the root of the tree)")
    vals = read_config()
    _, excluded = classify(tracked(LIVE))
    for path in argv:
        source, target = LIVE / path, SEED / path
        if not source.exists():
            die(f"{path} does not exist in the live tree")
        if source.is_dir():
            die(f"{path} is a directory: pass the files one by one "
                "(A7 — explicit lists, never globs)")
        if path in excluded:
            die(f"{path} is excluded by policy:\n  {excluded[path]}")

        try:
            text = underive(path, unrender(source.read_text(), vals))
        except UnicodeDecodeError:
            die(f"{path} is not text: it cannot be un-rendered, copy it by "
                "hand and explain why in the commit")

        # The guard that makes this worth anything: if a value of THIS
        # instance survives, the copy is aborted. Without this check the
        # tool would be a `cp` with extra steps.
        for key in CONFIG_KEYS:
            if vals[key] in text:
                die(f"{path}: the value of {key} survived "
                    f"({vals[key]}) the un-rendering — nothing is copied")

        target.parent.mkdir(parents=True, exist_ok=True)
        new = not target.exists()
        target.write_text(text)
        shutil.copymode(source, target)
        print(f"  {GREEN}{'new' if new else 'updated'}{RESET}  {path}")
    print(f"\n{YELLOW}remember:{RESET} verify-static verifies THE SEED. "
          "Run it before committing.")
    return 0


def cmd_excluded(_argv: list[str]) -> int:
    live = tracked(LIVE)
    _, excluded = classify(live)
    for pattern, reason in EXCLUSIONS + _instance_organizations():
        matched = [f for f in live if fnmatch.fnmatch(f, pattern)]
        print(f"{BLUE}{pattern}{RESET}  ({len(matched)} files)")
        for line in reason.split(". "):
            if line.strip():
                print(f"    {GRAY}{line.strip().rstrip('.')}.{RESET}")
        print()
    return 0


def main() -> int:
    if not SEED.is_dir():
        die(f"{SEED} does not exist")
    if not LIVE.is_dir():
        die(f"{LIVE} does not exist: this tool compares against the live "
            "instance, and on this machine there is none")
    # Same rule as EXCLUSIONS: an entry that no longer bites stops
    # protecting without warning. Here it is checked up front, not when
    # that file is touched, because `diff` with no arguments would never
    # touch it.
    for path, (start, end, _) in UNDERIVED.items():
        f = LIVE / path
        if not f.is_file():
            die(f"UNDERIVED names {path} and it does not exist in the instance")
        t = f.read_text()
        if start not in t or end not in t:
            die(f"UNDERIVED: {path} no longer has the markers of the derived "
                "block. Without them, pulling that file would bake this "
                "instance's organizations inside the product.")
    cmds = {"diff": cmd_diff, "pull": cmd_pull, "excluded": cmd_excluded}
    if len(sys.argv) < 2 or sys.argv[1] not in cmds:
        print(__doc__)
        return 2
    return cmds[sys.argv[1]](sys.argv[2:])


if __name__ == "__main__":
    sys.exit(main())
