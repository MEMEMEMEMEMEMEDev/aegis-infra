#!/usr/bin/env python3
# aegis-summary: Acceptance test of the organizations protocol
# aegis-group:   dev
# aegis-hidden:  true
"""Acceptance test #1 of the organizations protocol.

Compares the Kubernetes OBJECTS the generator produces against the ones
written by hand in the repo, for an organization that is already
deployed.

It compares objects and not bytes on purpose: reproducing hand-written
comments has no value and is not possible. What matters is that the same
objects come out with the same fields. If they do not, the protocol's
model does not describe reality — and that has to be known BEFORE
generating new organizations with it.

    aegis dev test-org orgs/portafolio.yaml
"""
import importlib.machinery
import importlib.util
import os
import sys

import yaml

# ── canonical python preamble (V-102) ────────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import paths                  # noqa: E402

# PLATFORM_DIR is the INSTANCE (the live checkout of the platform), not
# the product. In v2 this line was `dirname(dirname(__file__))` and it
# worked because the command lived INSIDE the instance. On moving the
# code to the product the same line went on compiling and started
# pointing at the wrong place — C1/C2's «dependency invisible to a grep».
PLATFORM_DIR = str(paths.platform_dir())
HERE = os.path.join(_AEGIS_ROOT, "libexec")

# The generator is a MODULE, not an executable loaded by its path: if
# the package is missing, this blows up here and does not pass for «does
# not apply» (A2).
from aegis import org as gen             # noqa: E402

red = "\033[31m"; green = "\033[32m"; yellow = "\033[33m"; gray = "\033[90m"; reset = "\033[0m"


def objects(text):
    """(kind, name) -> object, ignoring the empty documents."""
    out = {}
    for d in yaml.safe_load_all(text):
        if not d:
            continue
        out[(d["kind"], d["metadata"]["name"])] = d
    return out


def differences(a, b, path=""):
    """Differences field by field. Returns a list of texts."""
    ds = []
    if type(a) is not type(b):
        return [f"{path}: type {type(a).__name__} vs {type(b).__name__}"]
    if isinstance(a, dict):
        for k in sorted(set(a) | set(b)):
            if k not in b:
                ds.append(f"{path}/{k}: ONLY by hand = {a[k]!r}")
            elif k not in a:
                ds.append(f"{path}/{k}: ONLY generated = {b[k]!r}")
            else:
                ds += differences(a[k], b[k], f"{path}/{k}")
    elif isinstance(a, list):
        if len(a) != len(b):
            ds.append(f"{path}: {len(a)} elements by hand vs {len(b)} generated")
        else:
            for i, (x, y) in enumerate(zip(a, b)):
                ds += differences(x, y, f"{path}[{i}]")
    elif a != b:
        ds.append(f"{path}: by hand={a!r}  generated={b!r}")
    return ds


def main(contract_path):
    raw = open(contract_path, encoding="utf-8").read()
    plans = yaml.safe_load(open(os.path.join(PLATFORM_DIR, "plans.yaml"), encoding="utf-8"))
    c = gen.validate(yaml.safe_load(raw), plans)
    org = c["organizacion"]
    org_dir = os.path.join(PLATFORM_DIR, "k8s", "organizations", f"org-{org}")

    out, _ = gen.render(c, plans, raw)

    # By hand: everything kustomize would incorporate as resources.
    by_hand = {}
    for f in ("bundle.yaml", "netpol.yaml", "apps.yaml"):
        p = os.path.join(org_dir, f)
        if os.path.exists(p):
            by_hand.update(objects(open(p, encoding="utf-8").read()))

    generated = {}
    for f in ("bundle.yaml", "netpol.yaml", "apps.yaml"):
        if f in out:
            generated.update(objects(out[f]))

    print(f"\n{'='*66}\nACCEPTANCE TEST #1 — org-{org}\n{'='*66}")
    print(f"by hand:   {len(by_hand)} objects")
    print(f"generated: {len(generated)} objects\n")

    failures = 0
    for key in sorted(set(by_hand) | set(generated)):
        kind, name = key
        label = f"{kind}/{name}"
        if key not in generated:
            print(f"  {red}✗{reset} {label}  {red}the generator does NOT produce it{reset}")
            failures += 1
            continue
        if key not in by_hand:
            print(f"  {yellow}+{reset} {label}  {gray}only generated (it did not exist by hand){reset}")
            continue
        ds = differences(by_hand[key], generated[key])
        if not ds:
            print(f"  {green}✓{reset} {label}")
        else:
            print(f"  {yellow}~{reset} {label}  {gray}{len(ds)} difference(s){reset}")
            for d in ds[:8]:
                print(f"        {gray}{d}{reset}")
            failures += 1

    print()
    if failures:
        print(f"{yellow}{failures} object(s) with differences.{reset}")
        print(f"{gray}Every difference is a decision: either the generator is wrong, or\n"
              f"the object written by hand has a particularity that has to be taken\n"
              f"to the contract, or it is a real inconsistency worth correcting.{reset}\n")
        return 1
    print(f"{green}The generator reproduces org-{org} object by object.{reset}\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1]))
