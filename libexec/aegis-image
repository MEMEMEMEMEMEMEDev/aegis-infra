#!/usr/bin/env bash
# aegis-summary: Ask for a base image: mirrored, scanned, signed, and the FROM to paste
# aegis-group:   apps
# aegis-subcommands: request list from check gc
# aegis-help:
# Usage: aegis image request <repo>:<tag> [--bump]
#                           [--allow <CVE> --until <YYYY-MM-DD> --reason "<text>"]
#        aegis image list
#        aegis image from <name>:<tag>
#        aegis image check
#        aegis image gc [--keep <N>] [--repo <name>] [--yes]
#
# request  asks the platform for a base image. It measures the digest the
#          tag points at TODAY, declares it in mirror-images/images.txt,
#          commits AND PUSHES that edit (the mirror job clones the repo
#          from its remote: an unpushed commit is an edit it never sees),
#          fires the mirror job (pull, blocking scan, push, signature)
#          and prints the one line to paste into a Containerfile.
#          Running it twice over the same tag writes nothing, commits
#          nothing and fires nothing: it prints the same line and leaves.
#          --bump  the upstream tag MOVED and you decide to follow it.
#                  Without it, a moved tag is an error, not a silent
#                  re-pin: a new digest is not a new image.
#          --allow/--until/--reason  the scan went red and the CVE is
#                  provably not reachable in this binary: writes ONE
#                  dated, path-scoped exception into
#                  mirror-images/trivyignore.yaml and retries ONCE.
#                  All three are required together. There is no --force.
# list     what is declared, crossed against the internal registry:
#          name, tag, short digest, mirrored, signed, live exception.
# from     prints ONLY the FROM line for an image already mirrored, so a
#          template or a generator can consume it. Nothing on stdout if
#          it is not there.
# check    everything declared is mirrored and signed; what is not comes
#          with the command that fixes it.
# gc       prunes the internal registry: it deletes the manifests that
#          nothing fixes and nothing runs, and then collects the blobs
#          they held. It PRINTS ITS PLAN AND STOPS unless --yes is
#          given, because deleting images is not an operation that
#          happens on its own.
#          --keep <N>  how many of the newest images of each repository
#                  survive on age alone (default 2: the one that is
#                  running and the one to roll back to; a third is not
#                  a rollback, it is history). Whatever the instance
#                  fixes by digest is kept whatever N says.
#          --repo <name>  one repository instead of all of them.
#          --yes   act. Without it nothing is deleted and nothing is
#                  collected.
#
# AEGIS_IMAGE_DRY_RUN=1  request and list explain what they WOULD do and
#          touch nothing: no cluster, no registry, no git, no build. It
#          is how this command is exercised where there is no instance.
#
# Exit codes: the house's four, plus what each one means here —
#   0  the image is mirrored and signed; the FROM was printed
#   1  measured and wrong: the upstream tag moved (use --bump), the scan
#      went red, or `from`/`check` found something not mirrored
#   2  COULD NOT EVALUATE: no cluster, no instance, no registry answer
#   3  invalid usage

# aegis-image — a developer asks for a technology, and gets back the
# FROM the build will demand.
#
# ── why it exists ─────────────────────────────────────────────────
# Until today, using Python 3.11 or Java 21 meant reading a 462-line
# protocol, measuring a digest by hand, editing a list, firing a job
# from the Jenkins console and typing the FROM from memory. Every one
# of those five steps is a place to be wrong, and being wrong there is
# expensive in the worst way: the build STARTS and dies later, further
# away, in somebody else's pipeline.
#
# The platform does not get to pick versions for anybody — three
# Pythons are three lines in the list, and which three is the
# developer's business. What the platform owes is the other half: FIX
# the digest of what was asked for, SCAN it, SIGN it, and hand back the
# exact line. That is this command, and it is the same five steps with
# the hand taken out.
#
# ── what it does NOT do ───────────────────────────────────────────
# It does not deploy, and it does not bump anybody's FROM. Mirroring an
# image and putting it in production are two decisions (images.md §2),
# and this command only ever takes the first. It does not re-pin a
# moved upstream tag on its own either: --bump is a person saying yes.
# And it has no --force. The two honest ways out of a red scan are a
# newer tag or a dated exception that says what was measured; a third
# one would only be a way of not looking.

set -euo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
# The PRODUCT resolves from this file, following symlinks (phase 05
# installs /usr/local/bin/aegis as a symlink; with a bare dirname
# AEGIS_ROOT would be /usr/local). The INSTANCE is lib/paths.sh's
# business, never this file's.
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} image: readlink is missing — I cannot tell where the product lives" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
bad_usage() { printf '%s image: %s\n' "${AEGIS_CMD:-aegis}" "$*" >&2; printf 'try: %s image --help\n' "${AEGIS_CMD:-aegis}" >&2; exit 3; }

# ── arguments, BEFORE anything runs ─────────────────────────────────
# `--help` is answered here with nothing sourced beyond paths.sh and
# nothing executed: until 2026-08-26 `aegis preflight --help` installed
# packages instead of describing itself.
VERB="${1:-}"; [[ $# -gt 0 ]] && shift
case "$VERB" in
    -h|--help|"")               usage; exit 0 ;;
    request|list|from|check|gc) ;;
    *) bad_usage "«$VERB» is not a subcommand (request | list | from | check | gc)" ;;
esac

REF="" ; BUMP=0 ; ALLOW="" ; UNTIL="" ; REASON=""

# ── gc: the retention policy, and the two states of this command ────
# GC_KEEP_DEFAULT is the number of images each repository keeps ON AGE
# ALONE, on top of everything that is fixed or running. It is 2 and the
# reason is arithmetic, not taste — the long form is in
# docs/protocols/images.md §8:
#   · what a rollback needs is two digests, the one deployed and the
#     one it replaced. A third is not a rollback, it is history;
#   · the GPU engine costs about 5.6 GB per build in this registry (two
#     rebuilds occupied 11.2 GB, measured 2026-09-01), and the same
#     disk has to hold the ~42 GiB of scratch its next build needs
#     while the kubelet evicts below ~11 GiB free. Each extra copy of
#     THAT one repository spends 5.6 GB of that margin.
# It is a floor, never a ceiling on safety: a digest the instance fixes
# or the cluster runs is kept whatever this number says.
GC_KEEP_DEFAULT=2
# GC_ACT is the whole difference between saying and doing, and it opens
# at 0: this command explains its plan and touches nothing unless a
# person typed --yes. There is no environment variable that flips it.
GC_ACT=0
KEEP="$GC_KEEP_DEFAULT" ; ONLY_REPO=""
case "$VERB" in
  request)
    while (($#)); do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            --bump)    BUMP=1; shift ;;
            --allow)   [[ $# -ge 2 ]] || bad_usage "--allow needs a CVE identifier"; ALLOW="$2"; shift 2 ;;
            --allow=*) ALLOW="${1#--allow=}"; shift ;;
            --until)   [[ $# -ge 2 ]] || bad_usage "--until needs a date (YYYY-MM-DD)"; UNTIL="$2"; shift 2 ;;
            --until=*) UNTIL="${1#--until=}"; shift ;;
            --reason)  [[ $# -ge 2 ]] || bad_usage "--reason needs the text of the measurement"; REASON="$2"; shift 2 ;;
            --reason=*) REASON="${1#--reason=}"; shift ;;
            --force*)  bad_usage "there is no --force here: a red scan has two honest ways out, a newer tag or a dated exception (--allow/--until/--reason). Both leave a trace; a force leaves none" ;;
            -*)        bad_usage "unknown flag «$1»" ;;
            *)         [[ -z "$REF" ]] || bad_usage "one image at a time (already given: «$REF», then «$1»)"
                       REF="$1"; shift ;;
        esac
    done
    [[ -n "$REF" ]] || bad_usage "request needs an image: <repo>:<tag>"
    # The three travel together or not at all. An exception with no
    # measurement is a CVE nobody looks at; one with no end date is
    # invisible debt (images.md §6, and check 136 refuses both shapes).
    if [[ -n "$ALLOW$UNTIL$REASON" && ( -z "$ALLOW" || -z "$UNTIL" || -z "$REASON" ) ]]; then
        bad_usage "--allow, --until and --reason go together: a scan exception is a MEASUREMENT (what was checked), a DATE it stops holding, and the CVE it covers"
    fi
    [[ -z "$ALLOW" || "$ALLOW" =~ ^CVE-[0-9]{4}-[0-9]{4,}$ ]] \
        || bad_usage "«$ALLOW» is not a CVE identifier (CVE-YYYY-NNNN...)"
    [[ -z "$UNTIL" || "$UNTIL" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] \
        || bad_usage "«$UNTIL» is not an ISO date (YYYY-MM-DD): trivy silences forever what it cannot parse"
    ;;
  from)
    [[ $# -ge 1 ]] || bad_usage "from needs an image: <name>:<tag>"
    case "$1" in -h|--help) usage; exit 0 ;; -*) bad_usage "unknown flag «$1»" ;; esac
    REF="$1"; shift
    (($# == 0)) || bad_usage "from takes exactly one argument (got «$1» as well)"
    ;;
  list|check)
    (($# == 0)) || { [[ "$1" == -h || "$1" == --help ]] && { usage; exit 0; }; bad_usage "$VERB takes no arguments (got «$1»)"; }
    ;;
  gc)
    while (($#)); do
        case "$1" in
            -h|--help)  usage; exit 0 ;;
            --keep)     [[ $# -ge 2 ]] || bad_usage "--keep needs a number"; KEEP="$2"; shift 2 ;;
            --keep=*)   KEEP="${1#--keep=}"; shift ;;
            --repo)     [[ $# -ge 2 ]] || bad_usage "--repo needs a repository name"; ONLY_REPO="$2"; shift 2 ;;
            --repo=*)   ONLY_REPO="${1#--repo=}"; shift ;;
            --dry-run)  shift ;;
            --yes)      GC_ACT=1; shift ;;
            --force*)   bad_usage "there is no --force here either: what protects an image from this command is that something fixes it or runs it, and no flag is going to argue with that. If a pin is wrong, fix the pin" ;;
            -*)         bad_usage "unknown flag «$1»" ;;
            *)          bad_usage "gc takes no positional arguments (got «$1»): one repository is --repo <name>" ;;
        esac
    done
    [[ "$KEEP" =~ ^[0-9]+$ ]] \
        || bad_usage "--keep needs a whole number of images to retain per repository (got «$KEEP»)"
    ;;
esac

# ── the libs (only now: nothing above needed them) ──────────────────
# common.sh: log_* to stderr, die, retry_net, REGISTRY_HOST_INTERNAL,
# git_commit_if_changes. secrets.sh: secrets_workdir (tmpfs + shred on
# exit) and registry_creds. jenkins.sh: the API from inside the pod,
# next-build-number BEFORE the trigger, wait by number.
# shellcheck source=../lib/common.sh
source "$AEGIS_ROOT/lib/common.sh"
# shellcheck source=../lib/secrets.sh
source "$AEGIS_ROOT/lib/secrets.sh"
# shellcheck source=../lib/jenkins.sh
source "$AEGIS_ROOT/lib/jenkins.sh"

# rc 2 is «the instrument never reached the subject» — not «wrong» and
# never «empty». die() is rc 1 (measured and wrong); this is the other
# verdict, and it carries the reason.
could_not() { log_error "COULD NOT EVALUATE: $*"; exit 2; }

DRY=0; [[ "${AEGIS_IMAGE_DRY_RUN:-0}" == 1 ]] && DRY=1
dry() { (( DRY == 1 )); }

[[ -f "$AEGIS_CONF" ]] && source "$AEGIS_CONF"
: "${REGISTRY_CLUSTER_IP:=}"

MIRROR_JOB=mirror-images
IMAGES_REL="mirror-images/images.txt"
IGNORE_REL="mirror-images/trivyignore.yaml"

# WHERE THE LIST LIVES. The mirror job reads it out of a checkout of the
# INSTANCE's platform repo, so that is the copy an edit has to land in —
# never the seed, which is the product and is read-only during a run.
# The one exception is the dry run: with no instance on the machine
# there is still something worth answering, and reading the seed's copy
# answers it without pretending the instance exists.
# It is resolved ONLY for the subcommands that read the list. `from`
# asks the registry and nothing else, and it is consumed by generators
# on machines that have a cluster: making it demand a platform checkout
# would be answering «there is no instance» to a question about the
# registry — the wrong verdict, which is worse than none.
LIST_ROOT="$PLATFORM_DIR" IMAGES="" IGNORE=""
need_list() {
    LIST_ROOT="$PLATFORM_DIR"
    if [[ ! -f "$PLATFORM_DIR/$IMAGES_REL" ]]; then
        if dry && [[ -f "$AEGIS_ROOT/seed/platform/$IMAGES_REL" ]]; then
            LIST_ROOT="$AEGIS_ROOT/seed/platform"
            log_warn "dry run with no instance at $PLATFORM_DIR: reading the SEED's list ($LIST_ROOT/$IMAGES_REL). A real run edits the instance's copy and never this one"
        else
            could_not "$PLATFORM_DIR/$IMAGES_REL does not exist — there is no instance here, or its platform repo is not the one the mirror job reads"
        fi
    fi
    IMAGES="$LIST_ROOT/$IMAGES_REL"
    IGNORE="$LIST_ROOT/$IGNORE_REL"
}

# ═══════════════════════════════════════════════════════════════════
#  the list: parsing, and the source registry nobody should have to type
# ═══════════════════════════════════════════════════════════════════

# entries: the file without comments or blank lines. Two fields, tab or
# spaces, exactly as the job's parser reads them (check 135).
entries() { grep -vE '^[[:space:]]*(#|$)' "$IMAGES"; }

# default_registry_path: where a bare `python:3.12-slim` comes from.
# DERIVED from the list and not written here, which is rule 1 of the
# glossary's §4: if the platform ever moves off this mirror, the entries
# move and so does this answer — there is no second place to edit. Today
# it resolves to the public ECR mirror of the official images, chosen
# because it serves the same bytes as Docker Hub without a pull-rate
# limit (the mirror job died on a `TOOMANYREQUESTS` once already).
default_registry_path() {
    entries | awk '{print $1}' \
        | sed -n 's|^\(.*/library\)/[^/]*:.*|\1|p' \
        | sort | uniq -c | sort -rn | awk 'NR==1{print $2}'
}

# resolve_ref <ref> — sets SRC_REPO (host/path, no tag) and SRC_TAG.
# The registry-or-not question is Docker's own rule, not a guess: the
# first segment is a registry when it carries a dot or a port.
SRC_REPO="" SRC_TAG=""
resolve_ref() {
    local ref="$1" last first
    [[ "$ref" != *@* ]] || bad_usage "give «${ref%%@*}» by TAG, not by digest: measuring the digest is what this command is for"
    last="${ref##*/}"
    if [[ "$last" == *:* ]]; then SRC_TAG="${last##*:}"; ref="${ref%:*}"; fi
    # No tag = no request. `latest` is the mutable pointer this whole
    # protocol exists to refuse, and inventing one here would be the
    # platform choosing a version on somebody's behalf — the one thing
    # it must not do.
    [[ -n "$SRC_TAG" ]] || bad_usage "«$1» carries no tag: say WHICH version you need (python:3.12-slim, eclipse-temurin:21-jre). A request with no tag is a request for whatever the registry happens to serve today"
    first="${ref%%/*}"
    if [[ "$ref" == */* && ( "$first" == *.* || "$first" == *:* || "$first" == localhost ) ]]; then
        SRC_REPO="$ref"
    else
        local pre; pre="$(default_registry_path)"
        [[ -n "$pre" ]] || die "$IMAGES declares no official-image path to default to: give the full reference, registry included"
        SRC_REPO="$pre/$ref"
    fi
}

# The destination name is the last segment of the source path, which is
# what every entry in the list already does (`.../library/redis` →
# `redis`). Derived, so two people asking for the same technology get
# the same line and not two copies of it under different names.
dst_of() { printf '%s:%s' "${SRC_REPO##*/}" "$SRC_TAG"; }

# line_for <repo> <tag> — the entry that declares THIS source, or empty.
# Keyed on repo:tag (what was asked for), never on the digest: the whole
# point of --bump is that the digest under a tag can change.
line_for() { entries | awk -v k="$1:$2@" 'index($1, k)==1{print; exit}'; }

# ═══════════════════════════════════════════════════════════════════
#  the upstream registry: measuring a digest without crane on the host
# ═══════════════════════════════════════════════════════════════════
# The host has no crane (the protocol's `crane digest` is what a person
# types; a command cannot depend on it being installed), so the digest
# is read the way every registry client reads it: the v2 API, the token
# dance, and Docker-Content-Digest off the manifest HEAD. It is the same
# mechanic phase 80 and `aegis ci digests` use against the internal
# registry, with the anonymous pull token added on top.
OCI_ACCEPT='application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.docker.distribution.manifest.v2+json'

# docker.io is a NAME, not the endpoint: the registry answers on
# registry-1.docker.io. A reference that says docker.io and a curl that
# believes it gets a 404 that looks like «that image does not exist».
oci_endpoint() { case "$1" in docker.io|index.docker.io) printf 'registry-1.docker.io' ;; *) printf '%s' "$1" ;; esac; }

_oci_call() {   # <HEAD|GET> <url> — prints the http code; body/headers to tmpfs
    local m="$1" url="$2"
    local -a args=(-sS --max-time 30 -D "$SECRETS_TMP/oci.hdr" -o "$SECRETS_TMP/oci.body"
                   -w '%{http_code}' -H "Accept: $OCI_ACCEPT")
    [[ "$m" == HEAD ]] && args+=(-I)
    # The bearer travels by -K (a curl config, 600, in tmpfs) and never
    # by argv: /proc/PID/cmdline is world-readable, and a pull token is
    # still a credential (rule A27, check 075).
    [[ -s "$SECRETS_TMP/oci.curlrc" ]] && args+=(-K "$SECRETS_TMP/oci.curlrc")
    curl "${args[@]}" "$url"
}

# oci_fetch <HEAD|GET> <url> <repo-path> — one call, and if the registry
# answers 401 it plays the challenge it just handed us and calls again.
# Anything that is not a 200 at the end is a failure with its code said
# out loud: a silent empty answer is the disease, not the diagnosis.
oci_fetch() {
    local m="$1" url="$2" path="$3" code chal realm service scope token
    : > "$SECRETS_TMP/oci.curlrc"
    code="$(_oci_call "$m" "$url")" || { log_warn "$url: curl could not complete the request"; return 1; }
    if [[ "$code" == 401 ]]; then
        chal="$(tr -d '\r' < "$SECRETS_TMP/oci.hdr" | sed -n 's/^[Ww][Ww][Ww]-[Aa]uthenticate:[[:space:]]*[Bb]earer[[:space:]]*//p' | head -1)"
        [[ -n "$chal" ]] || { log_warn "$url: 401 without a Bearer challenge — this registry wants credentials aegis does not have"; return 1; }
        realm="$(sed -n 's/.*realm="\([^"]*\)".*/\1/p' <<< "$chal")"
        service="$(sed -n 's/.*service="\([^"]*\)".*/\1/p' <<< "$chal")"
        scope="$(sed -n 's/.*scope="\([^"]*\)".*/\1/p' <<< "$chal")"
        [[ -n "$scope" ]] || scope="repository:$path:pull"
        [[ -n "$realm" ]] || { log_warn "$url: the challenge names no realm"; return 1; }
        token="$(curl -fsS --max-time 30 --get \
                    ${service:+--data-urlencode "service=$service"} \
                    --data-urlencode "scope=$scope" "$realm" \
                 | jq -r '.token // .access_token // empty')" || token=""
        [[ -n "$token" ]] || { log_warn "$realm did not hand out an anonymous pull token"; return 1; }
        ( umask 077; printf 'header = "Authorization: Bearer %s"\n' "$token" > "$SECRETS_TMP/oci.curlrc" )
        code="$(_oci_call "$m" "$url")" || return 1
    fi
    [[ "$code" == 200 ]] || { log_warn "$url answered HTTP $code"; return 1; }
    return 0
}

# upstream_digest — what the tag points at TODAY. Docker-Content-Digest
# when the registry sends it; otherwise the sha256 of the manifest body,
# which is the same number by definition.
upstream_digest() {
    local host path url d
    host="$(oci_endpoint "${SRC_REPO%%/*}")"; path="${SRC_REPO#*/}"
    url="https://$host/v2/$path/manifests/$SRC_TAG"
    retry_net 3 oci_fetch HEAD "$url" "$path" || return 1
    d="$(tr -d '\r' < "$SECRETS_TMP/oci.hdr" | awk 'tolower($1)=="docker-content-digest:"{print $2}' | tail -1)"
    if [[ ! "$d" =~ ^sha256:[0-9a-f]{64}$ ]]; then
        retry_net 3 oci_fetch GET "$url" "$path" || return 1
        d="sha256:$(sha256sum < "$SECRETS_TMP/oci.body" | awk '{print $1}')"
    fi
    [[ "$d" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
    printf '%s' "$d"
}

# upstream_newer_tags — the tags upstream publishes that sort ABOVE the
# one we are on and carry the same shape (`3.12-slim` suggests
# `3.13-slim`, never `3.13-bookworm`). It is advice, not a decision:
# whether a newer tag is the right one is not a thing a sort can know,
# and the answer is printed as a suggestion for a human to weigh.
upstream_newer_tags() {
    local host path suffix
    host="$(oci_endpoint "${SRC_REPO%%/*}")"; path="${SRC_REPO#*/}"
    oci_fetch GET "https://$host/v2/$path/tags/list" "$path" || return 1
    suffix="$(sed 's/^[0-9][0-9.]*//' <<< "$SRC_TAG")"
    jq -r '.tags[]?' < "$SECRETS_TMP/oci.body" \
      | grep -E "^[0-9][0-9.]*$(sed 's/[][\.*^$/]/\\&/g' <<< "$suffix")$" \
      | sort -V | awk -v cur="$SRC_TAG" 'seen{print} $0==cur{seen=1}' | tail -3
}

# ═══════════════════════════════════════════════════════════════════
#  the internal registry: is it there, and is it signed
# ═══════════════════════════════════════════════════════════════════
# Read exactly as `aegis ci digests` reads it: by ClusterIP (the cert's
# SAN carries it), netrc by file, CA by file, and the digest out of the
# registry's own manifest — never a build log (check 069).
reg_ready() {
    kubectl -n jenkins-system get secret regcred-internal -o name >/dev/null 2>&1 \
        || could_not "the Secret jenkins-system/regcred-internal is not readable (kubeconfig? is the cluster up?)"
    kubectl -n cert-manager get secret aegis-internal-ca -o name >/dev/null 2>&1 \
        || could_not "the Secret cert-manager/aegis-internal-ca is not readable — without the CA the registry's TLS cannot be trusted"
    if [[ -z "$REGISTRY_CLUSTER_IP" ]]; then
        REGISTRY_CLUSTER_IP="$(kubectl -n registry-system get svc registry -o jsonpath='{.spec.clusterIP}' 2>/dev/null || true)"
        [[ -n "$REGISTRY_CLUSTER_IP" ]] \
            || could_not "no REGISTRY_CLUSTER_IP in $AEGIS_CONF and registry-system/svc/registry has no ClusterIP"
    fi
    registry_creds "$REGISTRY_HOST_INTERNAL" "$REGISTRY_CLUSTER_IP"
    [[ -s "$SECRETS_TMP/registry.netrc" && -s "$SECRETS_TMP/aegis-ca.crt" ]] \
        || could_not "the registry credential or the CA came out empty from the cluster"
}
# reg_head <repo> <reference> — ONE HEAD against the internal registry.
# It prints the HTTP code and leaves the headers in tmpfs; it fails only
# when the registry never answered at all.
#
# WHY NOT `curl -f`. With -f a 404 and a refused connection come back as
# the same failed exit, and the caller that reads «failed» as «the image
# is not there» reports rc 1 —measured and wrong— for a registry that is
# merely unreachable. Measured with REGISTRY_CLUSTER_IP pointed at
# 127.0.0.1: `image check` said «declared and NOT mirrored» for the seven
# declared images and offered to fire seven mirror builds; `image from`,
# which is the contract the generators consume, answered «it is not in
# the internal registry» to a question it had not been able to ask. The
# header of this file promises the third verdict for exactly this («2
# COULD NOT EVALUATE: no cluster, no instance, no registry answer») and
# this is where it is earned.
reg_head() {   # <repo> <reference>
    retry_net 3 curl -sS --max-time 30 \
        --netrc-file "$SECRETS_TMP/registry.netrc" --cacert "$SECRETS_TMP/aegis-ca.crt" \
        -o /dev/null -D "$SECRETS_TMP/reg.hdr" -w '%{http_code}' \
        -I -H "Accept: $OCI_ACCEPT" \
        "https://$REGISTRY_CLUSTER_IP:5000/v2/$1/manifests/$2"
}

# reg_digest <repo> <tag> — the digest the registry SERVES, with the
# three verdicts kept apart:
#   0  it serves it, and the digest is on stdout
#   1  it answered, and it does not have it
#   2  it did not answer, or answered something that is not an answer
reg_digest() {   # <repo> <tag>
    local code d
    code="$(reg_head "$1" "$2")" || return 2
    case "$code" in
        200) ;;
        404) return 1 ;;
        *)   log_warn "the internal registry answered HTTP $code for $1:$2 — a code is not a verdict about the image"; return 2 ;;
    esac
    d="$(tr -d '\r' < "$SECRETS_TMP/reg.hdr" | awk 'tolower($1)=="docker-content-digest:"{print $2}' | tail -1)"
    [[ "$d" =~ ^sha256:[0-9a-f]{64}$ ]] \
        || { log_warn "the internal registry served $1:$2 without a Docker-Content-Digest header"; return 2; }
    printf '%s' "$d"
}
# SIGNED, and what that word means here. cosign publishes the signature
# of <digest> as a tag `sha256-<hex>.sig` in the same repository, so its
# PRESENCE is a fact this host can measure with the registry API alone —
# no cosign binary, no public key, nothing to install. What it is not is
# a cryptographic verification: that one is done where the key already
# is, by Kyverno at admission (require-aegis-signature) and by the
# from-guard stage of Jenkinsfile.app at build time. Saying «signed»
# here and meaning «the signature object exists» is only honest if it is
# written down, so it is.
reg_signed() {   # <repo> <digest> — 0 signed · 1 no signature object · 2 no answer
    local code
    code="$(reg_head "$1" "${2/:/-}.sig")" || return 2
    case "$code" in
        200) return 0 ;;
        404) return 1 ;;
        *)   log_warn "the internal registry answered HTTP $code for the signature of $1@$2"; return 2 ;;
    esac
}

from_line() { printf 'FROM %s/%s@%s\n' "$REGISTRY_HOST_INTERNAL" "$1" "$2"; }

# ═══════════════════════════════════════════════════════════════════
#  the mirror job
# ═══════════════════════════════════════════════════════════════════
jenkins_ready() {
    kubectl -n jenkins-system get sts jenkins -o name >/dev/null 2>&1 \
        || could_not "jenkins-system/sts/jenkins is not reachable (kubeconfig? is the cluster up?)"
    jenkins_get_code "/job/$MIRROR_JOB/api/json" 2>/dev/null | grep -q '^200$' \
        || could_not "Jenkins has no job «$MIRROR_JOB» — did the jenkins App sync the Job DSL?"
}

# fire_mirror — fires the job and waits. Returns 0 on SUCCESS; on
# failure it leaves MIRROR_BUILD pointing at the build whose console
# carries the reason. The retry logic (a FAILURE with a network
# signature is re-fired, one without is not) is lib/jenkins.sh's, not a
# second copy of it here.
MIRROR_BUILD=""
fire_mirror() {
    local tries=3 first n res
    first="$(jenkins_next_build "$MIRROR_JOB")" \
        || could_not "no nextBuildNumber for $MIRROR_JOB — the Jenkins API stopped answering"
    MIRROR_BUILD="$first"
    if jenkins_build_retry "$MIRROR_JOB" 2700 "$tries" ""; then
        for ((n = first; n < first + tries; n++)); do
            res="$(jenkins_get "/job/$MIRROR_JOB/$n/api/json" 2>/dev/null | jq -r '.result // empty' 2>/dev/null || true)"
            [[ "$res" == SUCCESS ]] && { MIRROR_BUILD="$n"; return 0; }
        done
        return 0
    fi
    # the LAST attempt that produced a verdict is the one whose console
    # explains the red.
    for ((n = first + tries - 1; n >= first; n--)); do
        res="$(jenkins_get "/job/$MIRROR_JOB/$n/api/json" 2>/dev/null | jq -r '.result // empty' 2>/dev/null || true)"
        [[ -n "$res" ]] && { MIRROR_BUILD="$n"; break; }
    done
    return 1
}

# THE JOB IS NOT ABOUT ONE IMAGE. `mirror-images` pulls, scans, pushes
# and signs EVERY entry of images.txt on every run (the
# `MIRROR_ENTRIES.each` of its Jenkinsfile); a broken entry is noted
# down, the loop carries on, and the build fails at the end with the
# whole list. So the red of a build is not evidence about the image
# somebody happened to ask for today, and until this was written it was
# reported as if it were: asking for python:3.12-slim the day
# postgres:17.10-alpine grew a CRITICAL produced «python:3.12-slim was
# NOT mirrored», the CRITICAL rows of postgres listed underneath, and a
# suggested `--allow <postgres CVE>` under the python request — a dated
# exception filed against the wrong binary, with a measurement about
# another one attached to it.
#
# The console names who failed twice, and both are read here: one
# `FAILED <dst>: <message>` per broken entry, and the final
# `images that failed (N): a, b`.
failed_entries() {   # <console>
    python3 - "$1" <<'PY'
import re, sys
console = open(sys.argv[1], errors="replace").read().split("\n")
out = [m.group(1) for m in (re.match(r"FAILED (\S+):", l.strip()) for l in console) if m]
if not out:
    for l in console:
        m = re.search(r"images that failed \(\d+\): (.+)$", l)
        if m:
            out = [x.strip() for x in m.group(1).split(",") if x.strip()]
print("\n".join(dict.fromkeys(out)))
PY
}

# console_slice <console> <dst> — the part of the console that belongs to
# ONE entry. The job echoes `================ <dst> ================`
# before each one, and that separator is the only thing that scopes a
# trivy row to the image it was found on: the scan runs over
# `mirror.tar`, so the target names trivy prints carry no trace of which
# entry they came from.
console_slice() {   # <console> <dst>
    python3 - "$1" "$2" <<'PY'
import sys
console, dst = open(sys.argv[1], errors="replace").read().split("\n"), sys.argv[2]
out, on = [], False
for ln in console:
    s = ln.strip()
    if s.startswith("================") and s.endswith("================"):
        mid = s.strip("=").strip()
        # trivy underlines each scan target with a bare row of "=", and
        # report_scan needs those to find the targets: a separator with
        # nothing between the bars is not the job's, it is the scan's.
        if mid:
            on = (mid == dst)
            continue
    if on:
        out.append(ln)
print("\n".join(out))
PY
}

# report_scan <console> <dst> — what the scan found, said in the terms a
# decision needs: severity, package, the version that fixes it, and the
# target it was found on (which is what an exception has to be scoped
# to). The verdict itself came from Jenkins' API, not from this text:
# prose is what a person reads, never what a program decides on.
report_scan() {
    python3 - "$1" "$2" <<'PY'
import re, sys
console, dst = open(sys.argv[1], errors="replace").read().split("\n"), sys.argv[2]
target, rows = None, []
for i, ln in enumerate(console):
    s = ln.strip()
    if i + 1 < len(console) and set(console[i + 1].strip()) == {"="} and s:
        target = s
        continue
    if "CVE-" not in s and "GHSA-" not in s:
        continue
    cells = [c.strip() for c in s.split("│") if c.strip()] or s.split()
    sev = next((c for c in cells if c in ("CRITICAL", "HIGH", "MEDIUM", "LOW")), "")
    if sev not in ("CRITICAL", "HIGH"):
        continue
    ident = next((c for c in cells if c.startswith(("CVE-", "GHSA-"))), "")
    rows.append((target or "?", sev, cells[0] if cells else "?", ident, cells[-1] if cells else ""))
if not rows:
    print("    the console shows no CRITICAL/HIGH row — the red is not the scan's:", file=sys.stderr)
    print("\n".join("    " + l for l in console[-25:]), file=sys.stderr)
    sys.exit(0)
print(f"    {len(rows)} blocking finding(s) on {dst}:", file=sys.stderr)
for t, sev, pkg, ident, fixed in rows[:20]:
    print(f"    {sev:<8} {ident:<20} {pkg:<28} fixed in: {fixed}   [on {t}]", file=sys.stderr)
seen = sorted({t for t, *_ in rows})
print(f"    scan targets involved (this is what an exception's `paths` must name): {', '.join(seen)}", file=sys.stderr)
PY
}

# ═══════════════════════════════════════════════════════════════════
#  request
# ═══════════════════════════════════════════════════════════════════

# write_entry — inserts the declaration in the group it belongs to,
# keeping the file's own headings. The list is read by people as much as
# by the job: a line appended at the bottom, far from the `# --- ` it
# belongs under, is how a curated file turns into a dump.
write_entry() {   # <src-with-digest> <dst>
    python3 - "$IMAGES" "$1" "$2" <<'PY'
import sys
path, src, dst = sys.argv[1:4]
lines = open(path).read().split("\n")
# the group a runtime asked for by a developer belongs to; if the file
# does not carry it, the entry opens it, with the same shape as the rest.
HEAD = "# --- application runtimes"
start = next((i for i, l in enumerate(lines) if l.startswith(HEAD)), None)
row = f"{src}\t{dst}"
if start is None:
    while lines and not lines[-1].strip():
        lines.pop()
    lines += ["", "# --- application runtimes -------------------------------------------", row, ""]
else:
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("# --- ")), len(lines))
    while end > start + 1 and not lines[end - 1].strip():
        end -= 1
    lines[end:end] = [row]
open(path, "w").write("\n".join(lines))
PY
}

bump_entry() {   # <repo> <tag> <new-digest>
    python3 - "$IMAGES" "$1" "$2" "$3" <<'PY'
import re, sys
path, repo, tag, digest = sys.argv[1:5]
txt = open(path).read()
pat = re.compile(rf"^({re.escape(repo)}:{re.escape(tag)}@)sha256:[0-9a-f]{{64}}", re.M)
new, n = pat.subn(rf"\g<1>{digest}", txt, count=1)
if n != 1:
    sys.exit(f"the entry {repo}:{tag} is not in {path} exactly once ({n} matches)")
open(path, "w").write(new)
PY
}

# write_exception — one dated, path-scoped entry in trivyignore.yaml,
# in the shape check 136 demands and the file's own comment prescribes:
# the CVE, the exact scan targets it was found on, the measurement with
# the day it was made, and the day it stops holding. The file is
# appended as TEXT and never round-tripped through a YAML dumper: its
# comments are the measurements, and a dumper would throw them away.
write_exception() {   # <cve> <until> <reason> <paths...>
    python3 - "$IGNORE" "$@" <<'PY'
import datetime, sys, yaml
path, cve, until, reason = sys.argv[1:5]
paths = sys.argv[5:]
if not paths:
    sys.exit("no scan target to scope the exception to: a path-less entry silences the CVE wherever it appears, which is the wildcard this file forbids")
today = datetime.date.today()
end = datetime.date.fromisoformat(until)
if end <= today:
    sys.exit(f"--until {until} is not in the future (measured today, {today})")
limit = today.replace(year=today.year + 1)
if end > limit:
    sys.exit(f"--until {until} is more than 12 months after the measurement ({today}): the measurement holds for THIS binary, not for one two rebuilds away")
txt = open(path).read()
if f"id: {cve}" in txt:
    sys.exit(f"{cve} already has an entry in {path}: re-measure the one that is there instead of adding a second")
body = [
    "",
    f"  # {cve} — exception written by the operator on {today} while asking",
    "  # for this image. The statement is the measurement; when it expires,",
    "  # trivy reports again and the measurement has to be redone.",
    f"  - id: {cve}",
    "    paths: [" + ", ".join(f'"{p}"' for p in paths) + "]",
    f'    statement: "{reason.rstrip(chr(46))}. Measured {today}."',
    f"    expired_at: {end.isoformat()}",
]
new = txt.rstrip("\n") + "\n" + "\n".join(body) + "\n"
doc = yaml.safe_load(new)
if not isinstance(doc, dict) or not isinstance(doc.get("vulnerabilities"), list):
    sys.exit("the file stopped parsing as a trivy ignore-file after the append — nothing was written")
open(path, "w").write(new)
print(f"    {cve} scoped to {', '.join(paths)}, expires {end.isoformat()}", file=sys.stderr)
PY
}

# commit_list — the edit lands where the JOB reads it, which is not this
# disk. The mirror job is a pipeline-from-SCM: it clones
# `__PLATFORM_REPO__` at branch main (the Job DSL in
# k8s/base/platform/jenkins/values.yaml) and does readFile over THAT
# checkout. So a commit that stays local is an edit the job never sees,
# and the three shapes of that bug are all silent:
#   · a first request: the job re-mirrors the OLD list, ends SUCCESS,
#     and the registry does not serve the new image — the command then
#     blames the registry for a push that never happened;
#   · a --bump: the job re-mirrors the OLD digest, ends SUCCESS, the
#     registry serves it, and the FROM printed carries a digest the list
#     on disk no longer declares. Green and lying, which is worse;
#   · an --allow: the retry fires a job that never sees trivyignore.yaml
#     and comes back red identical, so the exception looks not to work.
# git_push_verified is the house helper for exactly this class (a failed
# push that carries on cost run #9). The equality against @{upstream}
# afterwards is the property itself and not the push's exit code: what
# has to be true is that the remote branch NOW CONTAINS this commit.
commit_list() {   # <message> <paths...>
    local msg="$1"; shift
    git -C "$LIST_ROOT" rev-parse --git-dir >/dev/null 2>&1 \
        || could_not "$LIST_ROOT is not a git repository — the mirror job builds from a commit, so an edit nobody committed is an edit the job never sees"
    git_commit_if_changes "$LIST_ROOT" "$msg" "$@"
    git -C "$LIST_ROOT" rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1 \
        || could_not "$LIST_ROOT has no upstream branch: the mirror job clones the platform repo from its remote, and a commit with nowhere to go is an edit the job never sees"
    git_push_verified "$LIST_ROOT"
    local head up
    head="$(git -C "$LIST_ROOT" rev-parse HEAD)"
    up="$(git -C "$LIST_ROOT" rev-parse '@{upstream}' 2>/dev/null || true)"
    [[ "$head" == "$up" ]] \
        || could_not "the push left $LIST_ROOT at $head and its remote branch at ${up:-nothing}: the mirror job reads the REMOTE, so it would build the list as it was before this edit"
    log_info "the edit is on the remote branch the mirror job builds from ($head)"
}

do_request() {
    need_list
    resolve_ref "$REF"
    local dst; dst="$(dst_of)"
    local repo_name="${dst%%:*}"
    local existing pinned
    existing="$(line_for "$SRC_REPO" "$SRC_TAG")"
    pinned=""; [[ -n "$existing" ]] && pinned="$(awk '{print $1}' <<< "$existing" | sed 's/.*@//')"

    # A destination taken by ANOTHER source is the one collision that
    # would silently make two technologies share a name in the registry.
    local clash
    clash="$(entries | awk -v d="$dst" '$2==d{print $1}' | grep -v "^$SRC_REPO:" || true)"
    [[ -z "$clash" ]] || die "the destination $dst is already declared for $clash: two sources cannot share one name:tag in the registry"

    if dry; then
        log_info "dry run — nothing is measured, written, committed or built"
        printf 'source       %s:%s\n' "$SRC_REPO" "$SRC_TAG"
        printf 'destination  %s/%s\n' "$REGISTRY_HOST_INTERNAL" "$dst"
        if [[ -z "$existing" ]]; then
            printf 'would        measure the digest of the tag, add the line to %s, commit AND PUSH it (the job clones the remote), fire %s and print the FROM\n' "$IMAGES_REL" "$MIRROR_JOB"
        elif (( BUMP )); then
            printf 'declared     %s\n' "$pinned"
            printf 'would        re-measure the tag and, if it moved, rewrite that digest, commit AND PUSH it, fire %s and print the FROM\n' "$MIRROR_JOB"
        else
            printf 'declared     %s\n' "$pinned"
            printf 'would        re-measure the tag: unchanged and already mirrored+signed prints the FROM and writes nothing; moved is an error unless --bump\n'
        fi
        return 0
    fi

    secrets_workdir
    jenkins_ready
    reg_ready

    local measured
    measured="$(upstream_digest)" \
        || could_not "could not read the digest of $SRC_REPO:$SRC_TAG from its registry — this is NOT «the tag does not exist»: the read itself failed"
    log_info "$SRC_REPO:$SRC_TAG is $measured today"

    local action="none"
    if [[ -z "$existing" ]]; then
        action="add"
    elif [[ "$pinned" == "$measured" ]]; then
        action="none"
    elif (( BUMP )); then
        action="bump"
    else
        # A moved tag is a DECISION, and the platform does not take it.
        # image-watch already knows whether the candidate is any
        # cleaner: UpstreamFixAvailable fires only when the image is
        # vulnerable today AND the tag moved AND the candidate scans
        # clean. Re-pinning without that is signing somebody else's new
        # bytes with our key because a string stayed the same.
        log_error "$SRC_REPO:$SRC_TAG moved upstream:"
        log_error "  declared $pinned"
        log_error "  today    $measured"
        log_error "A new digest is NOT a new image (docs/protocols/images.md §0): the tag moved twice in one day once, and neither move carried the fix."
        log_error "image-watch already answers whether the candidate is cleaner — the alert UpstreamFixAvailable fires only when it is."
        log_error "If you decide to follow it: ${AEGIS_CMD:-aegis} image request $REF --bump"
        return 1
    fi

    local digest rc=0
    if [[ "$action" == none ]]; then
        # IDEMPOTENCE, and the whole point of it: declared with this
        # digest is not the same as SERVED with it. The registry is
        # asked, and only when it answers with a mirrored and signed
        # image does this command write nothing, build nothing and
        # simply hand back the line.
        #
        # And an unanswered read is NOT «it is not there»: taking it for
        # one fires a whole mirror build —every entry pulled, scanned and
        # signed again— over an image that may be perfect.
        digest="$(reg_digest "$repo_name" "$SRC_TAG")" || rc=$?
        (( rc != 2 )) || could_not "the internal registry did not answer about $dst: nothing can be concluded, and firing $MIRROR_JOB over an unanswered read would be acting on a guess"
        if (( rc == 0 )); then
            local sg=0; reg_signed "$repo_name" "$digest" || sg=$?
            (( sg != 2 )) || could_not "the internal registry did not answer about the signature of $dst"
            if (( sg == 0 )); then
                log_ok "$dst is already declared at this digest, mirrored and signed — nothing to do"
                from_line "$dst" "$digest"
                return 0
            fi
        fi
        local held="does not hold it"; (( rc == 0 )) && held="holds it unsigned"
        log_warn "$dst is declared at this digest but the registry $held: firing $MIRROR_JOB (the list is not touched)"
    fi

    case "$action" in
        add)  write_entry "$SRC_REPO:$SRC_TAG@$measured" "$dst"
              commit_list "feat(mirror): $dst, requested through the image command" "$IMAGES_REL"
              log_ok "$dst declared in $IMAGES_REL" ;;
        bump) bump_entry "$SRC_REPO" "$SRC_TAG" "$measured"
              commit_list "fix(mirror): $dst follows the tag upstream moved to" "$IMAGES_REL"
              log_ok "$dst re-pinned to $measured" ;;
    esac

    local attempt=1 red_elsewhere=0
    while :; do
        if fire_mirror; then break; fi

        local console="$SECRETS_TMP/mirror-console.txt"
        jenkins_get "/job/$MIRROR_JOB/$MIRROR_BUILD/consoleText" > "$console" 2>/dev/null || : > "$console"

        # WHOSE RED IS IT — answered before a single word is said about
        # $dst, because «$dst was NOT mirrored» is plainly false when the
        # red belonged to another entry.
        local culprits others slice
        culprits="$(failed_entries "$console")"
        if [[ -z "$culprits" ]]; then
            log_error "$MIRROR_JOB #$MIRROR_BUILD went red and its console names no failing entry: the build died before or outside the per-image loop, so nothing can be attributed — least of all to $dst. The last lines of that build:"
            tail -25 "$console" | sed 's/^/    /' >&2
            return 1
        fi
        if ! grep -qxF "$dst" <<< "$culprits"; then
            log_error "$MIRROR_JOB #$MIRROR_BUILD went red, and NOT on $dst. What failed: $(tr '\n' ' ' <<< "$culprits")"
            log_error "The job mirrors every entry of $IMAGES_REL on every run, so that red was there before this request and belongs to those entries (${AEGIS_CMD:-aegis} image list names their sources)."
            [[ -z "$ALLOW" ]] \
                || die "--allow $ALLOW was given while asking for $dst, and $dst is not what failed: the exception would be scoped to another image's scan targets and would carry your measurement under a binary you did not measure. Ask for THAT image, with its own measurement"
            red_elsewhere=1
            break
        fi

        # Scoped to this entry's block. Without it the CRITICAL rows of
        # every other broken image get printed under this request, and
        # the `paths:` of an exception would be scoped to them.
        slice="$SECRETS_TMP/mirror-console-entry.txt"
        console_slice "$console" "$dst" > "$slice"
        log_error "$MIRROR_JOB #$MIRROR_BUILD went red — $dst was NOT mirrored (the scan runs BEFORE the push: nothing entered the registry)"
        others="$(grep -vxF "$dst" <<< "$culprits" | tr '\n' ' ')"
        [[ -z "${others// /}" ]] \
            || log_warn "that build also failed on: ${others}— each one is its own request, with its own measurement; nothing below is about them"
        report_scan "$slice" "$dst"

        if [[ -z "$ALLOW" || $attempt -gt 1 ]]; then
            log_error "The two honest ways out:"
            local newer
            newer="$(upstream_newer_tags 2>/dev/null | tr '\n' ' ' || true)"
            if [[ -n "${newer// /}" ]]; then
                log_error "  1. a newer tag. Upstream publishes, above $SRC_TAG and with the same shape: $newer"
            else
                log_error "  1. a newer tag — none newer with the same shape as $SRC_TAG could be listed from upstream; check the image's own release notes"
            fi
            log_error "  2. a dated exception, only for a CVE you have MEASURED is not reachable in this binary:"
            log_error "     ${AEGIS_CMD:-aegis} image request $REF --allow <CVE> --until <YYYY-MM-DD> --reason \"what you measured\""
            log_error "     It is scoped to the scan targets listed above and expires; there is no --force."
            return 1
        fi

        # The exception path, once. A second red after writing it means
        # the exception did not cover what was blocking, and retrying
        # again would only be a loop with a file growing inside it.
        local targets
        targets="$(python3 - "$slice" "$ALLOW" <<'PY'
import sys
console = open(sys.argv[1], errors="replace").read().split("\n")
cve, target, hits = sys.argv[2], None, []
for i, ln in enumerate(console):
    s = ln.strip()
    if i + 1 < len(console) and set(console[i + 1].strip()) == {"="} and s:
        target = s
        continue
    if cve in s and target:
        hits.append(target)
print("\n".join(dict.fromkeys(hits)))
PY
)"
        [[ -n "$targets" ]] || die "$ALLOW does not appear in the part of $MIRROR_JOB #$MIRROR_BUILD's console that belongs to $dst: an exception for a CVE this image's scan did not report would silence something nobody measured on it. If it is another entry's finding, that entry is its own request"
        # shellcheck disable=SC2086
        write_exception "$ALLOW" "$UNTIL" "$REASON" $targets \
            || die "the exception could not be written (nothing was changed)"
        commit_list "fix(mirror): dated exception for $ALLOW on $dst" "$IGNORE_REL"
        log_warn "exception written and committed — retrying $MIRROR_JOB ONCE"
        attempt=2
    done

    # The two failures used to be one message that blamed the registry
    # for both. They are not the same fact and they do not have the same
    # verdict: «it answered and it does not have it» is measured and
    # wrong (rc 1); «it did not answer» is the instrument not reaching
    # the subject (rc 2).
    local outcome="ended SUCCESS"
    (( red_elsewhere == 0 )) || outcome="did not fail on $dst but went red on other entries"
    rc=0; digest="$(reg_digest "$repo_name" "$SRC_TAG")" || rc=$?
    (( rc != 2 )) || could_not "$MIRROR_JOB #$MIRROR_BUILD $outcome and the internal registry did not answer: whether $dst is there cannot be said from here"
    (( rc == 0 )) || die "$MIRROR_JOB #$MIRROR_BUILD $outcome and the registry answers that it does not serve $dst — read that build: the push step is where the bytes were supposed to land"
    rc=0; reg_signed "$repo_name" "$digest" || rc=$?
    (( rc != 2 )) || could_not "the internal registry did not answer about the signature of $dst"
    (( rc == 0 )) || die "$dst is in the registry and carries NO signature: Kyverno would reject any pod that used it. Read $MIRROR_JOB #$MIRROR_BUILD — the sign step is the last one and it did not leave its object"
    log_ok "$dst mirrored, scanned and signed"
    # The verdict is about $dst and says only that. The job stays red for
    # the others, and `aegis image check` is where that surfaces as a red
    # for the platform instead of for this request.
    (( red_elsewhere == 0 )) \
        || log_warn "$MIRROR_JOB is still red for the other entries named above: this exit code is about $dst, and ${AEGIS_CMD:-aegis} image check is what reports the rest"
    from_line "$dst" "$digest"
}

# ═══════════════════════════════════════════════════════════════════
#  list
# ═══════════════════════════════════════════════════════════════════
do_list() {
    need_list
    local n=0
    if dry; then
        log_info "dry run — the registry is not asked; only what the list DECLARES is shown"
        printf '%-28s %-22s %-14s %s\n' NAME TAG DIGEST STATE
        while read -r src dst; do
            [[ -n "$dst" ]] || continue
            n=$((n+1))
            printf '%-28s %-22s %-14s %s\n' "${dst%%:*}" "${dst#*:}" \
                "$(sed 's/.*@sha256:\(.\{12\}\).*/\1/' <<< "$src")" "declared (not measured: dry run)"
        done < <(entries)
        log_ok "$n images declared in $IMAGES_REL"
        return 0
    fi
    secrets_workdir
    reg_ready
    # The live exceptions, so a line that is only green because a CVE is
    # being looked past says so, with the day it stops being looked past.
    local exc; exc="$SECRETS_TMP/exceptions.txt"; : > "$exc"
    [[ -f "$IGNORE" ]] && python3 - "$IGNORE" > "$exc" <<'PY'
import sys, yaml
doc = yaml.safe_load(open(sys.argv[1])) or {}
for v in doc.get("vulnerabilities") or []:
    for p in v.get("paths") or []:
        print(f"{v.get('id')}\t{v.get('expired_at')}\t{p}")
PY
    printf '%-28s %-22s %-14s %-9s %-7s %s\n' NAME TAG DIGEST MIRRORED SIGNED EXCEPTION
    local unread=0
    while read -r src dst; do
        [[ -n "$dst" ]] || continue
        n=$((n+1))
        local name="${dst%%:*}" tag="${dst#*:}" d short mirrored signed exline rc=0 sg=0
        # A row of «no» for a registry that never answered is a table
        # that reads as a verdict and is not one. Unread rows say `?`,
        # and the command's exit code says COULD NOT EVALUATE.
        d="$(reg_digest "$name" "$tag")" || rc=$?
        if (( rc == 2 )); then unread=$((unread+1)); mirrored="?"; signed="?"; short="—"
        elif (( rc == 1 )); then mirrored=no; signed=no; short="—"
        else mirrored=yes; short="$(sed 's/^sha256://;s/^\(.\{12\}\).*/\1/' <<< "$d")"
             reg_signed "$name" "$d" || sg=$?
             case "$sg" in 0) signed=yes ;; 1) signed=NO ;; *) signed="?"; unread=$((unread+1)) ;; esac
        fi
        # An exception naming this image's own scan target, or the tar
        # glob every mirrored image is scanned as.
        exline="$(awk -F'\t' -v n="$name" '$3 ~ /\.tar/ || index($3, n) {printf "%s→%s ", $1, $2}' "$exc" | head -c 60)"
        printf '%-28s %-22s %-14s %-9s %-7s %s\n' "$name" "$tag" "$short" "$mirrored" "$signed" "${exline:-—}"
    done < <(entries)
    (( unread == 0 )) || could_not "$unread read(s) of the internal registry never got an answer (rows marked ?): what the table shows for those images is not a measurement"
    log_ok "$n images declared; the registry answered for each"
}

# ═══════════════════════════════════════════════════════════════════
#  from — the contract other generators consume
# ═══════════════════════════════════════════════════════════════════
# ONE line on stdout and nothing else, or nothing at all on stdout and
# the reason on stderr. Whoever calls this pipes it into a file; a
# progress message on stdout would end up inside somebody's
# Containerfile, which is exactly why stdout is sacred here.
do_from() {
    local name="${REF%%:*}" tag="${REF#*:}"
    [[ "$REF" == *:* && -n "$name" && -n "$tag" ]] \
        || bad_usage "from needs <name>:<tag> as the registry holds it (see: ${AEGIS_CMD:-aegis} image list)"
    secrets_workdir
    reg_ready
    local d rc=0 sg=0
    # `from` is the contract the generators consume, and a generator
    # takes «it is not there» for a measured answer. So an unanswered
    # read has to come out as the third verdict and never as the first:
    # a template that stops being generated because the socket was shut
    # is a different bug from one whose base was never mirrored.
    d="$(reg_digest "$name" "$tag")" || rc=$?
    (( rc != 2 )) || could_not "the internal registry did not answer about $name:$tag — nothing is said about whether it is mirrored"
    if (( rc == 1 )); then
        log_error "$name:$tag is not in the internal registry — ask for it: ${AEGIS_CMD:-aegis} image request $name:$tag"
        return 1
    fi
    reg_signed "$name" "$d" || sg=$?
    (( sg != 2 )) || could_not "the internal registry did not answer about the signature of $name:$tag"
    if (( sg == 1 )); then
        log_error "$name:$tag is in the registry and carries NO signature object: a pod using it is rejected at admission. Re-run: ${AEGIS_CMD:-aegis} image request $name:$tag"
        return 1
    fi
    from_line "$name:$tag" "$d"
}

# ═══════════════════════════════════════════════════════════════════
#  check
# ═══════════════════════════════════════════════════════════════════
# Written to be CALLED by the round (`aegis check`) as much as typed:
# one line per thing that is wrong, each one carrying the command that
# fixes it, and a verdict in the exit code.
do_check() {
    need_list
    secrets_workdir
    reg_ready
    local n=0 bad=0 unread=0
    while read -r src dst; do
        [[ -n "$dst" ]] || continue
        n=$((n+1))
        local name="${dst%%:*}" tag="${dst#*:}" srcref="${src%@*}" d rc=0 sg=0
        d="$(reg_digest "$name" "$tag")" || rc=$?
        # An unreachable registry used to come out of here as «declared
        # and NOT mirrored», once per entry, each line offering to fire a
        # mirror build. This check is CALLED by the round, so that was a
        # red verdict for the whole platform written off one unanswered
        # socket.
        if (( rc == 2 )); then
            unread=$((unread+1))
            log_warn "$dst: the internal registry did not answer — this is not «not mirrored», it is not measured"
            continue
        fi
        if (( rc == 1 )); then
            bad=$((bad+1))
            log_error "$dst declared and NOT mirrored — fix: ${AEGIS_CMD:-aegis} image request $srcref"
            continue
        fi
        reg_signed "$name" "$d" || sg=$?
        if (( sg == 2 )); then
            unread=$((unread+1))
            log_warn "$dst: the internal registry did not answer about its signature — not measured"
        elif (( sg == 1 )); then
            bad=$((bad+1))
            log_error "$dst mirrored and NOT signed (Kyverno rejects it at admission) — fix: ${AEGIS_CMD:-aegis} image request $srcref"
        fi
    done < <(entries)
    (( n > 0 )) || could_not "$IMAGES_REL declares no image: there is nothing to contrast against the registry"
    # COULD NOT EVALUATE wins over the partial answer: the question is
    # «is EVERYTHING declared mirrored and signed», and it has no answer
    # while a single entry is unread. What was measured is printed above
    # all the same — a verdict withheld is not evidence withheld.
    (( unread == 0 )) || could_not "$unread of the $n declared images could not be read from the internal registry: the question this command answers is about all of them"
    if (( bad > 0 )); then
        log_error "$bad of $n declared images are not usable in a tenant"
        return 1
    fi
    log_ok "the $n declared images are mirrored and signed"
}

# ═══════════════════════════════════════════════════════════════════
#  gc — what the registry keeps, and what nobody was ever going to use
# ═══════════════════════════════════════════════════════════════════
# MEASURED 2026-09-01. The internal registry stores every image that is
# ever built and nothing prunes it. The GPU engine costs about 5.6 GB
# compressed per build, so two rebuilds occupied 11.2 GB; pruning by
# hand —deleting the manifest through the registry's API and then
# running `registry garbage-collect --delete-untagged` inside the pod—
# brought it back to 3.5 GB. It had to be done three times in one day,
# and one of the images deleted had never even started.
#
# IT COMPOSES WITH THE OTHER CONSUMER OF THAT DISK, and that is what
# makes it expensive. The build of that same engine needs about 42 GiB
# of ephemeral storage on the node (phase 87 measures it before firing)
# and the kubelet starts evicting pods below roughly 11 GiB free. So
# EVERY REBUILD MAKES THE NEXT ONE HARDER — and the symptom never
# mentions a disk: the pod is «Evicted» and the pipeline says ABORTED.
#
# WHAT PROTECTS AN IMAGE FROM THIS COMMAND. Not its tag, and not its
# age on its own. Three facts, each read from where it is true, and any
# one of them is enough:
#   1. THE INSTANCE FIXES IT BY DIGEST. A digest written in a manifest
#      of this instance is in use even if its tag is a year old — that
#      is the whole point of pinning by digest.
#   2. IT IS DECLARED IN images.txt. `aegis image check` promises the
#      registry serves every destination of that list; pruning one
#      would make this file break its own promise.
#   3. THE CLUSTER IS RUNNING IT. The app overlays of the tenants live
#      in the ORGANISATIONS' repositories, not in the platform's, so a
#      pruner that only read the platform tree would cheerfully delete
#      the image of a pod that is serving traffic. The cluster is
#      asked, and if it does not answer this command stops: a prune
#      planned over an unanswered read is a prune planned blind.
# On top of those, the newest --keep images of every repository survive
# on age alone. Everything else is a candidate.
#
# THE SIGNATURES TRAVEL WITH THE MANIFEST, and they have to be deleted
# explicitly. cosign publishes the signature of <digest> as a TAG in
# the same repository, `sha256-<hex>.sig`; from the registry's side
# that is a TAGGED manifest, so `--delete-untagged` marks it live and
# leaves it —and its blobs— exactly where they are. Deleting an image
# without its companion therefore frees less than it looks like and
# leaves behind a signature of nothing. So the companions of a pruned
# digest are pruned in the same pass, derived from the digest itself
# (`sha256-<hex>.*`, which covers .sig and any .att/.sbom that may
# appear), and the ones already orphaned by the hand-pruning of
# 2026-09-01 are picked up by that same rule.

GC_PLAN=""            # the plan, once it exists: the only list a delete may come from
GC_CFG="" GC_ROOT=""  # the config the running registry was told to read, and the storage root it declares

gc_gb() { awk -v b="${1:-0}" 'BEGIN{printf "%.2f GB", b/1000000000}'; }
gc_kb_gb() { awk -v k="${1:-0}" 'BEGIN{printf "%.2f GB", k*1024/1000000000}'; }

# ── the registry as an object on a disk ─────────────────────────────
# WHICH CONFIG, and it is derived rather than typed. `garbage-collect`
# takes a config file and sweeps the storage THAT file declares; a
# second copy of the path written here would be a second thing to keep
# in step with the Deployment, and the day the two diverge this command
# would sweep a directory nobody is serving and report freeing nothing.
# The one the running binary was handed is in its args.
gc_registry_target() {
    GC_CFG="$(kubectl -n registry-system get deploy registry -o json 2>/dev/null \
        | jq -r '.spec.template.spec.containers[]? | select(.name=="registry") | .args[]?' \
        | grep -E '\.ya?ml$' | head -1)"
    [[ -n "$GC_CFG" ]] \
        || could_not "registry-system/deploy/registry names no config file in its args: the collector sweeps the storage its config declares, and guessing that path would sweep something else"
    GC_ROOT="$(kubectl -n registry-system exec deploy/registry -- cat "$GC_CFG" 2>/dev/null \
        | python3 -c 'import sys, yaml; d = yaml.safe_load(sys.stdin) or {}; print(((d.get("storage") or {}).get("filesystem") or {}).get("rootdirectory", ""))' 2>/dev/null || true)"
    [[ -n "$GC_ROOT" ]] \
        || could_not "could not read $GC_CFG from inside the registry pod: without the storage root there is nowhere to measure before and after, and a prune that cannot say what it freed is a prune nobody can audit"
    # THE VERSION MATTERS, in one direction only. distribution 2.x had a
    # collector that did not mark the per-architecture manifests an
    # INDEX references, so `--delete-untagged` could strip the children
    # of a mirrored multi-arch tag and leave the tag pointing at
    # nothing. 3.x marks them. The platform pins 3.1.1 in
    # k8s/base/registry-system/registry.yaml; what is read here is what
    # is actually running, because that is the one doing the sweeping.
    local ver major
    ver="$(kubectl -n registry-system exec deploy/registry -- registry --version 2>/dev/null | tr -d '\r' || true)"
    major="$(grep -oE 'v?[0-9]+\.[0-9]+\.[0-9]+' <<< "${ver:-}" | tail -1 | tr -d v | cut -d. -f1 || true)"
    if [[ -n "$major" ]] && (( major < 3 )); then
        die "the registry running here is «$ver», and on 2.x --delete-untagged does not mark the manifests an index references: sweeping would break every mirrored multi-architecture tag. Nothing was deleted"
    fi
    [[ -n "$major" ]] \
        || log_warn "the registry did not say its version («${ver:-nothing}»): the collector is being assumed to be the 3.x one the platform pins, which is the one that marks the children of an index"
    log_info "registry storage $GC_ROOT, config $GC_CFG${ver:+, $ver}"
}

# gc_disk_kb — the storage as the filesystem sees it, which is the only
# number that answers «how much did this free». The registry's API can
# add up the blobs it knows about; it cannot see what the collector
# actually removed.
gc_disk_kb() {
    kubectl -n registry-system exec deploy/registry -- du -sk "$GC_ROOT" 2>/dev/null \
        | awk 'NR==1 && $1 ~ /^[0-9]+$/ {print $1}'
}

# ── (1) what may not be touched ─────────────────────────────────────
# The protected set, one row per fact: kind <TAB> repo <TAB> value <TAB>
# where it was read. Nothing in it is a list somebody maintains; all
# three sources are derived, and deliberately so — half the bugs of
# 2026-09-01 were hand-written lists that had quietly stopped being
# true.
gc_pins() {
    local out="$SECRETS_TMP/gc-protected.tsv"
    : > "$out"

    # (1) THE INSTANCE'S OWN MANIFESTS. Every reference to the internal
    # registry that carries a digest, plus the `images:` blocks that
    # kustomize and services.yaml write as a name and a digest on two
    # lines. Comments are stripped first: this tree documents every
    # decision beside the code, so the file that pins a digest is also
    # the file whose prose quotes the digest it used to pin.
    gc_scan_manifests "$PLATFORM_DIR" >> "$out" \
        || die "the scan of $PLATFORM_DIR for pinned digests failed: nothing was planned and nothing was deleted — a prune that cannot read what the instance fixes is a prune that deletes what is running"

    # (2) WHAT images.txt DECLARES. `aegis image check` promises the
    # registry serves every destination of that list; a prune that
    # removed one would break the promise of another subcommand of this
    # same file.
    local src dst
    while read -r src dst; do
        [[ -n "$dst" ]] || continue
        printf 'tag\t%s\t%s\tdeclared in %s\n' "${dst%%:*}" "${dst#*:}" "$IMAGES_REL" >> "$out"
    done < <(entries)

    # (3) WHAT THE CLUSTER IS RUNNING. The tenants' overlays live in the
    # organisations' repositories, which this disk does not have, so
    # source (1) cannot see the image of an app that is serving traffic
    # right now. The workloads are asked directly and every string under
    # them that names an image counts — `image` as desired and `imageID`
    # as resolved, anywhere in the object, which is how a sidecar or an
    # initContainer added tomorrow is covered without anybody editing
    # this.
    local live
    live="$(kubectl get pods,deployments,statefulsets,daemonsets,cronjobs,jobs -A -o json 2>/dev/null \
        | jq -r '[.. | objects | (.image?, .imageID?) | strings] | .[]' 2>/dev/null || true)"
    [[ -n "$live" ]] \
        || could_not "the cluster did not answer what it is running: that is NOT «it is running nothing», and planning a prune over that answer would be planning it blind. Nothing was deleted"
    gc_live_refs <<< "$live" >> "$out" \
        || die "the live images of the cluster could not be read into the protected set: nothing was deleted"

    sort -u -o "$out" "$out"
    log_info "$(wc -l < "$out") protected reference(s): what the instance fixes, what $IMAGES_REL declares, and what the cluster is running"
}

# gc_scan_manifests <dir> — the pins written down in a tree.
# It lives in python for the reason check 166 paid for: a sed that fails
# silently prints nothing, and «nothing is pinned» is the one wrong
# answer this command must never get. A scan that dies exits non-zero
# and takes the command down with it.
gc_scan_manifests() {
    python3 - "$1" "$REGISTRY_HOST_INTERNAL" <<'PY'
import os, re, sys

root, host = sys.argv[1], sys.argv[2]
# `#` opens a comment in YAML at the start of a line or after
# whitespace, which is the shape that leaves `${var#pat}` and a URL's
# `https://` intact.
HASH = re.compile(r'(^|\s)#.*$')
REF = re.compile(re.escape(host) + r"/([A-Za-z0-9._/-]+?)(?::[A-Za-z0-9._-]+)?@(sha256:[0-9a-f]{64})")
# the two-line shape: kustomize writes `name:` + `digest:`, services.yaml
# writes `imagen:` + `digest:`. One fact, two spellings, one rule.
NAME = re.compile(r'^\s*-?\s*(?:name|image|imagen):\s*["\']?([A-Za-z0-9._:/-]+)["\']?\s*$')
DIG = re.compile(r'^\s*digest:\s*["\']?(sha256:[0-9a-f]{64})["\']?\s*$')


def repo_of(value):
    v = value
    if v.startswith(host + "/"):
        v = v[len(host) + 1:]
    v = v.split("@", 1)[0]
    head, _, last = v.rpartition("/")
    if ":" in last:
        last = last.split(":", 1)[0]
    return (head + "/" + last) if head else last


seen, files, skipped = set(), 0, 0
for dirpath, dirnames, filenames in os.walk(root):
    dirnames[:] = [d for d in dirnames if d != ".git"]
    for fn in sorted(filenames):
        path = os.path.join(dirpath, fn)
        try:
            if os.path.getsize(path) > 2 * 1024 * 1024:
                skipped += 1
                continue
            text = open(path, encoding="utf-8").read()
        except (OSError, UnicodeDecodeError):
            skipped += 1
            continue
        files += 1
        rel = os.path.relpath(path, root)
        lines = [HASH.sub(r'\1', l) for l in text.splitlines()]
        for m in REF.finditer("\n".join(lines)):
            seen.add(("digest", repo_of(m.group(1)), m.group(2), "fixed by digest in " + rel))
        pending = None
        for i, line in enumerate(lines):
            m = NAME.match(line)
            if m:
                pending = (repo_of(m.group(1)), i)
                continue
            m = DIG.match(line)
            if m and pending and i - pending[1] <= 12:
                seen.add(("digest", pending[0], m.group(1), "fixed by digest in " + rel))
for row in sorted(seen):
    print("\t".join(row))
print("__SCANNED__ %d files read, %d skipped as unreadable or too large" % (files, skipped), file=sys.stderr)
PY
}

# gc_live_refs — the image strings the cluster handed back, turned into
# protected rows. A reference with a digest protects the digest; one
# with only a tag protects the tag, which is the same protection said
# in the other of the two ways a Pod can name an image.
gc_live_refs() {
    python3 - "$REGISTRY_HOST_INTERNAL" <<'PY'
import re, sys

host = sys.argv[1]
REF = re.compile(re.escape(host) + r"/([A-Za-z0-9._/-]+?)(?::[A-Za-z0-9._-]+)?@(sha256:[0-9a-f]{64})$")
TAG = re.compile(re.escape(host) + r"/([A-Za-z0-9._/-]+?):([A-Za-z0-9._-]+)$")
n = 0
for line in sys.stdin:
    s = line.strip()
    # the kubelet reports what it resolved with this prefix on it
    if s.startswith("docker-pullable://"):
        s = s[len("docker-pullable://"):]
    m = REF.match(s)
    if m:
        print("digest\t%s\t%s\trunning in the cluster" % m.groups())
        n += 1
        continue
    m = TAG.match(s)
    if m:
        print("tag\t%s\t%s\trunning in the cluster" % m.groups())
        n += 1
print("__LIVE__ %d reference(s) of the internal registry are in use" % n, file=sys.stderr)
PY
}

# ── (2) the registry as it is ───────────────────────────────────────
# reg_body <path under /v2/> — the body of a GET, with the three
# verdicts kept apart the way reg_head keeps them: 0 it served it, 1 it
# answered that it does not have it, 2 it did not answer. No `curl -f`,
# for the reason written above reg_head.
reg_body() {
    local code
    code="$(retry_net 3 curl -sS --max-time 60 \
        --netrc-file "$SECRETS_TMP/registry.netrc" --cacert "$SECRETS_TMP/aegis-ca.crt" \
        -o "$SECRETS_TMP/reg.body" -D "$SECRETS_TMP/reg.hdr" -w '%{http_code}' \
        -H "Accept: $OCI_ACCEPT" \
        "https://$REGISTRY_CLUSTER_IP:5000/v2/$1")" || return 2
    case "$code" in
        200) cat "$SECRETS_TMP/reg.body"; return 0 ;;
        404) return 1 ;;
        *)   log_warn "the internal registry answered HTTP $code for /v2/$1"; return 2 ;;
    esac
}

# gc_meta <repo> <digest> — «when was this image made» and «what does it
# cost», printed as created<TAB>bytes. Both come out of the image's own
# manifest and config, because the tag says nothing about either: the
# tags in this registry are `main-000012`, `vllm0.11.2-9f3a1c` and
# `2.1-260827`, three schemes no sort orders together. The date the
# image carries orders all of them.
gc_meta() {
    local repo="$1" dig="$2" body mt sub cfg created bytes
    body="$(reg_body "$repo/manifests/$dig")" || return 2
    mt="$(jq -r '.mediaType // empty' <<< "$body" 2>/dev/null || true)"
    # A multi-architecture index has no config of its own: the date and
    # the size live in the manifests it points at. The first of them
    # answers both questions to within minutes and megabytes of its
    # siblings, and this is a retention decision, not an audit.
    if [[ "$mt" == *".index."* || "$mt" == *".list."* ]]; then
        sub="$(jq -r '.manifests[0].digest // empty' <<< "$body" 2>/dev/null || true)"
        [[ -n "$sub" ]] || return 2
        body="$(reg_body "$repo/manifests/$sub")" || return 2
    fi
    cfg="$(jq -r '.config.digest // empty' <<< "$body" 2>/dev/null || true)"
    bytes="$(jq '[(.config.size // 0)] + [((.layers // [])[].size)] | add' <<< "$body" 2>/dev/null || true)"
    [[ -n "$cfg" ]] || return 2
    created="$(reg_body "$repo/blobs/$cfg" | jq -r '.created // empty' 2>/dev/null || true)"
    printf '%s\t%s' "${created:-}" "${bytes:-0}"
}

# gc_inventory — one row per (repo, tag) the registry SERVES:
# repo <TAB> tag <TAB> digest <TAB> created <TAB> bytes. Everything in
# it is read. A repository or a tag whose read fails takes the command
# down, because a plan built on a partial inventory prunes what it saw
# and calls the rest orphaned.
gc_inventory() {
    local out="$SECRETS_TMP/gc-inventory.tsv"
    : > "$out"
    local catalog repos repo tags_json tag digest created bytes meta rc n=0
    catalog="$(reg_body '_catalog?n=1000')" \
        || could_not "the internal registry did not answer its catalogue: this is NOT «the registry is empty», and a plan over an empty answer deletes nothing while the disk keeps filling"
    # distribution answers a truncated catalogue with a Link header. A
    # plan over half a registry is a plan that calls the other half
    # gone, so half an answer is no answer.
    if grep -qi '^link:' "$SECRETS_TMP/reg.hdr" 2>/dev/null; then
        could_not "the registry's catalogue came back paginated (a Link header): this command reads it in one page, so it would be planning over part of the registry"
    fi
    repos="$(jq -r '.repositories[]?' <<< "$catalog" | sort)"
    if [[ -n "$ONLY_REPO" ]]; then
        repos="$(grep -Fx -- "$ONLY_REPO" <<< "$repos" || true)"
        [[ -n "$repos" ]] || die "the internal registry holds no repository called «$ONLY_REPO»"
    fi
    while IFS= read -r repo; do
        [[ -n "$repo" ]] || continue
        tags_json="$(reg_body "$repo/tags/list")" \
            || could_not "$repo: the registry did not answer its tag list — a repository whose tags could not be read cannot be planned, and planning it as empty would make every signature in it look orphaned"
        while IFS= read -r tag; do
            [[ -n "$tag" ]] || continue
            rc=0; digest="$(reg_digest "$repo" "$tag")" || rc=$?
            (( rc != 2 )) \
                || could_not "$repo:$tag: the registry did not answer about its manifest, so this repository cannot be planned"
            (( rc == 0 )) || { log_warn "$repo:$tag went away between the tag list and the manifest read — left out of the plan"; continue; }
            created="" ; bytes=0
            if meta="$(gc_meta "$repo" "$digest")"; then
                created="${meta%%$'\t'*}" ; bytes="${meta##*$'\t'}"
            else
                log_warn "$repo:$tag: the registry did not say when this image was made — it goes into the plan UNDATED, which is read as «not a candidate»"
            fi
            printf '%s\t%s\t%s\t%s\t%s\n' "$repo" "$tag" "$digest" "$created" "${bytes:-0}" >> "$out"
            n=$((n + 1))
        done < <(jq -r '.tags[]?' <<< "$tags_json" | sort)
    done <<< "$repos"
    log_info "$n tag(s) read from the registry, across $(awk -F'\t' '{print $1}' "$out" | sort -u | grep -c . || true) repository/ies"
}

# ── (3) the plan ────────────────────────────────────────────────────
# The ONE place that decides, and it subtracts the protected set from
# the inventory before anything else. It is python and in one piece for
# the reason this tree keeps paying for: a scanner that dies must take
# the command with it, and an awk pipeline that prints nothing looks
# exactly like a registry with nothing to prune.
gc_plan() {
    GC_PLAN="$SECRETS_TMP/gc-plan.tsv"
    python3 - "$SECRETS_TMP/gc-inventory.tsv" "$SECRETS_TMP/gc-protected.tsv" "$KEEP" "$GC_PLAN" <<'PY'
import collections, re, sys

inv_p, prot_p, keep_s, out_p = sys.argv[1:5]
keep = int(keep_s)

# cosign publishes the signature of <digest> as the tag
# `sha256-<hex>.sig` in the same repository. .att and .sbom follow the
# same layout, so the rule is derived from the shape and not from a
# list of three suffixes that would be two suffixes next year.
COMPANION = re.compile(r'^sha256-([0-9a-f]{64})\.[A-Za-z0-9]+$')

prot_digest, prot_tag, why = set(), set(), {}
with open(prot_p, encoding="utf-8") as fh:
    for line in fh:
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 4:
            continue
        kind, repo, value, where = parts[:4]
        if kind == "digest":
            prot_digest.add((repo, value))
            why.setdefault(("digest", repo, value), where)
        elif kind == "tag":
            prot_tag.add((repo, value))
            why.setdefault(("tag", repo, value), where)

repos = collections.defaultdict(lambda: {"img": {}, "comp": collections.defaultdict(list)})
with open(inv_p, encoding="utf-8") as fh:
    for line in fh:
        parts = line.rstrip("\n").split("\t")
        if len(parts) != 5:
            continue
        repo, tag, digest, created, size = parts
        m = COMPANION.match(tag)
        if m:
            repos[repo]["comp"]["sha256:" + m.group(1)].append((tag, digest, int(size or 0)))
        else:
            e = repos[repo]["img"].setdefault(digest, {"tags": [], "created": "", "bytes": int(size or 0)})
            e["tags"].append(tag)
            if created and not e["created"]:
                e["created"] = created

rows, kept, pruned, freeable = [], 0, 0, 0
for repo in sorted(repos):
    imgs = repos[repo]["img"]
    # The newest --keep, by the date the image itself carries. One the
    # registry could not date has no place in that order and is not a
    # candidate at all: «I do not know how old this is» is not a reason
    # to delete something.
    dated = sorted((d for d in imgs if imgs[d]["created"]),
                   key=lambda d: imgs[d]["created"], reverse=True)
    recent = set(dated[:keep])
    verdicts = {}
    for digest, e in sorted(imgs.items(), key=lambda kv: kv[1]["created"], reverse=True):
        reason = None
        if (repo, digest) in prot_digest:
            reason = why[("digest", repo, digest)]
        else:
            held = [t for t in e["tags"] if (repo, t) in prot_tag]
            if held:
                reason = "%s: %s" % (held[0], why[("tag", repo, held[0])])
            elif not e["created"]:
                reason = "undated: the registry did not say when it was made"
            elif digest in recent:
                reason = "one of the newest %d of this repository" % keep
        verdicts[digest] = "KEEP" if reason else "PRUNE"
        rows.append((verdicts[digest], repo, digest, e["bytes"], e["created"] or "-",
                     ",".join(sorted(e["tags"])),
                     reason or "nothing fixes it, nothing runs it, and %d newer images exist here" % keep))
    for parent, companions in sorted(repos[repo]["comp"].items()):
        for tag, digest, size in companions:
            if parent not in imgs:
                verdict, reason = "PRUNE", "orphan: the manifest it signs is no longer in this repository"
            elif verdicts.get(parent) == "KEEP":
                verdict, reason = "KEEP", "it signs a manifest that stays"
            else:
                # --delete-untagged will NOT collect this one: it is a
                # TAG, so the collector marks it live and keeps its
                # blobs. It has to be deleted here or not at all.
                verdict, reason = "PRUNE", "it signs a manifest being pruned"
            rows.append((verdict, repo, digest, size, "-", tag, reason))

with open(out_p, "w", encoding="utf-8") as out:
    for r in rows:
        out.write("\t".join(str(x) for x in r) + "\n")
        if r[0] == "PRUNE":
            pruned += 1
            freeable += int(r[3])
        else:
            kept += 1
print("__PLAN__\t%d keep\t%d prune\t%d bytes" % (kept, pruned, freeable), file=sys.stderr)
PY
}

# ── (4) acting ──────────────────────────────────────────────────────
# gc_planned_prune <repo> <digest> — 0 only when THE PLAN says so.
gc_planned_prune() {
    [[ -s "${GC_PLAN:-}" ]] || return 1
    awk -F'\t' -v r="$1" -v d="$2" '$1=="PRUNE" && $2==r && $3==d {found=1} END{exit !found}' "$GC_PLAN"
}

# reg_delete_manifest — THE ONLY PLACE IN THIS FILE THAT DELETES, and
# both refusals live HERE and not at the call site. A guard written at
# the call site has to be written again by whoever adds the next one,
# and the one who forgets is the one nobody notices: that is the class
# this arrangement closes, not the case.
reg_delete_manifest() {   # <repo> <digest>
    local repo="$1" dig="$2" code
    (( GC_ACT == 1 )) \
        || { log_error "refusing to delete $repo@$dig: nobody asked this run to act — it is a dry run"; return 1; }
    gc_planned_prune "$repo" "$dig" \
        || { log_error "refusing to delete $repo@$dig: the plan does not list it as a candidate. What the instance fixes by digest, what $IMAGES_REL declares, what the cluster is running and the newest images of each repository are KEEP rows, and a KEEP row is not deletable from here"; return 1; }
    code="$(retry_net 3 curl -sS --max-time 60 \
        --netrc-file "$SECRETS_TMP/registry.netrc" --cacert "$SECRETS_TMP/aegis-ca.crt" \
        -o /dev/null -w '%{http_code}' -X DELETE \
        "https://$REGISTRY_CLUSTER_IP:5000/v2/$repo/manifests/$dig")" \
        || { log_warn "$repo@$dig: the registry did not answer the delete"; return 2; }
    case "$code" in
        202|200) return 0 ;;
        404)     log_warn "$repo@$dig was already gone"; return 0 ;;
        405)     log_error "the registry refuses DELETE (405): its config carries no storage.delete.enabled, so nothing can be pruned until that is on"; return 2 ;;
        *)       log_error "the registry answered HTTP $code deleting $repo@$dig"; return 2 ;;
    esac
}

# gc_collect — the half that was missing the three times this was done
# by hand. Deleting a manifest through the API only unlinks it; the
# layers stay on the disk until the collector sweeps them.
gc_collect() {
    log_info "registry garbage-collect --delete-untagged over $GC_CFG: this is the step that actually frees the blobs"
    kubectl -n registry-system exec deploy/registry -- \
        registry garbage-collect --delete-untagged "$GC_CFG" >&2
}

# gc_no_build_in_flight — the collector walks the blob store while the
# registry keeps serving it, and distribution says so itself: a blob
# uploaded during the sweep can be freed before the manifest that
# references it is written. Jenkins' own convention names the condition
# —a job that is building carries an `_anime` colour— so the question
# is derived instead of guessed.
gc_no_build_in_flight() {
    local api building
    # The read and the parse are two steps, and the reason is the shape
    # this tree keeps meeting: `curl | jq` exits with jq's code, and jq
    # over an empty stdin prints nothing and exits 0. A Jenkins that
    # never answered would come out of one pipeline as «nothing is
    # building», which is the one answer that must never be guessed.
    api="$(jenkins_get '/api/json?tree=jobs[name,color,jobs[name,color]]' 2>/dev/null)" \
        || could_not "Jenkins did not answer what is building: sweeping while a push is in flight can free the blobs that push just uploaded, so this is not a question to skip"
    [[ -n "$api" ]] \
        || could_not "Jenkins answered nothing when asked what is building: an empty answer is not «nothing is building»"
    building="$(jq -r '[.. | objects | select(has("color") and has("name")) | select(.color | type=="string" and endswith("_anime")) | .name] | join(", ")' <<< "$api")" \
        || could_not "Jenkins' answer about what is building could not be read as JSON: nothing can be concluded from it"
    [[ -z "$building" ]] \
        || die "these jobs are building right now: $building. The collector sweeps the blob store while the registry keeps serving it, and a blob uploaded during the sweep can be freed before the manifest that references it is written. Wait for them and run this again — nothing was deleted"
}

do_gc() {
    need_list
    # There is no answer to this question without the instance: what may
    # be pruned is decided by what THIS instance fixes, and the seed's
    # copy of the list fixes sixty-four zeros. The dry run of `request`
    # may fall back to it; this one may not.
    [[ "$LIST_ROOT" == "$PLATFORM_DIR" ]] \
        || could_not "there is no instance at $PLATFORM_DIR: what may be pruned is decided by what this instance fixes, and the seed's copy of the list fixes nothing real"
    secrets_workdir
    reg_ready
    gc_registry_target

    gc_pins
    gc_inventory
    gc_plan || die "the plan could not be computed: nothing was deleted"

    printf '%-8s %-26s %-14s %-10s %-20s %s\n' VERDICT REPOSITORY DIGEST SIZE CREATED 'TAGS — WHY'
    local verdict repo digest bytes created tags reason
    while IFS=$'\t' read -r verdict repo digest bytes created tags reason; do
        [[ -n "$verdict" ]] || continue
        printf '%-8s %-26s %-14s %-10s %-20s %s\n' \
            "$verdict" "$repo" "${digest:7:12}" "$(gc_gb "$bytes")" "${created:0:19}" "$tags — $reason"
    done < "$GC_PLAN"

    local n_keep n_prune freeable
    n_keep="$(awk -F'\t' '$1=="KEEP"{n++} END{print n+0}' "$GC_PLAN")"
    n_prune="$(awk -F'\t' '$1=="PRUNE"{n++} END{print n+0}' "$GC_PLAN")"
    freeable="$(awk -F'\t' '$1=="PRUNE"{s+=$4} END{print s+0}' "$GC_PLAN")"
    log_info "$n_keep manifest(s) stay, $n_prune are candidates, about $(gc_gb "$freeable") of image bytes behind them"

    if (( GC_ACT == 0 )); then
        log_warn "DRY RUN — nothing was deleted and nothing was collected. Deleting images is not an operation that happens on its own: --yes does it, --keep <N> changes how many stay on age alone"
        return 0
    fi
    (( n_prune > 0 )) \
        || { log_ok "there is nothing to prune: every manifest in the registry is fixed, declared, running, or among the newest $KEEP of its repository"; return 0; }

    jenkins_ready
    gc_no_build_in_flight

    local before after freed=0 deleted=0 failed=0
    before="$(gc_disk_kb)"
    [[ -n "$before" ]] \
        || could_not "could not measure $GC_ROOT before deleting: a prune that cannot say what it freed is one nobody can audit, and that measurement is half of what this verb exists to produce"
    log_info "before: $(gc_kb_gb "$before") in $GC_ROOT"

    while IFS=$'\t' read -r verdict repo digest bytes created tags reason; do
        [[ "$verdict" == PRUNE ]] || continue
        if reg_delete_manifest "$repo" "$digest"; then
            deleted=$((deleted + 1))
            log_info "deleted $repo@${digest:7:12} ($tags — $reason)"
        else
            failed=$((failed + 1))
        fi
    done < "$GC_PLAN"

    gc_collect \
        || die "$deleted manifest(s) were deleted and the collector did not finish: the blobs behind them are still on the disk. Read the registry pod's log and run this again — re-running is safe, a deletion already made answers 404 and is counted as done"

    after="$(gc_disk_kb)"
    [[ -n "$after" ]] \
        || could_not "$deleted manifest(s) deleted and collected, and $GC_ROOT could not be measured afterwards: the work was done and the number cannot be given"
    freed=$(( before - after ))
    (( freed >= 0 )) || freed=0
    log_ok "$deleted manifest(s) deleted · $GC_ROOT went $(gc_kb_gb "$before") → $(gc_kb_gb "$after") · freed $(gc_kb_gb "$freed")"
    (( failed == 0 )) \
        || die "$failed of the $n_prune candidates could not be deleted (the reasons are above); what was deleted has been collected"
}

case "$VERB" in
    request) do_request ;;
    list)    do_list ;;
    from)    do_from ;;
    check)   do_check ;;
    gc)      do_gc ;;
esac
