#!/usr/bin/env python3
"""aegis-borde — ¿los hostnames que los contratos declaran EXISTEN?

POR QUÉ EXISTE. El modo de fallo del borde es el peor que hay: si un
hostname no se aplicó, simplemente NO EXISTE. Sin error, sin alarma,
sin nada rojo — el IngressRoute del cluster está perfecto, el
certificado está emitido, y nadie llega. Pasó con ai.__ROOT_DOMAIN__
(#35) y casi pasa con blog el 2026-08-03.

POR QUÉ NO USA EL STATE DE TOFU. Dos razones, y la segunda es la que
importa:

  1. El state necesita la age key para descifrarse (#46), y la age key
     no entra a CI. Este chequeo tiene que poder correr ahí.

  2. Más de fondo: el state dice lo que tofu CREE que existe. Este
     chequeo pregunta lo que existe DE VERDAD. Si los dos coincidieran
     siempre no haría falta ninguno de los dos; la única razón de
     mirar es que pueden diferir. Un detector de deriva que lee el
     mismo archivo que el aplicador no detecta nada.

LO QUE ESTE CHEQUEO NO CUBRE, dicho de frente: mira los CNAME de la
zona, que es exactamente el fallo de #35. NO mira las reglas de
ingress del túnel — un CNAME que existe con un túnel que no lo enruta
da 404, y eso este script no lo ve. Para mirarlo haría falta el
tunnel_id, que vive en el state. Está anotado como límite y no como
"ya está cubierto", porque un chequeo que promete de más es peor que
no tenerlo.

Uso:
    bin/aegis-borde                 # compara y reporta
    TF_VAR_cloudflare_api_token=... bin/aegis-borde    # modo CI

Salida: 0 todo declarado existe · 1 falta alguno · 2 no se pudo evaluar
"""
import importlib.machinery
import importlib.util
import json
import os
import subprocess
import sys
import urllib.error
import urllib.request

RAIZ = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOKENS = os.path.join(RAIZ, "tofu", "secrets", "tokens.enc.yaml")
CONF = os.environ.get(
    "AEGIS_INIT_CONF", os.path.join(RAIZ, "..", "init", "aegis-init.conf"))

rojo = "\033[31m"; verde = "\033[32m"; ama = "\033[33m"; gris = "\033[90m"; fin = "\033[0m"
if not sys.stdout.isatty():
    rojo = verde = ama = gris = fin = ""


def generador():
    """bin/aegis-org como módulo — la lista de hostnames sale de AHÍ.

    Reimplementar la derivación acá sería tener dos fuentes para la
    misma lista, que es la duplicación que #45 vino a eliminar. Si las
    dos se separan, el chequeo compara contra algo que nadie despliega
    y pasa siempre.
    """
    p = os.path.join(RAIZ, "bin", "aegis-org")
    spec = importlib.util.spec_from_loader(
        "aegis_org", importlib.machinery.SourceFileLoader("aegis_org", p))
    m = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(m)
    return m


def de_conf(clave):
    """Lee una clave del aegis-init.conf sin sourcearlo."""
    try:
        with open(CONF, encoding="utf-8") as f:
            for linea in f:
                linea = linea.strip()
                if linea.startswith(clave + "="):
                    return linea.split("=", 1)[1].strip().strip('"').strip("'")
    except FileNotFoundError:
        pass
    return None


def credenciales():
    """(token, zone_id). El entorno tiene PRECEDENCIA — misma regla que
    tofu-apply.sh, y por el mismo motivo: así CI corre sin la age key."""
    token = (os.environ.get("TF_VAR_cloudflare_api_token")
             or os.environ.get("CF_API_TOKEN"))
    zona = (os.environ.get("TF_VAR_cloudflare_zone_id")
            or os.environ.get("CF_ZONE_ID") or de_conf("CF_ZONE_ID"))

    if not token:
        if not os.environ.get("SOPS_AGE_KEY_FILE"):
            return None, zona
        try:
            # El token NO pasa por argv: sops escribe a stdout y se lee
            # acá adentro.
            crudo = subprocess.run(["sops", "-d", TOKENS], check=True,
                                   capture_output=True, text=True).stdout
        except (subprocess.CalledProcessError, FileNotFoundError):
            return None, zona
        import yaml
        doc = yaml.safe_load(crudo) or {}
        v = (doc.get("cloudflare") or {}).get("api_token")
        token = v.get("value") if isinstance(v, dict) else v
    return token, zona


def cnames_vivos(token, zona):
    """Los CNAME que Cloudflare dice que existen, paginando de verdad.

    Sin paginar, una zona con más de 100 registros reportaría faltantes
    que sí existen — un falso positivo que enseña a ignorar el chequeo.
    """
    vivos = set()
    pagina = 1
    while True:
        url = (f"https://api.cloudflare.com/client/v4/zones/{zona}/dns_records"
               f"?type=CNAME&per_page=100&page={pagina}")
        req = urllib.request.Request(url, headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=20) as r:
            cuerpo = json.load(r)
        if not cuerpo.get("success"):
            raise RuntimeError(f"la API de Cloudflare respondió errores: "
                               f"{cuerpo.get('errors')}")
        for reg in cuerpo.get("result") or []:
            vivos.add(reg["name"])
        info = cuerpo.get("result_info") or {}
        if pagina >= (info.get("total_pages") or 1):
            return vivos
        pagina += 1


def main():
    g = generador()
    import yaml
    edge = yaml.safe_load(open(os.path.join(RAIZ, "edge.yaml"), encoding="utf-8"))
    dominio_raiz = edge["dominio_raiz"]
    esperados = {f"{e}.{dominio_raiz}" for e in g.etiquetas_del_borde()}

    token, zona = credenciales()
    # NO se cae en silencio ni se da por bueno. "No se pudo evaluar" es
    # un resultado distinto de "pasó", y confundirlos es la Enfermedad E
    # (docs/failure-modes.md).
    if not token or not zona:
        falta = "token de Cloudflare" if not token else "CF_ZONE_ID"
        print(f"  {ama}!{fin} borde NO EVALUADO — falta {falta}")
        print(f"    {gris}Exportá TF_VAR_cloudflare_api_token, o SOPS_AGE_KEY_FILE\n"
              f"    para que se descifre de tofu/secrets/tokens.enc.yaml.\n"
              f"    Esto NO es un visto bueno: es un chequeo que no corrió.{fin}")
        return 2

    try:
        vivos = cnames_vivos(token, zona)
    except (urllib.error.URLError, RuntimeError, KeyError) as e:
        print(f"  {ama}!{fin} borde NO EVALUADO — la API de Cloudflare no respondió")
        print(f"    {gris}{e}{fin}")
        return 2

    faltan = sorted(esperados - vivos)
    # Solo los CNAME del dominio raíz: la zona puede tener registros de
    # otras cosas del operador que aegis no gestiona ni debe reclamar.
    nuestros = {v for v in vivos if v.endswith("." + dominio_raiz)}
    sobran = sorted(nuestros - esperados)

    if faltan:
        print(f"  {rojo}✗{fin} {len(faltan)} hostname(s) declarado(s) que NO EXISTEN:")
        for h in faltan:
            print(f"      {h}")
        print(f"    {gris}Nadie llega a esos sitios y nada más lo va a avisar.\n"
              f"    Aplicá el borde:  cd platform/tofu && \\\n"
              f"      SOPS_AGE_KEY_FILE=~/.config/sops/age/aegis.key \\\n"
              f"      ./tofu-apply.sh -chdir=envs/cloudflare-tunnel apply{fin}")
    else:
        print(f"  {verde}✓{fin} los {len(esperados)} hostnames de los contratos existen en Cloudflare")

    if sobran:
        print(f"  {ama}!{fin} {len(sobran)} CNAME(s) que ningún contrato pide:")
        for h in sobran:
            print(f"      {h}")
        print(f"    {gris}Sobra en el borde lo que ya no está en git. Borrarlos es\n"
              f"    un apply CON destroy, así que va a mano y con el plan leído.{fin}")

    return 1 if faltan else 0


if __name__ == "__main__":
    sys.exit(main())
