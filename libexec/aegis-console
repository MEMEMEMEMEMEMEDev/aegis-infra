#!/usr/bin/env python3
# aegis-summary: The visual console: capture the states of the world it has to draw
# aegis-group:   operate
# aegis-subcommands: capture list serve
# aegis-help:
# Usage: aegis console capture <name> --what "<one sentence>" --run "<command>" [--run ...]
#        aegis console list
#        aegis console serve [--port N]
#
# capture  runs each <command> with --json, ANONYMISES the documents and
#          writes them to console/cases/<name>/ together with a case.yaml
#          declaring where they came from and what shape they had.
# list     the corpus: name, provenance and what state of the world it is
# serve    reads the instance and draws it, on 127.0.0.1 and nowhere else
#
"""aegis-console — the states of the world the console has to draw.

WHY A CORPUS AND NOT SCREENSHOTS. The console's input is not the
cluster: it is the JSON documents the CLI emits. So a «state of the
world» is a set of documents, and that is something that can be stored,
versioned and replayed. What it buys is the one thing no dashboard can
prove about itself: that «I could not look» never gets flattened into
«it is fine» on the way to the screen.

WHY NOTHING IS INVENTED. On 2026-09-10 a whole session was measured
with an impeccable method against a tree that was 172 commits old:
every measurement was true of the artifact in front of it, and the
artifact was not the product. A corpus written by hand would be that
same failure, frozen. So every case declares its PROVENANCE:

    medido      captured here, from the live instance
    derivado    a RECORDED mutation of a measured case, replayable
    sintetico   written by hand, only where the real state cannot be
                reached, and it says why

WHY THE VALUES MAY AGE AND THE SHAPE MAY NOT. This repo does not
version fixtures, on purpose: a sample file ages in silence because
nothing re-derives it. The way out is the one `images.txt` already
uses — it freezes a digest and `image-watch` asks every morning whether
the tag moved. Here the case freezes the VALUES and a check re-derives
the SHAPE against the real command. A case says «this is how the world
looked that day», which stays true forever; what cannot age quietly is
the contract, and that is exactly what gets asked again.
"""
import datetime
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.parse

# ── canonical python preamble (V-102) ────────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))
from aegis import cli, paths              # noqa: E402

import yaml                               # noqa: E402

CASES = os.path.join(_AEGIS_ROOT, "console", "cases")
CONF_EXAMPLE = os.path.join(_AEGIS_ROOT, "init", "aegis-init.conf.example")


# ── the anonymiser ───────────────────────────────────────────────────
#
# WHY THE RULE IS BLUNT, ON PURPOSE.
#
# Two cleverer versions were written first and both failed, in opposite
# directions, and the second one is the reason this is blunt now:
#
#   «not identifying if the value appears in the product's source» —
#   let the GitHub OWNER through, because the README legitimately
#   prints the repository's own URL. It failed towards the leak.
#
#   «not identifying if the value appears in aegis-init.conf.example» —
#   flagged AI_GATEWAY_REPO=ai-gateway, a name the product uses
#   everywhere, because the example carries it empty. It failed towards
#   noise.
#
# So there is no cleverness left: EVERY value of the live conf that
# differs from the example is scrubbed. The cost was measured before
# choosing — of the nine values that differ on this instance, exactly
# one appears in the corpus at all. The hazard is that a common word
# (`default` is a Kubernetes namespace) would mangle a document one
# day; that fails towards an unreadable case, which is visible. The
# clever versions failed towards a domain in a public git history,
# which is not.

# THE SUBSTITUTIONS ARE DERIVED FROM THIS MACHINE, never written down
# here. A list of secrets to scrub is a list that goes stale the day
# somebody adds a key, and the miss is invisible: the case looks fine
# and carries the operator's domain into a public repo.
#
# The same shape as check 086, and for the same reason: only the values
# that DIFFER from aegis-init.conf.example identify anybody. A value
# equal to the default identifies nobody, and scrubbing it would only
# make the case unreadable.
def _too_short_to_mask(value):
    """A value of three characters or less cannot be scrubbed without
    mangling unrelated text, and cannot identify anybody either."""
    return len(value) < 4


def _substitutions():
    # WHERE THE INSTANCE IS belongs to lib/aegis/paths.py and to nobody
    # else (C1/C2, and check 102 rule 4 for the bash side).
    conf = paths.aegis_home() / "aegis.conf"
    generic = {
        "GH_OWNER": "owner", "ROOT_DOMAIN": "example.test",
        "ACME_EMAIL": "operator@example.test",
        "CF_ACCOUNT_ID": "0" * 32, "CF_ZONE_ID": "0" * 32,
        "REGISTRY_CLUSTER_IP": "10.43.0.1", "AI_GATEWAY_REPO": "ai-gateway",
    }
    def read(path):
        out = {}
        try:
            for line in open(path, encoding="utf-8"):
                m = re.match(r'^\s*([A-Z_]+)=(.*)$', line)
                if m:
                    out[m.group(1)] = m.group(2).strip().strip('"').strip("'")
        except FileNotFoundError:
            pass
        return out
    live, example = read(conf), read(CONF_EXAMPLE)
    subs = []
    for key, value in live.items():
        if not value or value == example.get(key):
            continue
        # AND IT HAS TO IDENTIFY SOMEBODY. «Differs from the example» is
        # check 086's rule and it is right for what 086 asks — is THIS
        # instance's value baked into the seed — but it is too blunt
        # here: `AI=gpu` and `KUBE_CONTEXT_EXPECTED=default` differ from
        # the example and identify nobody. Masking them would mangle
        # every document that says «gpu» for an unrelated reason, and a
        # corpus nobody can read stops being checked.
        #
        if _too_short_to_mask(value):
            continue
        replacement = generic.get(key)
        if replacement is None or replacement == value:
            # A key nobody taught this function about — or one whose
            # generic form happens to equal the live value, which would
            # be a substitution that scrubs nothing. Neither is skipped
            # quietly: an unknown identifying value is what this
            # function exists to stop.
            replacement = f"__{key.lower()}__"
            print(f"  {key}: masked as {replacement} (no generic form declared for it)",
                  file=sys.stderr)
        subs.append((value, replacement))
    # $HOME last and always: paths travel inside messages.
    subs.append((os.path.expanduser("~"), "/home/operator"))
    # Longest first, so that a value containing another is not left
    # half-scrubbed (ROOT_DOMAIN inside an email, for instance).
    return sorted(subs, key=lambda p: -len(p[0]))


def repos_nobody_deploys(runs):
    """The repositories of this account that NO contract declares, as
    substitutions.

    THE SECOND KIND OF IDENTITY, and it was found the first time
    `repos list` was captured. The blunt rule above masks what differs
    from the example `aegis.conf`, and a repository name is in no
    `aegis.conf`: forty-three of them went into a case in one go —
    `merpy-android`, `mineserver`, an old university assignment — and
    the corpus is published.

    What a contract DECLARES is another matter: those names are already
    part of what this platform runs and what its own documents describe.
    What nobody deploys is somebody's private work that happens to live
    in the same account, and it has no business in a case at all.

    They are replaced by position rather than dropped, so that the shape
    a case exists to hold —how many there are, what they are written in,
    how many nothing is running— survives intact.
    """
    if not any(line.split()[:1] == ["repos"] for line in runs if line.split()):
        return []
    try:
        _rc, doc = cli.run_json("repos", "list")
    except cli.CouldNotEvaluate:
        # Nobody could ask. There is then nothing to mask, and the
        # capture of that source will record the blindness itself.
        return []
    free = [s["step"].split(":", 1)[1] for s in doc.get("steps") or []
            if s.get("step", "").startswith("repo:") and not s.get("sirve")]
    # Longest first for the same reason the conf values are: one name
    # containing another must not be left half-scrubbed.
    return [(n, f"repo-{i:02d}") for i, n in
            enumerate(sorted(free, key=len, reverse=True), 1)]


def anonymise(text, subs):
    for value, replacement in subs:
        text = text.replace(value, replacement)
    return text


def still_identifying(text, subs):
    """What survived. Belt and braces: the caller refuses to write a
    case this is not empty for."""
    return [v for v, _ in subs if v and v in text]


# ── the shape pin ────────────────────────────────────────────────────
# What a check re-derives later against the real command. NOT the
# values: the vocabulary. Which keys the document has at its top level,
# and which `state` words appear anywhere inside it.
def shape_of(doc):
    states = set()
    def walk(node):
        if isinstance(node, dict):
            for k, v in node.items():
                if k == "state" and isinstance(v, str):
                    states.add(v)
                walk(v)
        elif isinstance(node, list):
            for v in node:
                walk(v)
    walk(doc)
    return {"claves": sorted(doc) if isinstance(doc, dict) else [],
            "estados": sorted(states)}


def _aegis_commit():
    try:
        return subprocess.run(["git", "-C", _AEGIS_ROOT, "rev-parse", "HEAD"],
                              capture_output=True, text=True, check=True).stdout.strip()
    except Exception:
        return None


def capture(name, what, runs):
    if not re.match(r"^[a-z][a-z0-9-]{2,39}$", name):
        print(f"the case name {name!r} must be [a-z][a-z0-9-]{{2,39}}", file=sys.stderr)
        return 3
    dest = os.path.join(CASES, name)
    docs_dir = os.path.join(dest, "documents")
    subs = _substitutions()
    # The repositories nobody deploys are identity too, and they are
    # not in any aegis.conf. Appended AFTER, so the conf's values still
    # win where a name happens to contain one.
    subs = subs + repos_nobody_deploys(runs)
    produced, shapes = [], {}

    for line in runs:
        parts = line.split()
        if not parts:
            continue
        filename = f"{parts[0]}.json"
        entry = {"comando": " ".join(parts), "documento": filename}
        try:
            rc, doc = cli.run_json(*parts)
            entry["rc"] = rc
        except cli.CouldNotEvaluate as e:
            # THE CASE ZERO IS A CASE. A command that gives back no
            # readable document is a state of the world the console has
            # to draw — and the one almost nobody designs, because the
            # easy answer is a spinner that never stops. It is recorded
            # as what it is: the absence of a document, with the reason.
            entry.pop("documento")
            # THE REASON IS ALSO THE CASE, and it is also text of this
            # machine: this message carries the absolute path of the
            # libexec it looked in. Found the first time this ran — the
            # anonymiser was guarding the documents and nobody was
            # guarding the sentence beside them.
            reason = anonymise(str(e), subs)
            left = still_identifying(reason, subs)
            if left:
                print(f"the reason `{' '.join(parts)}` gave still carries {len(left)} "
                      f"value(s) of this instance: nothing was written", file=sys.stderr)
                return 1
            entry["sin_documento"] = reason
            produced.append(entry)
            print(f"  {parts[0]}: NO DOCUMENT — {reason}")
            continue
        raw = json.dumps(doc, ensure_ascii=False, indent=2) + "\n"
        text = anonymise(raw, subs)
        # WHAT WAS MASKED, SAID OUT LOUD. The rule is blunt on purpose
        # (see the note above), so the day it mangles a common word the
        # operator finds out here and not by reading a case that makes
        # no sense.
        for value, replacement in subs:
            n = raw.count(value)
            if n:
                print(f"    masked {n}x {replacement}")
        left = still_identifying(text, subs)
        if left:
            print(f"the document of `{' '.join(parts)}` still carries {len(left)} value(s) "
                  f"of this instance after anonymising: nothing was written", file=sys.stderr)
            return 1
        os.makedirs(docs_dir, exist_ok=True)
        open(os.path.join(docs_dir, filename), "w", encoding="utf-8").write(text)
        shapes[filename] = shape_of(json.loads(text))
        produced.append(entry)
        print(f"  {parts[0]}: rc {rc} · {filename}")

    if not produced:
        print("nothing was run: a case with no documents is not a case", file=sys.stderr)
        return 3

    case = {"version": 1, "caso": name, "que": what, "procedencia": "medido",
            "producido_por": produced,
            "medido_en": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "aegis": _aegis_commit(), "forma": shapes}
    os.makedirs(dest, exist_ok=True)
    with open(os.path.join(dest, "case.yaml"), "w", encoding="utf-8") as fh:
        yaml.safe_dump(case, fh, sort_keys=False, allow_unicode=True, width=78)
    print(f"\ncase {name}: {len(produced)} command(s), "
          f"{os.path.relpath(dest, _AEGIS_ROOT)}/")
    return 0


def listing():
    if not os.path.isdir(CASES):
        print(f"there is no corpus yet ({os.path.relpath(CASES, _AEGIS_ROOT)}/)")
        return 0
    rows = 0
    for name in sorted(os.listdir(CASES)):
        path = os.path.join(CASES, name, "case.yaml")
        if not os.path.isfile(path):
            continue
        case = yaml.safe_load(open(path, encoding="utf-8")) or {}
        print(f"  {name:<28} {case.get('procedencia','?'):<10} {case.get('que','')}")
        rows += 1
    print(f"\n{rows} case(s)")
    return 0


# ── serve ────────────────────────────────────────────────────────────
# WHAT IT READS. Six commands, named here rather than derived because
# each one is a DECISION about what the first screen is for, not a
# detail: the organizations are the entry —the list the operator asked
# for—, the traffic is what actually arrived at each of them, the round
# says how the platform is, the capacity answers whether another
# organization fits, and the edge says whether the hostnames anybody
# types actually exist. More arrive with the panels that need
# them.
# `builds show --last 60` and not its default of ten: the panel draws
# each project's last push on its own card, and ten events across five
# organizations is a window one busy tenant fills by itself. Sixty is
# about a week here, and what a card cannot find it says out loud.
SOURCES = ("org list", "repos list", "traffic show", "capacity show",
           "builds show --last 60", "check", "edge check")


# AND WHAT ONE ORGANIZATION'S SCREEN READS. Three commands, each one
# ASKED ABOUT THAT ORGANIZATION rather than about the instance: the
# living side of the contract, what happened to its last pushes, what
# arrived at it, and whether its data has a copy somewhere else. Scoped at the source and not filtered here
# on purpose — a screen that filtered a document would be dropping
# measurements, and the console's one promise is that it does not.
ORG_SOURCES = ("tenant show {org}", "builds show --org {org}",
               "traffic show --org {org}", "data remote status --org {org}")


# ── the only write this console does ─────────────────────────────────
# AT MODULE LEVEL AND NOT INSIDE THE HANDLER, so that it can be run on
# its own: check 099 calls it against a fixture tree and compares the
# tree before and after. A rule about what a program writes that is only
# ever read is a rule nobody has tried.
def validate_contract(text):
    """The validator's own words about this text, or None.

    ONE validator, the same one `aegis org apply` runs. A second opinion
    about what a contract is would be a second thing to keep in step,
    and the first time they drifted the console would be blessing
    something the generator refuses.
    """
    tmp = tempfile.mkdtemp(prefix="aegis-console-")
    try:
        probe = os.path.join(tmp, "contrato.yaml")
        with open(probe, "w", encoding="utf-8") as fh:
            fh.write(text)
        try:
            _rc, doc = cli.run_json("org", "validate", probe)
        except cli.CouldNotEvaluate as e:
            # The validator is not there. Saying «refused» would be a
            # lie in the safe direction, and the safe direction is not
            # the honest one: nobody looked.
            return f"the contract could not be validated: {e}"
        # FROM THE DOCUMENT AND NOT FROM THE NARRATION. The validator's
        # sentence is exactly what the person has to read —it names the
        # field and explains why— but it travels as a value in the
        # document, not as the prose beside it. Check 123 caught the
        # first version of this reading stderr, and it was right: the
        # day somebody rewords the message, prose breaks and a field
        # does not.
        for step in doc.get("steps") or []:
            if step.get("valid") is False:
                # The message names the temporary file this function
                # just made, which the person never saw and cannot open.
                return str(step.get("error") or "the contract was refused and said "
                           "nothing").replace(probe, "the contract").strip()
        if doc.get("rc"):
            return (f"the contract was refused (rc {doc.get('rc')}) and the document "
                    f"says nothing about which part")
        return None
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def write_contract(text):
    """Write ONE contract into orgs/, and nothing else, ever.

    It does not commit, it does not push, it does not apply, and it does
    not touch the cluster. `aegis org` already has that property —«the
    worst that can happen is an ugly diff nobody commits»— and this
    console inherits it verbatim: a file in a working tree changes
    nothing, because ArgoCD reads the remote. What makes an organization
    exist is a commit, and that is the operator's to make.

    It refuses to overwrite. An organization that already exists is not
    created by writing over its contract: that is an edit, it is a
    different decision, and it is not this screen's.

    Returns (path, None) or (None, why not).
    """
    bad = validate_contract(text)
    if bad:
        return None, bad
    try:
        name = (yaml.safe_load(text) or {}).get("organizacion")
    except yaml.YAMLError as e:
        return None, f"the contract is not readable YAML: {e}"
    if not name:
        return None, "the contract names no organization"
    orgs = os.path.join(str(paths.platform_dir()), "orgs")
    if not os.path.isdir(orgs):
        return None, (f"there is no {orgs} to write into: this does not look like an "
                      f"instance of aegis")
    target = os.path.join(orgs, f"{name}.yaml")
    if os.path.exists(target):
        return None, (f"there is already a contract at {target}. Creating an "
                      f"organization does not write over one that exists: that is an "
                      f"edit, and it is a different decision.")
    with open(target, "w", encoding="utf-8") as fh:
        fh.write(text)
    return target, None


def read_contract(org):
    """The contract of one organization, as it is on disk.

    READ FROM THE FILE THIS SCREEN IS ABOUT TO REWRITE, and not from
    `aegis org list`'s document, which carries a SUMMARY of each service
    — no `usa`, no `almacenamiento`, no `ai` block. Editing from a
    summary means writing back a contract that lost everything the
    summary left out, and `usa` is optional so nothing would refuse it.
    Rewriting a file you have not read is the mistake; this is the fix.
    """
    path = os.path.join(str(paths.platform_dir()), "orgs", f"{org}.yaml")
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            return yaml.safe_load(fh) or None
    except (OSError, yaml.YAMLError):
        return None


def replace_contract(text):
    """Write over a contract that EXISTS. The other write, and the one
    that needed its own door.

    `write_contract` refuses to overwrite on purpose: an organization
    that is already there is not created by writing over its contract.
    This is the operation that is allowed to, and everything it checks
    is a way of making sure it is the same organization:

      · the contract has to validate, before anything is touched;
      · a file for that organization has to already be there — this
        does not create, and a create that arrives disguised as an edit
        would skip every question the create screen asks;
      · the name may not change. Renaming would write a SECOND contract
        and leave the first where it is: two files, one namespace, and
        a screen that says it saved.

    What it does NOT do is keep a copy of the old one. git already has
    it, and a `.anterior` beside the real file is a second place a
    tenant's contract lives — which is exactly the state the checks
    over this screen refuse.

    Returns (path, None) or (None, why not).
    """
    bad = validate_contract(text)
    if bad:
        return None, bad
    try:
        name = (yaml.safe_load(text) or {}).get("organizacion")
    except yaml.YAMLError as e:
        return None, f"the contract is not readable YAML: {e}"
    if not name:
        return None, "the contract names no organization"
    orgs = os.path.join(str(paths.platform_dir()), "orgs")
    target = os.path.join(orgs, f"{name}.yaml")
    if not os.path.exists(target):
        return None, (f"there is no contract at {target} to change. This screen edits "
                      f"an organization that exists; creating one is another screen, "
                      f"and it asks other questions.")
    with open(target, "w", encoding="utf-8") as fh:
        fh.write(text)
    return target, None


def finish_contract(path):
    """Derive the manifests and the secrets. The rest of the errand.

    WHY THIS IS HERE AT ALL. Writing the contract was one sixth of
    signing an organization up. The other five were left in a terminal:
    `aegis org apply`, `aegis secret create`, the commit, `aegis sync
    root`, and `aegis app apply`. A console that walks somebody to the
    first file and then hands them five commands is not a console, it is
    a form with a nice font.

    WHY IT IS ONLY THESE TWO. They write FILES IN THIS INSTANCE and
    nothing else — `aegis org` promises it in its own module and
    `aegis secret` never invokes kubectl at all. That is the same
    property this console already had, so taking them on costs nothing
    and changes no promise.

    The three that are left are left ON PURPOSE and each for its own
    reason: the commit is the operator's, because that is what makes a
    file in a working tree harmless; `aegis sync root` speaks to the
    cluster; and `aegis app apply` creates a repository, a deploy key
    and a webhook ON GITHUB, which is somebody else's machine.

    A step that fails does not abort the others: an instance with no age
    key can still have its manifests derived, and being told which half
    happened is worth more than being told nothing did.
    """
    done = []
    for verb, args, what in (("org", ("apply", path), "manifests"),
                             ("secret", ("create", path), "secrets")):
        try:
            rc, doc = cli.run_json(verb, *args)
        except cli.CouldNotEvaluate as e:
            done.append({"paso": f"{verb} {args[0]}", "que": what,
                         "rc": None, "documento": None, "sin_documento": str(e)})
            continue
        done.append({"paso": f"{verb} {args[0]}", "que": what,
                     "rc": rc, "documento": doc, "sin_documento": None})
    return done


def _organizations(readings):
    """Who the console will draw a page for: the names the contracts
    declare, taken from the reading already on the screen. Derived and
    never a list kept here, so an organization created ten minutes ago
    has a page as soon as the list does."""
    for r in readings:
        if r.get("comando") != "org list":
            continue
        return {s["step"].split(":", 1)[1]
                for s in (r.get("documento") or {}).get("steps") or []
                if s.get("step", "").startswith("organization:")}
    return set()


def _read_instance(sources=SOURCES):
    """One reading per source. A source that cannot answer is a reading
    too — the case zero, live — and never an exception that empties the
    page."""
    import datetime
    readings = []
    for line in sources:
        parts = line.split()
        when = datetime.datetime.now().astimezone().isoformat(timespec="seconds")
        entry = {"comando": line, "rc": None, "documento": None,
                 "sin_documento": None, "medido_en": when}
        try:
            entry["rc"], entry["documento"] = cli.run_json(*parts)
        except cli.CouldNotEvaluate as e:
            entry["sin_documento"] = str(e)
        except Exception as e:                            # noqa: BLE001
            # ANY failure is «I could not look», never a traceback and
            # never a blank page. A console that dies because one of
            # its sources did is a console that tells you nothing about
            # the other one.
            entry["sin_documento"] = f"{type(e).__name__}: {e}"
        readings.append(entry)
    return readings


def serve(port):
    import http.server
    import secrets
    import threading

    from aegis import console as drawing
    from aegis import guard

    # ONE TOKEN PER PROCESS, minted here and never written anywhere: not
    # to a file, not to the log, not to the line printed on start. It
    # travels in the page this server serves and comes back in what that
    # page submits. A site on the internet can make the operator's
    # browser POST here —same-origin policy has never stopped that— but
    # it cannot READ the answer, so it never learns this string.
    token = secrets.token_urlsafe(32)

    state = {"readings": _read_instance(), "orgs": {}}
    lock = threading.Lock()

    def _schema():
        """What a contract may contain. Asked of the command every time
        rather than once at start-up: a platform that learns a new type
        while this server is running should not need it restarted to
        offer it."""
        try:
            _rc, doc = cli.run_json("org", "schema")
            return doc
        except cli.CouldNotEvaluate:
            # An empty document, and the form says out loud that it
            # could not read the options — never a form with no choices
            # on it, which looks like a platform that has none.
            return {"steps": [], "rc": 2}

    def read_org(name):
        return _read_instance(tuple(s.format(org=name) for s in ORG_SOURCES))

    class Handler(http.server.BaseHTTPRequestHandler):
        # The default logs one line per request to stderr, which on a
        # console the operator leaves open is noise that hides anything
        # worth reading.
        def log_message(self, *_args):
            pass

        def _send(self, code, body, kind="text/html; charset=utf-8", head_only=False):
            raw = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(raw)))
            # It draws only what it built: no third party, no inline
            # handler, nothing fetched. The header says so out loud so
            # that a future panel cannot quietly start reaching out.
            # `form-action 'self'` and not 'none' since the console
            # grew a screen that writes. Everything else stands: no
            # script, nothing fetched, no frame. The one thing this
            # page may now do is submit back to itself, which is
            # exactly the narrowest form of what it needs.
            self.send_header("Content-Security-Policy",
                             "default-src 'none'; style-src 'unsafe-inline'; "
                             "font-src data:; form-action 'self'; base-uri 'none'; "
                             "frame-ancestors 'none'")
            self.send_header("Referrer-Policy", "no-referrer")
            self.end_headers()
            if not head_only:
                self.wfile.write(raw)

        def do_HEAD(self):                                # noqa: N802
            # Without this, a HEAD answers 501 — and the first thing
            # anybody points at a new URL is `curl -I`. Same headers,
            # no body: it is cheap and it stops the console looking
            # broken to the simplest probe there is.
            self.do_GET(head_only=True)

        def _refuse(self, why, head_only=False):
            # The reason is said out loud, to the client and on the
            # operator's terminal: a console that refuses silently is a
            # console that looks broken. What is never said is the
            # token.
            print(f"refused: {why}", file=sys.stderr)
            self._send(403, f"{why}\n", "text/plain; charset=utf-8", head_only)

        def _form(self):
            """The submitted fields. A body larger than a contract could
            possibly be is refused rather than read: nothing here needs
            to accept an upload, and a server that reads whatever it is
            handed is a server somebody can keep busy."""
            import urllib.parse as _u
            length = int(self.headers.get("Content-Length") or 0)
            if length > 64 * 1024:
                return None
            raw = self.rfile.read(length).decode("utf-8", "replace")
            return {k: v[0] for k, v in _u.parse_qs(raw, keep_blank_values=True).items()}

        def do_POST(self):                                # noqa: N802
            why = guard.why_not_read(self.headers, port)
            if why:
                self._refuse(why)
                return
            fields = self._form() or {}
            why = guard.why_not_write("POST", self.headers, token, fields.get("token"))
            if why:
                self._refuse(why)
                return
            path = self.path.split("?")[0]
            if path == "/new":
                self._preview(fields)
                return
            if path == "/new/write":
                self._write(fields)
                return
            m = re.fullmatch(r"/org/([^/]+)/(edit|write)", path)
            if m:
                # The name off a URL is matched against the contracts
                # and never passed along as typed: every source here
                # ends up as an argv.
                name = urllib.parse.unquote(m.group(1))
                if name not in _organizations(state["readings"]):
                    self._send(404, "no organization by that name\n",
                               "text/plain; charset=utf-8")
                    return
                if m.group(2) == "edit":
                    self._preview(fields, org=name)
                else:
                    self._write(fields, org=name)
                return
            self._send(404, "404\n", "text/plain; charset=utf-8")

        def _current(self, org):
            """The contract this screen is about to change, whole."""
            return read_contract(org)

        def _preview(self, fields, org=None):
            """Build it, validate it, and draw what would change. NOTHING
            of the instance is touched: the contract goes to a temporary
            file that is removed no matter how this ends, and `aegis org
            plan` is the same command the operator would run by hand."""
            schema = _schema()
            current = self._current(org) if org else None
            before = None
            if org:
                if current is None:
                    self._send(404, "no organization by that name\n",
                               "text/plain; charset=utf-8")
                    return
                before = yaml.safe_dump(current, allow_unicode=True,
                                        sort_keys=False, width=88)
                _contract, text, refused = drawing.contract_from_edit(
                    fields, schema, current)
                if refused:
                    self._send(200, drawing.wrap(drawing.render_edit(
                        schema, current, token, fields, refused), f"{org} · edit"))
                    return
            else:
                _contract, text = drawing.contract_from_form(fields, schema)
            bad = validate_contract(text)
            if bad:
                page = (drawing.render_edit(schema, current, token, fields, bad)
                        if org else
                        drawing.render_form(schema, token, fields, bad))
                self._send(200, drawing.wrap(page, f"{org} · edit" if org
                                             else "a new organization"))
                return
            tmp = tempfile.mkdtemp(prefix="aegis-console-")
            try:
                probe = os.path.join(tmp, "contrato.yaml")
                with open(probe, "w", encoding="utf-8") as fh:
                    fh.write(text)
                try:
                    _rc, doc = cli.run_json("org", "plan", probe)
                except cli.CouldNotEvaluate as e:
                    page = (drawing.render_edit(schema, current, token, fields,
                                                f"the plan could not be run: {e}")
                            if org else
                            drawing.render_form(schema, token, fields,
                                                f"the plan could not be run: {e}"))
                    self._send(200, drawing.wrap(page, "the plan"))
                    return
            finally:
                shutil.rmtree(tmp, ignore_errors=True)
            self._send(200, drawing.wrap(
                drawing.render_plan(doc, text, token, before=before, org=org),
                "the plan"))

        def _write(self, fields, org=None):
            # VALIDATED AGAIN, on the way in. What comes back in a form
            # is whatever the browser sent, and the fact that this
            # server drew it a moment ago is not evidence that it is
            # what came back.
            text = fields.get("contrato") or ""
            if org:
                current = self._current(org)
                # AND THE SAME REFUSALS AS THE PREVIEW, applied again on
                # the way in. The preview's answer is not evidence about
                # what came back: a body can be replayed, edited, or
                # posted from a page that was drawn ten minutes ago over
                # an organization that has changed since.
                try:
                    submitted = yaml.safe_load(text) or {}
                except yaml.YAMLError as e:
                    submitted, refused = {}, f"the contract is not readable YAML: {e}"
                else:
                    refused = drawing.refuse_edit(submitted, current)
                if refused:
                    self._send(200, drawing.wrap(drawing.render_edit(
                        _schema(), current, token, None, refused), f"{org} · edit"))
                    return
                target, bad = replace_contract(text)
            else:
                target, bad = write_contract(text)
            if bad:
                page = (drawing.render_edit(_schema(), self._current(org), token,
                                            None, bad) if org else
                        drawing.render_form(_schema(), token, {}, bad))
                self._send(200, drawing.wrap(page, "a new organization"))
                return
            # AND THE REST OF THE ERRAND. The manifests and the secrets
            # come from the two commands that write files and nothing
            # else; what is left after them is shown as the three
            # commands they are.
            after = finish_contract(target)
            doc = None
            try:
                _rc, doc = cli.run_json("org", "plan", target)
            except cli.CouldNotEvaluate:
                doc = None
            with lock:
                state["readings"] = _read_instance()
                state["orgs"].clear()
            name = os.path.basename(target).removesuffix(".yaml")
            self._send(200, drawing.wrap(
                drawing.render_plan(doc, text, token, written=target,
                                    after=after, org=name,
                                    platform=str(paths.platform_dir())), "the plan"))

        def do_GET(self, head_only=False):                # noqa: N802
            # THE HOST CHECK APPLIES TO READS TOO, and it was missing
            # while this console only read. A page on the internet whose
            # name resolves to 127.0.0.1 reaches this port with its own
            # origin intact, and what it finds is every hostname, every
            # organization and every finding of the round.
            why = guard.why_not_read(self.headers, port)
            if why:
                self._refuse(why, head_only)
                return
            path = self.path.split("?")[0]
            if path == "/measure":
                # Re-measuring is a GET today and it changes nothing but
                # what is on the screen. The moment anything here writes,
                # it moves to POST like the rest.
                with lock:
                    state["readings"] = _read_instance()
                    state["orgs"].clear()
                self.send_response(303)
                self.send_header("Location", "/")
                self.end_headers()
                return
            if path == "/new":
                # `?repo=<name>` is the import: the form opens already
                # holding what was MEASURED about that repository — its
                # name and the URL GitHub itself returned — and a
                # suggestion for the type that the form says is a
                # suggestion. A name that is not in the reading fills
                # nothing, which is the only safe answer to a name that
                # came off a URL.
                filled = None
                asked = urllib.parse.parse_qs(
                    self.path.partition("?")[2]).get("repo", [""])[0]
                if asked:
                    step = drawing.repo_in(state["readings"], asked)
                    if step is not None:
                        filled = drawing.import_fields(
                            asked, step.get("lenguaje"), step.get("url"))
                self._send(200, drawing.wrap(
                    drawing.render_form(_schema(), token, filled),
                    "a new organization"), head_only=head_only)
                return
            m = re.fullmatch(r"/org/([^/]+)/edit", path)
            if m:
                name = urllib.parse.unquote(m.group(1))
                current = self._current(name)
                if current is None:
                    self._send(404, "no organization by that name\n",
                               "text/plain; charset=utf-8", head_only)
                    return
                self._send(200, drawing.wrap(drawing.render_edit(
                    _schema(), current, token), f"{name} · edit"),
                    head_only=head_only)
                return
            if path.startswith("/org/"):
                # The name comes off a URL anybody can type. It is
                # matched against the organizations the CONTRACTS
                # declare and never passed along as typed: every one of
                # these sources ends up as an argv, and an argv built
                # out of a URL is the oldest hole there is.
                name = urllib.parse.unquote(path[len("/org/"):]).strip("/")
                if name not in _organizations(state["readings"]):
                    self._send(404, "no organization by that name\n",
                               "text/plain; charset=utf-8", head_only)
                    return
                with lock:
                    readings = state["orgs"].get(name)
                if readings is None:
                    readings = read_org(name)
                    with lock:
                        state["orgs"][name] = readings
                self._send(200, drawing.page(readings, f"{name} · aegis", subject=name),
                           head_only=head_only)
                return
            if path != "/":
                self._send(404, "404\n", "text/plain; charset=utf-8", head_only)
                return
            with lock:
                readings = list(state["readings"])
            self._send(200, drawing.page(readings, "aegis"), head_only=head_only)

    # 127.0.0.1 AND NOT 0.0.0.0, and there is no flag to change it. This
    # page shows everything the round can see about the instance and it
    # has no login of its own; the way it is reached from elsewhere is
    # an SSH tunnel, or Cloudflare Access in front of it under the
    # cloudflare profile — the same door Jenkins and ArgoCD go through.
    # A bind address is one keystroke away from publishing all of that,
    # so the keystroke does not exist.
    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    print(f"the console is reading on http://127.0.0.1:{port}/  (ctrl-c to stop)")
    print(f"  sources: {', '.join(SOURCES)}")
    print(f"  /org/<name> reads one organization: "
          f"{', '.join(x.replace('{org}', '<name>') for x in ORG_SOURCES)}")
    print(f"  /new         describes a new organization. It writes ONE file and "
          f"nothing else: no commit, no push, no cluster")
    print(f"  /measure reads them again")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        server.server_close()
    return 0


def main():
    ap = cli.parser("console", __doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    c = sub.add_parser("capture", help="run the commands and store the state of the world")
    c.add_argument("name")
    c.add_argument("--what", required=True, metavar="SENTENCE",
                   help="what state of the world this is, in one sentence")
    c.add_argument("--run", action="append", default=[], metavar="COMMAND",
                   help="an aegis command WITHOUT --json (repeatable)")
    sub.add_parser("list", help="the corpus")
    sv = sub.add_parser("serve", help="read the instance and draw it, on loopback")
    sv.add_argument("--port", type=int, default=7391,
                    help="the loopback port (default 7391)")
    a = ap.parse_args()
    if a.verb == "list":
        return listing()
    if a.verb == "serve":
        return serve(a.port)
    return capture(a.name, a.what, a.run)


if __name__ == "__main__":
    sys.exit(main())
