#!/usr/bin/env python3
# aegis-summary: Derives from the contract everything the organization needs
# aegis-group:   apps
# aegis-subcommands: plan apply validate edge routes plan-delete delete migrate
"""aegis org — the command line on top of lib/aegis/org.py.

The body (the contract's validation and the eleven derivations) lives in
the PACKAGE, not here. In v2 it lived in this file and the consumers
—aegis-app, aegis-secret, aegis dev test-org, aegis dev test-types—
loaded it with SourceFileLoader, that is, they imported an EXECUTABLE by
its path. That cost three things (docs/cli/inconsistencias.md C1):

  · the surrounding `except ImportError` treated «the file is not there»
    as «this check does not apply» — case A2 of the register: check 4
    passed identically with aegis-org absent;
  · a grep does not find that dependency, so moving the file broke
    nothing visible until something was really used;
  · and on loading it, the executable's whole preamble ran.

Now it is `from aegis import org`: if the package is missing, the import
fails and whoever needed it turns red, which is the correct outcome.
"""
import os
import sys

# ── canonical python preamble (V-102) ────────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))

from aegis import org                    # noqa: E402

if __name__ == "__main__":
    sys.exit(org.main())
