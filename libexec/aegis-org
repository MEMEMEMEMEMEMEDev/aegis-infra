#!/usr/bin/env python3
# aegis-summary: Deriva del contrato todo lo que la organización necesita
# aegis-group:   apps
"""aegis org — la línea de comandos sobre lib/aegis/org.py.

El cuerpo (validación del contrato y las once derivaciones) vive en el
PAQUETE, no acá. En v2 vivía en este archivo y los consumidores
—aegis-app, aegis-secreto, aegis-org-prueba, aegis-tipos-prueba— lo
cargaban con SourceFileLoader, es decir, importaban un EJECUTABLE por
su ruta. Eso costaba tres cosas (docs/cli/inconsistencias.md C1):

  · el `except ImportError` de alrededor trataba «el archivo no está»
    como «esta comprobación no aplica» — el caso A2 del registro: el
    check 4 pasaba idéntico con aegis-org ausente;
  · un grep no encuentra esa dependencia, así que mover el archivo no
    rompía nada visible hasta que algo se usaba de verdad;
  · y al cargarlo, el preámbulo del ejecutable corría entero.

Ahora es `from aegis import org`: si el paquete falta, el import falla
y quien lo necesitaba se pone rojo, que es lo correcto.
"""
import os
import sys

# ── preámbulo canónico de python (V-102) ─────────────────────────────
_AEGIS_ROOT = os.environ.get("AEGIS_ROOT") or os.path.dirname(
    os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_AEGIS_ROOT, "lib"))

from aegis import org                    # noqa: E402

if __name__ == "__main__":
    sys.exit(org.main())
