#!/usr/bin/env bash
# aegis-summary: The round: measures reality against what is declared
# aegis-group:   operate
# aegis-help:
# Usage: aegis check
#
# The routine round. It takes no arguments and WRITES NOTHING: it
# measures the live cluster against what the instance declares
# (signature enforcement, backups per organization, drift) and
# reports each subject as done / already / COULD NOT EVALUATE.

# aegis-check — the routine round, the one you run when coming back
# from a shutdown or before starting to touch anything.
#
# IT WRITES NOTHING. All it does is read and, in the case of the
# signature check, ask the apiserver for an ADMISSION verdict with
# --dry-run=server: it goes through the webhooks but does not create the
# pod.
#
# ── why it exists ─────────────────────────────────────────────────
# Phase 80 of the init tests the supply chain thoroughly (negative,
# scope, fail-closed). But that runs ONCE, at bootstrap. Day to day
# there was nothing, and the only thing at hand —`kubectl get
# clusterpolicy`— LIES:
#
#   NAME                      BACKGROUND   ACTION
#   require-aegis-signature   true         Audit      <- FALSE
#
# That column reads spec.validationFailureAction, a DEPRECATED field
# that Kyverno's webhook fills in by itself with its default (it is
# documented in k8s/argocd-apps/ci-supply-tenants.yaml, where it is
# ignored in the diff precisely because it is cosmetic). The real
# Enforce lives in the rule:
# spec.rules[].verifyImages[].failureAction. On 2026-08-03 I read
# "Audit" during a routine check and for a minute I gave up the
# platform's central guarantee for lost.
#
# It is the same class of trap as the `sops -d ... | head -c 1` of
# docs/protocols/ai-tenant-key.md §3: a command that answers something
# plausible and wrong. The lesson, already written in f4b8132, is that
# the check is tied to the INVARIANT and not to where/how it is
# written.
#
# So no field of the policy is read here. An unsigned image is pushed
# in and it is demanded that it BOUNCE. If some day somebody really
# puts the policy in Audit, or deletes the rule, or breaks the
# namespaceSelector, this check goes red — no matter what the YAML
# says.
set -uo pipefail

# ── canonical preamble (V-102) ───────────────────────────────────────
if [[ -z "${AEGIS_ROOT:-}" ]]; then
    command -v readlink >/dev/null || { echo "${AEGIS_CMD:-aegis} check: readlink is missing" >&2; exit 2; }
    AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
fi
export AEGIS_ROOT
# shellcheck source=../lib/paths.sh
source "$AEGIS_ROOT/lib/paths.sh"

usage() { sed -n '/^# aegis-help:/,/^$/p' "$0" | sed 's/^# \?//;1d'; cat "$AEGIS_ROOT/share/exit-codes.txt"; }
for a in "$@"; do case "$a" in
    -h|--help) usage; exit 0 ;;
    *) echo "${AEGIS_CMD:-aegis} check takes no arguments (got '$a'); try --help" >&2; exit 3 ;;
esac; done
# aegis_exec (rule 5.1) lives in common.sh. The round does not need the
# rest of the init, but it does need to invoke other commands WITHOUT an
# absent command turning into «no failures».
aegis_exec() {
    local cmd="$1"; shift
    local target="$AEGIS_ROOT/libexec/aegis-$cmd"
    if [[ ! -e "$target" ]]; then
        printf 'COULD NOT EVALUATE: the command %s does not exist (%s) — it is not that there are no failures: it is that it could not be looked at\n' \
            "${AEGIS_CMD:-aegis} $cmd" "$target" >&2
        return 2
    fi
    [[ -x "$target" ]] || { printf 'COULD NOT EVALUATE: %s is not executable (chmod +x)\n' "$target" >&2; return 2; }
    "$target" "$@"
    local rc=$?
    [[ $rc == 126 || $rc == 127 ]] && { printf 'COULD NOT EVALUATE: %s could not be executed (rc %s)\n' "${AEGIS_CMD:-aegis} $cmd" "$rc" >&2; return 2; }
    return $rc
}

# The probe image: public, foreign to the internal registry and
# therefore never signed with our key. PINNED on purpose (same criterion
# as phase 80): a moving tag would make the check depend on what Docker
# Hub uploaded last night.
IMG_UNSIGNED="busybox:1.36"

# ── why that image is NOT enough on its own (#78) ──────────────────
# Measured on 2026-08-12: the rejection of busybox:1.36 did NOT say
# "unsigned". It said:
#     Get "https://index.docker.io/v2/": tls: failed to verify
#     certificate: x509: certificate signed by unknown authority
#
# Which means Kyverno never even reached the registry. The pod gets
# rejected all the same —it fails closed, which is right— but this check
# was reporting GREEN for the wrong reason: what it was measuring was
# «Kyverno cannot talk to Docker Hub», not «unsigned images get
# rejected». It would have stayed green with the signature policy
# completely broken.
#
# The cause: the chart mounts the internal CA ON TOP OF
# /etc/ssl/certs/ca-certificates.crt and points SSL_CERT_FILE there, so
# Kyverno's trust store is that CA and NOTHING else. It is a deliberate
# fix so that it trusts the internal registry, with a side effect nobody
# saw.
#
# The good probe is a REACHABLE unsigned image: one from the internal
# registry, whose TLS Kyverno does validate. It is DISCOVERED instead of
# being pinned, because pinning a tag that exists today by historical
# accident is a check tied to a place (C15) that lies the moment the
# garbage collector runs.
internal_unsigned_probe() {
    local cred
    cred=$(kubectl -n jenkins-system get secret regcred-internal \
             -o jsonpath='{.data.\.dockerconfigjson}' 2>/dev/null | base64 -d) || return 1
    [[ -n "$cred" ]] || return 1
    printf '%s' "$cred" | python3 -c '
import base64, json, ssl, sys, urllib.request

cfg = json.load(sys.stdin)["auths"]
host = next(iter(cfg))
auth = cfg[host]["auth"]
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
ACC = ("application/vnd.oci.image.index.v1+json,"
       "application/vnd.oci.image.manifest.v1+json,"
       "application/vnd.docker.distribution.manifest.v2+json")

def fetch(path, method="GET"):
    r = urllib.request.Request(f"https://{host}/v2/{path}", method=method)
    r.add_header("Authorization", "Basic " + auth); r.add_header("Accept", ACC)
    return urllib.request.urlopen(r, timeout=15, context=ctx)

try:
    repos = json.load(fetch("_catalog"))["repositories"]
except Exception:
    sys.exit(1)

for repo in repos:
    try:
        tags = json.load(fetch(f"{repo}/tags/list")).get("tags") or []
    except Exception:
        continue
    for t in [x for x in tags if not x.endswith(".sig")]:
        try:
            dig = fetch(f"{repo}/manifests/{t}", "HEAD").headers.get("Docker-Content-Digest")
            if not dig:
                continue
            fetch(f"{repo}/manifests/{dig.replace(chr(58), chr(45))}.sig", "HEAD")
        except urllib.error.HTTPError as e:
            if e.code == 404:            # unsigned: this is the one we want
                print(f"{host}/{repo}:{t}"); sys.exit(0)
        except Exception:
            continue
sys.exit(1)
' 2>/dev/null
}
POLICY="require-aegis-signature"

# The positive needs a namespace OUTSIDE the enforce zone. The recovery
# ones (argocd, kyverno, registry-system, jenkins-system, cert-manager,
# infra-edge) never carry the label —that is the invariant that protects
# the bootstrap— so any of them will do. jenkins-system is also not
# restricted, and the probe runs as root.
NS_OUTSIDE="jenkins-system"

# The probes declare resources because the namespaces have a
# ResourceQuota and the quota DEMANDS limits. Without this the probe
# bounces because of quota and not because of the policy — which is
# exactly the mistake this script exists in order not to make: the first
# version said "the webhook's namespaceSelector overflowed" when all
# that was happening was a missing limits.cpu. With resources declared,
# the only thing that can reject it is the signature enforce.
LIMITS='{"requests":{"cpu":"10m","memory":"32Mi"},"limits":{"cpu":"50m","memory":"64Mi"}}'
# And the same for Pod Security: the namespaces this probe enters
# enforce `restricted`, and a pod that runs as root with privilege
# escalation is rejected by PodSecurity BEFORE Kyverno ever sees it —
# on the first clean instance the round said "rejected in garage-system
# but NOT by require-aegis-signature" about a probe PSS had turned
# away. The probe carries the full restricted profile, so that once
# more the only thing left to reject it is the signature.
SECCTX_POD='{"runAsNonRoot":true,"runAsUser":65532,"seccompProfile":{"type":"RuntimeDefault"}}'
SECCTX_CTR='{"allowPrivilegeEscalation":false,"capabilities":{"drop":["ALL"]}}'
probe() { # probe <ns> <name>
    kubectl run "$2" -n "$1" --image="$IMG_UNSIGNED" --restart=Never \
      --dry-run=server -o name \
      --overrides="{\"apiVersion\":\"v1\",\"spec\":{\"securityContext\":$SECCTX_POD,\"containers\":[{\"name\":\"$2\",\"image\":\"$IMG_UNSIGNED\",\"command\":[\"true\"],\"resources\":$LIMITS,\"securityContext\":$SECCTX_CTR}]}}" 2>&1
}

red=$'\033[31m'; green=$'\033[32m'; yellow=$'\033[33m'; gray=$'\033[90m'; reset=$'\033[0m'
[[ -t 1 ]] || { red=""; green=""; yellow=""; gray=""; reset=""; }

failures=0; notices=0
ok()     { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
bad()    { printf '  %s✗%s %s\n' "$red"   "$reset" "$*"; failures=$((failures + 1)); }
notice() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; notices=$((notices + 1)); }
note()   { printf '    %s%s%s\n' "$gray" "$*" "$reset"; }
heading(){ printf '\n%s\n' "$*"; }

# ── a ✓ demands that something was measured ───────────────────────
# The rule was already written in verify-static (check 55: «if evaluated
# == 0 → FAIL, the check evaluated nothing») and this file broke it in
# SIX places: if kubectl fails, the 2>/dev/null swallows the error, the
# output is left empty, and the emptiness reads exactly like health. An
# `ok "0 certificates at True"` with the apiserver down is exactly
# Disease E — the check passes without having looked at its subject.
#
# Here the house's third outcome is made mechanical: zero subjects is
# neither green nor red, it is COULD NOT EVALUATE, which counts as a
# notice and NOT as approval.
#
#   ok_if_measured <n> "<message if it measured and is right>" "<what was being measured>"
ok_if_measured() {
    if [[ "${1:-0}" -gt 0 ]]; then
        ok "$2"
    else
        notice "COULD NOT EVALUATE: $3 — zero subjects (did kubectl answer?)"
    fi
}

# ── a DEGRADED measurement cannot end up green ─────────────────────
# `note()` is the detail line of something ALREADY counted: it hangs off
# a bad or off a notice and explains why. That is fine in 15 of its 19
# uses.
#
# Where it is not fine is when the note is the ONLY thing reporting that
# the measurement got weaker. The live case was the signature probe: if
# there is no unsigned internal image, it falls back to a public one,
# and the code's own comment said «the verdict degrades» — in grey,
# adding nothing, and two lines later a ✓ could come out. The final
# verdict («no failures, N notices») never found out.
#
# `degraded()` prints just as discreetly and DOES count: the measurement
# happened, but it is not the one the message says.
degraded() { note "$*"; notices=$((notices + 1)); }

# ── the meters' protocol, in ONE single place ──────────────────────
# The big python blocks do not return a number: they return LINES
# carrying their own verdict (BAD:/GOOD:/NOTE:/NOT EVALUATED), which is
# the right thing — whoever measures is whoever knows what they measured
# means.
#
# But the dispatch was copied in two places and both had the same hole:
# if the meter BLOWS UP, the traceback goes to stderr, the output is
# left empty, no branch of the case matches and the section prints its
# heading and NOTHING ELSE. Total silence. No ✓, no ✗, no !, and the
# final tally without a single signal that nothing was measured there.
#
# It is Disease E in its purest form: it is not that it reports health
# without measuring, it is that it does not report. And a missing line
# reads even better than a false green, because nobody counts it.
#
# Here silence is impossible: if the meter did not emit a single
# verdict, that IS the finding.
#
#   dispatch <rc> "<output>" "<what was being measured>"
dispatch() {
    local rc="$1" output="$2" subject="$3" said=0 line
    while IFS= read -r line; do
        case "$line" in
            BAD:*)            bad    "${line#BAD: }";  said=1 ;;
            GOOD:*)           ok     "${line#GOOD: }"; said=1 ;;
            NOTE:*)           note   "${line#NOTE: }" ;;
            "NOT EVALUATED"*) notice "$line";          said=1 ;;
        esac
    done <<< "$output"
    (( said )) || notice "COULD NOT EVALUATE: $subject — the meter finished (rc $rc) without emitting a single verdict: it blew up, and the traceback went to stderr"
}

# ── 1. the node ───────────────────────────────────────────────────
heading "node"
if ! kubectl get nodes >/dev/null 2>&1; then
    bad "no contact with the apiserver — the rest of the check means nothing"
    exit 1
fi
while read -r name state rest; do
    [[ -z "$name" ]] && continue
    if [[ "$state" == "Ready" ]]; then ok "$name Ready"
    else bad "$name in state $state"; fi
done < <(kubectl get nodes --no-headers 2>/dev/null)

# ── 2. pods that should not be like that ──────────────────────────
# Completed is normal (Jobs that finished); the rest is not.
heading "pods"
all_pods=$(kubectl get pods -A --no-headers 2>/dev/null)
n_pods=$(printf '%s' "$all_pods" | grep -c . )
# The message promised «none restarting» and the condition NEVER looked
# at the restarts: a pod in CrashLoopBackOff that happens to be Running
# at the instant of sampling passed green.
#
# But the lifetime counter is NOT a useful signal in this house: the dev
# machine is suspended every night BY DESIGN (§3.3), so a 27-day-old pod
# accumulates hundreds of restarts while being perfectly healthy. A
# threshold on the total produces 20 permanent reds, and a permanent red
# trains people to ignore the whole check.
# What IS a signal is a RECENT restart: the pod fell over while the
# machine was awake.
odd=$(printf '%s\n' "$all_pods" \
        | awk '$4 != "Running" && $4 != "Completed" {print "  " $1 "/" $2 " " $4}')
#
# And the JSON is read in its OWN call to kubectl, distinct from the one
# that feeds $n_pods. That matters: if this one fails and the other does
# not, ok_if_measured sees subjects and gives the ✓ «none restarting»
# without anybody having looked at a single restart. A green born of an
# error, which is worse than a false red because it does not get
# investigated. That is why the meter SPEAKS when it cannot parse,
# instead of exiting successfully and in silence (which was the
# `sys.exit(0)` that lived here until 2026-08-22).
restarts=$(kubectl get pods -A -o json 2>/dev/null | python3 -c '
import sys, json, datetime
LIMIT_MIN = 60
try:
    pods = json.load(sys.stdin)["items"]
except Exception:
    print("NOT EVALUATED: kubectl did not return a readable JSON of pods — "
          "the recent restarts were NOT looked at")
    sys.exit(2)
now = datetime.datetime.now(datetime.timezone.utc)
for p in pods:
    ns = p["metadata"]["namespace"]; nom = p["metadata"]["name"]
    for c in (p.get("status", {}).get("containerStatuses") or []):
        ended = (c.get("lastState", {}).get("terminated") or {}).get("finishedAt")
        if not ended:
            continue
        try:
            t = datetime.datetime.fromisoformat(ended.replace("Z", "+00:00"))
        except Exception:
            continue
        mins = (now - t).total_seconds() / 60
        if mins <= LIMIT_MIN:
            reason = (c.get("lastState", {}).get("terminated") or {}).get("reason", "?")
            cn = c.get("name", "?")
            print(f"  {ns}/{nom} ({cn}) restarted {mins:.0f} min ago — {reason}")
' 2>/dev/null)
if [[ "$restarts" == "NOT EVALUATED"* ]]; then
    notice "$restarts"
    [[ -n "$odd" ]] && { bad "and there are pods in a bad state as well:"; printf '%s\n' "$odd"; }
elif [[ -n "$odd" || -n "$restarts" ]]; then
    bad "there are pods in a bad state:"
    [[ -n "$odd" ]] && printf '%s\n' "$odd"
    [[ -n "$restarts" ]] && printf '%s\n' "$restarts"
else
    ok_if_measured "$n_pods" "the $n_pods pods are running, none restarting" \
                 "the state of the pods"
fi

# ── 3. the ArgoCD apps ────────────────────────────────────────────
heading "argocd"
all_apps=$(kubectl get applications -n argocd --no-headers \
           -o custom-columns='N:.metadata.name,S:.status.sync.status,H:.status.health.status' \
           2>/dev/null)
n_apps=$(printf '%s' "$all_apps" | grep -c . )
desync=$(printf '%s\n' "$all_apps" | grep -v 'Synced  *Healthy' | grep -v '^$')
if [[ -z "$desync" ]]; then
    ok_if_measured "$n_apps" "the $n_apps apps Synced + Healthy" \
                 "the state of the ArgoCD Applications"
else
    # OutOfSync is not an outage: `root` has no automatic sync on
    # purpose (the app-of-apps' manual gate), so being behind a commit
    # is its NORMAL state. That is why it is a notice and not a
    # failure — but it is shown, because a permanent yellow ends up
    # covering the real drift.
    notice "drifted apps:"
    printf '%s\n' "$desync" | sed 's/^/    /'
    note "to sync: ${AEGIS_CMD:-aegis} sync --drifted"
fi

# ── 3b. what is left over in the cluster ──────────────────────────
# `prune` is omitted across the whole platform (A19): removing something
# from git does NOT remove it from the cluster. The decision is correct
# —a badly fired prune takes data with it— but it leaves a blind spot.
# With orphanedResources.warn in the tenant AppProjects, ArgoCD marks
# what stayed alive undeclared, and it is shown here.
#
# It is reported as a NOTICE and not as a failure: an orphan is not an
# outage, it is something somebody has to look at and decide about.
# And HERE IT IS SAID HOW MANY WERE EVALUATED, which was the half that
# was missing.
#
# An app only produces the Orphaned condition if ITS AppProject has
# `orphanedResources`. The ones in a project without that block never
# give the condition — and this check, which only looked at whether the
# condition was there, counted them as clean.
#
# Measured on 2026-08-05: of 28 Applications, 2 were evaluated. The
# other 26 —including the five `org-*`, which are the ones deploying the
# NetworkPolicies of the incident that motivated #31— came out green
# without anybody having looked at them. Disease E inside the check
# written to cure Disease E.
#
# The number is not decoration: it is what tells "there are no orphans"
# apart from "no orphans were looked for".
reading=$(kubectl get applications,appprojects -n argocd -o json 2>/dev/null | python3 -c "
import json, sys
d = json.load(sys.stdin)
projects, apps = {}, []
for it in d.get('items', []):
    if it['kind'] == 'AppProject':
        projects[it['metadata']['name']] = bool(it['spec'].get('orphanedResources'))
    else:
        apps.append(it)

evaluated, blind, findings = [], [], []
for it in apps:
    name = it['metadata']['name']
    if projects.get(it['spec'].get('project'), False):
        evaluated.append(name)
    else:
        blind.append('%s (%s)' % (name, it['spec'].get('project')))
    for c in (it['status'].get('conditions') or []):
        if 'Orphaned' in c.get('type', ''):
            findings.append('    %s: %s' % (name, (c.get('message') or '').strip()))

print(len(evaluated)); print(len(apps))
print('\x1e'.join(sorted({c.split('(')[1].rstrip(')') for c in blind})))
print('\x1e'.join(findings))
" 2>/dev/null)
n_eval=$(sed -n 1p <<<"$reading")
n_all=$(sed -n 2p <<<"$reading")
blind_projects=$(sed -n 3p <<<"$reading" | tr '\036' ' ')
orphans=$(sed -n 4p <<<"$reading" | tr '\036' '\n')

if [[ -z "$n_all" ]]; then
    notice "the orphan state could not be read — this is NOT approval"
elif [[ -n "$orphans" ]]; then
    notice "orphan resources (in the cluster, not in git):"
    printf '%s\n' "$orphans"
    note "to see them: kubectl get all -n <namespace> and compare against the repo"
else
    # THE PROJECTS THAT ARE NOT COVERED, AND WHY (#47, measured 2026-08-05).
    #
    # Not covering something can be an oversight or a decision, and a
    # check that does not tell them apart is worth as much as no check
    # at all. These two are here because it was MEASURED what happened
    # when they were covered:
    #
    #   aegis-platform   ~146 permanent notices. 81 from the `gpu` App
    #                    alone, whose target namespace is kube-system,
    #                    so it reports everything k3s installs; the rest
    #                    are Secrets generated by cert-manager and by
    #                    ArgoCD itself, ReplicaSet pods and default
    #                    ServiceAccounts. None of them came out of git
    #                    nor is going to.
    #   aegis-bootstrap  the root App, whose target is the whole ArgoCD
    #                    namespace.
    #
    # A permanent notice switches the signal off just as much as an
    # absence does. They are accepted as a KNOWN limit and are always
    # printed, so that the limit is read on every run instead of living
    # inside a commit.
    #
    # What is NOT accepted is a blind project nobody decided on: if one
    # appears outside this list, this warns about it.
    declared_blind="aegis-bootstrap aegis-platform"
    unexpected=""
    for p in $blind_projects; do
        case " $declared_blind " in
            *" $p "*) : ;;
            *) unexpected="$unexpected $p" ;;
        esac
    done
    if [[ -n "$unexpected" ]]; then
        notice "there are AppProject(s) without orphanedResources that nobody declared:$unexpected"
        note "either they get it added, or they get documented as a limit in this check"
    else
        ok_if_measured "$n_eval" "nothing orphaned in the $n_eval apps with coverage" \
                     "the orphan resources of the apps"
        note "$((n_all - n_eval)) without coverage ON PURPOSE ($blind_projects):" \
             "covering them gives ~146 permanent notices about resources that never" \
             "came out of git — measured, not assumed"
    fi
fi

# ── 3b-bis. STUCK sync operations ─────────────────────────────────
#
# On 2026-08-06 a hook Job was left in Terminating with the finalizer
# `argocd.argoproj.io/hook-finalizer` set, and ArgoCD —which waits for
# the previous operation to finish before starting another— stopped
# syncing the `garage` app. FOUR DAYS. It was found by chance (#62).
#
# What makes this failure mode so hard to see is that EVERYTHING LOOKS
# FINE: the Application keeps saying Synced and Healthy, because what is
# deployed does match the last thing that got applied. What does not
# happen is the new stuff. There is no error to look at; there is
# something that stopped happening.
#
# BOTH ENDS are measured, because each one on its own lies:
#   · the operation: a non-terminal phase that has been open for hours
#   · the resource: an object with an old deletionTimestamp — that is,
#     somebody asked for it to be deleted and a finalizer is not letting go
#
# Only the first would miss a stuck finalizer that has not blocked
# anything yet; only the second would miss an operation hanging for some
# other reason.
heading "stuck syncs"
stuck_output=$(GRACE_MIN="${AEGIS_SYNC_GRACE:-30}" python3 - <<'PYEOF'
import datetime, json, os, subprocess, sys

GRACE = int(os.environ.get("GRACE_MIN", "30"))
NOW = datetime.datetime.now(datetime.timezone.utc)
TERMINAL = {"Succeeded", "Failed", "Error"}

def age_min(ts):
    if not ts:
        return None
    return (NOW - datetime.datetime.fromisoformat(ts.replace("Z", "+00:00"))
            ).total_seconds() / 60.0

def kget(args):
    r = subprocess.run(["kubectl", "get"] + args + ["-o", "json"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    return json.loads(r.stdout).get("items", [])

apps = kget(["applications", "-n", "argocd"])
if apps is None:
    print("NOT EVALUATED: could not read the ArgoCD Applications"); sys.exit(2)

problems = []
for a in apps:
    op = (a.get("status", {}) or {}).get("operationState", {}) or {}
    phase = op.get("phase")
    if not phase or phase in TERMINAL:
        continue
    e = age_min(op.get("startedAt"))
    if e is not None and e > GRACE:
        problems.append(f"the app {a['metadata']['name']} has been {e/60:.1f} h "
                        f"in phase {phase} — ArgoCD is not going to start another sync")

# The resource that jams it. An old deletionTimestamp is always a
# finalizer that will not let go: without finalizers, deletion is
# immediate.
hanging = kget(["jobs,pods", "-A"]) or []
for r in hanging:
    m = r["metadata"]
    e = age_min(m.get("deletionTimestamp"))
    if e is None or e <= GRACE:
        continue
    fin = ", ".join(m.get("finalizers", [])) or "no finalizers (kubelet stuck?)"
    problems.append(f"{m['namespace']}/{m['name']} has been {e/60:.1f} h in Terminating "
                    f"[{fin}]")

for x in problems:
    print(f"BAD: {x}")
if not problems:
    print(f"GOOD: {len(apps)} apps with no open operations and nothing in Terminating "
          f"for more than {GRACE} min")
sys.exit(1 if problems else 0)
PYEOF
)
dispatch $? "$stuck_output" "the stuck sync operations"

# ── 3c. the CI quota against the REAL pipelines ───────────────────
# It exists because verify-static CANNOT do this check.
#
# That one verifies THE SEED, and there the only pipelines that exist
# are the template and ci-images. The ones that really run live in the
# apps' repos, which the seed does not know about. So check 36 over
# there watches the invariant against a SUBSTITUTE — and it passed green
# while this instance was in exactly the state that invariant exists to
# prevent (#58, measured on 2026-08-07).
#
# The invariant is the same: the quota has to hold jenkins-0 plus TWO
# overlapping builds, because with multibranch and retries overlapping
# is normal. What changes is what it is measured against.
#
# THE PIPELINES ARE READ FROM GITHUB, not from a pod. The build pods are
# ephemeral: Jenkins deletes them when they finish, so looking at the
# cluster gave "there is nothing to measure" almost always — a check
# that cannot run watches nothing. The repos come from the jobs declared
# in Jenkins' values.yaml, the same as in aegis-webhook, so a new repo
# enters on its own.
heading "CI quota"
quota_output=$(AEGIS_PLATFORM="$PLATFORM_DIR" python3 - <<'PYEOF'
import json, os, re, subprocess, sys

PLATFORM = os.environ["AEGIS_PLATFORM"]
VALUES = os.path.join(PLATFORM, "k8s", "base", "platform", "jenkins", "values.yaml")

def cpu(v):
    v = str(v).strip()
    return int(v[:-1]) if v.endswith("m") else int(float(v) * 1000)

def mem(v):
    v = str(v).strip()
    for suf, mult in (("Gi", 1024), ("Mi", 1), ("Ki", 1 / 1024)):
        if v.endswith(suf):
            return float(v[:-2]) * mult
    return 0.0

# 1) the repos with a job, from Jenkins' values.yaml
try:
    text = open(VALUES, encoding="utf-8").read()
except OSError as e:
    print(f"NOT EVALUATED: could not read Jenkins' values.yaml ({e})"); sys.exit(2)
repos = re.findall(r"repoOwner\('([^']+)'\)\s*\n\s*repository\('([^']+)'\)", text)
if not repos:
    print("NOT EVALUATED: no multibranch job in the values.yaml"); sys.exit(2)

# 2) each one's Jenkinsfile, from GitHub
def pipeline_limits(owner, repo):
    r = subprocess.run(
        ["gh", "api", f"repos/{owner}/{repo}/contents/Jenkinsfile", "--jq", ".content"],
        capture_output=True, text=True)
    if r.returncode != 0:
        return None
    import base64
    try:
        src = base64.b64decode(r.stdout).decode("utf-8", "replace")
    except Exception:
        return None
    c = m = 0.0
    for lim in re.finditer(
            r"limits:\s*\{\s*cpu:\s*([^,]+),\s*memory:\s*([^}\s]+)\s*\}", src):
        c += cpu(lim.group(1)); m += mem(lim.group(2))
    return (c, m) if c else None

worst = (0.0, 0.0, None)
unread = []
for owner, repo in repos:
    lim = pipeline_limits(owner, repo)
    if lim is None:
        unread.append(f"{owner}/{repo}")
        continue
    if lim[0] > worst[0]:
        worst = (lim[0], lim[1], f"{owner}/{repo}")

if worst[2] is None:
    print("NOT EVALUATED: could not read a single Jenkinsfile from GitHub")
    print("(is `gh` or its credential missing?) This is NOT approval.")
    sys.exit(2)

# 3) jenkins-0 and the quota, from the cluster
def kget(*a):
    r = subprocess.run(["kubectl", *a], capture_output=True, text=True)
    return json.loads(r.stdout) if r.returncode == 0 and r.stdout.strip() else None

q = kget("get", "resourcequota", "jenkins-quota", "-n", "jenkins-system", "-o", "json")
if not q:
    print("NOT EVALUATED: cannot find the ResourceQuota jenkins-quota"); sys.exit(2)
hard = q["spec"]["hard"]

jp = kget("get", "pod", "jenkins-0", "-n", "jenkins-system", "-o", "json")
if not jp:
    print("NOT EVALUATED: jenkins-0 is not there to be measured"); sys.exit(2)
jc = sum(cpu(x.get("resources", {}).get("limits", {}).get("cpu", 0))
         for x in jp["spec"]["containers"])
jm = sum(mem(x.get("resources", {}).get("limits", {}).get("memory", 0))
         for x in jp["spec"]["containers"])

bad = False
for label, j, b, qv, u in (("cpu", jc, worst[0], cpu(hard["limits.cpu"]), "m"),
                           ("memory", jm, worst[1], mem(hard["limits.memory"]), "Mi")):
    needed = j + 2 * b
    if needed > qv:
        print(f"the {label} quota does NOT hold jenkins-0 + 2 overlapping builds")
        print(f"  jenkins-0 {j:.0f}{u} + 2 x {b:.0f}{u} = {needed:.0f}{u}  >  quota {qv:.0f}{u}")
        print(f"  the heaviest is {worst[2]}; the second build is queued with no warning")
        bad = True

if unread:
    print(f"careful: could not read {len(unread)} Jenkinsfile ({', '.join(unread)})")
    print("the maximum weight may be underestimated")

if bad:
    sys.exit(1)
print(f"holds jenkins-0 + 2 overlapping builds "
      f"(the heaviest of {len(repos)} repos: {worst[2]}, {worst[0]:.0f}m/{worst[1]:.0f}Mi)")
sys.exit(0)
PYEOF
)
case $? in
    0) ok "$quota_output" ;;
    2) notice "CI quota NOT EVALUATED"
       printf '%s\n' "$quota_output" | sed 's/^ */    /' ;;
    *) bad "the CI quota does not hold two overlapping builds"
       printf '%s\n' "$quota_output" | sed 's/^ */    /' ;;
esac

# ── 4. THE SIGNATURE: the negative ────────────────────────────────
# The heart of the check. The invariant is tested by admission.
heading "supply chain"
ns_inside=$(kubectl get ns -l aegis.dev/part-of=aegis-tenants \
              -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)
if [[ -z "$ns_inside" ]]; then
    bad "no namespace carries aegis.dev/part-of=aegis-tenants — NOTHING is under enforce"
else
    # The REACHABLE probe is the one that really measures. If there is
    # no unsigned one in the internal registry, it falls back to the
    # public one — but the verdict degrades, because then what the
    # message says was not what got measured.
    internal=$(internal_unsigned_probe) || internal=""
    if [[ -n "$internal" ]]; then
        IMG_UNSIGNED="$internal"
        note "probe: $internal (internal, reachable — the rejection can be about the SIGNATURE)"
    else
        # And this COUNTS. The comment above already said «the verdict
        # degrades» and yet it was a grey line that added nothing: two
        # lines later a ✓ could come out and the final tally could say
        # «no failures», with the measurement made against an image
        # Kyverno cannot even reach (#78).
        degraded "no unsigned internal image: probing with $IMG_UNSIGNED (public) — Kyverno may reject it for not reaching the registry, not for the signature"
    fi

    output=$(probe "$ns_inside" check-unsigned); rc=$?
    if [[ $rc -eq 0 ]]; then
        bad "an UNSIGNED image was ADMITTED in $ns_inside"
        note "the signature enforce is not acting — this is the platform's central guarantee"
    elif grep -q "$POLICY" <<<"$output"; then
        # #78: the policy rejected it. But for LACK OF SIGNATURE, or
        # because it could not reach the registry? Both give a rejected
        # pod and only one proves the invariant.
        if grep -qiE 'no signatures found|signature not found|no matching signatures' <<<"$output"; then
            ok "unsigned image REJECTED in $ns_inside FOR LACK OF SIGNATURE (citing $POLICY)"
        elif grep -qiE 'x509|certificate signed by|tls:|no such host|connection refused|i/o timeout|dial tcp' <<<"$output"; then
            bad "rejected for NOT BEING ABLE TO REACH the registry — the signature invariant was NOT measured"
            note "the pod is blocked all the same (it fails closed), but this check cannot claim that the signature is being verified"
            note "$(head -c 300 <<<"$output" | tr '\n' ' ')"
        else
            notice "rejected by $POLICY with a reason I do not recognise — check it by hand"
            note "$(head -c 300 <<<"$output" | tr '\n' ' ')"
        fi
    else
        # Rejected, but not by our policy. It could be a quota, the PSS,
        # or a webhook that is down. It is not enough as proof: it has
        # to be looked at, not taken for granted.
        bad "rejected in $ns_inside but NOT by $POLICY — the rejection proves nothing"
        note "$(head -c 400 <<<"$output" | tr '\n' ' ')"
    fi

    # ── 5. THE SIGNATURE: the positive ────────────────────────────
    # Without this, a webhook that rejects EVERYTHING would pass the
    # previous check with honours. The positive is what tells "the
    # policy works" apart from "the cluster admits nothing".
    if kubectl get ns "$NS_OUTSIDE" >/dev/null 2>&1; then
        out_f=$(probe "$NS_OUTSIDE" check-outside-scope); rc=$?
        if [[ $rc -eq 0 ]]; then
            ok "the same image is ADMITTED in $NS_OUTSIDE — the blast radius is bounded"
        elif grep -q "$POLICY" <<<"$out_f"; then
            bad "$NS_OUTSIDE rejects by $POLICY: the webhook's namespaceSelector overflowed"
            note "the recovery namespaces must NOT be under enforce (otherwise a broken cluster cannot be fixed)"
        else
            # Rejected by something else (quota, PSS, a LimitRange). It
            # says nothing about the webhook's scope, so it is not
            # reported as if it did.
            notice "$NS_OUTSIDE rejected the probe for a reason unrelated to the signature — the positive control did not measure"
            note "$(head -c 300 <<<"$out_f" | tr '\n' ' ')"
        fi
    else
        notice "$NS_OUTSIDE does not exist — no positive control"
    fi
fi

# ── 6. certificates ───────────────────────────────────────────────
heading "certificates"
bad_certs=$(kubectl get certificate -A --no-headers 2>/dev/null | awk '$3 != "True" {print "    " $1 "/" $2 " " $3}')
total=$(kubectl get certificate -A --no-headers 2>/dev/null | wc -l)
if [[ -z "$bad_certs" ]]; then
    ok_if_measured "$total" "$total certificates at True" "the cluster's Certificates"
else bad "unissued certificates:"; printf '%s\n' "$bad_certs"; fi

# ── 6a-bis. whose the routing is ──────────────────────────────────
# It EXERCISES the invariant of #54, it does not assume it.
#
# An AppProject filters by *kind* and never by the value of a field, so
# there is no way of saying "IngressRoutes yes, but only with YOUR
# Host". As long as a tenant could create one, it could claim the
# neighbour's hostname. MEASURED on 2026-08-06: two organizations
# claimed the same host, both admitted without a complaint, and traefik
# served the second one's. The legitimate owner had no defence and no
# warning.
#
# The fix has TWO halves and both can be loosened separately, so both
# are looked at:
#   a) no tenant project can create IngressRoutes
#   b) no live IngressRoute in an organization namespace belongs to an
#      owner other than the platform
#
# (b) matters apart from (a) because prune is off (A19): a route created
# before the control survives the control coming into existence.
heading "whose the routing is"
uncontrolled=""
for p in $(kubectl get appproject -n argocd -o name 2>/dev/null | sed 's|.*/||' | grep '^aegis-tenant-'); do
    kubectl get appproject "$p" -n argocd \
        -o jsonpath='{.spec.namespaceResourceBlacklist[*].kind}' 2>/dev/null \
        | grep -qw IngressRoute || uncontrolled="$uncontrolled $p"
done
n_projects=$(kubectl get appproject -n argocd -o name 2>/dev/null | sed 's|.*/||' | grep -c '^aegis-tenant-')
if [[ -n "$uncontrolled" ]]; then
    bad "tenant project(s) that CAN write their own routing:$uncontrolled"
else
    ok_if_measured "$n_projects" \
       "the $n_projects tenant projects have IngressRoute forbidden" \
       "the tenant AppProjects (#54)"
fi

# Two lists and one subtraction, and NOT a jsonpath filter on the label.
# The filter `labels.x != "value"` does not match when the label is
# ABSENT, which is precisely the case to detect: a route nobody labelled
# passed as good. Written that way on 2026-08-06 and discovered on the
# spot because the check was tested with a genuinely foreign route — the
# same Disease E, committed inside the Disease E detector.
# The label selector is resolved by the server and does not have that
# hole.
list_routes(){ kubectl get ingressroute -A "$@" --no-headers \
    -o custom-columns=X:.metadata.namespace,Y:.metadata.name 2>/dev/null \
    | awk '$1 ~ /^org-/ {print $1 "/" $2}' | sort; }
foreign=$(comm -23 <(list_routes) <(list_routes -l aegis.dev/part-of=aegis-organizaciones))
n_routes=$(list_routes | wc -l)
if [[ -n "$foreign" ]]; then
    bad "IngressRoute(s) in an organization namespace that the platform did not put there:"
    printf '    %s\n' $foreign
    note "prune is off (A19): a route older than the control survives the control coming into existence"
else
    ok_if_measured "$n_routes" \
       "the $n_routes organization routes belong to the platform" \
       "the IngressRoutes of the organization namespaces"
fi

# ── 6b. the edge ──────────────────────────────────────────────────
# It asks Cloudflare which hostnames EXIST and compares them with the
# ones derived from the contracts. It does not look at tofu's state on
# purpose: the state says what tofu believes, and the only reason to
# look is that they can differ (see aegis edge).
#
# It tells three results apart, not two: exists / missing / COULD NOT
# EVALUATE. The third is a notice and not approval.
heading "edge"
# Rule 5.1: through LIBEXEC and with a guard. Until today this was a
# relative path and the `case` had no branch for 127 (A1 of the
# register): with the command absent —renamed, moved, without
# permissions— the round did not say «I could not look», it said «no
# failures». Green out of blindness is the worst outcome for a
# monitoring tool: nobody investigates a green.
aegis_exec edge
case $? in
    0) : ;;
    1) failures=$((failures + 1)) ;;
    *) notices=$((notices + 1)) ;;   # aegis_exec already said WHY
esac

# ── 6c. that a push reaches Jenkins ───────────────────────────────
# The same failure mode as the edge, which is why it is next to it:
# there is no error, there is ABSENCE. A repo without a webhook still
# builds —when the multibranch's periodic scan runs— so the build
# eventually passes, late and with no visible relation to the push.
# Nobody reports it because nothing fails.
#
# Measured on 2026-08-05: two of the four repos with a job in Jenkins
# had no webhook. The init only creates it for the TWO of the bootstrap
# (make_repo_webhook, phase 15); everything added afterwards was left
# out (#32).
heading "CI webhooks"
aegis_exec webhook
case $? in
    0) : ;;
    1) failures=$((failures + 1)) ;;
    *) notices=$((notices + 1)) ;;
esac

# ── 6d. that the LAST push actually BUILT ─────────────────────────
#
# The check above looks at whether the webhook EXISTS. This one looks at
# whether it served, which is not the same thing, and the difference
# cost three builds on 2026-08-10.
#
# That day the same fix was pushed to four repos. All four reached
# GitHub. ONE built. The other three got 502s from Jenkins inside a
# 25-second window, and GitHub DOES NOT RETRY a failed delivery: the
# push is left delivered on git's side and unbuilt on CI's side. The
# "CI webhooks" section was giving green for all five repos while it was
# happening, and it was right — the webhooks were there.
#
# WHY THE CODE OF THE LAST DELIVERY IS NOT LOOKED AT, which would be the
# obvious thing: because it measures the plumbing. A push may fail to
# build because of a downed webhook, a disabled job, an unindexed
# multibranch, or something that has not happened yet. What matters is
# the invariant:
#
#     every commit on main of a repo with a job has a build
#
# So the HEAD of main is compared against the revision Jenkins actually
# checked out in its last build. If they differ, there was a push that
# did not build — whatever the cause.
#
# WITH A MARGIN, because a build takes time: a HEAD from less than
# AEGIS_BUILD_GRACE minutes ago may still be queued, and flagging it
# would be a false positive every time somebody pushes.
heading "every push built"
push_output=$(AEGIS_PLATFORM="$PLATFORM_DIR" \
              GRACE="${AEGIS_BUILD_GRACE:-15}" python3 - <<'PYEOF'
import json, os, re, subprocess, sys, datetime

PLATFORM = os.environ["AEGIS_PLATFORM"]
GRACE = int(os.environ.get("GRACE", "15"))
VALUES = os.path.join(PLATFORM, "k8s", "base", "platform", "jenkins", "values.yaml")

try:
    text = open(VALUES, encoding="utf-8").read()
except OSError as e:
    print(f"NOT EVALUATED: could not read Jenkins' values.yaml ({e})"); sys.exit(2)

# job -> (owner, repo). From the SAME file that aegis-webhook and the CI
# quota use: a new repo enters on its own, without touching this script.
jobs = re.findall(
    r"multibranchPipelineJob\('([^']+)'\).*?repoOwner\('([^']+)'\)\s*\n\s*repository\('([^']+)'\)",
    text, re.S)
if not jobs:
    print("NOT EVALUATED: no multibranch job in the values.yaml"); sys.exit(2)

def jenkins(cmd):
    r = subprocess.run(["kubectl", "exec", "-n", "jenkins-system", "jenkins-0",
                        "-c", "jenkins", "--", "sh", "-lc", cmd],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""

problems, ok = [], []
for job, owner, repo in jobs:
    r = subprocess.run(["gh", "api", f"repos/{owner}/{repo}/commits/main",
                        "--jq", ".sha + \" \" + .commit.committer.date"],
                       capture_output=True, text=True)
    if r.returncode != 0 or not r.stdout.strip():
        problems.append((job, f"could not read the HEAD of {owner}/{repo} on GitHub"))
        continue
    sha, date = r.stdout.split()
    age = (datetime.datetime.now(datetime.timezone.utc)
           - datetime.datetime.fromisoformat(date.replace("Z", "+00:00"))
           ).total_seconds() / 60.0

    base = f"/var/jenkins_home/jobs/{job}/branches/main/builds"
    n = jenkins(f"ls -1 {base} 2>/dev/null | grep -E '^[0-9]+$' | sort -n | tail -1")
    if not n:
        problems.append((job, "no build at all on the main branch"))
        continue
    rev = jenkins(f"grep -am1 'Checking out Revision' {base}/{n}/log 2>/dev/null "
                  f"| sed -E 's/.*Revision ([0-9a-f]{{40}}).*/\\1/'")
    if not rev:
        problems.append((job, f"build #{n} does not say which revision it checked out"))
        continue
    if rev == sha:
        ok.append(f"{job} #{n} = {sha[:8]}")
    elif age < GRACE:
        ok.append(f"{job} {sha[:8]} from {age:.0f} min ago — within the grace period ({GRACE})")
    else:
        problems.append((job, f"HEAD {sha[:8]} from {age/60:.1f} h ago UNBUILT "
                              f"(the last build, #{n}, took {rev[:8]})"))

for j, m in problems:
    print(f"BAD: {j}: {m}")
# The per-repo detail goes as a NOTE —it is the backing for the claim,
# not the claim— and the section's verdict is ONE line. Before, each
# repo came out as GOOD: and the section's ✓ was put there by bash
# looking at the rc: two sources of truth for the same judgement, and
# bash's went mute if this blew up.
for x in ok:
    print(f"NOTE: {x}")
if not problems:
    print(f"GOOD: the {len(jobs)} repos with a job have their last push on main built")
sys.exit(1 if problems else 0)
PYEOF
)
dispatch $? "$push_output" "that every push on main has built"

# ── 7. the AI substrate ───────────────────────────────────────────
# It is not a pass/fail: `cerrado` mode with the engine at 0 is the
# CORRECT state at rest. It is reported so that the operator can see
# whether something was left switched on from yesterday (which costs
# VRAM and money, and is what one wants to notice on coming back).
heading "ai"
mode=$(kubectl get cm ai-modo -n ai-system -o jsonpath='{.data.modo}' 2>/dev/null)
reason=$(kubectl get cm ai-modo -n ai-system -o jsonpath='{.data.motivo}' 2>/dev/null)
reps=$(kubectl get deploy engine-llm -n ai-system -o jsonpath='{.spec.replicas}' 2>/dev/null)
if [[ -z "$mode" ]]; then
    notice "there is no ai-modo ConfigMap (is ai-system undeployed?)"
else
    ok "mode=$mode · engine=${reps:-?} replica(s)${reason:+ · \"$reason\"}"
    [[ "$mode" == "cerrado" && "${reps:-0}" != "0" ]] \
        && notice "cerrado mode but the engine is NOT at 0 — the controller did not reconcile"
fi
if command -v nvidia-smi >/dev/null 2>&1; then
    note "VRAM: $(nvidia-smi --query-gpu=memory.used,memory.total --format=csv,noheader 2>/dev/null)"
fi

# ── 8. the backups ────────────────────────────────────────────────
#
# It does NOT look at whether the mechanism exists: it looks at whether
# THERE ARE BUNDLES and how old they are.
#
# The distinction is the whole point. `aegis state backup` has existed
# since the very beginning, it is documented in OPERAR.md and in
# AGENTS.md, and on 2026-08-09 it was discovered that it had NEVER been
# run: zero .age files on the whole machine. That the script exists does
# not tell "there is a backup" apart from "one was never made", and
# since the repo names it, we were all reading the first one.
#
# There are TWO halves and both are needed: `state` brings the secrets,
# the init's trace and the edge's tfstate; `data` brings the tenants'
# databases and objects. With only one of them you get up either an
# empty platform, or a dump nobody knows where to put.
#
# And since 2026-08-11 the question changed, because the backup was
# split per organization. It used to be "is there a data bundle?" — ONE
# question, ONE answer. Now the honest question is "does EACH
# organization have a backup?", and that is not answered by looking at
# whether some .age exists: an organization created yesterday has no
# folder, the tree still has fresh files from the others, and the green
# would come out all the same.
#
# That is why the organizations are ENUMERATED from the contracts (the
# same source aegis-data uses) and one bundle per organization is
# demanded. With a single project, a correct check and a lying one give
# the same green; with two, the lying one starts to lie. It is written
# properly now.
heading "backups"
BACKUPS="${AEGIS_BACKUPS:-$HOME/aegis-backups}"
THRESHOLD_H=${AEGIS_BACKUP_HOURS:-48}
ROOT_P="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# bundle_age <glob-pattern> -> prints "<age_h> <bytes> <basename>" of the
# newest one, or nothing if there is none.
bundle_age() {
    local u; u=$(ls -t $1 2>/dev/null | head -1) || true
    [[ -n "$u" ]] || return 1
    printf '%s %s %s\n' \
        "$(( ( $(date +%s) - $(stat -c %Y "$u") ) / 3600 ))" \
        "$(stat -c %s "$u")" "$(basename "$u")"
}

if [[ ! -d "$BACKUPS" ]]; then
    bad "the backups directory does not exist ($BACKUPS) — there is not a single bundle"
else
    # (a) the destination disk is the one that was noted down. If the
    #     second disk is not mounted, this path is an empty directory on
    #     the root disk and the backups would be landing on the very
    #     disk they are meant to survive.
    MARK="$BACKUPS/.aegis-destino"
    if [[ -f "$MARK" ]]; then
        expected=$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("uuid",""))' "$MARK" 2>/dev/null)
        current=$(findmnt -no UUID --target "$BACKUPS" 2>/dev/null)
        if [[ -n "$expected" && "$expected" != "$current" ]]; then
            bad "the backup destination is NOT the disk that was noted down (expected $expected, there is ${current:-none}) — is the disk unmounted? the bundles would land on the root disk"
        else
            ok "destination on the disk that was noted down (fs ${current:-?})"
        fi
    else
        notice "no $MARK: nobody noted down which disk the backups live on (the first capture writes it)"
    fi

    # (b) the platform's STATE: one only, it belongs to nobody in particular.
    if reading=$(bundle_age "$BACKUPS/platform/aegis-state-*.age"); then
        read -r e_h e_b e_n <<<"$reading"
        if (( e_h > THRESHOLD_H )); then
            notice "platform/state: ${e_h}h (threshold ${THRESHOLD_H}h) — $e_n"
        else
            ok "platform/state: ${e_h}h, ${e_b} bytes · $e_n"
        fi
    else
        bad "no STATE bundle in $BACKUPS/platform/ — with only the data you have a dump nobody knows where to put"
    fi

    # (c) and one per organization, ENUMERATED from the contracts.
    mapfile -t ORGS < <(python3 - "$ROOT_P/orgs" <<'PYEOF'
import os, sys, yaml
d = sys.argv[1]
if not os.path.isdir(d):
    print("\x01the contracts directory %s does not exist — I do not know who to demand a backup from" % d)
    sys.exit(0)
for f in sorted(os.listdir(d)):
    if not f.endswith(".yaml"):
        continue
    try:
        c = yaml.safe_load(open(os.path.join(d, f), encoding="utf-8")) or {}
    except Exception as e:
        # A bare `continue` here was the worst silence in the file: the
        # organization DISAPPEARS from the list, no bundle is demanded
        # of it, and since it also lowers the number of subjects, the
        # remaining ones keep looking fine. Nobody finds out that there
        # is one without a backup.
        print("\x01%s does not parse (%s) — if that organization declares data, "
              "nobody is demanding a backup of it" % (f, type(e).__name__))
        continue
    org = c.get("organizacion") or c.get("nombre")
    # only the ones that DECLARE data: an organization of pure static
    # has nothing to back up, and demanding a bundle of it would be a
    # permanent red, which switches the signal off just as much as an
    # absence does.
    has = any((s or {}).get("tipo") == "postgres" for s in c.get("servicios") or []) \
          or bool((c.get("almacenamiento") or {}).get("bucket"))
    if org and has:
        print(org)
PYEOF
)
    # The lines with \x01 at the front are complaints from the
    # enumerator, not organizations. They are set aside BEFORE counting:
    # if they entered the list, a bundle would be demanded of a name
    # that does not exist.
    COMPLAINTS=(); CLEAN=()
    for l in "${ORGS[@]}"; do
        if [[ "$l" == $'\x01'* ]]; then COMPLAINTS+=("${l#$'\x01'}"); else CLEAN+=("$l"); fi
    done
    ORGS=("${CLEAN[@]}")
    for q in "${COMPLAINTS[@]}"; do
        notice "COULD NOT EVALUATE: $q"
    done
    if (( ${#ORGS[@]} == 0 && ${#COMPLAINTS[@]} == 0 )); then
        notice "no contract declares data: there is no tenant backup to demand (is that expected?)"
    fi
    for org in "${ORGS[@]}"; do
        if reading=$(bundle_age "$BACKUPS/org-$org/aegis-datos-org-$org-*.age"); then
            read -r o_h o_b o_n <<<"$reading"
            if (( o_h > THRESHOLD_H )); then
                notice "org-$org: ${o_h}h (threshold ${THRESHOLD_H}h) — $o_n"
            else
                ok "org-$org: ${o_h}h, ${o_b} bytes · $o_n"
            fi
        else
            bad "org-$org declares data and does NOT have a single bundle in $BACKUPS/org-$org/"
        fi
    done

    # (d) and what is left over: an org-* folder without a contract is a
    #     decommissioned organization whose safekeeping stayed there. It
    #     is not deleted —A19: removing from git does not remove from
    #     disk— but it is said.
    for d in "$BACKUPS"/org-*/; do
        [[ -d "$d" ]] || continue
        n=$(basename "$d"); n=${n#org-}
        printf '%s\n' "${ORGS[@]}" | grep -qxF "$n" \
            || notice "$(basename "$d")/ has backups and no contract declares it — a decommissioned organization?"
    done

    # (e) THE COPY THAT IS NOT IN THIS HOUSE. Everything above measures
    #     a disk that burns with the machine, and until 2026-08-29 the
    #     only thing said about the other half was a notice on an
    #     environment variable — a check on whether a MECHANISM was
    #     configured, which is the same mistake §8 opens by describing:
    #     that `aegis state backup` existed and had never been run.
    #
    #     So it is asked, not assumed. `remote status` reaches the
    #     destination and reports ages; its rc 2 is a destination that
    #     could NOT be reached, which is not a destination with no
    #     backup — reporting the two alike sends the operator looking
    #     for a bundle that is probably there, behind a network that
    #     is down.
    #
    #     And the threshold is the CADENCE THAT WAS SET, exported by
    #     the same command, not the 48h this section uses for the local
    #     disk: an instance whose clock says 6h is late long before one
    #     whose clock says 24h.
    remote_out="$(aegis_exec data remote status 2>/dev/null)"; rc=$?
    if (( rc == 2 )); then
        notice "COULD NOT EVALUATE the off-site copy: the destination did not answer, or the command is not there. It is NOT that there is none — \`${AEGIS_CMD:-aegis} data remote list\` says which of the two"
    elif (( rc != 0 )); then
        bad "the off-site destination has no credential in the store: every bundle above lives ONLY on this machine (\`${AEGIS_CMD:-aegis} data remote adopt\`)"
    else
        while IFS= read -r l; do
            case "$l" in
                B*) bad "${l#B}" ;;
                *)  ok  "${l#O}" ;;
            esac
        done < <(REMOTE_OUT="$remote_out" python3 - <<'PYCHK'
import os, re, time
txt = os.environ["REMOTE_OUT"]
now = time.time()
m = re.search(r"^aegis_backup_remote_cadence_seconds (\d+)", txt, re.M)
cad = int(m.group(1)) if m else 86400
ages = re.findall(r'^aegis_backup_remote_timestamp_seconds\{org="([^"]*)"\} (\d+)', txt, re.M)
if not ages:
    print("Bthe destination answered and carries NOT ONE copy: the data of this "
          "instance lives in exactly one place")
for org, ts in sorted(ages):
    h = (now - int(ts)) / 3600.0
    if (now - int(ts)) > 2 * cad:
        print("Borg-%s off-site: %.1fh old, past two runs of a %.0fh clock" % (org, h, cad / 3600.0))
    else:
        print("Oorg-%s off-site: %.1fh (clock %.0fh)" % (org, h, cad / 3600.0))
PYCHK
        )
    fi
fi

# ── 9. observability watches itself ───────────────────────────────
#
# Until 2026-08-22 this file had ZERO mentions of vmalert, vmagent,
# vlogs, grafana, alertmanager, ntfy or blackbox: the whole validation
# of the stack lived in phase 85's gates, which run ONCE, at start-up.
# It was verified that observability had been mounted properly; never
# that it kept working.
#
# That day trivy's CronJob had been failing for 30 h, vmalert was not
# reloading its rules and vmagent could not even restart — with every
# gate of phase 85 green for two days, because they had been true at the
# moment they ran.
#
# It is measured by EFFECT and from outside, not by asking each pod
# whether it is happy: are there fresh metrics?, are the rules git
# declares LOADED?, are the declared targets being scraped?
heading "observability"

_svc_ip() { # the real ClusterIP, or the endpoint's if the Service is headless
    local ns=$1 sv=$2 ip
    ip=$(kubectl get svc -n "$ns" "$sv" -o jsonpath='{.spec.clusterIP}' 2>/dev/null)
    [[ -n "$ip" && "$ip" != "None" ]] || \
        ip=$(kubectl get endpoints -n "$ns" "$sv" -o jsonpath='{.subsets[0].addresses[0].ip}' 2>/dev/null)
    printf '%s' "$ip"
}
_svc_port() { kubectl get svc -n "$1" "$2" -o jsonpath='{.spec.ports[0].port}' 2>/dev/null; }

VM_IP=$(_svc_ip observability vmsingle); VM_PT=$(_svc_port observability vmsingle)
if [[ -z "$VM_IP" || -z "$VM_PT" ]]; then
    notice "COULD NOT EVALUATE: I did not find the vmsingle Service — the rest of this section means nothing"
else
  _vm() { curl -s --max-time 10 "http://$VM_IP:$VM_PT/api/v1/query" --data-urlencode "query=$1" 2>/dev/null; }
  _vm_num() { _vm "$1" | python3 -c 'import sys,json
try:
    d=json.load(sys.stdin)["data"]["result"]
    print(int(float(d[0]["value"][1])) if d else "")
except Exception:
    print("")' 2>/dev/null; }

  # (a) does the metrics database have FRESH data? Without this, every
  #     panel and every alert is looking at a dead file and does not say
  #     so.
  fresh=$(_vm_num 'count(count by (job) (up))')
  if [[ -z "$fresh" ]]; then
      bad "vmsingle does not answer queries — the platform is blind and the alerts cannot be evaluated"
  else
      ok_if_measured "$fresh" "$fresh scrape jobs with fresh metrics" \
                   "the targets vmagent is scraping"
      # (b) targets down RIGHT NOW. The alert exists, but the round
      #     cannot depend on somebody looking at their phone.
      down=$(_vm_num 'count(up == 0)')
      [[ -n "$down" && "$down" -gt 0 ]] \
          && bad "$down scrape target(s) down: whatever they measure is mute, not green"
  fi

  # (c) THE RULES FROM GIT ARE LOADED. This is the check that did not
  #     exist and would have caught vmalert's vice: a rule that is
  #     committed and synced DOES NOT EXIST until vmalert re-reads it.
  #     ArgoCD says «Synced» all the same, and the alert is simply not
  #     there.
  declared=$(kubectl get cm -n observability vmalert-reglas -o json 2>/dev/null \
      | python3 -c 'import sys,json,re
try:
    d=json.load(sys.stdin)["data"]
    print(sum(len(re.findall(r"^\s*- alert:", v, re.M)) for v in d.values()))
except Exception:
    print("")' 2>/dev/null)
  VA_IP=$(_svc_ip observability vmalert); VA_PT=$(_svc_port observability vmalert)
  loaded=""
  [[ -n "$VA_IP" && -n "$VA_PT" ]] && loaded=$(curl -s --max-time 10 \
      "http://$VA_IP:$VA_PT/api/v1/rules" 2>/dev/null | python3 -c 'import sys,json
try:
    g=json.load(sys.stdin)["data"]["groups"]
    print(sum(len(x.get("rules",[])) for x in g))
except Exception:
    print("")' 2>/dev/null)
  if [[ -z "$declared" || -z "$loaded" ]]; then
      notice "COULD NOT EVALUATE: I could not contrast the rules from git against the ones vmalert has loaded"
  elif [[ "$declared" != "$loaded" ]]; then
      bad "git declares $declared alerts and vmalert has $loaded loaded"
      note "a rule that is not loaded DOES NOT EXIST, and ArgoCD says Synced all the same"
  else
      ok_if_measured "$loaded" "the $loaded alerts from git are loaded in vmalert" \
                   "the declared rules against the loaded ones"
  fi

  # (d) the probes aegis-org derives from the contracts. An
  #     organization with a domain and without a probe was born blind
  #     all over again.
  with_domain=$(grep -lE '^dominio:' "$ROOT_P"/orgs/*.yaml 2>/dev/null | wc -l)
  # `or vector(0)`: with no tenant declaring a domain there is no probe
  # series at all, count() of nothing is NO series, and the round used
  # to say "could not evaluate" about a measurement that is simply 0
  # (first clean instance, 2026-08-27)
  probes=$(_vm_num 'count(count by (job) (probe_success{job=~"sitio-.*"})) or vector(0)')
  if [[ -z "$probes" ]]; then
      notice "COULD NOT EVALUATE: I could not count the tenant probes"
  elif [[ "$with_domain" -eq 0 ]]; then
      # zero contracts with a domain is a MEASURED zero, not a blind one
      notice "no organization declares a domain yet: nothing to probe (0 contracts with dominio: in orgs/)"
  elif [[ "$with_domain" -gt 0 && "$probes" -lt "$with_domain" ]]; then
      bad "$with_domain organization(s) with a domain and only $probes probe(s): one of them was born unwatched"
      note "they are derived by ${AEGIS_CMD:-aegis} org apply → k8s/base/observability/vmagent/values.yaml"
  else
      ok_if_measured "$probes" "the $probes public organizations have a probe" \
                   "the probes derived from the contracts"
  fi

  # (e) the channel. It is not tested by sending a message (that would
  #     dirty the operator's topic on every run): it is verified that
  #     the chain is WHOLE and that the heartbeat keeps beating — if the
  #     deadman stopped firing, some link got cut.
  AM_IP=$(_svc_ip observability alertmanager); AM_PT=$(_svc_port observability alertmanager)
  heartbeat=""
  [[ -n "$AM_IP" && -n "$AM_PT" ]] && heartbeat=$(curl -s --max-time 10 \
      "http://$AM_IP:$AM_PT/api/v2/alerts" 2>/dev/null | python3 -c 'import sys,json
try:
    print(sum(1 for a in json.load(sys.stdin) if a["labels"].get("alertname")=="DeadmanAegis"))
except Exception:
    print("")' 2>/dev/null)
  if [[ -z "$heartbeat" ]]; then
      notice "COULD NOT EVALUATE: Alertmanager did not answer — I do not know whether the alert chain is alive"
  elif [[ "$heartbeat" -eq 0 ]]; then
      bad "the DeadmanAegis heartbeat did not reach Alertmanager: the alert chain is cut"
      note "its value is its ABSENCE — if it is missing, no other alert is going to arrive either"
  else
      ok "the heartbeat reaches Alertmanager: the vmalert→AM chain is alive"
  fi

  # (f) WHAT IS RUNNING — did anybody scan it? The `scan` and `sign`
  #     stages of the template tolerate the trivy-server or the cosign
  #     key not existing (phases 50-70 of start-up) and stay GREEN. The
  #     tolerance is fine; that it was invisible with the platform
  #     already standing, is not: `scan_skipped:true` travelled in the
  #     event, was kept for a year, and nobody ever read it.
  #
  #     From today the build pushes the measurement, the
  #     ImagenSinEscaneo alert reads it and this block crosses it
  #     against what is DEPLOYED — which is the question neither the
  #     panel nor the alert can ask: they only see the images that were
  #     built at some point.
  #
  #     The three outcomes, kept apart:
  #       · the last build skipped the scan  → failure
  #       · deployed and with no measurement → COULD NOT EVALUATE
  #       · measured and scanned             → green
  #     Only the ones from the INTERNAL registry: they are the ones one
  #     of our two pipelines produces and therefore the only ones it
  #     makes sense to demand a measurement of. A public image from a
  #     third-party chart is not scanned by aegis and asking it for a
  #     metric would be inventing a permanent yellow. The registry host
  #     is DERIVED from the Service, it is not written here.
  REG_HOST=$(kubectl get svc -n registry-system registry \
      -o jsonpath='{.metadata.name}.{.metadata.namespace}.svc' 2>/dev/null)
  deployed=""
  [[ -n "$REG_HOST" ]] && deployed=$(kubectl get pods -A \
      -o jsonpath='{range .items[*]}{range .spec.containers[*]}{.image}{"\n"}{end}{end}' 2>/dev/null \
      | grep -F "$REG_HOST" \
      | sed -E 's|^.*/||; s|[:@].*$||' | sort -u)
  measures=$(_vm 'last_over_time(aegis_build_scan_skipped[30d])' \
      | python3 -c 'import sys,json
try:
    for r in json.load(sys.stdin)["data"]["result"]:
        print(r["metric"].get("image",""), int(float(r["value"][1])))
except Exception:
    pass' 2>/dev/null)
  if [[ -z "$deployed" ]]; then
      notice "COULD NOT EVALUATE: I could not list the deployed images — I do not know what is running unscanned"
  else
      unscanned=""; no_measure=""; n_ok=0
      while read -r img; do
          [[ -n "$img" ]] || continue
          line=$(printf '%s\n' "$measures" | awk -v i="$img" '$1==i {print $2}')
          if [[ -z "$line" ]]; then no_measure="$no_measure $img"
          elif [[ "$line" == "1" ]]; then unscanned="$unscanned $img"
          else n_ok=$((n_ok+1)); fi
      done <<< "$deployed"
      if [[ -n "$unscanned" ]]; then
          bad "image(s) running whose last build SKIPPED the scan:$unscanned"
          note "rebuild them with the trivy-server alive; nothing tells them apart from a scanned one"
      fi
      [[ -n "$no_measure" ]] \
          && notice "COULD NOT EVALUATE: no build measurement (an image older than the metric, or from a pipeline that does not push it?):$no_measure"
      # The ✓ only if there is something to celebrate. ok_if_measured
      # does NOT go here: every deployed image falls into exactly one of
      # the three buckets (scanned / unscanned / no measurement), so
      # with a non-empty list at least one line always comes out —
      # silence is impossible by construction. Putting the helper in
      # anyway would mean that with n_ok=0 the same fact got reported
      # TWICE, and a repeated notice reads like two problems.
      [[ "$n_ok" -gt 0 ]] \
          && ok "$n_ok deployed image(s) with their last build scanned"
  fi

  #     ...and did anybody scan it AGAIN? The round above answers for
  #     the BUILD: the image went through Trivy the day it was pushed.
  #     It says nothing about the CVEs published since. image-watch
  #     (Jenkins, once a day) re-scans every mirrored image against
  #     today's DB and leaves a heartbeat; a run that dies leaves none.
  #     The same four outcomes, and the seams matter:
  #       · heartbeat in the last 2d and no fixable CVE → green
  #       · heartbeat in the last 2d and fixable CVEs   → failure
  #       · no heartbeat in 2d but one in 30d           → failure: the
  #         watch STOPPED (that is ImageWatchSilent, seen from here)
  #       · no heartbeat in 30d either                  → COULD NOT
  #         EVALUATE: never ran, or the cron is older than the window
  #     The [2d] is 2 × the job's period (check 092 §8's floor): with
  #     [1d] one late run reads as silence. The second query, at [30d],
  #     exists so that «stopped» and «never» do not print the same line:
  #     the alert cannot tell them apart, this round can.
  hb=$(_vm_num 'last_over_time(aegis_image_watch_timestamp_seconds[2d])')
  if [[ -z "$hb" ]]; then
      hb30=$(_vm_num 'last_over_time(aegis_image_watch_timestamp_seconds[30d])')
      if [[ -n "$hb30" ]]; then
          bad "image-watch STOPPED: its last heartbeat is $(( ($(date +%s) - hb30) / 86400 )) day(s) old — what is running has not been re-scanned since"
          note "the cron is gone from job-dsl, the job is broken, or vmsingle rejected the push: read the image-watch console"
      else
          notice "COULD NOT EVALUATE: image-watch has never run (or its heartbeat is older than 2 days) — nothing on this instance has re-scanned what it serves"
      fi
  else
      age_h=$(( ($(date +%s) - hb) / 3600 ))
      if [[ "$age_h" -gt 48 ]]; then
          bad "image-watch's heartbeat is ${age_h}h old: the daily run is missing"
      else
          fixable=$(_vm 'sum by (image) (last_over_time(aegis_image_fixable_vulns[2d])) > 0' \
              | python3 -c 'import sys,json
try:
    for r in json.load(sys.stdin)["data"]["result"]:
        print(r["metric"].get("image","?") + "=" + str(int(float(r["value"][1]))))
except Exception:
    pass' 2>/dev/null | sort | tr '\n' ' ')
          could_not=$(_vm 'last_over_time(aegis_image_watch_failed[2d]) == 1' \
              | python3 -c 'import sys,json
try:
    for r in json.load(sys.stdin)["data"]["result"]:
        print(r["metric"].get("image","?"))
except Exception:
    pass' 2>/dev/null | sort | tr '\n' ' ')
          if [[ -n "$fixable" ]]; then
              bad "image-watch ran ${age_h}h ago and found fixable CVE(s) against today's DB: ${fixable% }"
              note "for an aegis-base-* the loop already tried a rebuild; for a third party read UpstreamFixAvailable (crane digest on the upstream tag)"
          else
              ok "image-watch ran ${age_h}h ago: nothing running has a fixable CVE against today's DB"
          fi
          # A zero the watch could not measure is not a zero. It is
          # reported as its own line so that the ✓ above never covers
          # it: «COULD NOT EVALUATE ≠ clean».
          [[ -n "$could_not" ]] \
              && notice "COULD NOT EVALUATE: image-watch could not scan ${could_not% } — their fixable count is not a measurement"
      fi
  fi
fi

# ── verdict ───────────────────────────────────────────────────────
printf '\n'
if [[ $failures -gt 0 ]]; then
    printf '%s%d failure(s)%s, %d notice(s)\n' "$red" "$failures" "$reset" "$notices"
    exit 1
fi
printf '%sno failures%s, %d notice(s)\n' "$green" "$reset" "$notices"
exit 0
