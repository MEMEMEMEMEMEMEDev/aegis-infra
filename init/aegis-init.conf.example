# aegis-init.conf.example — REFERENCE ONLY, for automation.
# THE NORMAL PATH IS NOT THIS FILE: init runs a guided wizard
# (it asks field by field, with defaults and validation) and
# writes aegis-init.conf by itself. Use this example only to
# pre-arm a non-interactive re-run.
# Regenerate interactively: aegis init --configure
#
# All T1: domains, names, public IDs. ZERO secrets.
# How the platform is reached from outside. It decides which of the
# variables below are used, and no phase asks "which profile am I":
#   cloudflare — a zone of yours, the tunnel and Access in front.
#   local      — no zone and no tunnel: a bridge on the host, names
#                through sslip.io, TLS from aegis' own internal CA.
EDGE="cloudflare"
# Address the host bridge listens on, EDGE=local only (empty under
# cloudflare). 127.0.0.1 = reachable from this machine or an SSH
# tunnel; a LAN address exposes it to the network:
EDGE_BIND_IP=""
GH_OWNER="mi-org"
# Work repos the init CREATES under GH_OWNER and then OWNS
# (commits, tags, settings, webhooks): new names, never repos
# already used for something else:
PLATFORM_REPO="aegis-platform"
APP_REPO="aegis-canary"
ROOT_DOMAIN="example.com"                # cloudflare: an active zone
                                         # local: <ip-with-dashes>.sslip.io
ACME_EMAIL="operador@example.com"        # contact email (CF account email under cloudflare)
KUBE_CONTEXT_EXPECTED="default"          # k3s default context
REGISTRY_CLUSTER_IP="10.43.179.123"      # in 10.43.0.0/16; paired
                                         # with the cert's SAN
AEGIS_WORKSPACE="$HOME/aegis"
# Cloudflare IDs (public, 32 hex): dash.cloudflare.com → your zone
# → Overview → right-hand column, "API" section.
# With EDGE=local both stay EMPTY, and the validation demands it:
CF_ACCOUNT_ID=""
CF_ZONE_ID=""
# Whether this instance carries the AI subsystem (phase 87).
#   no   the instance does not carry it: the phase skips with its
#        reason written and its gates stay without a subject.
#   cpu  gateway, controller and the small engine. No card needed.
#   gpu  the whole subsystem. It needs an NVIDIA card, its driver and
#        the container toolkit ON THIS HOST; phase 87 measures all
#        three and stops if they are not there.
# A value outside these three is NOT read as "no": the phase dies
# rather than guess which one was meant.
AI="no"
