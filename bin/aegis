#!/usr/bin/env bash
# aegis — the dispatcher.
#
# One door: `aegis <command> [args...]` executes libexec/aegis-<command>
# and passes it EVERYTHING else without looking at it. This file knows
# exactly three things: --help, --version and help. Any other flag
# belongs to the command, not to it — `aegis org apply --check` arrives
# at aegis-org intact.
#
# Three rules baked in, each with its bug behind it:
#
# 1. THE NAME COMES FROM argv[0]. $AEGIS_CMD is exported and every
#    message that names a command to the operator is built from it, never
#    as a literal. It is the class-level answer to the ~155 Class E
#    strings (docs/cli/inconsistencies.md): they are not translated one
#    by one, they are derived from one. If the binary is renamed
#    tomorrow, the messages follow. Check V-103 watches it.
#
# 2. LIBEXEC RESOLVES THROUGH SYMLINKS. Phase 05 installs
#    /usr/local/bin/aegis -> <product>/bin/aegis (a symlink and not a
#    copy, so a `git pull` of the product updates the CLI). With a plain
#    dirname, AEGIS_ROOT would be /usr/local and there would be neither
#    phases nor libs. If readlink is missing, it DIES with the reason —
#    it does not guess.
#
# 3. THE MENU IS DERIVED. There is no list of commands anywhere: each
#    libexec/aegis-*'s metadata is read. A command with no metadata does
#    not appear in the menu AND makes `aegis verify` fail (V-101). In v2
#    only 1 of 12 commands had anyone verifying it.
set -uo pipefail

export AEGIS_CMD="$(basename "$0")"

command -v readlink >/dev/null || {
    echo "$AEGIS_CMD: readlink is missing — I cannot tell where the product lives" >&2; exit 2; }
AEGIS_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
export AEGIS_ROOT
LIBEXEC="$AEGIS_ROOT/libexec"
export AEGIS_HOME="${AEGIS_HOME:-$( . "$AEGIS_ROOT/lib/paths.sh" >/dev/null 2>&1; printf '%s' "$AEGIS_HOME" )}"

# ── a command's metadata ─────────────────────────────────────────────
# In the first 20 lines, so reading it is cheap and so it sits at the top
# where it can be seen.
meta() { sed -n "1,20{s/^# $1:[[:space:]]*//p}" "$2" | head -1; }

version() {
    if git -C "$AEGIS_ROOT" rev-parse --git-dir >/dev/null 2>&1; then
        git -C "$AEGIS_ROOT" describe --tags --always --dirty 2>/dev/null && return 0
    fi
    [[ -f "$AEGIS_ROOT/VERSION" ]] && { cat "$AEGIS_ROOT/VERSION"; return 0; }
    echo "unknown (neither a git repo nor a VERSION in $AEGIS_ROOT)"
}

menu() {
    printf '\033[1maegis\033[0m — self-hosted GitOps platform · %s\n\n' "$(version)"
    printf 'usage: %s <command> [subcommand] [options]\n' "$AEGIS_CMD"
    printf '       %s <command> --help    for the detail of each one\n\n' "$AEGIS_CMD"
    # The group order is the design's (docs/cli/design.md §4): first what
    # is done once, then what is done every day.
    for g in setup apps operate infra backup dev; do
        local shown=false
        for f in "$LIBEXEC"/aegis-*; do
            [[ -f "$f" ]] || continue
            [[ "$(meta aegis-group "$f")" == "$g" ]] || continue
            [[ "$(meta aegis-hidden "$f")" == "true" ]] && continue
            $shown || { printf '\033[1m%s\033[0m\n' "$g"; shown=true; }
            printf '  %-12s %s\n' "${f##*/aegis-}" "$(meta aegis-summary "$f")"
        done
        $shown && echo
    done
    printf 'exit codes: 0 done or already so · 1 missing or wrong ·\n'
    printf '            2 COULD NOT EVALUATE · 3 invalid usage\n'
}

# ── dispatch ─────────────────────────────────────────────────────────
case "${1:-}" in
    ""|help|--help|-h) menu; exit 0 ;;
    --version|-V)      version; exit 0 ;;
    -*) echo "$AEGIS_CMD: '$1' is not a command (flags belong to the command, not the dispatcher)" >&2
        echo "try: $AEGIS_CMD --help" >&2; exit 3 ;;
esac

CMD="$1"; shift
TARGET="$LIBEXEC/aegis-$CMD"

if [[ ! -e "$TARGET" ]]; then
    # Suggestions by similarity: a typo does not deserve a wall. They are
    # derived from what EXISTS, not from a list.
    SIMILAR="$(for f in "$LIBEXEC"/aegis-*; do
                     [[ -f "$f" ]] || continue
                     n="${f##*/aegis-}"
                     [[ "$n" == *"$CMD"* || "$CMD" == *"$n"* || "${n:0:2}" == "${CMD:0:2}" ]] && printf '%s ' "$n"
                 done)"
    echo "$AEGIS_CMD: '$CMD' is not a command." >&2
    [[ -n "$SIMILAR" ]] && echo "similar: $SIMILAR" >&2
    echo "the full menu: $AEGIS_CMD --help" >&2
    exit 2
fi
if [[ ! -x "$TARGET" ]]; then
    # 126 would be "Permission denied" and would send you chasing ghosts.
    # The real reason fits in one line, and so does the fix.
    echo "$AEGIS_CMD: $TARGET exists but is not executable — chmod +x $TARGET" >&2
    exit 2
fi
exec "$TARGET" "$@"
