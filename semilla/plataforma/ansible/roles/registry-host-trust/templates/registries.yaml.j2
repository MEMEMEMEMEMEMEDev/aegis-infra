# /etc/rancher/k3s/registries.yaml — mirror del registry interno.
# ClusterIP FIJA ({{ registry_cluster_ip }}) pareada con el SAN
# ipAddresses del cert (A24/A30). Renderizado por Ansible; no editar
# a mano.
mirrors:
  "registry.registry-system.svc.cluster.local:{{ registry_port }}":
    endpoint:
      - "https://{{ registry_cluster_ip }}:{{ registry_port }}"
configs:
  "{{ registry_cluster_ip }}:{{ registry_port }}":
    tls:
      ca_file: /etc/rancher/k3s/aegis-ca.pem
