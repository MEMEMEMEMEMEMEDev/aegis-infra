variable "github_pat" {
  description = "Fine-grained PAT (Administration RW, Contents RW, Metadata R, Webhooks RW). Wrapper-only, sin default (A14). EXPIRA: anotar fecha en Bitwarden (issue-github-token.md)."
  type        = string
  sensitive   = true
}

variable "github_argocd_webhook_secret" {
  description = "HMAC compartido webhook GitHub->ArgoCD. Mismo origen que el Secret KSOPS github-webhook (generados JUNTOS en fase 15 — A27)."
  type        = string
  sensitive   = true
}

variable "github_owner" {
  type = string
}

variable "platform_repo_name" {
  type    = string
  default = "ops-stack"
}

variable "root_domain" {
  type = string
}
