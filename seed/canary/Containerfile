# Canary v2 — builder pinned to a SUPPORTED LINE (A42: the toolchain
# pin ages; Trivy's scan watches it and blocks).
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod main.go ./
RUN CGO_ENABLED=0 go build -o /hello-aegis .

FROM docker.io/library/alpine:3.21
COPY --from=build /hello-aegis /usr/local/bin/hello-aegis
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/hello-aegis"]
