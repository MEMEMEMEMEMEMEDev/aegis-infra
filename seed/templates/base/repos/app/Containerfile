# __ORG__-app — builder pinned to a SUPPORTED LINE (the toolchain pin
# ages; the pipeline's Trivy scan watches it and blocks when it piles
# up CVEs — that red build is the signal to bump it here).
FROM docker.io/library/golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod main.go ./
RUN CGO_ENABLED=0 go build -o /app .

FROM docker.io/library/alpine:3.21
COPY --from=build /app /usr/local/bin/app
# Non-root ALWAYS: the organization's namespace is PSS restricted and a
# root container does not even get to start.
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/app"]
