# __ORG__-app — a node service: INSTALLED AND TESTED by the pipeline
# (ci/compile.sh, in the aegis-ci-node container), run on the node runtime
# that carries neither npm nor a shell. This file only copies the result.
#
# There is no build stage here on purpose, since 2026-10-02: it stood on
# node:22.23.1-alpine, which had to be mirrored before the template could be
# instantiated, and which the door retained on alpha-arch (its bundled npm
# carried CVEs past their window). The static template made the same move
# on 2026-09-30.
#
# WHY THE FROM IS A PLACEHOLDER. `aegis app new` resolves it against the
# INTERNAL registry when it instantiates, and writes the reference pinned
# by digest. An image pulled off the internet by tag is a mutable pointer
# inside the pipeline that afterwards signs the result, which is the hole
# mirror-images exists to close. And the digest cannot be computed here:
# the mirror rebuilds the manifest as it copies, so upstream's digest is
# not the one that pulls.
#
# WHY THE RUNTIME IS NOT aegis-base-node, which is what the platform's
# own backends moved to on 2026-08-27. Not a preference: that image is
# tagged `<alpine minor>-<build number>`, the number is born in each
# instance's registry, and `aegis image from` resolves an EXACT tag — so
# the seed has no tag to name. The README says which one line to change,
# and why it is worth changing once this repo has built once.
FROM __FROM_NODE__
# What this base guarantees, and what this file therefore assumes: uid
# 65532, node as the ENTRYPOINT (so the CMD below is a path and nothing
# else), and no shell and no npm anywhere in it. There is no RUN in this
# file and there cannot be one.
WORKDIR /app
# From the workspace the pipeline just installed, tested and pruned in.
# .dockerignore lets through only these.
COPY --chown=65532:65532 package.json package-lock.json ./
COPY --chown=65532:65532 node_modules ./node_modules
COPY --chown=65532:65532 src ./src
EXPOSE 8080
# Numeric and non-root: the namespace is PSS restricted, and a
# `USER name` fails runAsNonRoot because the kubelet cannot read the
# image's /etc/passwd to prove the name is not root 0.
USER 65532:65532
CMD ["/app/src/server.js"]
