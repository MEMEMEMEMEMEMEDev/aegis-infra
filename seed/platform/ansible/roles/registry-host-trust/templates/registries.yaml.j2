# /etc/rancher/k3s/registries.yaml — mirror of the internal registry.
# FIXED ClusterIP ({{ registry_cluster_ip }}) paired with the
# ipAddresses SAN of the cert (A24/A30). Rendered by Ansible; do not
# edit by hand.
mirrors:
  "registry.registry-system.svc.cluster.local:{{ registry_port }}":
    endpoint:
      - "https://{{ registry_cluster_ip }}:{{ registry_port }}"
configs:
  "{{ registry_cluster_ip }}:{{ registry_port }}":
    tls:
      ca_file: /etc/rancher/k3s/aegis-ca.pem
