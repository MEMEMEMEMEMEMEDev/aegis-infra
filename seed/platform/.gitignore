# tofu: providers and state NEVER reach the repo (run #4: git add -A
# dragged in a 233 MB .terraform/ — GitHub rejects it — and the
# tfstate, which can contain sensitive values).
# The .terraform.lock.hcl IS versioned (reproducibility of providers)
# — these patterns do not touch it.
**/.terraform/
*.tfstate
*.tfstate.backup
crash.log

# ansible's venv (regenerable from requirements.txt — phase 20):
ansible/.venv/
