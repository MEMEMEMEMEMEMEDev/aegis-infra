# aegis-ci-crane — crane (go-containerregistry) is DISTROLESS (no
# shell): Jenkins container(){ sh } cannot use it => extract the pinned
# official binary onto alpine (the aegis-ci-cosign pattern, A43/A49). It
# is used to PUSH the ALREADY scanned tar (scan-before-push) in the
# unprivileged build (W-05). Build: job 'ci-images' (jobs-as-code), NOT
# by hand. Pin = debt watched by the scan.
FROM gcr.io/go-containerregistry/crane:v0.20.3 AS crane
FROM alpine:3.22
COPY --from=crane /ko-app/crane /usr/local/bin/crane
RUN crane version
