# aegis-ci-cosign v2 — the official cosign is DISTROLESS (no shell):
# Jenkins container(){ sh } cannot use it => extract the pinned
# official binary onto alpine (the v1 pattern, A43/A49). Build: Jenkins
# job 'ci-images' (jobs-as-code), NOT by hand (settles 26 §16.9).
# Pin = debt watched by the scan (A42).
FROM ghcr.io/sigstore/cosign/cosign:v2.6.3 AS cosign
FROM alpine:3.22
COPY --from=cosign /ko-app/cosign /usr/local/bin/cosign
RUN cosign version
