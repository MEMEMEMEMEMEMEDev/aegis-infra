// ci-images — builds and pushes the CI tooling images to the internal
// registry. Job defined in JCasC job-dsl (D9).
//
// W-05: unprivileged build. kaniko (upstream, unprivileged) replaces
// buildah with its privileged mode, its vfs driver and its fuse device.
// kaniko extracts layers straight onto the FS (it does NOT perform the
// mounts that killed rootless buildah on Ubuntu 24.04); it runs as root
// inside the container, but the container is not a privileged one => it
// cannot escape to the node. The official tools (cosign, crane) are
// distroless (no shell) => they are extracted onto alpine (the
// aegis-ci-* pattern). There is NO scan here, so kaniko builds AND
// pushes directly. The pod declares EXPLICITLY what the push needs
// (regcred + CA). Strict RQ: every container carries limits.
pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:3355.v388858a_47b_33-23
    resources:
      requests: { cpu: 500m, memory: 512Mi }
      limits:   { cpu: 1000m, memory: 1Gi }
  # kaniko, unprivileged (W-05). Auth: regcred in kaniko's docker
  # config; the registry's own CA through --registry-certificate. -debug
  # ships a shell (container(){ sh }). No fuse device, no vfs, no
  # elevated privileges.
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    command: ['sleep', 'infinity']
    volumeMounts:
    - name: regcred
      mountPath: /kaniko/.docker/config.json
      subPath: .dockerconfigjson
      readOnly: true
    - name: ca-trust
      mountPath: /kaniko/ca.crt
      subPath: ca.crt
      readOnly: true
    resources:
      requests: { cpu: 500m, memory: 512Mi }
      limits:   { cpu: 1500m, memory: 2Gi }
  volumes:
  - name: regcred
    secret:
      secretName: regcred-internal
      items: [{ key: .dockerconfigjson, path: .dockerconfigjson }]
  - name: ca-trust
    secret:
      secretName: aegis-ca-trust
      items: [{ key: ca.crt, path: ca.crt }]
'''
      defaultContainer 'kaniko'
    }
  }
  environment {
    REGISTRY = 'registry.registry-system.svc.cluster.local:5000'
  }
  stages {
    stage('build+push tooling images') {
      steps {
        sh '''
          # SINGLE SOURCE of the pin: the FROM of each Containerfile →
          # the tag of the resulting image is DERIVED from it (no second
          # place to edit — the lesson of the duplicated pin).
          #
          # The capture is "everything up to the first space" and NOT
          # "a v followed by digits": node is versioned 22.23.1-alpine,
          # no v and with a suffix. With the old pattern the tag came
          # out EMPTY and the `test -n` below killed the build — which
          # at least failed loudly, but was of no use. The seed carried
          # that old pattern, and only built two of its four images,
          # until 2026-08-27: check 137 now demands that every
          # ci-images/*/Containerfile has its build_push here.
          build_push() {   # <subdir> <name> <FROM-pattern> [<tag-sed>]
            local dir="ci-images/$1" name="$2" pat="$3" expr="${4:-}" tag
            # The 4th argument exists for aegis-ci-tofu, whose version is
            # NOT in a FROM: the official OpenTofu image fails on purpose
            # when used as a base (opentofu#1931), so the binary is
            # downloaded verified and the version lives in an ARG.
            if [ -n "$expr" ]; then
              tag="$(sed -n "$expr" "$dir/Containerfile" | head -1)"
            else
              tag="$(sed -n "s|^FROM .*${pat}:\\([^ ]*\\).*|\\1|p" \
                     "$dir/Containerfile" | head -1)"
            fi
            test -n "$tag"
            echo "== ${name}:${tag} (kaniko, unprivileged) =="
            /kaniko/executor \
              --context="dir://${WORKSPACE}/${dir}" \
              --dockerfile=Containerfile \
              --destination="${REGISTRY}/${name}:${tag}" \
              --registry-certificate "${REGISTRY}=/kaniko/ca.crt"
          }
          build_push cosign aegis-ci-cosign cosign
          build_push crane  aegis-ci-crane  crane
          build_push node   aegis-ci-node   node
          build_push tofu   aegis-ci-tofu   tofu \
            's|^ARG TOFU_VERSION=\\(.*\\)|\\1|p'
        '''
      }
    }
  }
}
