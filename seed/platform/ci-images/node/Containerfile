# aegis-ci-node — node con git, para compilar sitios cuyas dependencias
# viven en repos git privados.
#
# La imagen oficial `node:*-alpine` NO trae git ni cliente ssh. El
# portafolio consume @ahroi/foundation (el design system, repo
# aegis-canvas) como DEPENDENCIA DE GIT, y sin git `npm ci` ni siquiera
# llega a clonar: falla en la resolución.
#
# La alternativa obvia era un `apk add git` dentro del pipeline. Se
# descartó, y no por elegancia: baja un paquete SIN PIN en cada build,
# contra una red que se puede caer y contra un repo que puede mover la
# versión abajo de los pies. Un build reproducible no puede depender de
# eso. Acá el pin es el FROM, y el tag de la imagen resultante se DERIVA
# de él — mismo contrato que aegis-ci-cosign y aegis-ci-crane, sin un
# segundo lugar donde editar la versión.
#
# git y NO openssh-client, a propósito: el pipeline reescribe las URLs
# ssh:// a https:// con un token de corta vida, así que no hace falta
# cliente ssh, ni llave montada, ni verificación de host key.
#
# A diferencia de cosign y crane —que son distroless y hay que extraer
# sobre alpine— node:alpine ya trae shell, así que se le agrega git y
# nada más.
FROM node:22.23.1-alpine

# Los `--version` no son adorno: si el apk deja la imagen sin git, el
# build de ESTA imagen falla acá y no seis meses después dentro del
# pipeline de una app, que es donde el error sale disfrazado.
RUN apk add --no-cache git \
 && git --version \
 && node --version \
 && npm --version
