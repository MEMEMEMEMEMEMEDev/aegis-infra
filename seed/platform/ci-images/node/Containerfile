# aegis-ci-node — node with git, for building sites whose dependencies
# live in private git repos.
#
# The official `node:*-alpine` image ships neither git nor an ssh
# client. The portfolio consumes @ahroi/foundation (the design system,
# repo aegis-canvas) as a GIT DEPENDENCY, and without git `npm ci` does
# not even get as far as cloning: it fails at resolution.
#
# The obvious alternative was an `apk add git` inside the pipeline. It
# was discarded, and not out of elegance: it pulls an UNPINNED package
# on every build, against a network that can go down and against a repo
# that can move the version out from under our feet. A reproducible
# build cannot depend on that. Here the pin is the FROM, and the tag of
# the resulting image is DERIVED from it — same contract as
# aegis-ci-cosign and aegis-ci-crane, with no second place to edit the
# version.
#
# git and NOT openssh-client, on purpose: the pipeline rewrites the
# ssh:// URLs to https:// with a short-lived token, so there is no need
# for an ssh client, a mounted key, or host key verification.
#
# Unlike cosign and crane —which are distroless and have to be extracted
# onto alpine— node:alpine already ships a shell, so git is added to it
# and nothing else.
FROM node:22.23.1-alpine

# The `--version` calls are not decoration: if the apk leaves the image
# without git, the build of THIS image fails right here and not six
# months later inside some app pipeline, which is where the error comes
# out in disguise.
RUN apk add --no-cache git \
 && git --version \
 && node --version \
 && npm --version
