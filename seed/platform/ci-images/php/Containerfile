# aegis-ci-php — PHP 8.4 with composer and git, for building PHP
# applications in the pipeline. It BUILDS; it never runs in a tenant
# namespace, which is aegis-base-php's job.
#
# BEWARE THE EASY CONFUSION, the same one mirror-images/images.txt warns
# about for node: aegis-ci-php does NOT serve aegis-base-php's purpose
# and the other way round. This one needs composer and git in order to
# resolve dependencies; the base must not have them anywhere near a
# tenant pod. Two images for two jobs: one builds, the other runs.
#
# WHY alpine + apk AND NOT `FROM php:8.4-cli-alpine`
# ──────────────────────────────────────────────────
# The official image would be one line shorter and would bring a
# DIFFERENT PHP than the one that runs in production: a different build,
# a different extension set, different compile flags. That is the same
# argument base-images/node/Containerfile makes for node and musl, and
# it weighs more here, because a PHP extension missing or differing
# between build and runtime does not fail at `composer install` — it
# fails in a request, months later, in a stack trace that names a class.
# Same alpine, same php84 packages, same extensions: what builds the
# application is the runtime the application will have.
#
# WHY composer COMES AS A PINNED PHAR AND NOT FROM apk
# ────────────────────────────────────────────────────
# MEASURED, because it is not obvious: alpine's `composer` package
# declares `D:php83 php83-phar php83-curl php83-iconv php83-mbstring
# php83-openssl php83-zip p7zip`. Installing it would pull a SECOND PHP
# — 8.3 — into this image, and composer would then run under a
# different interpreter than the one it is resolving dependencies for.
# That defeats the entire paragraph above.
#
# So the phar, pinned BY VERSION AND BY SHA-256, verified before it is
# allowed to exist. A download in a build is only acceptable when it is
# pinned to content; this one is. The ARG is the single source of the
# pin and the tag of this image is derived from it, the same shape
# aegis-ci-tofu uses.
FROM public.ecr.aws/docker/library/alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

ARG PHP_VERSION=8.4.16
ARG COMPOSER_VERSION=2.8.10
# sha256 of composer.phar 2.8.10, measured 2026-09-12 from
# github.com/composer/composer/releases. If upstream ever replaces the
# artifact under the same version, this build fails instead of
# installing whatever is there now.
ARG COMPOSER_SHA256=28dbb6bd8bef31479c7985b774c130a8bda37dbe63c35b56f6cb6bc377427573

# The php84 set is aegis-base-php's, PLUS what only a build needs:
#   php84-zip + unzip  composer extracts dist packages with these; with
#                      neither it silently falls back to cloning every
#                      package from source, which is slower and needs
#                      network to places the pipeline should not go.
#   git                composer resolves `dev-` branches and any
#                      repository entry through it. Adding it in the
#                      pipeline instead would pull an UNPINNED package
#                      on every build, against a network that can go
#                      down — the aegis-ci-node lesson, verbatim.
#   libgcc             MEASURED, and it is the whole reason this image
#                      exists. php84-opcache links against libgcc_s.so.1
#                      and does NOT declare it, so without this package
#                      every single `php` invocation here printed
#                      «Failed loading Zend extension 'opcache'» and ran
#                      WITHOUT opcache. The base image gets libgcc for
#                      free because nginx pulls it in; this one has no
#                      nginx. That is exactly the build/runtime
#                      divergence this image is supposed to prevent —
#                      and it arrived as a warning on stderr, which is
#                      the shape that gets scrolled past.
#
# NO php84-intl here either, and for the same reason as the base: what
# builds and what runs must agree. An `intl` present at build and absent
# at runtime is a class that exists in CI and not in the pod.
RUN set -eux; \
    apk upgrade --no-cache; \
    apk add --no-cache \
      git unzip curl \
      libgcc \
      php84 php84-common \
      php84-ctype php84-curl php84-dom php84-fileinfo php84-iconv \
      php84-mbstring php84-opcache php84-openssl php84-pdo php84-pdo_pgsql \
      php84-phar php84-session php84-simplexml php84-sodium \
      php84-tokenizer php84-xml php84-xmlwriter php84-zip; \
    ln -sf /usr/bin/php84 /usr/bin/php

# THE PHAR, verified before it is trusted, staged through /tmp and left
# WITHOUT an execute bit. The shape is aegis-ci-tofu's, and it is not a
# preference: it is the one that builds here. What follows is what was
# MEASURED, because the first explanation written in this file was wrong
# and a diagnostic put in to check it said so.
#
#   build #2  the phar went straight into /usr/local/bin/composer with
#             busybox wget and was then chmod'ed 0755. kaniko answered
#             «error building stage: failed to execute command:
#             permission denied». The obvious reading — "the builder
#             refuses chmod" — went into this comment, and was WRONG.
#   build #3  a non-fatal probe printed `chmod: ACEPTADO por este
#             builder`. So chmod is fine, and the comment was folklore.
#   build #4  two isolated probes, each ending in `true` so neither
#             could fail the build:
#               · touch + chmod + rm inside /usr/local/bin  → passes
#               · wget of the 3 MB phar into /usr/local/bin, chmod, rm
#                 → every command runs and echoes, and THEN the stage
#                 dies with the same message, before kaniko even prints
#                 "Taking snapshot". The shell had already exited 0.
#
# So the failure is not the chmod and not the shell: it is kaniko's own
# work at the end of a stage that pulled a multi-megabyte file into
# /usr/local/bin. The mechanism is not established — and it does not
# need to be, because the shape that does build is already the house
# pattern: download to /tmp, verify the checksum, put the file in its
# final home. What IS established is which shapes fail and which works,
# and that is what a comment should carry.
#
# The phar therefore keeps mode 0644 and lives under /usr/local/lib.
# Nothing is lost: every caller goes through the interpreter anyway, and
# a pipeline that writes `php /usr/local/lib/composer.phar install` says
# out loud WHICH php is resolving the dependencies — which is the entire
# point of this image (see the php83 note above).
#
# curl viene en la lista de arriba Y SE QUEDA. La forma habitual —instalarlo
# como `--virtual .build-deps` y borrarlo con `apk del` al terminar— se probó y
# ROMPIÓ LA IMAGEN de una manera que vale la pena dejar escrita:
#
#   Con el `apk del` al final de este RUN, la imagen resultante decía
#   `apk info -e libgcc` → instalado, y `find / -name 'libgcc_s.so*'` → nada.
#   El log del propio apk muestra que sólo purgó curl («Purging curl»), o sea
#   que el paquete no lo borró apk: se perdió en el snapshot que kaniko toma
#   después de un borrado. Y el efecto no era un error: php seguía arrancando,
#   sin opcache, avisando una vez por stderr.
#
# No hay `apk del`, no hay snapshot sobre un borrado, no hay problema. Un
# paquete de más en una imagen que ni se escanea ni corre en un tenant vale
# infinitamente menos que un build que produce algo distinto de lo que dice.
RUN set -eux; \
    curl -fsSL -o /tmp/composer.phar \
      "https://github.com/composer/composer/releases/download/${COMPOSER_VERSION}/composer.phar"; \
    echo "${COMPOSER_SHA256}  /tmp/composer.phar" | sha256sum -c -; \
    mkdir -p /usr/local/lib; \
    cp /tmp/composer.phar /usr/local/lib/composer.phar; \
    rm -f /tmp/composer.phar

# The `--version` calls are not decoration: if an apk leaves the image
# without one of these, the build of THIS image fails right here and not
# six months later inside some app pipeline, which is where the error
# comes out in disguise. The extension loop names the missing one.
RUN set -eux; \
    php -v; \
    git --version; \
    unzip -v > /dev/null; \
    php /usr/local/lib/composer.phar --version --no-interaction; \
    for ext in ctype curl dom fileinfo iconv mbstring openssl pdo pdo_pgsql \
               Phar session SimpleXML sodium tokenizer xml xmlwriter zip; do \
      php -m | grep -qix "$ext" || { echo "MISSING PHP EXTENSION: $ext"; php -m; exit 1; }; \
    done; \
    php -m | grep -qix "Zend OPcache" || { \
      echo "OPCACHE NO CARGA. Suele ser libgcc_s.so.1 ausente: php84-opcache"; \
      echo "enlaza contra ella y NO la declara. php -v lo dice en stderr y"; \
      echo "sigue andando, que es la forma en que esto pasa desapercibido."; \
      php -v; exit 1; }; \
    php -r 'exit(ini_get("opcache.enable") === false ? 1 : 0);'

# Composer must never phone home from the pipeline for anything but the
# packages it was asked for, and must never write outside the workspace.
ENV COMPOSER_ALLOW_SUPERUSER=1 \
    COMPOSER_NO_INTERACTION=1 \
    COMPOSER_CACHE_DIR=/tmp/composer-cache \
    COMPOSER_HOME=/tmp/composer-home

