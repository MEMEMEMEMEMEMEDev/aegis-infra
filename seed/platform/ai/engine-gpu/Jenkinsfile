// engine-gpu — build, scan, push and signature of the GPU engine image.
//
// SAME RITE AS EVERY OTHER IMAGE, and that is the whole point of this
// file existing: the image it produces used to be assembled by hand on
// the operator's machine. Here the cosign key lives in a Secret of
// jenkins-system and never leaves it, the scan is the same blocking one
// every pipeline runs, and the result lands in the same supply-chain
// log. The operator's machine sees neither the key nor the registry.
//
// build -> scan -> push -> sign, the order of Jenkinsfile.app: the scan
// runs BEFORE the push (an image that does not pass the scan never
// comes to exist in the registry) and the signature is by DIGEST, never
// by tag.
//
// FIRED BY HAND, like mirror-images. This module changes rarely and a
// build per push of the platform repo would rebuild ten gigabytes of
// wheels for every manifest edit that does not touch it.
//
// ── TWO THINGS TO KNOW BEFORE FIRING IT ────────────────────────────
//
// 1. IT IS BIG AND IT IS SLOW. The wheels this pulls (torch with its
//    CUDA runtime, vllm with its kernels) are several gigabytes. The
//    timeout below is generous on purpose; on a domestic uplink the
//    first build is measured in hours, and a build that dies at 45
//    minutes teaches nothing.
// 2. THE BASE MUST BE RESOLVED FIRST. The Containerfile's FROM is a
//    placeholder until `aegis ai images` writes the internal registry's
//    digest into it. Kaniko would otherwise fail on a literal
//    `__FROM_PYTHON__`, which is a clear error but a late one — the
//    preflight stage below turns it into an immediate one.
//
// ── VERIFIED 2026-09-02 ────────────────────────────────────────────
// Run for the first time on this date, and it took several runs to
// get there — every one of them a defect this pipeline could not have
// known about while it was only written: a reserved word that stopped
// it from parsing, a builder that cannot work through the container
// exec API, a node with no room for the layers, and a scan that
// refused four fixable CVEs. All corrected in place, each with the
// measurement that moved it.
//
// It now builds in ~24 minutes and pushes an image that scans with
// zero findings.
pipeline {
  agent {
    kubernetes {
      // jenkins-system's ResourceQuota is strict: EVERY container
      // declares limits, jnlp included — never `yaml ''`.
      yaml '''
apiVersion: v1
kind: Pod
spec:
  imagePullSecrets:
  - name: regcred-internal
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:3355.v388858a_47b_33-23
    resources:
      requests: { cpu: 500m, memory: 512Mi }
      limits:   { cpu: 1000m, memory: 1Gi }
  # kaniko WITHOUT privileges. The Containerfile's RUN steps happen in
  # here and need to reach the wheel indexes; the memory is generous
  # because pip unpacks wheels of hundreds of megabytes and torch is
  # the largest of them.
  - name: kaniko
    image: gcr.io/kaniko-project/executor:v1.23.2-debug
    # NOT `sleep infinity` plus `container('kaniko'){ sh }`, which is
    # the usual shape and the one every other lane uses. Measured on
    # 2026-09-01: kaniko started through the container EXEC API dies
    # with «failed to execute command: permission denied» the moment
    # the build installs an OS package — one `apt-get install less` is
    # enough, and the RUN itself completes first, so the error lands
    # nowhere near its cause. The same Containerfile, the same pod,
    # the same kaniko, started inside the container's OWN process
    # tree, builds fine. It is not Debian, not apt, not the snapshot
    # mode: four flags and five hypotheses were tried and only this
    # distinction holds.
    #
    # So the container's main process IS the builder: it waits for the
    # arguments the pipeline writes, runs the executor as its own
    # child, leaves the exit code in a file and stays alive so Jenkins
    # keeps its agent. The pipeline never execs into this container.
    command:
    - /busybox/sh
    - -c
    - |
      until [ -f /home/jenkins/agent/kaniko.go ]; do /busybox/sleep 2; done
      /kaniko/executor $(/busybox/cat /home/jenkins/agent/kaniko.args) \
        > /home/jenkins/agent/kaniko.log 2>&1
      /busybox/echo $? > /home/jenkins/agent/kaniko.rc
      exec /busybox/sleep infinity
    volumeMounts:
    - name: regcred
      mountPath: /kaniko/.docker/config.json
      subPath: .dockerconfigjson
      readOnly: true
    - name: ca-trust
      mountPath: /kaniko/ca.crt
      subPath: ca.crt
      readOnly: true
    resources:
      requests: { cpu: 1000m, memory: 2Gi }
      limits:   { cpu: 3000m, memory: 8Gi }
  # trivy: a THIN client — the server (trivy-system) holds the database.
  - name: trivy
    image: ghcr.io/aquasecurity/trivy:0.72.0
    command: ['sleep', 'infinity']
    resources:
      requests: { cpu: 250m, memory: 512Mi }
      limits:   { cpu: 1000m, memory: 2Gi }
  - name: crane
    image: registry.registry-system.svc.cluster.local:5000/aegis-ci-crane:v0.20.3
    command: ['sleep', 'infinity']
    env:
    - name: DOCKER_CONFIG
      value: /crane/docker
    - name: SSL_CERT_FILE
      value: /crane/ca/ca.crt
    volumeMounts:
    - name: regcred
      mountPath: /crane/docker/config.json
      subPath: .dockerconfigjson
      readOnly: true
    - name: ca-trust
      mountPath: /crane/ca/ca.crt
      subPath: ca.crt
      readOnly: true
    resources:
      requests: { cpu: 250m, memory: 256Mi }
      limits:   { cpu: 1000m, memory: 1Gi }
  # cosign: the password arrives by secretKeyRef, NEVER through argv.
  # No `optional`: a missing key is a real error and must break here —
  # an unsigned image does not run, and the symptom would otherwise
  # surface much later, at Kyverno's admission.
  - name: cosign
    image: registry.registry-system.svc.cluster.local:5000/aegis-ci-cosign:v2.6.3
    command: ['sleep', 'infinity']
    env:
    - name: COSIGN_PASSWORD
      valueFrom:
        secretKeyRef:
          name: cosign-signing-key
          key: cosign.password
    - name: DOCKER_CONFIG
      value: /cosign/docker
    volumeMounts:
    - name: cosign-key
      mountPath: /cosign/keys/cosign.key
      subPath: cosign.key
      readOnly: true
    - name: regcred
      mountPath: /cosign/docker/config.json
      subPath: .dockerconfigjson
      readOnly: true
    - name: ca-trust
      mountPath: /cosign/ca/ca.crt
      subPath: ca.crt
      readOnly: true
    resources:
      requests: { cpu: 100m, memory: 128Mi }
      limits:   { cpu: 500m, memory: 256Mi }
  volumes:
  - name: regcred
    secret:
      secretName: regcred-internal
      items: [{ key: .dockerconfigjson, path: .dockerconfigjson }]
  - name: ca-trust
    secret:
      secretName: aegis-ca-trust
      items: [{ key: ca.crt, path: ca.crt }]
  - name: cosign-key
    secret:
      secretName: cosign-signing-key
      items: [{ key: cosign.key, path: cosign.key }]
'''
      defaultContainer 'jnlp'
    }
  }
  options {
    // Hours and not minutes: see «it is big and it is slow» above.
    timeout(time: 4, unit: 'HOURS')
  }
  environment {
    REGISTRY     = 'registry.registry-system.svc.cluster.local:5000'
    IMAGE        = 'aegis-ai-vllm'
    TRIVY_SERVER = 'http://trivy.trivy-system.svc.cluster.local:4954'
  }
  stages {
    stage('preflight') {
      // Fails EARLY. Without a key there is no signature and without a
      // signature the image does not run; and with an unresolved FROM
      // there is nothing to build. Better to know both before hours of
      // wheels.
      steps {
        container('cosign') {
          sh '''
            test -f /cosign/keys/cosign.key || {
              echo "ERROR: the cosign-signing-key Secret is missing from jenkins-system."
              exit 1
            }
          '''
        }
        sh '''
          # ONLY the FROM lines. Until 2026-09-01 this grepped the whole
          # file, and the file DOCUMENTS its own placeholder in a comment
          # right above the FROM — so the guard matched its own
          # explanation and the pipeline could never be built, resolved
          # or not. The same trap that had to be corrected in checks 161,
          # 163, 165 and 166 the same day: prose read as code.
          if grep -E '^[[:space:]]*FROM[[:space:]]' ai/engine-gpu/Containerfile | grep -q '__FROM_'; then
            echo "ERROR: the FROM of ai/engine-gpu/Containerfile is still a placeholder."
            echo "It is resolved against the INTERNAL registry, by digest, before building:"
            echo "  aegis ai bases"
            echo "A base that did not go through the mirror was neither scanned nor signed,"
            echo "and a pod built on it is rejected at admission."
            exit 1
          fi
        '''
      }
    }
    stage('compute-tag') {
      steps {
        script {
          // The vLLM version plus the short commit: the tag says which
          // engine this is, and the manifest still pins by digest.
          def version = sh(returnStdout: true, script:
            'sed -n "s/^RUN pip install --no-cache-dir vllm==\\([0-9.]*\\).*/\\1/p" ai/engine-gpu/Containerfile | head -1').trim()
          // `commit`, and NOT `short`: short is a primitive type in
          // Groovy, so `def short = …` does not parse and the whole
          // pipeline dies before its first stage. This lane's twin
          // called it `corto`; translating the product into English
          // turned that into a keyword.
          def commit = sh(returnStdout: true, script: 'git rev-parse --short=7 HEAD').trim()
          if (!version) { error 'could not read the vllm version out of the Containerfile' }
          env.TAG = "vllm${version}-${commit}"
          echo "tag: ${env.TAG}"
        }
      }
    }
    stage('build') {
      steps {
        // Driven from the agent: the arguments go to a file, the
        // builder is woken with a flag file, its log is streamed and
        // its exit code is read back. See the kaniko container above
        // for why it is not `container('kaniko'){ sh }`.
        sh '''
          set -eu
          W=/home/jenkins/agent
          rm -f "$W/kaniko.rc" "$W/kaniko.go"
          : > "$W/kaniko.log"
          printf '%s' "--context=dir://${WORKSPACE}/ai/engine-gpu --dockerfile=Containerfile --destination=${REGISTRY}/${IMAGE}:${TAG} --no-push --tarPath=${WORKSPACE}/image.tar --compressed-caching=false --registry-certificate ${REGISTRY}=/kaniko/ca.crt" > "$W/kaniko.args"
          touch "$W/kaniko.go"
          # --compressed-caching=false: kaniko keeps every layer it has
          # already snapshotted compressed IN MEMORY, and this image
          # unpacks torch+cu128 and vLLM — several GB per layer.
          # Measured 2026-09-01: without the flag the kaniko container
          # was OOMKilled at its 8Gi ceiling right after torch
          # installed. The flag trades that memory for disk, which is
          # the resource this machine actually has.
          # the build runs for hours: its output has to be visible AS
          # it happens, not at the end.
          tail -f "$W/kaniko.log" & TAIL=$!
          while [ ! -f "$W/kaniko.rc" ]; do sleep 5; done
          sleep 2; kill "$TAIL" 2>/dev/null || true
          RC="$(cat "$W/kaniko.rc")"
          [ "$RC" = "0" ] || {
            echo "kaniko finished with rc=$RC — the console above is its whole output"
            exit 1
          }
        '''
      }
    }
    stage('scan') {
      steps {
        container('trivy') {
          sh '''
            trivy image \
              --server ${TRIVY_SERVER} \
              --input ${WORKSPACE}/image.tar \
              --exit-code 1 \
              --severity CRITICAL,HIGH \
              --ignore-unfixed \
              --scanners vuln \
              --no-progress
          '''
        }
      }
    }
    stage('push') {
      steps {
        container('crane') {
          sh '''
            crane push ${WORKSPACE}/image.tar ${REGISTRY}/${IMAGE}:${TAG}
            crane digest ${REGISTRY}/${IMAGE}:${TAG} > ${WORKSPACE}/image-digest
            echo "pushed digest: $(cat ${WORKSPACE}/image-digest)"
          '''
        }
      }
    }
    stage('sign') {
      steps {
        container('cosign') {
          sh '''
            DIGEST=$(cat ${WORKSPACE}/image-digest)
            cosign sign --yes \
              --key /cosign/keys/cosign.key \
              --tlog-upload=false \
              --registry-cacert /cosign/ca/ca.crt \
              ${REGISTRY}/${IMAGE}@${DIGEST}
            echo "signed: ${REGISTRY}/${IMAGE}@${DIGEST}"
          '''
        }
      }
    }
    stage('report') {
      steps {
        sh '''
          DIGEST=$(cat ${WORKSPACE}/image-digest 2>/dev/null || echo "")
          printf 'AEGIS_EVENT {"event":"supply-chain","image":"%s","tag":"%s","digest":"%s","ts":"%s"}\\n' \
            "${IMAGE}" "${TAG}" "${DIGEST}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
          echo "NEXT STEP (building does not deploy): pin this digest with"
          echo "  aegis ai images"
          echo "which writes it into k8s/base/ai-system/kustomization.yaml."
        '''
      }
    }
  }
}
