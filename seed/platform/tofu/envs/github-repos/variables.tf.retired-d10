variable "github_pat" {
  description = "Fine-grained PAT (Administration RW, Contents RW, Metadata R, Webhooks RW). Wrapper-only, no default (A14). IT EXPIRES: write the date down in Bitwarden (issue-github-token.md)."
  type        = string
  sensitive   = true
}

variable "github_argocd_webhook_secret" {
  description = "HMAC shared by the GitHub->ArgoCD webhook. Same origin as the KSOPS Secret github-webhook (generated TOGETHER in phase 15 — A27)."
  type        = string
  sensitive   = true
}

variable "github_owner" {
  type = string
}

variable "platform_repo_name" {
  type    = string
  default = "ops-stack"
}

variable "root_domain" {
  type = string
}
