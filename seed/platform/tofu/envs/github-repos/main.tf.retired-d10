# env github-repos v2 — the platform repo's settings + the
# GitHub→ArgoCD webhook. B4 FIXED AT THE ROOT: an explicit
# delete_branch_on_merge=false AND the module's default is false too
# (in v1 the fix lived only in gh api and the .tf contradicted it —
# 2026-06-17:210-218).

terraform {
  required_providers {
    github = {
      source  = "integrations/github"
      version = "~> 6.0"
    }
  }
}

provider "github" {
  token = var.github_pat
  owner = var.github_owner
}

module "platform_repo" {
  source = "../../modules/github-repos"

  repo_name   = var.platform_repo_name
  description = "aegis platform (v2) — IaC + GitOps + CI/CD"
  visibility  = "private"

  # operational rule B4: branches are NOT deleted on merge.
  delete_branch_on_merge = false

  # current flow: feature -> PR to main -> squash
  allow_squash_merge = true
  default_branch     = "main"

  # GitHub -> ArgoCD webhook (HMAC from tokens.enc.yaml; the receiving
  # side is the KSOPS Secret github-webhook — ADR-0015, D8):
  argocd_webhook_url    = "https://argocd.${var.root_domain}/api/webhook"
  argocd_webhook_secret = var.github_argocd_webhook_secret
}
