# module github-repos v2 — the repo's settings + the ArgoCD webhook.
# Default delete_branch_on_merge=FALSE (B4: in v1 the module's default
# of true was a landmine — every new consumer stepped on it).

terraform {
  required_providers {
    github = { source = "integrations/github", version = "~> 6.0" }
  }
}

variable "repo_name" { type = string }
variable "description" {
  type    = string
  default = ""
}
variable "visibility" {
  type    = string
  default = "private"
}
variable "delete_branch_on_merge" {
  description = "OPERATIONAL RULE: false. The setting deletes branches on merge even without --delete-branch (pothole B4, 2026-06-17)."
  type        = bool
  default     = false
}
variable "allow_squash_merge" {
  type    = bool
  default = true
}
variable "default_branch" {
  type    = string
  default = "main"
}
variable "argocd_webhook_url" { type = string }
variable "argocd_webhook_secret" {
  type      = string
  sensitive = true
}

resource "github_repository" "this" {
  name                   = var.repo_name
  description            = var.description
  visibility             = var.visibility
  delete_branch_on_merge = var.delete_branch_on_merge
  allow_squash_merge     = var.allow_squash_merge
  allow_merge_commit     = true
  allow_rebase_merge     = true
  has_issues             = true

  squash_merge_commit_title   = "COMMIT_OR_PR_TITLE"
  squash_merge_commit_message = "COMMIT_MESSAGES"

  lifecycle {
    # greenfield creates it; if the repo already exists (re-bootstrap),
    # it is imported by hand BEFORE the apply — init v1 does not
    # import (H5).
    prevent_destroy = true
  }
}

resource "github_branch_default" "main" {
  repository = github_repository.this.name
  branch     = var.default_branch
}

resource "github_repository_webhook" "argocd" {
  repository = github_repository.this.name
  active     = true
  events     = ["push"]

  configuration {
    url          = var.argocd_webhook_url
    content_type = "json"
    secret       = var.argocd_webhook_secret
    insecure_ssl = false
  }
}
