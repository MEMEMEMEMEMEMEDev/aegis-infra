// mirror-images — pulls THIRD-PARTY images into the internal registry,
// scans them and SIGNS them with the aegis key.
//
// THE PROBLEM IT SOLVES
// require-aegis-signature demands our own signature for every Pod in a
// tenant namespace. A public image (redis, postgres, whatever) cannot
// run there. Without this job the only way out was to weaken the
// policy — that is, to break the platform's central property in order
// to use a database. This job is the correct way out: the third-party
// image goes through the SAME control as our own code (blocking scan +
// signature), and only then does it get in.
//
// WHAT THIS JOB DOES NOT DO: deploy. Mirroring an image does not put it
// in production; that is an explicit bump in the manifest that consumes
// it. Two distinct decisions, taken separately.
//
// The list lives in mirror-images/images.txt, pinned BY DIGEST
// (`name:tag@digest`: the tag is kept as text for image-watch, the
// digest is what gets pulled).
//
// NO kaniko: nothing is built here. crane pulls the tar, trivy looks at
// it, crane pushes it, cosign signs it. The order matters: the scan runs
// BEFORE the push, just like in Jenkinsfile.app — an image that did not
// pass the scan never comes to exist in the registry.
//
// WHAT THE SCAN DECIDES, since 2026-09-30 (plan/21). Until that day a
// fixable CRITICAL/HIGH stopped the entry and the job went red, and it
// did so for EVERY entry on EVERY run: two OpenSSL CVEs published the
// day before, in python:3.12-slim and nodejs-distroless:22, killed a
// clean install on the Arch lab VM although the platform needs neither of
// them to run and nobody could make them clean. Now:
//   - an entry already in the registry, signed by aegis FROM THIS SAME
//     SOURCE (the signature carries it as an annotation, verified with
//     our key), is not judged again here: what is inside it is
//     image-watch's to re-scan every morning, against today's DB;
//   - a new entry is judged by vuln-policy/verdict.sh, the one verdict
//     every scan uses: inside its window a finding enters as DEBT with a
//     due date; past it, exploited in the wild, or undated, the entry is
//     RETAINED — not pushed, not signed, named in the console;
//   - the job ends red when an entry is BROKEN (pull, scan, verdict,
//     push, sign), UNSTABLE when entries were only retained, and green
//     otherwise, debts and all.
// Script-level state shared between stages. Declared as fields ON
// PURPOSE: a bare `NAME = value` inside a stage makes Jenkins warn
// «WorkflowScript seems to be setting a field named NAME … did you
// forget the def keyword?» on every run (measured on the first build
// of base-images, 2026-08-27), and a `def` inside the stage would die
// with it. @Field is the declared shape of a script global.
import groovy.transform.Field
@Field def MIRROR_ENTRIES = []
@Field def RETAINED = []

pipeline {
  agent {
    kubernetes {
      // jenkins-system's strict RQ: EVERY container declares limits
      // (jnlp included — never `yaml ''`, that overrides the default).
      yaml '''
apiVersion: v1
kind: Pod
spec:
  imagePullSecrets:
  - name: regcred-internal
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:3355.v388858a_47b_33-23
    resources:
      requests: { cpu: 250m, memory: 512Mi }
      limits:   { cpu: 1000m, memory: 1Gi }
  # crane: talks to the PUBLIC registries (pull) and to the internal
  # one (push). SSL_CERT_FILE points at the aegis CA and that does NOT
  # break public TLS: Go loads that file IN ADDITION TO the system
  # certificate directories (/etc/ssl/certs), not instead of them — it
  # is additive. Verified against this very binary before writing the
  # job. That is why ONE container is enough for both sides.
  - name: crane
    image: registry.registry-system.svc.cluster.local:5000/aegis-ci-crane:v0.20.3
    command: ['sleep', 'infinity']
    env:
    - name: DOCKER_CONFIG
      value: /crane/docker
    - name: SSL_CERT_FILE
      value: /crane/ca/ca.crt
    volumeMounts:
    - name: regcred
      mountPath: /crane/docker/config.json
      subPath: .dockerconfigjson
      readOnly: true
    - name: ca-trust
      mountPath: /crane/ca/ca.crt
      subPath: ca.crt
      readOnly: true
    resources:
      requests: { cpu: 100m, memory: 256Mi }
      limits:   { cpu: 1000m, memory: 1Gi }
  # trivy: THIN client — the server (trivy-system) holds the DB.
  - name: trivy
    image: ghcr.io/aquasecurity/trivy:0.72.0
    command: ['sleep', 'infinity']
    resources:
      requests: { cpu: 100m, memory: 256Mi }
      limits:   { cpu: 1000m, memory: 1Gi }
  # cosign: custom aegis-ci-cosign image (the official binary is
  # distroless and container(){sh} needs a shell). Password through
  # secretKeyRef, NEVER argv. No optional here: this job does not run
  # during bootstrap, so a missing key is a real error and must break
  # the build rather than be skipped.
  - name: cosign
    image: registry.registry-system.svc.cluster.local:5000/aegis-ci-cosign:v2.6.3
    command: ['sleep', 'infinity']
    env:
    - name: COSIGN_PASSWORD
      valueFrom:
        secretKeyRef:
          name: cosign-signing-key
          key: cosign.password
    - name: DOCKER_CONFIG
      value: /cosign/docker
    volumeMounts:
    - name: cosign-key
      mountPath: /cosign/keys/cosign.key
      subPath: cosign.key
      readOnly: true
    - name: regcred
      mountPath: /cosign/docker/config.json
      subPath: .dockerconfigjson
      readOnly: true
    - name: ca-trust
      mountPath: /cosign/ca/ca.crt
      subPath: ca.crt
      readOnly: true
    resources:
      requests: { cpu: 50m, memory: 128Mi }
      limits:   { cpu: 500m, memory: 256Mi }
  volumes:
  - name: regcred
    secret:
      secretName: regcred-internal
      items: [{ key: .dockerconfigjson, path: .dockerconfigjson }]
  - name: ca-trust
    secret:
      secretName: aegis-ca-trust
      items: [{ key: ca.crt, path: ca.crt }]
  - name: cosign-key
    secret:
      secretName: cosign-signing-key
      items: [{ key: cosign.key, path: cosign.key }]
'''
      defaultContainer 'jnlp'
    }
  }
  options {
    timeout(time: 45, unit: 'MINUTES')
  }
  environment {
    REGISTRY     = 'registry.registry-system.svc.cluster.local:5000'
    TRIVY_SERVER = 'http://trivy.trivy-system.svc.cluster.local:4954'
  }
  stages {
    stage('preflight') {
      // Fails EARLY and with a message that says what to do. Without
      // this, a missing key only shows up in the last stage of the
      // last image, after pulling and scanning everything.
      steps {
        container('cosign') {
          sh '''
            test -f /cosign/keys/cosign.key || {
              echo "ERROR: the cosign-signing-key Secret is missing in jenkins-system."
              echo "       Without a key nothing can be signed, and an unsigned"
              echo "       image does not run in a tenant. See phase 80-supply-chain."
              exit 1
            }
          '''
        }
        container('trivy') {
          sh '''
            wget -q -T 10 -O /dev/null "${TRIVY_SERVER}/healthz" || {
              echo "ERROR: trivy-server is not answering at ${TRIVY_SERVER}."
              echo "       Mirroring without scanning is not an option: it would"
              echo "       sign with the aegis key something nobody has looked at."
              exit 1
            }
          '''
        }
      }
    }

    stage('parse list') {
      steps {
        script {
          def entries = []
          readFile('mirror-images/images.txt').split('\n').each { line ->
            def l = line.trim()
            if (!l || l.startsWith('#')) { return }
            def parts = l.split(/\s+/)
            if (parts.size() != 2) {
              error "images.txt: malformed line (2 fields expected): ${l}"
            }
            if (!parts[0].contains('@sha256:')) {
              // The digest pin is not optional: a tag is a mutable
              // pointer, and mirroring one signs with OUR key whatever
              // the source happens to be serving today.
              error "images.txt: the source must be pinned by digest: ${parts[0]}"
            }
            if (!(parts[0] =~ /:[^@\/]+@sha256:/)) {
              // Not an error: instances written before 2026-08-27 carry
              // `<source>@<digest>` with the tag in a comment, and they
              // still mirror fine. What they lose is the morning
              // question — image-watch cannot ask whether a tag moved
              // upstream when it does not know the tag. In the seed,
              // check 135 makes this shape impossible.
              echo "NOTICE: ${parts[0]} carries no upstream tag — image-watch cannot ask whether upstream moved (write it as name:tag@digest)"
            }
            entries << [src: parts[0], dst: parts[1]]
          }
          if (entries.isEmpty()) { error 'images.txt has no entries at all' }
          echo "${entries.size()} image(s) to mirror:"
          entries.each { echo "  ${it.src}  ->  ${env.REGISTRY}/${it.dst}" }
          MIRROR_ENTRIES = entries
        }
      }
    }

    stage('exploited list') {
      steps {
        container('trivy') {
          // CISA's list of vulnerabilities exploited in the wild, fresh:
          // a finding on it gets no window at the door. The fetch is the
          // job's, not the verdict's (the verdict never talks to the
          // network). When it fails the platform repo's copy is used —
          // image-watch refreshes it every morning — and verdict.sh
          // decides whether that copy is young enough to give debt credit.
          // Busybox has no jq: the two fields read are flat strings.
          sh '''
            VP="${WORKSPACE}/k8s/base/platform/vuln-policy"
            if wget -q -T 20 -O kev.json https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json 2>/dev/null; then
              REL="$(grep -o '"dateReleased": *"[0-9-]*' kev.json | head -1 | sed 's/.*"//')"
              {
                printf '# CISA KEV dateReleased=%s fetched=%s (by mirror-images #%s)\\n' "$REL" "$(date -u +%Y-%m-%d)" "$BUILD_NUMBER"
                grep -o '"cveID": *"CVE-[0-9]*-[0-9]*"' kev.json | sed 's/.*"\\(CVE-[^"]*\\)"/\\1/'
              } > kev.txt
              echo "exploited-in-the-wild list: $(grep -c '^CVE-' kev.txt) CVE(s), released $REL"
            else
              cp "$VP/kev.txt" kev.txt
              echo "NOTICE: the exploited-in-the-wild list could not be fetched; the platform repo's copy is used ($(head -1 kev.txt | sed 's/.*dateReleased=\\([0-9-]*\\).*/released \\1/')) and the verdict decides whether it is fresh enough"
            fi
            rm -f kev.json
          '''
        }
      }
    }

    stage('mirror') {
      steps {
        script {
          def failed = []
          MIRROR_ENTRIES.each { e ->
            // Through env, not Groovy interpolation: whatever reaches
            // the shell's argv comes from the process environment.
            env.SRC = e.src
            env.DST = e.dst
            echo "================ ${e.dst} ================"
            // ALREADY IN, FROM THIS SOURCE: not judged again at the door.
            // The signature this job left carries the source it mirrored
            // (`aegis.dev/source`), and cosign checks it with our key: a
            // tag somebody pushed by hand, or one mirrored from another
            // digest, does not verify and is mirrored anew.
            def provenance = 1
            container('cosign') {
              provenance = sh(returnStatus: true, script: '''
                cosign public-key --key /cosign/keys/cosign.key > mirror-cosign.pub 2>/dev/null || exit 2
                cosign verify --key mirror-cosign.pub \
                    --registry-cacert /cosign/ca/ca.crt \
                    --insecure-ignore-tlog=true \
                    -a "aegis.dev/source=${SRC}" "${REGISTRY}/${DST}" > /dev/null 2>&1
              ''')
              sh 'rm -f mirror-cosign.pub'
            }
            if (provenance == 0) {
              echo "-- already mirrored from ${e.src} and signed by aegis: not judged again here (image-watch re-scans it every morning)"
              return
            }
            try {
              container('crane') {
                // RETRY on the pull, and ONLY on the pull. It is the
                // only step that depends on a third-party service: build
                // 3 died with "TOOMANYREQUESTS: Rate exceeded" from
                // public.ecr.aws, which is a problem of neither the
                // image nor the platform. Telling "the network failed"
                // from "the image is no good" matters: the first is
                // retried, the second NEVER. Hence no retry on the scan
                // or the signature — retrying a scan that found a CVE
                // would be absurd.
                sh '''
                  rm -f mirror.tar mirror-digest
                  echo "-- pull $SRC"
                  n=0
                  until crane pull "$SRC" mirror.tar; do
                    n=$((n+1))
                    if [ "$n" -ge 3 ]; then
                      echo "   pull failed 3 times — giving up on this image"
                      exit 1
                    fi
                    echo "   transient failure; retry $n/3 in $((n*20))s"
                    sleep $((n*20))
                  done
                '''
              }
              def judged = -1
              container('trivy') {
                // ONE scan, as JSON; the table a person reads and the
                // lines the verdict reads are both converted from it, so
                // they cannot disagree.
                //
                // --ignorefile: exceptions SCOPED BY PATH and with an
                // expiry date, each one with its measurement (or its
                // accepted risk) written beside it (see trivyignore.yaml).
                // What it excuses never reaches the verdict.
                //
                // exit 10 = RETAINED (the verdict stopped it; nothing is
                // pushed); any other non-zero = BROKEN (the scan or the
                // verdict could not be given — never read as clean).
                judged = sh(returnStatus: true, script: '''
                  set -e
                  VP="${WORKSPACE}/k8s/base/platform/vuln-policy"
                  rm -f scan.json findings.txt verdict.txt mirror-debts
                  echo "-- scan $DST"
                  trivy image --server "$TRIVY_SERVER" --input mirror.tar \
                    --exit-code 0 --severity CRITICAL,HIGH --ignore-unfixed \
                    --scanners vuln --no-progress \
                    --ignorefile "${WORKSPACE}/mirror-images/trivyignore.yaml" \
                    --format json --output scan.json
                  trivy convert --format table scan.json
                  trivy convert --format template --template "$(sh "$VP/verdict.sh" --template)" \
                    --output findings.txt scan.json
                  sed "s|^|AEGIS_SCAN $DST |" findings.txt
                  rc=0
                  KEV="${WORKSPACE}/kev.txt" sh "$VP/verdict.sh" findings.txt > verdict.txt || rc=$?
                  sed "s|^|AEGIS_VERDICT $DST |" verdict.txt
                  grep -c '^debt|' verdict.txt > mirror-debts || true
                  case "$rc" in
                    0) exit 0 ;;
                    1) exit 10 ;;
                    *) echo "the verdict could not be given (rc $rc): an unjudged scan is not a clean one"; exit 1 ;;
                  esac
                ''')
              }
              if (judged == 10) {
                echo "FAILED ${e.dst}: retained at the door — the findings marked «block» above stop it (not pushed, not signed; nothing entered the registry)"
                RETAINED << e.dst
                return
              }
              if (judged != 0) {
                error "the scan of ${e.dst} could not be judged (exit ${judged})"
              }
              container('crane') {
                sh '''
                  echo "-- push ${REGISTRY}/${DST}"
                  crane push mirror.tar "${REGISTRY}/${DST}"
                  crane digest "${REGISTRY}/${DST}" > mirror-digest
                  echo "   digest: $(cat mirror-digest)"
                '''
              }
              container('cosign') {
                // Signs BY DIGEST (immutable) against the internal
                // registry. --tlog-upload=false: nothing from the
                // private registry leaves for the public Rekor.
                // `aegis.dev/source` is the provenance the next run
                // verifies before judging this entry again (above).
                sh '''
                  echo "-- sign ${DST}"
                  DIGEST="$(cat mirror-digest)"
                  cosign sign --yes \
                    --key /cosign/keys/cosign.key \
                    --tlog-upload=false \
                    -a "aegis.dev/source=${SRC}" \
                    --registry-cacert /cosign/ca/ca.crt \
                    "${REGISTRY}/${DST%%:*}@${DIGEST}"
                '''
              }
              // Observability HOOK (observability/design.md §2): one
              // JSON line per image, natural key = digest. Same format
              // and same transport as the supply-chain event in
              // Jenkinsfile.app — and for the same reason: printing it
              // is NOT enough. The output of an `sh` does not reach the
              // container stdout but the remoting channel, and Vector,
              // which reads /var/log/pods, never sees it. This printf
              // had been writing to nobody since the day it was born.
              //
              // `source` is "jenkins-mirror" and not the source image:
              // it is the _stream_field, that is, the identity of the
              // PRODUCER of the event, not of its content. The source
              // image goes into `origen`, which is what it always was.
              //
              // And the metrics: here scan and signature are BLOCKING
              // (a third-party image that does not pass the scan is not
              // mirrored), so reaching this line proves both of them
              // ran. The explicit zero is pushed anyway, because an
              // absent series does not say "it was scanned": it says
              // nothing, and mirrored images also run in the namespaces
              // of the organizations. Without this, postgres and garage
              // stayed "unmeasured" forever in the round.
              sh '''
                EVENTO=$(printf \
                  '{"source":"jenkins-mirror","event":"mirror","origen":"%s","image":"%s","digest":"%s","scan_skipped":false,"sign_skipped":false,"debts":%s,"build":"%s","ts":"%s"}' \
                  "${SRC}" "${DST}" "$(cat mirror-digest)" "$(cat mirror-debts 2>/dev/null || echo 0)" "${BUILD_NUMBER}" \
                  "$(date -u +%Y-%m-%dT%H:%M:%SZ)")
                printf 'AEGIS_EVENT %s\\n' "$EVENTO"
                printf '%s\\n' "$EVENTO" \
                  | curl -fsS --max-time 15 \
                      -H 'Content-Type: application/stream+json' --data-binary @- \
                      'http://vlogs-events.observability.svc.cluster.local:9428/insert/jsonline?_time_field=ts&_msg_field=image&_stream_fields=source' 2>/dev/null \
                  || echo "NOTICE: the event could not be recorded in vlogs-events (curl exit $?; the mirror does NOT fail over this)"
                IMG="${DST%%:*}"
                {
                  printf 'aegis_build_scan_skipped{image="%s"} 0\\n' "$IMG"
                  printf 'aegis_build_sign_skipped{image="%s"} 0\\n' "$IMG"
                  printf 'aegis_build_timestamp_seconds{image="%s"} %s\\n' "$IMG" "$(date -u +%s)"
                } | curl -fsS --max-time 15 --data-binary @- \
                      'http://vmsingle.observability.svc.cluster.local:8428/api/v1/import/prometheus' 2>/dev/null \
                  || echo "NOTICE: the mirror metrics did not reach vmsingle (curl exit $?; the mirror does NOT fail over this)"
              '''
            } catch (err) {
              // A broken image must not stop the rest from being
              // mirrored: it is noted down and the loop goes on. The
              // build fails at the end all the same — but with the
              // whole picture instead of just the first error.
              echo "FAILED ${e.dst}: ${err.getMessage()}"
              failed << e.dst
            } finally {
              sh 'rm -f mirror.tar mirror-digest mirror-debts scan.json findings.txt verdict.txt || true'
            }
          }
          if (failed) {
            error "images that failed (${failed.size() + RETAINED.size()}): ${(failed + RETAINED).join(', ')}"
          }
          if (RETAINED) {
            // Retained is not broken: the job did its work, and what it
            // held back is named, entry by entry, with the findings that
            // stopped it (AEGIS_VERDICT … block). UNSTABLE says exactly
            // that; lib/jenkins.sh reads it as rc 4, and phase 80 stops
            // only if the platform itself needs a retained image.
            RETAINED.each { echo "RETAINED ${it}" }
            unstable "images that failed (${RETAINED.size()}): ${RETAINED.join(', ')} — retained at the door, nothing else broke"
          } else {
            echo "all images mirrored and signed (or already in, from the same source)."
          }
        }
      }
    }
  }
}
